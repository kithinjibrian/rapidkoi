// Verifying a signed site, without a network: sites are built in memory
// with real keys and signatures, and fetched through a fake `get`. Every
// check has a case that fails it, and trust is recorded only on success.
import rapidkoi.trust.verify {
    Standing,
    Change,
    Keyring,
    VerifyError,
    keyring,
    verify_site,
    separate,
    standing_of,
    Identity,
    identities,
    keyring_of,
    changes,
    moves,
    check_site,
    record,
    known_for,
    reason,
};
import rapidkoi.trust.index {
    Index,
    KeyFile,
    Rotation,
    sign_index,
    add,
    withdraw,
    key_file,
    rotate,
};
import rapidkoi.bundles.signing { write_signed, read_any };
import rapidkoi.trust.keys { SecretKey, hex };
import rapidkoi.bundles.bundle { Bundle, Manifest };
import std.crypto { ed25519_keypair, sha256 };
import std.time;

const HOST: string = "localhost:8000";
const SITE: string = "/.well-known/rapidkoi";

fun key(host: string): SecretKey {
    let (secret, pk) = ed25519_keypair().unwrap();
    SecretKey { host: host, secret: secret, public_key: pk }
}

fun app(version: string): Bundle = Bundle {
    manifest: Manifest {
        contract: 2,
        name: "Notes",
        version: version,
        description: None,
        state_version: 1,
        icon: None,
        banners: [],
        servers: [],
        permissions: [],
        controls: None,
    },
    module: [0, 97, 115, 109, 1, 0, 0, 0],
    assets: [],
};

/** A site's files by path. */
struct Site {
    files: Ref<(string, u8[])[]>,
}

fun put(s: Site, path: string, bytes: u8[]) {
    s.files.update(fun(all: (string, u8[])[]) {
        let mut next = all.filter(fun(f: (string, u8[])) = f.0 != path);
        next.push((path, bytes));
        next
    });
}

fun file(s: Site, path: string): u8[] {
    for f of s.files.get() {
        if f.0 == path {
            return f.1;
        }
    }
    panic("no {path}")
}

/** The fake fetch: 200 with a file's bytes, 404 without one. */
fun getter(s: Site): fun(string): Result<(i64, u8[]), string> = fun(path: string) {
    for f of s.files.get() {
        if f.0 == path {
            return Ok((200, f.1));
        }
    }
    Ok((404, []))
};

/**
 * Publishes `version` signed by `k` (the build signed by `build_key`),
 * with `sequence`, and `rotations` in the key file.
 */
fun publish_to(
    s: Site,
    k: SecretKey,
    build_key: SecretKey,
    version: string,
    sequence: i64,
    rotations: Rotation[],
): Index {
    let bytes = write_signed(app(version), build_key).unwrap();
    let ix = Index {
        sequence: sequence,
        ..add(
            Index { host: HOST, sequence: 0, current: "", versions: [] },
            version,
            sha256(bytes),
            bytes.len,
        ).unwrap(),
    };
    put(s, "{SITE}/builds/{hex(sha256(bytes))}.rkb", bytes);
    put(s, "{SITE}/index", sign_index(ix, k).unwrap());
    put(s, "{SITE}/key", key_file(KeyFile { host: HOST, key: k.public_key, rotations: rotations }));
    ix
}

fun fresh(k: SecretKey, version: string): Site {
    let s = Site { files: Ref.new([]) };
    publish_to(s, k, k, version, 1, []);
    s
}

fun why(ring: Keyring, s: Site): string = match verify_site(ring, HOST, getter(s)) {
    Err(e) => reason(e),
    Ok(_) => "ok",
};

@test
fun a_site_opens_verified() {
    let k = key(HOST);
    let ring = keyring();
    let v = verify_site(ring, HOST, getter(fresh(k, "1.0.0"))).unwrap();
    assert_eq(v.opened.bundle.manifest.version, "1.0.0");
    assert_eq(
        (v.trust.host, v.trust.key, v.trust.standing, v.trust.separate),
        (HOST, k.public_key, Standing.Verified, false),
    );
    // Its key is now trusted for a signed file from the same host.
    let signed = read_any(write_signed(app("1.0.0"), k).unwrap()).unwrap().signed.unwrap();
    assert_eq(standing_of(ring, signed).standing, Standing.Trusted);
    let stranger = read_any(
        write_signed(app("1.0.0"), key(HOST)).unwrap(),
    ).unwrap().signed.unwrap();
    assert_eq(standing_of(ring, stranger).standing, Standing.NotConfirmed);
}

@test
fun a_tampered_build_or_index_is_refused() {
    let k = key(HOST);
    let s = fresh(k, "1.0.0");
    let builds = s.files.get().filter(fun(f: (string, u8[])) = f.0.contains("/builds/"));
    let mut b = builds[0].1;
    b[b.len - 1] = b[b.len - 1] ^ 1;
    put(s, builds[0].0, b);
    assert_eq(why(keyring(), s), "The app's build doesn't match its index's hash");
    put(s, builds[0].0, [1, 2, 3]);
    assert_eq(why(keyring(), s), "The app's build isn't the size its index says");
    let t = fresh(k, "1.0.0");
    let mut ix = file(t, "{SITE}/index");
    ix[ix.len - 70] = ix[ix.len - 70] ^ 1;
    put(t, "{SITE}/index", ix);
    assert_eq(why(keyring(), t).starts_with("The app's index"), true);
}

@test
fun trust_is_only_recorded_when_everything_passes() {
    let ring = keyring();
    let s = fresh(key(HOST), "1.0.0");
    put(s, "{SITE}/index", [0]);
    assert_eq(why(ring, s) != "ok", true);
    // The failed key wasn't trusted, so another key is a first use, not a change.
    assert_eq(why(ring, fresh(key(HOST), "1.0.0")), "ok");
}

@test
fun a_swapped_key_without_a_trail_is_an_unapproved_change() {
    let ring = keyring();
    let old = key(HOST);
    verify_site(ring, HOST, getter(fresh(old, "1.0.0"))).unwrap();
    let new = key(HOST);
    let s = fresh(new, "1.0.0");
    match verify_site(ring, HOST, getter(s)) {
        Err(Unapproved(c)) => {
            assert_eq((c.host, c.old, c.new), (HOST, old.public_key, new.public_key));
            assert_eq(
                reason(VerifyError.Unapproved(c)),
                "localhost:8000 is now signed by a different key",
            );
            // "Open as a separate app": the new key opens, marked separate.
            separate(ring, c);
            let v = verify_site(ring, HOST, getter(s)).unwrap();
            assert_eq(v.trust.separate, true);
        }
        _ => panic("expected an unapproved change"),
    }
    // The old publisher's site still opens as before.
    assert_eq(verify_site(ring, HOST, getter(fresh(old, "1.0.0"))).unwrap().trust.separate, false);
}

@test
fun a_rotation_signed_by_the_old_key_is_accepted() {
    let ring = keyring();
    let old = key(HOST);
    let s = fresh(old, "1.0.0");
    verify_site(ring, HOST, getter(s)).unwrap();
    let new = key(HOST);
    publish_to(s, new, new, "1.1.0", 2, [rotate(old, new.public_key).unwrap()]);
    let v = verify_site(ring, HOST, getter(s)).unwrap();
    assert_eq((v.trust.key, v.trust.separate), (new.public_key, false));
    // The old key is no longer the one trusted: going back is a change.
    match verify_site(ring, HOST, getter(fresh(old, "1.0.0"))) {
        Err(Unapproved(_)) => {}
        _ => panic("expected an unapproved change"),
    }
}

@test
fun the_index_never_goes_back() {
    let ring = keyring();
    let k = key(HOST);
    let s = Site { files: Ref.new([]) };
    publish_to(s, k, k, "1.1.0", 5, []);
    verify_site(ring, HOST, getter(s)).unwrap();
    publish_to(s, k, k, "1.0.0", 3, []);
    assert_eq(
        why(ring, s),
        "The site sent an older index than one already seen (sequence 3, after 5)",
    );
    publish_to(s, k, k, "1.0.0", 5, []);
    assert_eq(why(ring, s), "ok");
}

@test
fun a_withdrawn_current_version_is_refused() {
    let k = key(HOST);
    let s = Site { files: Ref.new([]) };
    let ix = publish_to(s, k, k, "1.0.0", 1, []);
    put(
        s,
        "{SITE}/index",
        sign_index(withdraw(ix, "1.0.0", "Security fix in 1.0.1").unwrap(), k).unwrap(),
    );
    assert_eq(
        why(keyring(), s),
        "Version 1.0.0 was withdrawn by its publisher: Security fix in 1.0.1",
    );
}

@test
fun a_build_for_another_host_or_key_is_refused() {
    let k = key(HOST);
    let s = Site { files: Ref.new([]) };
    publish_to(s, k, SecretKey { host: "localhost:9000", ..k }, "1.0.0", 1, []);
    assert_eq(why(keyring(), s), "The app's build is for localhost:9000, not this site");
    publish_to(s, k, key(HOST), "1.0.0", 1, []);
    assert_eq(why(keyring(), s), "The app's build isn't signed by its site's key");
}

@test
fun keys_and_files_that_are_missing_or_foreign() {
    let s = Site { files: Ref.new([]) };
    match verify_site(keyring(), HOST, getter(s)) {
        Err(Unsigned) => {}
        _ => panic("expected an unsigned site"),
    }
    let k = key(HOST);
    let t = fresh(k, "1.0.0");
    put(
        t,
        "{SITE}/key",
        key_file(KeyFile { host: "localhost:9000", key: k.public_key, rotations: [] }),
    );
    assert_eq(why(keyring(), t), "The app's key file is for localhost:9000, not localhost:8000");
    let u = fresh(k, "1.0.0");
    put(u, "{SITE}/key", [0]);
    assert_eq(why(keyring(), u).starts_with("The app's key file can't be read"), true);
    let failing = fun(_: string): Result<(i64, u8[]), string> = Err("Connection refused");
    assert_eq(
        match verify_site(keyring(), HOST, failing) {
            Err(e) => reason(e),
            Ok(_) => "ok",
        },
        "The app's key file couldn't be fetched (Connection refused)",
    );
}

@test
fun a_keyring_goes_out_and_back_in() {
    let ring = keyring();
    let k = key(HOST);
    verify_site(ring, HOST, getter(fresh(k, "1.0.0"))).unwrap();
    let ids = identities(ring);
    assert_eq(ids, [
        Identity {
            host: HOST,
            key: k.public_key,
            sequence: 1,
            separate: false,
            since: ids[0].since,
            origin: k.public_key,
        },
    ]);
    // A keyring made from them trusts the same key: a swapped one asks.
    let again = keyring_of(ids);
    assert_eq(why(again, fresh(k, "1.0.0")), "ok");
    match verify_site(again, HOST, getter(fresh(key(HOST), "1.0.0"))) {
        Err(Unapproved(_)) => {}
        _ => panic("expected an unapproved change"),
    }
}

@test
fun the_change_count_moves_only_when_trust_does() {
    let ring = keyring();
    let k = key(HOST);
    let s = Site { files: Ref.new([]) };
    publish_to(s, k, k, "1.0.0", 1, []);
    assert_eq(changes(ring), 0);
    verify_site(ring, HOST, getter(s)).unwrap();
    assert_eq(changes(ring), 1);
    // The same key and sequence again: nothing new to save.
    verify_site(ring, HOST, getter(s)).unwrap();
    assert_eq(changes(ring), 1);
    publish_to(s, k, k, "1.1.0", 2, []);
    verify_site(ring, HOST, getter(s)).unwrap();
    assert_eq(changes(ring), 2);
    // A failure records nothing.
    put(s, "{SITE}/index", [0]);
    assert_eq(why(ring, s) != "ok", true);
    assert_eq(changes(ring), 2);
    separate(ring, Change { host: HOST, old: k.public_key, new: key(HOST).public_key });
    assert_eq(changes(ring), 3);
}

@test
fun a_rotation_is_recorded_as_a_move() {
    let ring = keyring();
    let old = key(HOST);
    let s = fresh(old, "1.0.0");
    verify_site(ring, HOST, getter(s)).unwrap();
    assert_eq(moves(ring).len, 0);
    let new = key(HOST);
    publish_to(s, new, new, "1.1.0", 2, [rotate(old, new.public_key).unwrap()]);
    verify_site(ring, HOST, getter(s)).unwrap();
    assert_eq(moves(ring), [(HOST, old.public_key, new.public_key)]);
}

@test
fun checking_over_a_snapshot_records_nothing_until_told() {
    let ring = keyring();
    let k = key(HOST);
    let s = fresh(k, "1.0.0");
    let (v, r) = check_site(known_for(ring, HOST), HOST, getter(s)).unwrap();
    assert_eq(v.trust.key, k.public_key);
    // Nothing recorded yet: the keyring is as it was.
    assert_eq((identities(ring).len, changes(ring)), (0, 0));
    record(ring, r);
    assert_eq((identities(ring).len, changes(ring)), (1, 1));
    // A snapshot taken before is stale now: it still says first use.
    assert_eq(known_for(ring, HOST).len, 1);
    assert_eq(known_for(ring, "localhost:9").len, 0);
}

@test
fun a_snapshot_is_checked_like_the_keyring() {
    let ring = keyring();
    let old = key(HOST);
    verify_site(ring, HOST, getter(fresh(old, "1.0.0"))).unwrap();
    // A swapped key over a snapshot: the same unapproved change.
    match check_site(known_for(ring, HOST), HOST, getter(fresh(key(HOST), "1.0.0"))) {
        Err(Unapproved(_)) => {}
        _ => panic("expected an unapproved change"),
    }
    // A rotation over a snapshot, recorded: the move is recorded too.
    let s = fresh(old, "1.0.0");
    let new = key(HOST);
    publish_to(s, new, new, "1.1.0", 2, [rotate(old, new.public_key).unwrap()]);
    let (_, r) = check_site(known_for(ring, HOST), HOST, getter(s)).unwrap();
    record(ring, r);
    assert_eq(moves(ring), [(HOST, old.public_key, new.public_key)]);
}

@test
fun first_use_dates_the_trust_and_later_changes_keep_it() {
    let ring = keyring();
    let before = time.now_ms();
    let old = key(HOST);
    let s = fresh(old, "1.0.0");
    verify_site(ring, HOST, getter(s)).unwrap();
    let since = identities(ring)[0].since;
    assert_eq(since >= before && since <= time.now_ms(), true);
    // A higher sequence, then a rotation: the same date.
    publish_to(s, old, old, "1.1.0", 2, []);
    verify_site(ring, HOST, getter(s)).unwrap();
    let new = key(HOST);
    publish_to(s, new, new, "1.2.0", 3, [rotate(old, new.public_key).unwrap()]);
    verify_site(ring, HOST, getter(s)).unwrap();
    let after = identities(ring);
    assert_eq((after.len, after[0].key, after[0].since), (1, new.public_key, since));
}

@test
fun an_app_s_origin_is_its_first_key_kept_through_rotations() {
    let ring = keyring();
    let old = key(HOST);
    let s = fresh(old, "1.0.0");
    let first = verify_site(ring, HOST, getter(s)).unwrap();
    assert_eq((first.trust.origin, identities(ring)[0].origin), (old.public_key, old.public_key));
    let new = key(HOST);
    publish_to(s, new, new, "1.1.0", 2, [rotate(old, new.public_key).unwrap()]);
    let after = verify_site(ring, HOST, getter(s)).unwrap();
    // The key moved on; who the app is, didn't.
    assert_eq((after.trust.key, after.trust.origin), (new.public_key, old.public_key));
    // A separate publisher is its own app: its own origin.
    let other = key(HOST);
    separate(ring, Change { host: HOST, old: new.public_key, new: other.public_key });
    let them = verify_site(ring, HOST, getter(fresh(other, "1.0.0"))).unwrap();
    assert_eq(them.trust.origin, other.public_key);
}
