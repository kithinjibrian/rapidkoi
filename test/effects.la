// Answering a contract v2 app's effects (PRP-011): its public key and
// sign-in signatures, for signed apps only, as you've chosen in the Account
// page. An echo guest's state becomes the answer it got, so each test reads
// exactly what Rapidkoi sent. Writes only under test/tmp/.
import rapidkoi.shell { Model, with_pages, update };
import rapidkoi.ui.layout { view };
import rapidkoi.guest.effects { answer_all };
import rapidkoi.data.saving { restore };
import rapidkoi.window.tabs { AppPage, Pin, Screen, open_module, state_of, with_saved };
import rapidkoi.window.actions { Msg, Approval, Answer, PanelPage };
import rapidkoi.bundles.permissions { Permission, Setting };
import rapidkoi.people.access { key_of };
import rapidkoi.bundles.bundle { Manifest };
import rapidkoi.guest.home { pins_of, left_off_of };
import kivuli { Cmd };
import rapidkoi.trust.verify { Trust, Standing };
import rapidkoi.people.identity { master, public_key, sign_in_message };
import rapidkoi.people.people {
    People,
    Person,
    person,
    with_person,
    nobody,
    with_setting,
    setting_of,
};
import rapidkoi.guest.contract { answer };
import rapidkoi.data.store { Store, store_at };
import cbor { Value, Entry, encode, decode, Limits };
import std.crypto { ed25519_verify };
import std.fs;
import wasmtime { Engine, Module };
import support { echo_v2, echo_opening, t, kv, fixed, counter_tree, result_of };
import kivuli.testing { texts };

const HOST: string = "notes.acme.com";

fun clean(path: string) {
    if fs.is_dir(path) {
        for name of fs.list_dir(path).unwrap() {
            clean("{path}/{name}");
        }
        fs.remove_dir(path).unwrap();
    } else if fs.exists(path) {
        fs.remove_file(path).unwrap();
    }
}

fun folder(name: string): Store {
    let dir = "test/tmp/effects-{name}";
    clean(dir);
    store_at(dir)
}

/** An init result asking for `effects`. */
fun asking(wanted: Value[]): u8[] = encode(
    Value.Map([
        Entry { key: t("state"), value: Value.Bytes([]) },
        Entry { key: t("effects"), value: Value.Array(wanted) },
    ]),
);

/** A v2 echo page asking at init; signed by `HOST` when `signed`. */
fun page(wanted: Value[], signed: bool): AppPage {
    let engine = Engine.new();
    let p = open_module(
        "notes",
        "rapidkoi://notes.acme.com",
        engine,
        Module.from_text(engine, echo_v2(asking(wanted))).unwrap(),
    );
    if !signed {
        return p;
    }
    AppPage {
        trust: Some(Trust {
            host: HOST,
            key: [3; 32],
            standing: Standing.Verified,
            build: [0; 32],
            separate: false,
            since: 0,
            origin: [3; 32],
        }),
        ..p,
    }
}

/** A window on `s` showing `p`, its effects answered. */
fun answered(s: Store, p: AppPage): Model {
    let engine = Engine.new();
    answer_all(restore(with_pages(engine, [p]), s)).0
}

fun got(m: Model): u8[] = state_of(m.tabs[0].page).unwrap_or([]);

@test
fun a_signed_app_gets_its_own_public_key() {
    let s = folder("key");
    let m = answered(s, page([kv([("kind", t("identity")), ("msg", t("me"))])], true));
    let pk = public_key(master(s).unwrap(), HOST, [3; 32], 0).unwrap();
    assert_eq(got(m), answer(t("me"), Value.Bytes(pk)));
    assert_eq(m.tabs[0].page.asks.len, 0);
    clean(s.dir);
}

@test
fun a_sign_in_signature_checks_with_that_key_over_the_host() {
    let s = folder("sign");
    let m = answered(
        s,
        page(
            [
                kv([
                    ("kind", t("sign")),
                    ("msg", t("signed")),
                    ("challenge", Value.Bytes([5, 6, 7])),
                ]),
            ],
            true,
        ),
    );
    let pk = public_key(master(s).unwrap(), HOST, [3; 32], 0).unwrap();
    let reply = decode(got(m), Limits.default()).unwrap();
    let sig = reply.get("value").unwrap().as_bytes().unwrap();
    assert_eq(ed25519_verify(pk, sign_in_message(HOST, [5, 6, 7]), sig), true);
    clean(s.dir);
}

@test
fun an_unsigned_app_gets_nothing() {
    let s = folder("unsigned");
    let m = answered(s, page([kv([("kind", t("identity")), ("msg", t("me"))])], false));
    assert_eq(got(m), answer(t("me"), Value.Null));
    // Nothing was made for it: no master secret.
    assert_eq(fs.exists("{s.dir}/identity"), false);
    clean(s.dir);
}

@test
fun signed_out_gets_nothing_and_starting_over_gives_a_new_key() {
    let s = folder("choices");
    let engine = Engine.new();
    let base = restore(
        with_pages(engine, [page([kv([("kind", t("identity")), ("msg", t("me"))])], true)]),
        s,
    );
    let out = Model {
        people: with_person(base.people, Person {
            signed_out: true,
            ..person(base.people, HOST, [3; 32]),
        }),
        ..base,
    };
    assert_eq(got(answer_all(out).0), answer(t("me"), Value.Null));
    let again = restore(
        with_pages(engine, [page([kv([("kind", t("identity")), ("msg", t("me"))])], true)]),
        s,
    );
    let over = Model {
        people: with_person(again.people, Person {
            generation: 1,
            ..person(again.people, HOST, [3; 32]),
        }),
        ..again,
    };
    let first = public_key(master(s).unwrap(), HOST, [3; 32], 0).unwrap();
    assert_eq(got(answer_all(over).0) != answer(t("me"), Value.Bytes(first)), true);
    clean(s.dir);
}

/** A page whose screen says hello by name. */
fun greeting(): AppPage {
    let engine = Engine.new();
    let tree = counter_tree("Hello, {{FIRST_NAME}} {{LAST_NAME}}!");
    open_module(
        "hi",
        "hi.wasm",
        engine,
        Module.from_text(engine, fixed(2, [], tree, result_of([]))).unwrap(),
    )
}

@test
fun an_app_shows_your_name_without_knowing_it() {
    let engine = Engine.new();
    let m = with_pages(engine, [greeting()]);
    let named = Model {
        people: People { first: "Brian", last: "Kithinji", apps: [], grants: [] },
        ..m,
    };
    assert_eq(texts(view(named)).any(fun(x: string) = x == "Hello, Brian Kithinji!"), true);
    // No name set: nothing in its place.
    assert_eq(texts(view(m)).any(fun(x: string) = x == "Hello,  !"), true);
}

@test
fun a_resumed_app_asks_again_when_opened() {
    let s = folder("resumed");
    let ask = encode(
        Value.Map([
            Entry { key: t("state"), value: Value.Bytes([]) },
            Entry {
                key: t("effects"),
                value: Value.Array([kv([("kind", t("identity")), ("msg", t("me"))])]),
            },
        ]),
    );
    let engine = Engine.new();
    let p = AppPage {
        trust: Some(Trust {
            host: HOST,
            key: [3; 32],
            standing: Standing.Verified,
            build: [0; 32],
            separate: false,
            since: 0,
            origin: [3; 32],
        }),
        ..open_module(
            "notes",
            "rapidkoi://notes.acme.com",
            engine,
            Module.from_text(engine, echo_opening(ask)).unwrap(),
        ),
    };
    // Resumed from a saved state (no init): opened still runs, so it asks.
    let (resumed, _) = with_saved(p, [], 1);
    assert_eq(resumed.asks.len, 1);
    let m = answer_all(restore(with_pages(engine, [resumed]), s)).0;
    let pk = public_key(master(s).unwrap(), HOST, [3; 32], 0).unwrap();
    assert_eq(got(m), answer(t("me"), Value.Bytes(pk)));
    clean(s.dir);
}

/** A v2 echo page asking `kind` at init, its manifest declaring `permissions` (PRP-030). */
fun holding(kind: string, extra: (string, Value)[], declared: string[]): AppPage {
    let mut fields = [("kind", t(kind)), ("msg", t("got"))];
    for e of extra {
        fields.push(e);
    }
    AppPage {
        manifest: Some(Manifest {
            contract: 2,
            name: "notes",
            version: "1.0.0",
            description: None,
            state_version: 1,
            icon: None,
            banners: [],
            servers: [],
            permissions: declared,
            controls: None,
        }),
        ..page([kv(fields)], false),
    }
}

/** A window with your pins showing `p`, its effects answered: the model and the commands. */
fun asked(p: AppPage): (Model, Cmd<Msg>) = answer_all(Model {
    pinned: [Pin { name: "Quote", path: "rapidkoi://quote.dafifi.net", icon: None }],
    ..with_pages(Engine.new(), [p]),
});

fun stopped_why(m: Model): string = match m.tabs[0].page.screen {
    Stopped(why, _) => why,
    _ => "running",
};

/** Every message a command sends after a delay. */
fun later(c: Cmd<Msg>): Msg[] = match c {
    After(_, msg) => [msg],
    Batch(cs) => {
        let mut all: Msg[] = [];
        for inner of cs {
            for msg of later(inner) {
                all.push(msg);
            }
        }
        all
    }
    _ => [],
};

@test
fun a_holder_reads_your_pins_and_where_you_left_off() {
    let (m, _) = asked(holding("pins", [], ["read_pins"]));
    assert_eq(state_of(m.tabs[0].page), Some(answer(t("got"), pins_of(m))));
    let (left, _) = asked(holding("left_off", [], ["read_left_off"]));
    assert_eq(state_of(left.tabs[0].page), Some(answer(t("got"), left_off_of(left))));
}

@test
fun asking_without_declaring_stops_the_app() {
    // The owner, session 166: reaching for what it didn't declare is a failure on screen.
    let (m, c) = asked(holding("pins", [], ["read_left_off"]));
    assert_eq(stopped_why(m), "This app asked for reading your pins without declaring it");
    let (left, _) = asked(holding("left_off", [], []));
    assert_eq(
        stopped_why(left),
        "This app asked for reading where you left off without declaring it",
    );
    let (open, sent) = asked(holding("open_pin", [("index", Value.int(0))], ["read_pins"]));
    assert_eq(stopped_why(open), "This app asked for opening your apps without declaring it");
    assert_eq(later(sent), []);
    let (cont, _) = asked(holding("continue", [], []));
    assert_eq(stopped_why(cont), "This app asked for opening your apps without declaring it");
    assert_eq(later(c), []);
}

@test
fun open_pin_and_continue_open_through_the_window() {
    let (_, c) = asked(holding("open_pin", [("index", Value.int(0))], ["open_apps"]));
    assert_eq(later(c), [Msg.OpenPinned("rapidkoi://quote.dafifi.net")]);
    let (_, past) = asked(holding("open_pin", [("index", Value.int(1))], ["open_apps"]));
    assert_eq(later(past), []);
    // Nothing left off: Continue opens nothing.
    let (_, none) = asked(holding("continue", [], ["open_apps"]));
    assert_eq(later(none), []);
}

/** `asked`, with the person's setting for `p`'s permission. */
fun set(p: AppPage, permission: Permission, s: Setting): (Model, Cmd<Msg>) = answer_all(Model {
    pinned: [Pin { name: "Quote", path: "rapidkoi://quote.dafifi.net", icon: None }],
    people: with_setting(nobody(), key_of(p), permission, s),
    ..with_pages(Engine.new(), [p]),
});

@test
fun blocked_answers_with_nothing_and_the_app_runs_on() {
    // PRP-031: the person decides; blocking isn't the app's failure.
    let (m, _) = set(holding("pins", [], ["read_pins"]), Permission.ReadPins, Setting.Blocked);
    assert_eq(state_of(m.tabs[0].page), Some(answer(t("got"), Value.Array([]))));
    let (left, _) = set(
        holding("left_off", [], ["read_left_off"]),
        Permission.ReadLeftOff,
        Setting.Blocked,
    );
    assert_eq(state_of(left.tabs[0].page), Some(answer(t("got"), Value.Null)));
    let (_, c) = set(
        holding("open_pin", [("index", Value.int(0))], ["open_apps"]),
        Permission.OpenApps,
        Setting.Blocked,
    );
    assert_eq(later(c), []);
}

@test
fun needs_approval_waits_for_the_person() {
    let p = holding("pins", [], ["read_pins"]);
    let (m, _) = set(p, Permission.ReadPins, Setting.Ask);
    assert_eq(
        m.approval,
        Some(Approval { tab: Some(0), permission: Permission.ReadPins, app: "notes" }),
    );
    assert_eq(m.tabs[0].page.asks.len, 1);
    // Allow once: answered; the setting stays.
    let (once, _) = update(m, Msg.Approve(Answer.Once));
    assert_eq(state_of(once.tabs[0].page), Some(answer(t("got"), pins_of(once))));
    assert_eq(
        (once.approval, setting_of(once.people, key_of(p), Permission.ReadPins)),
        (None, Setting.Ask),
    );
    // Always allow: answered, and allowed from now on.
    let (always, _) = update(m, Msg.Approve(Answer.Always));
    assert_eq(state_of(always.tabs[0].page), Some(answer(t("got"), pins_of(always))));
    assert_eq(setting_of(always.people, key_of(p), Permission.ReadPins), Setting.Allowed);
    // Don't allow: answered as blocked.
    let (deny, _) = update(m, Msg.Approve(Answer.Deny));
    assert_eq(state_of(deny.tabs[0].page), Some(answer(t("got"), Value.Array([]))));
    assert_eq(deny.approval, None);
}

@test
fun leaving_the_page_is_dont_allow() {
    let p = holding("pins", [], ["read_pins"]);
    let (m, _) = set(p, Permission.ReadPins, Setting.Ask);
    let (left, _) = update(m, Msg.NewTab);
    assert_eq(left.approval, None);
    assert_eq(state_of(left.tabs[0].page), Some(answer(t("got"), Value.Array([]))));
}

@test
fun an_approval_waits_while_a_card_is_open() {
    // Session 171: not over the settings you're changing; asked once it closes.
    let p = holding("pins", [], ["read_pins"]);
    let m = Model {
        pinned: [Pin { name: "Quote", path: "rapidkoi://quote.dafifi.net", icon: None }],
        people: with_setting(nobody(), key_of(p), Permission.ReadPins, Setting.Ask),
        panel: Some(PanelPage.Permissions),
        ..with_pages(Engine.new(), [p]),
    };
    let (open, _) = answer_all(m);
    assert_eq((open.approval, open.tabs[0].page.asks.len), (None, 1));
    let (closed, _) = update(open, Msg.ClosePanel);
    assert_eq(closed.approval.is_some(), true);
}
