// All apps' asks (PRP-067), pure: `apps`, and opening, pinning, unpinning,
// an app's permissions and Forget by index, read and held to their shapes;
// a bad one is the sentence that stops the app. No guest, no display.
import rapidkoi.guest.contract { read_update };
import rapidkoi.guest.nodes { Effect };
import cbor { Value, encode };
import support { t, kv };

/** What one effect reads as: its effect, or the sentence that stops the app. */
fun read_one(effect: (string, Value)[]): Result<Effect, string> {
    let mut fields = [("msg", t("m"))];
    for f of effect {
        fields.push(f);
    }
    let bytes = encode(kv([("state", kv([])), ("effects", Value.Array([kv(fields)]))]));
    match read_update(bytes) {
        Ok(u) => Ok(u.effects[0]),
        Err(Invalid(_, what)) => Err(what),
        Err(e) => Err("{e}"),
    }
}

fun at(kind: string, index: Value): Result<Effect, string> = read_one([
    ("kind", t(kind)),
    ("index", index),
]);

@test
fun each_ask_reads_with_its_index() {
    assert_eq(read_one([("kind", t("apps"))]), Ok(Effect.Apps(t("m"))));
    assert_eq(at("open_app", Value.int(2)), Ok(Effect.OpenApp(t("m"), 2)));
    assert_eq(at("pin_app", Value.int(0)), Ok(Effect.PinApp(t("m"), 0)));
    assert_eq(at("unpin_app", Value.int(1)), Ok(Effect.UnpinApp(t("m"), 1)));
    assert_eq(at("app_info", Value.int(3)), Ok(Effect.AppInfo(t("m"), 3)));
    assert_eq(at("forget_app", Value.int(4)), Ok(Effect.ForgetApp(t("m"), 4)));
}

@test
fun a_missing_or_negative_index_stops_the_app() {
    for kind of ["open_app", "pin_app", "unpin_app", "app_info", "forget_app"] {
        assert_eq(at(kind, Value.int(-1)), Err("an {kind} needs an index of 0 or more"));
        assert_eq(at(kind, t("first")), Err("an {kind} needs an index of 0 or more"));
        assert_eq(read_one([("kind", t(kind))]), Err("an {kind} needs an index of 0 or more"));
    }
}
