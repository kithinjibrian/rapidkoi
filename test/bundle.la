// Bundle format 1, pure: reading and writing `.rkb` bytes, and every rule
// a bundle must keep. No files, no guest, no display.
import rapidkoi.bundles.bundle { Bundle, Manifest, Controls, read, write, asset };
import rapidkoi.bundles.rules { BundleError, reason };
import cbor { Value, encode };
import support { t, kv, png as png_of };

/** A small PNG header: 64 × 64. */
fun png(): u8[] = png_of(64, 64);

fun manifest(): Manifest = Manifest {
    contract: 8,
    name: "Counter",
    version: "0.1.0",
    description: Some("Counts, and says hello"),
    state_version: 1,
    icon: Some("icon.png"),
    banners: [("home", "banner/home.png")],
    servers: ["api.acme.com", "localhost:9000"],
    permissions: [],
    controls: None,
};

fun good(): Bundle = Bundle {
    manifest: manifest(),
    module: [0, 97, 115, 109, 1, 0, 0, 0],
    assets: [("icon.png", png()), ("banner/home.png", png())],
};

/** A bundle's CBOR with the manifest given as raw pairs, to break rules write won't. */
fun raw(fields: (string, Value)[], assets: (string, Value)[]): u8[] = encode(
    kv([
        ("format", Value.int(1)),
        ("manifest", kv(fields)),
        ("module", Value.Bytes([0, 97, 115, 109])),
        ("assets", kv(assets)),
    ]),
);

fun base(): (string, Value)[] = [
    ("contract", Value.int(1)),
    ("name", t("Counter")),
    ("version", t("0.1.0")),
    ("state_version", Value.int(1)),
];

/** `base()` with one field replaced or added. */
fun with(name: string, v: Value): (string, Value)[] {
    let mut out = base().filter(fun(p: (string, Value)) = p.0 != name);
    out.push((name, v));
    out
}

fun without(name: string): (string, Value)[] = base().filter(fun(p: (string, Value)) = p.0 != name);

fun error_of(bytes: u8[]): string = match read(bytes) {
    Err(e) => reason(e),
    Ok(_) => "ok",
};

@test
fun a_bundle_round_trips() {
    let b = good();
    let back = read(write(b).unwrap()).unwrap();
    assert_eq(back.manifest == b.manifest, true);
    assert_eq(back.module, b.module);
    assert_eq(asset(back, "icon.png"), Some(png()));
    assert_eq(asset(back, "nope.png"), None);
}

@test
fun a_minimal_bundle_reads() {
    let b = read(raw(base(), [])).unwrap();
    assert_eq(b.manifest.description, None);
    assert_eq(b.manifest.icon, None);
    assert_eq(b.manifest.banners.len, 0);
    // Bundles from before PRP-012 reach nothing beyond their own host.
    assert_eq(b.manifest.servers.len, 0);
}

@test
fun servers_are_checked() {
    let list = fun(names: string[]) = Value.Array(names.map(fun(n: string) = t(n)));
    assert_eq(error_of(raw(with("servers", list(["api.acme.com"])), [])), "ok");
    assert_eq(
        error_of(raw(with("servers", list(["174.138.43.152"])), [])),
        "This bundle's \"servers\" lists \"174.138.43.152\", which isn't a server name",
    );
    assert_eq(
        error_of(raw(with("servers", t("api.acme.com")), [])),
        "This bundle's \"servers\" must be a list of names",
    );
    assert_eq(
        error_of(raw(with("servers", Value.Array([Value.int(1)])), [])),
        "This bundle's \"servers\" must be a list of names",
    );
    let mut many: string[] = [];
    for i of range(0, 33) {
        many.push("s{i}.acme.com");
    }
    assert_eq(
        error_of(raw(with("servers", list(many)), [])),
        "This bundle's \"servers\" lists too many (33; at most 32)",
    );
    let bad = Bundle { manifest: Manifest { servers: ["intranet"], ..manifest() }, ..good() };
    assert_eq(write(bad).is_err(), true);
}

@test
fun unknown_keys_are_ignored() {
    assert_eq(error_of(raw(with("future", t("thing")), [])), "ok");
}

@test
fun the_format_is_checked() {
    let two = encode(
        kv([
            ("format", Value.int(2)),
            ("manifest", kv(base())),
            ("module", Value.Bytes([])),
            ("assets", kv([])),
        ]),
    );
    assert_eq(error_of(two), "This bundle needs a newer version of Rapidkoi (format 2)");
    assert_eq(
        error_of(encode(kv([("manifest", kv(base()))]))),
        "This bundle is missing \"format\"",
    );
    assert_eq(
        error_of(encode(kv([("format", Value.int(1)), ("manifest", kv(base()))]))),
        "This bundle is missing \"module\"",
    );
    assert_eq(
        error_of(encode(kv([("format", Value.int(1)), ("module", Value.Bytes([]))]))),
        "This bundle is missing \"manifest\"",
    );
}

@test
fun manifest_fields_are_checked() {
    assert_eq(error_of(raw(without("name"), [])), "This bundle is missing \"name\"");
    assert_eq(
        error_of(raw(with("contract", t("1")), [])),
        "This bundle's \"contract\" must be a whole number",
    );
    assert_eq(
        error_of(raw(with("name", t("")), [])),
        "This bundle's \"name\" must be 1 to 64 bytes",
    );
    assert_eq(
        error_of(
            raw(
                with(
                    "name",
                    t("0123456789012345678901234567890123456789012345678901234567890123x"),
                ),
                [],
            ),
        ),
        "This bundle's \"name\" must be 1 to 64 bytes",
    );
    assert_eq(
        error_of(raw(with("name", t("tab\there")), [])),
        "This bundle's \"name\" can't hold control characters",
    );
    assert_eq(
        error_of(raw(with("state_version", Value.int(0)), [])),
        "This bundle's \"state_version\" must be at least 1",
    );
    assert_eq(
        error_of(raw(with("description", Value.int(5)), [])),
        "This bundle's \"description\" must be text",
    );
}

@test
fun versions_are_plain_semver() {
    for v of ["1.0", "1.0.0-beta", "a.b.c", "01.0.0", "1..0", ""] {
        assert_eq(
            error_of(raw(with("version", t(v)), [])),
            "This bundle's \"version\" must be MAJOR.MINOR.PATCH, like 1.4.0",
        );
    }
    assert_eq(error_of(raw(with("version", t("10.0.12")), [])), "ok");
}

@test
fun asset_names_are_checked() {
    for name of ["../x.png", "/x.png", "x.png/", "a//b.png", "X.png", "a b.png", ""] {
        assert_eq(
            error_of(raw(base(), [(name, Value.Bytes(png()))])),
            "This bundle has an asset with a bad name: \"{name}\"",
        );
    }
    let long: u8[] = [97; 129];
    let long_name = string_from_utf8(long).unwrap();
    assert_eq(
        error_of(raw(base(), [(long_name, Value.Bytes(png()))])),
        "This bundle has an asset with a bad name: \"{long_name}\"",
    );
    assert_eq(error_of(raw(base(), [("img/ok-1_2.png", Value.Bytes(png()))])), "ok");
}

@test
fun assets_must_be_pictures_and_referenced_ones_must_exist() {
    assert_eq(
        error_of(raw(base(), [("a.png", Value.Bytes([1, 2, 3]))])),
        "This bundle's asset \"a.png\" isn't a PNG, JPEG or SVG picture",
    );
    assert_eq(
        error_of(raw(with("icon", t("icon.png")), [])),
        "This bundle's \"icon\" names an asset it doesn't have: \"icon.png\"",
    );
    assert_eq(
        error_of(raw(with("banners", kv([("home", t("b.png"))])), [])),
        "This bundle's \"banners\" names an asset it doesn't have: \"b.png\"",
    );
    assert_eq(
        error_of(raw(base(), [("a.png", t("not bytes"))])),
        "This bundle's asset \"a.png\" must be bytes",
    );
}

@test
fun permissions_are_names() {
    // PRP-030: whether a name is known, and who may hold it, is the loader's.
    let list = fun(names: string[]) = Value.Array(names.map(fun(n: string) = t(n)));
    assert_eq(error_of(raw(with("permissions", list(["read_pins", "camera"])), [])), "ok");
    assert_eq(error_of(raw(with("permissions", Value.Array([])), [])), "ok");
    assert_eq(
        error_of(raw(with("permissions", t("read_pins")), [])),
        "This bundle's \"permissions\" must be a list of names",
    );
    assert_eq(
        error_of(raw(with("permissions", list(["Read-Pins"])), [])),
        "This bundle's \"permissions\" lists \"Read-Pins\", which isn't a permission name",
    );
    assert_eq(
        error_of(raw(with("permissions", list(["read_pins", "read_pins"])), [])),
        "This bundle's \"permissions\" lists \"read_pins\" twice",
    );
    let mut many: string[] = [];
    for i of range(0, 17) {
        many.push("p{i}");
    }
    assert_eq(
        error_of(raw(with("permissions", list(many)), [])),
        "This bundle's \"permissions\" lists too many (17; at most 16)",
    );
    let declared = Bundle {
        manifest: Manifest { permissions: ["read_pins"], ..manifest() },
        ..good(),
    };
    assert_eq(read(write(declared).unwrap()).unwrap().manifest.permissions, ["read_pins"]);
    let bad = Bundle { manifest: Manifest { permissions: [""], ..manifest() }, ..good() };
    assert_eq(write(bad).is_err(), true);
}

@test
fun prerendered_must_be_empty() {
    assert_eq(
        error_of(raw(with("prerendered", Value.Array([t("x")])), [])),
        "This bundle asks for \"prerendered\", which this version of Rapidkoi can't grant yet",
    );
}

@test
fun sizes_and_counts_are_limited() {
    let mut many: (string, Value)[] = [];
    for i in 0..257 {
        many.push(("a{i}.png", Value.Bytes(png())));
    }
    assert_eq(error_of(raw(base(), many)), "This bundle has too many assets (257; at most 256)");
    let mut big: u8[] = [0; 4 * 1024 * 1024 + 1];
    let header = png();
    for i in 0..header.len {
        big[i] = header[i];
    }
    assert_eq(
        error_of(raw(base(), [("big.png", Value.Bytes(big))])),
        "This bundle's asset \"big.png\" is too large (4194305 bytes)",
    );
    let whole: u8[] = [0; 32 * 1024 * 1024 + 1];
    assert_eq(error_of(whole), "This bundle is too large (33554433 bytes)");
}

@test
fun hostile_bytes_are_errors() {
    assert_eq(error_of([]).starts_with("This file isn't a Rapidkoi bundle"), true);
    assert_eq(
        error_of([0x9b, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff]).starts_with(
            "This file isn't a Rapidkoi bundle",
        ),
        true,
    );
    assert_eq(
        error_of(encode(Value.Array([]))),
        "This file isn't a Rapidkoi bundle (it isn't a map)",
    );
}

@test
fun write_refuses_what_read_refuses() {
    let bad_name = Bundle { assets: [("../x.png", png())], ..good() };
    assert_eq(
        write(bad_name).map_err(reason),
        Err("This bundle has an asset with a bad name: \"../x.png\""),
    );
    let not_png = Bundle { assets: [("icon.png", [1, 2])], ..good() };
    assert_eq(
        write(not_png).map_err(reason),
        Err("This bundle's asset \"icon.png\" isn't a PNG, JPEG or SVG picture"),
    );
    let bad_version = Bundle { manifest: Manifest { version: "1", ..manifest() }, ..good() };
    assert_eq(write(bad_version).is_err(), true);
}

@test
fun image_sizes_are_limited_by_role() {
    let icon_ok = raw(with("icon", t("i.png")), [("i.png", Value.Bytes(png_of(1024, 1024)))]);
    assert_eq(error_of(icon_ok), "ok");
    let icon_big = raw(with("icon", t("i.png")), [("i.png", Value.Bytes(png_of(1025, 64)))]);
    assert_eq(
        error_of(icon_big),
        "This bundle's \"icon\" image is too large (1025 × 64 px; at most 1024 × 1024)",
    );
    let banner_ok = raw(with("banners", kv([("home", t("b.png"))])), [
        ("b.png", Value.Bytes(png_of(2048, 1024))),
    ]);
    assert_eq(error_of(banner_ok), "ok");
    let banner_big = raw(with("banners", kv([("home", t("b.png"))])), [
        ("b.png", Value.Bytes(png_of(2048, 1025))),
    ]);
    assert_eq(
        error_of(banner_big),
        "This bundle's \"banners\" image is too large (2048 × 1025 px; at most 2048 × 1024)",
    );
    assert_eq(
        error_of(raw(base(), [("x.png", Value.Bytes(png_of(4097, 10)))])),
        "This bundle's asset \"x.png\" image is too large (4097 × 10 px; at most 4096 × 4096)",
    );
    assert_eq(
        error_of(raw(base(), [("z.png", Value.Bytes(png_of(0, 10)))])),
        "This bundle's asset \"z.png\" isn't a PNG, JPEG or SVG picture",
    );
}

@test
fun a_png_needs_its_header_chunk() {
    let mut no_ihdr = png_of(10, 10);
    // "IHDR" → "IDAT": the first chunk must be the header.
    no_ihdr[13] = 68;
    no_ihdr[14] = 65;
    no_ihdr[15] = 84;
    assert_eq(
        error_of(raw(base(), [("a.png", Value.Bytes(no_ihdr))])),
        "This bundle's asset \"a.png\" isn't a PNG, JPEG or SVG picture",
    );
    let short: u8[] = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0];
    assert_eq(
        error_of(raw(base(), [("a.png", Value.Bytes(short))])),
        "This bundle's asset \"a.png\" isn't a PNG, JPEG or SVG picture",
    );
}

@test
fun controls_name_known_icons_and_rows() {
    // PRP-031: a built-in app's frame; who may use it is the loader's call.
    let list = fun(names: string[]) = Value.Array(names.map(fun(n: string) = t(n)));
    let controls = fun(address: string[], settings: string[]) = kv([
        ("address", list(address)),
        ("settings", list(settings)),
    ]);
    assert_eq(
        error_of(
            raw(
                with("controls", controls(["settings", "share"], ["app_settings.permissions"])),
                [],
            ),
        ),
        "ok",
    );
    assert_eq(error_of(raw(with("controls", controls([], ["app_settings", "forget"])), [])), "ok");
    assert_eq(
        error_of(raw(with("controls", controls(["shield"], [])), [])),
        "This bundle's \"controls\" names \"shield\", which isn't an address icon",
    );
    assert_eq(
        error_of(raw(with("controls", controls([], ["app_settings.colours"])), [])),
        "This bundle's \"controls\" names \"app_settings.colours\", which isn't a settings row",
    );
    assert_eq(
        error_of(raw(with("controls", controls(["share", "share"], [])), [])),
        "This bundle's \"controls\" names \"share\" twice",
    );
    assert_eq(
        error_of(raw(with("controls", t("settings")), [])),
        "This bundle's \"controls\" must map address and settings to lists of names",
    );
    let declared = Bundle {
        manifest: Manifest {
            controls: Some(Controls {
                address: ["settings"],
                settings: ["app_settings.permissions"],
            }),
            ..manifest(),
        },
        ..good(),
    };
    assert_eq(
        read(write(declared).unwrap()).unwrap().manifest.controls,
        declared.manifest.controls,
    );
    assert_eq(read(write(good()).unwrap()).unwrap().manifest.controls, None);
}

@test
fun a_bundle_holds_pngs_jpegs_and_svgs() {
    // PRP-047: pictures for an app's screen, checked by their headers.
    let svg = "<svg viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M0 0h24v24z\"/></svg>".to_bytes();
    let jpeg: u8[] = [
        0xff,
        0xd8,
        0xff,
        0xc0,
        0,
        17,
        8,
        0,
        10,
        0,
        20,
        3,
        1,
        0x22,
        0,
        2,
        0x11,
        1,
        3,
        0x11,
        1,
    ];
    let assets = [
        ("a.png", Value.Bytes(png_of(8, 8))),
        ("b.jpg", Value.Bytes(jpeg)),
        ("c.svg", Value.Bytes(svg)),
    ];
    assert_eq(error_of(raw(base(), assets)), "ok");
}

@test
fun gif_webp_and_big_svgs_are_refused() {
    let gif = "GIF89a".to_bytes() + [8, 0, 8, 0, 0, 0, 0];
    assert_eq(
        error_of(raw(base(), [("a.gif", Value.Bytes(gif))])),
        "This bundle's asset \"a.gif\" isn't a PNG, JPEG or SVG picture",
    );
    let webp = "RIFF".to_bytes() + [22, 0, 0, 0] + "WEBPVP8X".to_bytes() + [
        10,
        0,
        0,
        0,
        0,
        0,
        0,
        0,
        7,
        0,
        0,
        7,
        0,
        0,
    ];
    assert_eq(
        error_of(raw(base(), [("a.webp", Value.Bytes(webp))])),
        "This bundle's asset \"a.webp\" isn't a PNG, JPEG or SVG picture",
    );
    let mut big = "<svg width=\"2\" height=\"2\">".to_bytes();
    while big.len <= 1024 * 1024 {
        big.push(0x20);
    }
    assert_eq(
        error_of(raw(base(), [("big.svg", Value.Bytes(big))])),
        "This bundle's asset \"big.svg\" is too large (1048577 bytes)",
    );
    let bad_text: u8[] = [0x3c, 0x73, 0x76, 0x67, 0x3e, 0xff];
    assert_eq(
        error_of(raw(base(), [("x.svg", Value.Bytes(bad_text))])),
        "This bundle's asset \"x.svg\" isn't a PNG, JPEG or SVG picture",
    );
}
