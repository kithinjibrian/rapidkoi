// End to end: the Rust counter (guest/rust/counter) driven through the
// window, with no display. Skipped unless the guest has been built (see
// CLAUDE.md COMMANDS), so the suite never needs Rust.
import rapidkoi.shell { Model, start, update, title_of };
import rapidkoi.ui.layout { view };
import rapidkoi.window.window { card, page_of };
import rapidkoi.ui.content { app_view };
import rapidkoi.window.actions { Msg };
import kivuli.testing { click, is_disabled, type_into, texts };
import std.fs;
import rapidkoi.commands.pack { make };

const COUNTER: string = "guest/rust/target/wasm32-unknown-unknown/release/counter.wasm";

fun started(): Model {
    if !fs.is_file(COUNTER) {
        skip("build guest/rust first: cargo build --release --target wasm32-unknown-unknown");
    }
    let (m, _) = start(["./main", COUNTER], None);
    m
}

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

/** The app's texts: its page alone, not the frame (whose cards are built while closed). */
fun shown(m: Model): string[] = match page_of(m) {
    App(a) => texts(app_view(m.current.unwrap_or(-1), a, m)),
    Home => [],
};

@test
fun the_counter_starts_at_zero_with_reset_disabled() {
    let m = started();
    // The greeting's {FIRST_NAME} is filled (empty here: no name set), and
    // with no data folder it can't be signed in. Its buttons are contract 5
    // boxes, so their labels are texts too (PRP-037).
    assert_eq(shown(m), ["Counter", "Count: 0", "Add", "Reset", "Hello, !", "Not signed in"]);
    assert_eq(is_disabled(view(m), "Reset"), Ok(true));
    assert_eq(title_of(m), "Rapidkoi — Counter");
}

@test
fun add_counts_and_reset_clears() {
    let mut m = started();
    m = step(m, click(view(m), "Add").unwrap());
    m = step(m, click(view(m), "Add").unwrap());
    assert_eq(shown(m)[1], "Count: 2");
    assert_eq(is_disabled(view(m), "Reset"), Ok(false));
    m = step(m, click(view(m), "Reset").unwrap());
    assert_eq(shown(m)[1], "Count: 0");
}

@test
fun typing_a_name_greets_it() {
    let m = started();
    let named = step(m, type_into(view(m), "Your name", "Amina").unwrap());
    assert_eq(shown(named)[4], "Hello, Amina!");
}

@test
fun home_and_continue_keep_the_count() {
    let mut m = started();
    m = step(m, click(view(m), "Add").unwrap());
    m = step(m, click(view(m), "Add").unwrap());
    m = step(m, Msg.Home);
    m = step(m, card(m).unwrap().msg);
    assert_eq(shown(m)[1], "Count: 2");
    // Closed, then reopened, it still has its count.
    m = step(m, Msg.CloseTab(0));
    m = step(m, card(m).unwrap().msg);
    assert_eq(shown(m)[1], "Count: 2");
}

@test
fun a_pinned_counter_opens_from_home() {
    let mut m = step(started(), Msg.TogglePin);
    m = step(m, Msg.NewTab);
    m = step(m, Msg.OpenPinned(m.pinned[0].path));
    assert_eq(shown(m)[1], "Count: 0");
}

@test
fun the_counter_packed_as_a_bundle_runs_the_same() {
    if !fs.is_file(COUNTER) {
        skip("build guest/rust first: cargo build --release --target wasm32-unknown-unknown");
    }
    let out = "test/tmp/counter.rkb";
    let packed = make([
        COUNTER,
        "--name",
        "Counter",
        "--version",
        "0.1.0",
        "--description",
        "Counts, and says hello",
        "--icon",
        "guest/rust/counter/icon.png",
        "-o",
        out,
        "--force",
    ]);
    assert_eq(packed.is_ok(), true);
    let (opened, _) = start(["./main", out], None);
    // The bundle's icon and manifest came with it.
    let page = opened.tabs[0].page;
    assert_eq(page.icon.is_some(), true);
    assert_eq(
        page.manifest.map(fun(x) = (x.version, x.description)),
        Some(("0.1.0", Some("Counts, and says hello"))),
    );
    let mut m = opened;
    m = step(m, click(view(m), "Add").unwrap());
    assert_eq(shown(m)[1], "Count: 1");
    // ⟳ keeps the count.
    m = step(m, Msg.Reload);
    assert_eq(shown(m)[1], "Count: 1");
    fs.remove_file(out).unwrap();
}
