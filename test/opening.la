// Opening signed apps end to end, over real local sockets: publish a site
// to test/tmp, serve it on a green thread, open it in a window. Each test
// has its own port. Writes only under test/tmp/.
import rapidkoi.commands.publish { make_key, publish_site, pack_project };
import rapidkoi.commands.serve { handle };
import rapidkoi.shell { update };
import rapidkoi.ui.layout { view };
import rapidkoi.window.navigate { open_file, reload, from_outside };
import rapidkoi.window.actions { Msg };
import rapidkoi.window.window { page_of, Model, with_pages };
import rapidkoi.ui.frame { marker_note, file_of };
import kivuli.testing { texts, click, Lookup };
import std.http { Request };
import std.env;
import std.fs;
import std.task { sleep };
import wasmtime { Engine };
import support { png, settle, write_counting };

fun clean(path: string) {
    if fs.is_dir(path) {
        for name of fs.list_dir(path).unwrap() {
            clean("{path}/{name}");
        }
        fs.remove_dir(path).unwrap();
    } else if fs.exists(path) {
        fs.remove_file(path).unwrap();
    }
}

/** A project for `localhost:PORT` in test/tmp/open-PORT, its key beside it; published once. */
fun published(port: i64): string {
    let dir = "{env.current_dir().unwrap()}/test/tmp/open-{port}";
    clean(dir);
    clean("{dir}.key");
    fs.make_dirs(dir).unwrap();
    write_bytes("{dir}/m.wasm", [0, 97, 115, 109, 1, 0, 0, 0]).unwrap();
    write_bytes("{dir}/icon.png", png(32, 32)).unwrap();
    write_file(
        "{dir}/rapidkoi.toml",
        "[app]\nname = \"Notes\"\nversion = \"1.0.0\"\nhost = \"localhost:{port}\"\nmodule = \"m.wasm\"\nicon = \"icon.png\"\n[publish]\nkey = \"{dir}.key\"\n",
    ).unwrap();
    make_key(dir).unwrap();
    publish_site(dir).unwrap();
    dir
}

fun serving(dir: string, port: i64) {
    spawn http.serve("127.0.0.1:{port}", fun(r: Request) = handle("{dir}/site", port, r));
    sleep(100);
}

fun opened(port: i64): Model = opening(with_pages(Engine.new(), []), "rapidkoi://localhost:{port}");

/** Opens a file or address, running a background load to its end. */
fun opening(m: Model, path: string): Model {
    let (next, cmd) = open_file(m, path);
    settle(next, cmd, update)
}

/** ⟳, running the background load to its end. */
fun reloaded(m: Model): Model {
    let (next, cmd) = reload(m);
    settle(next, cmd, update)
}

/** What the trust marker says for the current app (its hover text in the address box, PRP-025). */
fun marks(m: Model, s: string): bool = match page_of(m) {
    App(p) => marker_note(p, file_of(p.path)) == s,
    Home => false,
};

fun shows(m: Model, s: string): bool = texts(view(m)).any(fun(x: string) = x == s);

fun step(m: Model, msg: Msg): Model {
    let (next, cmd) = update(m, msg);
    settle(next, cmd, update)
}

fun builds(dir: string): string = "{dir}/site/.well-known/rapidkoi/builds";

@test
fun a_published_site_opens_verified() {
    let dir = published(18741);
    serving(dir, 18741);
    let m = opened(18741);
    assert_eq(marks(m, "localhost:18741 · verified (development)"), true);
    clean(dir);
    clean("{dir}.key");
}

@test
fun a_changed_byte_is_refused_with_no_way_past() {
    let dir = published(18742);
    serving(dir, 18742);
    let m = opened(18742);
    let name = fs.list_dir(builds(dir)).unwrap()[0];
    let mut b = read_bytes("{builds(dir)}/{name}").unwrap();
    b[b.len / 2] = b[b.len / 2] ^ 1;
    write_bytes("{builds(dir)}/{name}", b).unwrap();
    let after = reloaded(m);
    assert_eq(shows(after, "Rapidkoi didn't run this app"), true);
    assert_eq(
        shows(
            after,
            "This app couldn't be verified, so Rapidkoi didn't run it: The app's build doesn't match its index's hash",
        ),
        true,
    );
    assert_eq(click(view(after), "Restart"), Err(Lookup.NotFound("button \"Restart\"")));
    clean(dir);
    clean("{dir}.key");
}

@test
fun a_new_key_without_a_trail_asks_first() {
    let dir = published(18743);
    serving(dir, 18743);
    let m = opened(18743);
    // The site starts over with another key, no rotation.
    clean("{dir}/site");
    clean("{dir}.key");
    make_key(dir).unwrap();
    publish_site(dir).unwrap();
    let asked = reloaded(m);
    assert_eq(shows(asked, "localhost:18743 is now signed by a different key"), true);
    assert_eq(click(view(asked), "Open my version"), Ok(Msg.KeepMine));
    let kept = step(asked, Msg.KeepMine);
    assert_eq(marks(kept, "localhost:18743 · verified (development)"), true);
    // Opened again after its tab closed (nothing open to keep): keeping
    // closes that tab. While it's open, opening it shows its tab (PRP-026).
    let closed = step(kept, Msg.CloseTab(kept.current.unwrap()));
    let new_tab = opening(closed, "rapidkoi://localhost:18743");
    assert_eq((new_tab.tabs.len, click(view(new_tab), "Don't open it")), (1, Ok(Msg.KeepMine)));
    assert_eq(step(new_tab, Msg.KeepMine).tabs.len, 0);
    // Asked again; this time, a separate app.
    let again = reloaded(kept);
    assert_eq(click(view(again), "Open as a separate app"), Ok(Msg.SeparateApp));
    // PRP-049: named first; your version stays, and the new one gets its own tab.
    let naming = step(again, Msg.SeparateApp);
    assert(naming.naming.is_some());
    let other = step(step(naming, Msg.NameSeparate("Other")), Msg.ConfirmSeparate);
    assert_eq(other.tabs.len, 2);
    assert_eq(marks(other, "localhost:18743 · verified (development) · new publisher"), true);
    match page_of(other) {
        App(p) => assert_eq(p.name, "Other"),
        Home => panic("the new app should be in front"),
    }
    clean(dir);
    clean("{dir}.key");
}

@test
fun a_signed_file_is_not_confirmed_until_its_key_is_trusted() {
    let dir = published(18744);
    serving(dir, 18744);
    pack_project(dir, false).unwrap();
    let file = "{dir}/Notes-1.0.0.rkb";
    let alone = opening(with_pages(Engine.new(), []), file);
    assert_eq(marks(alone, "localhost:18744 · not confirmed"), true);
    // The same window, after opening the site: its key is trusted now.
    let both = opening(opened(18744), file);
    assert_eq(marks(both, "localhost:18744 · trusted"), true);
    clean(dir);
    clean("{dir}.key");
}

@test
fun what_gio_hands_over_opens_as_typed() {
    // kivuli 0.61's on_open: GIO gives an address's bare host a trailing /.
    assert_eq(from_outside("rapidkoi://notes.dafifi.net/"), "rapidkoi://notes.dafifi.net");
    assert_eq(from_outside("https://notes.dafifi.net/"), "https://notes.dafifi.net");
    assert_eq(from_outside("rapidkoi://localhost:8000/"), "rapidkoi://localhost:8000");
    // A path after the host, and a file's absolute path, stay as they are.
    assert_eq(
        from_outside("https://notes.dafifi.net/@0.3.4?note=1"),
        "https://notes.dafifi.net/@0.3.4?note=1",
    );
    assert_eq(from_outside("/home/a/counter.rkb"), "/home/a/counter.rkb");
}

@test
fun a_launch_opens_what_it_names_in_the_running_window() {
    // A second ./main hands its items to the first (kivuli 0.61, DECISION-014).
    fs.make_dirs("test/tmp/launched").unwrap();
    let path = "{env.current_dir().unwrap()}/test/tmp/launched/counting.wasm";
    write_counting(path);
    let (m, _) = update(with_pages(Engine.new(), []), Msg.Launched([path]));
    assert_eq(m.tabs.len, 1);
    assert(texts(view(m)).any(fun(x: string) = x == "Count: 0"));
    // The same again is shown, not started twice (one tab per app).
    let (again, _) = update(m, Msg.Launched([path]));
    assert_eq(again.tabs.len, 1);
    clean("test/tmp/launched");
}
