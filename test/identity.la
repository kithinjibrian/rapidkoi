// Identity (PRP-011, PRP-076): the master secret (16 bytes, so it can be
// backup words), each app's key derived from it, host-bound sign-in
// signatures, and backing up. Writes only under test/tmp/.
import rapidkoi.people.identity {
    Master,
    IdentityError,
    master,
    public_key,
    sign_in,
    sign_in_message,
    user_label,
    reason,
    Backup,
    retire_old,
    backup_of,
    note_backup,
    adopt,
    words_for,
};
import rapidkoi.people.words { secret_of };
import rapidkoi.data.store { Store, store_at, save };
import cbor { Value, Entry, encode };
import std.crypto { ed25519_verify };
import std.fs;

fun clean(path: string) {
    if fs.is_dir(path) {
        for name of fs.list_dir(path).unwrap() {
            clean("{path}/{name}");
        }
        fs.remove_dir(path).unwrap();
    } else if fs.exists(path) {
        fs.remove_file(path).unwrap();
    }
}

fun folder(name: string): Store {
    let dir = "test/tmp/identity-{name}";
    clean(dir);
    store_at(dir)
}

const HOST: string = "notes.acme.com";

fun origin(n: u8): u8[] = [n; 32];

@test
fun the_master_is_made_once_and_read_back() {
    let s = folder("master");
    let m = master(s).unwrap();
    assert_eq(fs.is_file("{s.dir}/identity"), true);
    let again = master(s).unwrap();
    // The same master: the same key for the same app.
    assert_eq(
        public_key(again, HOST, origin(1), 0).unwrap(),
        public_key(m, HOST, origin(1), 0).unwrap(),
    );
    clean(s.dir);
}

@test
fun each_app_and_generation_gets_its_own_key() {
    let s = folder("keys");
    let m = master(s).unwrap();
    let a = public_key(m, HOST, origin(1), 0).unwrap();
    assert_eq(a.len, 32);
    assert_eq(public_key(m, HOST, origin(1), 0).unwrap(), a);
    assert_eq(public_key(m, "chat.example", origin(1), 0).unwrap() != a, true);
    assert_eq(public_key(m, HOST, origin(2), 0).unwrap() != a, true);
    assert_eq(public_key(m, HOST, origin(1), 1).unwrap() != a, true);
    // Another person's master: another key for the same app.
    let other = master(folder("other")).unwrap();
    assert_eq(public_key(other, HOST, origin(1), 0).unwrap() != a, true);
    clean(s.dir);
    clean("test/tmp/identity-other");
}

@test
fun a_sign_in_signature_binds_the_host() {
    let s = folder("sign");
    let m = master(s).unwrap();
    let pk = public_key(m, HOST, origin(1), 0).unwrap();
    let challenge: u8[] = [9, 8, 7, 6];
    let sig = sign_in(m, HOST, origin(1), 0, challenge).unwrap();
    assert_eq(sig.len, 64);
    assert_eq(ed25519_verify(pk, sign_in_message(HOST, challenge), sig), true);
    // The same signature doesn't check for another host or challenge.
    assert_eq(ed25519_verify(pk, sign_in_message("notes-acme.co", challenge), sig), false);
    assert_eq(ed25519_verify(pk, sign_in_message(HOST, [1]), sig), false);
    clean(s.dir);
}

@test
fun labels_are_short_and_stable() {
    let l = user_label([7; 32]);
    assert_eq((l.starts_with("User "), l.len), (true, 9));
    assert_eq(user_label([7; 32]), l);
    assert_eq(user_label([8; 32]) != l, true);
}

@test
fun a_broken_or_newer_identity_is_refused_never_replaced() {
    let s = folder("broken");
    save(s, "identity", [1, 2, 3]).unwrap();
    match master(s) {
        Err(Broken(_)) => {}
        _ => panic("expected a broken identity"),
    }
    // Never overwritten: replacing it would make you a stranger everywhere.
    assert_eq(read_bytes("{s.dir}/identity").unwrap(), [1, 2, 3]);
    assert_eq(
        reason(IdentityError.Broken("x")).starts_with("Rapidkoi couldn't read your identity"),
        true,
    );
    clean(s.dir);
}

@test
fun a_new_master_is_16_bytes_and_not_backed_up() {
    let s = folder("new");
    let m = master(s).unwrap();
    assert_eq(m.secret.len, 16);
    assert_eq(
        backup_of(s).unwrap().map(fun(b: Backup) = (b.backed_up, b.reminded)),
        Some((false, false)),
    );
    // Its 12 words are it.
    assert_eq(words_for(m).len, 12);
    assert_eq(secret_of(words_for(m)), Ok(m.secret));
    clean(s.dir);
}

@test
fun backing_up_is_kept_and_the_secret_stays() {
    let s = folder("noted");
    let m = master(s).unwrap();
    note_backup(s, Backup { backed_up: true, reminded: false }).unwrap();
    assert_eq(
        backup_of(s).unwrap().map(fun(b: Backup) = (b.backed_up, b.reminded)),
        Some((true, false)),
    );
    assert_eq(master(s).unwrap().secret, m.secret);
    clean(s.dir);
}

@test
fun typed_words_become_who_you_are() {
    let s = folder("adopt");
    let before = master(s).unwrap();
    let secret: u8[] = [7; 16];
    let m = adopt(s, secret).unwrap();
    assert_eq(master(s).unwrap().secret, secret);
    assert(
        public_key(m, HOST, origin(1), 0).unwrap() != public_key(
            before,
            HOST,
            origin(1),
            0,
        ).unwrap(),
    );
    // Restored from the words: backed up already.
    assert_eq(backup_of(s).unwrap().map(fun(b: Backup) = b.backed_up), Some(true));
    // Only 16 bytes are a secret.
    assert(adopt(s, [7; 32]).is_err());
    clean(s.dir);
}

@test
fun an_old_32_byte_identity_is_kept_aside_once() {
    let s = folder("old");
    let old = encode(
        Value.Map([
            Entry { key: Value.Text("format"), value: Value.int(1) },
            Entry { key: Value.Text("kind"), value: Value.Text("rapidkoi identity") },
            Entry { key: Value.Text("master"), value: Value.Bytes([3; 32]) },
        ]),
    );
    save(s, "identity", old).unwrap();
    assert_eq(retire_old(s).unwrap(), true);
    assert_eq(read_bytes("{s.dir}/identity-v1").unwrap(), old);
    assert_eq(fs.exists("{s.dir}/identity"), false);
    // A new one, when first needed; and nothing more to set aside.
    assert_eq(master(s).unwrap().secret.len, 16);
    assert_eq(retire_old(s).unwrap(), false);
    clean(s.dir);
}

@test
fun nothing_to_set_aside_without_an_identity() {
    let s = folder("none");
    assert_eq(retire_old(s).unwrap(), false);
    assert(backup_of(s).unwrap().is_none());
    clean(s.dir);
}
