// The address box (PRP-015, PRP-019): the framed pill in the header bar.
// Its suggestions card is gone until its redesign (session 108). Through
// kivuli.testing; fixture guests, no display.
import rapidkoi.shell { update };
import rapidkoi.window.window { Model, with_pages };
import rapidkoi.ui.addressbox;
import rapidkoi.ui.layout;
import rapidkoi.window.actions { Msg, Confirm };
import rapidkoi.window.tabs { AppPage, open_module };
import kivuli.testing { click, press, type_into, submit };
import wasmtime { Engine, Module };
import support { echo, said };

fun app(engine: Engine, name: string): AppPage = open_module(
    name,
    "{name}.wasm",
    engine,
    Module.from_text(engine, echo()).unwrap(),
);

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

/** Home, with apps "alpha" (tab 0) and "beta" (tab 1) open. */
fun home(): Model {
    let engine = Engine.new();
    step(with_pages(engine, [app(engine, "alpha"), app(engine, "beta")]), Msg.Home)
}

@test
fun home_at_rest_is_an_empty_field() {
    let f = addressbox.field(home());
    assert_eq(type_into(f, "Enter Address", "al"), Ok(Msg.Draft("al")));
    assert_eq(submit(f, "Enter Address"), Ok(Msg.Go));
}

@test
fun typing_shows_nothing_under_the_box() {
    // The suggestions card is gone until its redesign (the owner, session 108).
    let m = step(home(), Msg.Draft("alp"));
    let v = layout.view(m);
    // The sidebar's "alpha" is the open tab; the box suggests nothing.
    assert(click(addressbox.field(m), "alpha").is_err());
    assert(click(v, "dismiss").is_err());
    assert(press(v, "Escape").is_err());
    // Just the rounded field (session 80): Enter goes, there's no → button.
    assert(click(addressbox.field(m), "Go").is_err());
    assert_eq(submit(addressbox.field(m), "Enter Address"), Ok(Msg.Go));
}

@test
fun a_failed_open_keeps_why_in_the_model() {
    let m = step(step(home(), Msg.Draft("nope")), Msg.Go);
    assert_eq(said(m), Some("No app or file called “nope”"));
    assert_eq(m.draft, "nope");
}

@test
fun dismissing_empties_the_box() {
    let after = step(step(home(), Msg.Draft("alp")), Msg.Dismiss);
    assert_eq((after.draft, after.editing, said(after)), ("", false, None));
}

@test
fun an_app_page_has_the_same_field_with_its_address() {
    // One typing box on every tab (PRP-025): no button to click first.
    let m = step(home(), Msg.Select(0));
    let f = addressbox.field(m);
    assert_eq(type_into(f, "Enter Address", "x"), Ok(Msg.Draft("x")));
    assert_eq(submit(f, "Enter Address"), Ok(Msg.Go));
    // Typing starts editing; Dismiss puts the address back.
    let typed = step(m, Msg.Draft("quote"));
    assert_eq((typed.editing, typed.draft), (true, "quote"));
    assert_eq(step(typed, Msg.Dismiss).editing, false);
}

@test
fun the_settings_card_steps_aside_while_a_dialog_asks() {
    // ⚙'s card is a popover, drawn above the window, so a dialog in the
    // window would sit under it (the owner's screenshot, PRP-052).
    let engine = Engine.new();
    let open = step(with_pages(engine, [app(engine, "Notes")]), Msg.TogglePanel);
    assert_eq(addressbox.card_open(open), true);
    let asking = step(open, Msg.Ask(Confirm.Forget));
    assert_eq(addressbox.card_open(asking), false);
    // Cancel: the card comes back where it was.
    assert_eq(addressbox.card_open(step(asking, Msg.Cancel)), true);
}
