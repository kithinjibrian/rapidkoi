// The address box (PRP-015): the pill in the header bar and the card of
// suggestions under it. Through kivuli.testing; fixture guests, no display.
import rapidkoi.shell { Model, with_pages, update };
import rapidkoi.addressbox;
import rapidkoi.layout;
import rapidkoi.actions { Msg };
import rapidkoi.tabs { AppPage, open_module };
import kivuli { View };
import kivuli.testing { click, press, texts, type_into, submit };
import wasmtime { Engine, Module };
import support { echo };

fun app(engine: Engine, name: string): AppPage = open_module(
    name,
    "{name}.wasm",
    engine,
    Module.from_text(engine, echo()).unwrap(),
);

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

/** Home, with apps "alpha" (tab 0) and "beta" (tab 1) open. */
fun home(): Model {
    let engine = Engine.new();
    step(with_pages(engine, [app(engine, "alpha"), app(engine, "beta")]), Msg.Home)
}

/** The card, which must be showing. */
fun card(m: Model): View<Msg> = match addressbox.card(m) {
    Some(v) => v,
    None => panic("the card isn't showing"),
};

@test
fun home_at_rest_is_an_empty_field_and_no_card() {
    let m = home();
    let f = addressbox.field(m);
    assert_eq(type_into(f, "Enter Address", "al"), Ok(Msg.Draft("al")));
    assert_eq(submit(f, "Enter Address"), Ok(Msg.Go));
    assert(addressbox.card(m).is_none());
}

@test
fun typing_shows_what_was_typed_first() {
    let m = step(home(), Msg.Draft("zzz"));
    let v = card(m);
    assert_eq(texts(v), ["zzz"]);
    assert_eq(click(v, "zzz"), Ok(Msg.Go));
    assert_eq(click(addressbox.field(m), "Go"), Ok(Msg.Go));
}

@test
fun matches_show_under_rapidkoi_suggest() {
    let v = card(step(home(), Msg.Draft("alp")));
    assert_eq(texts(v), ["alp", "Rapidkoi suggest", "alpha"]);
    assert_eq(click(v, "alpha"), Ok(Msg.Select(0)));
}

@test
fun a_suggestion_opens_its_app_and_closes_the_card() {
    let m = step(home(), Msg.Draft("bet"));
    let chosen = click(card(m), "beta").unwrap();
    let after = step(m, chosen);
    assert_eq(after.current, Some(1));
    assert(addressbox.card(after).is_none());
}

@test
fun escape_and_a_click_outside_dismiss_the_card() {
    let m = step(home(), Msg.Draft("alp"));
    let v = layout.view(m);
    assert_eq(press(v, "Escape"), Ok(Msg.Dismiss));
    assert_eq(click(v, "dismiss"), Ok(Msg.Dismiss));
    let after = step(m, Msg.Dismiss);
    assert_eq(after.draft, "");
    assert(addressbox.card(after).is_none());
    assert(press(layout.view(after), "Escape").is_err());
}

@test
fun a_failed_open_says_why_in_the_card() {
    let m = step(step(home(), Msg.Draft("nope")), Msg.Go);
    let v = card(m);
    assert(texts(v).any(fun(s: string) = s == "No app or file called “nope”"));
    assert(texts(v)[0] == "nope");
}

@test
fun an_app_page_shows_its_address_until_clicked() {
    let m = step(home(), Msg.Select(0));
    let f = addressbox.field(m);
    assert(type_into(f, "Enter Address", "x").is_err());
    assert_eq(press(f, "Ctrl+K"), Ok(Msg.EditAddress));
    let editing = step(m, Msg.EditAddress);
    assert_eq(type_into(addressbox.field(editing), "Enter Address", "x"), Ok(Msg.Draft("x")));
    // Escape puts the address back.
    let back = step(editing, Msg.Dismiss);
    assert(type_into(addressbox.field(back), "Enter Address", "x").is_err());
}
