// The sidebar (PRP-023): pinned apps, open apps, the current one's ×, +,
// their shortcuts and menus. Through kivuli.testing; fixture guests, no
// display.
import rapidkoi.shell { update };
import rapidkoi.window.window { Model, with_pages };
import rapidkoi.ui.sidebar;
import rapidkoi.window.actions { Msg, TabAction, PinAction };
import rapidkoi.window.tabs { AppPage, Pin, Tab, open_module };
import kivuli.testing { click, pick, press };
import wasmtime { Engine, Module };
import support { echo };

fun app(engine: Engine, name: string): AppPage = open_module(
    name,
    "{name}.wasm",
    engine,
    Module.from_text(engine, echo()).unwrap(),
);

/** Notes (tab 0, current) and Todo (tab 1). */
fun two(): Model {
    let engine = Engine.new();
    with_pages(engine, [app(engine, "notes"), app(engine, "todo")])
}

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

fun pin(name: string): Pin = Pin { name: name, path: "{name}.wasm", icon: None, origin: None };

@test
fun open_apps_select_their_tab() {
    let v = sidebar.view(two());
    assert_eq(click(v, "notes"), Ok(Msg.Select(0)));
    assert_eq(click(v, "todo"), Ok(Msg.Select(1)));
}

@test
fun a_pin_opens_unless_its_app_is_open_already() {
    let m = Model { pinned: [pin("mail"), pin("todo")], ..two() };
    let v = sidebar.view(m);
    assert_eq(click(v, "Open mail"), Ok(Msg.OpenPinned("mail.wasm", None)));
    // Todo is pinned and open: one button, its tab.
    assert(click(v, "Open todo").is_err());
    assert_eq(click(v, "todo"), Ok(Msg.Select(1)));
}

@test
fun every_open_tab_has_a_close_button() {
    // Shown on hover, but always there (PRP-028). The current app's closes
    // the window in front; another's closes all of that app's (PRP-033).
    let v = sidebar.view(two());
    assert_eq(click(v, "Close notes"), Ok(Msg.CloseTab(0)));
    assert_eq(click(v, "Close todo"), Ok(Msg.CloseApp(1)));
    let home = sidebar.view(step(two(), Msg.NewTab));
    assert_eq(click(home, "Close notes"), Ok(Msg.CloseApp(0)));
}

@test
fun only_the_current_tab_closes_with_ctrl_w() {
    assert_eq(press(sidebar.view(two()), "Ctrl+W"), Ok(Msg.CloseTab(0)));
    assert_eq(press(sidebar.view(step(two(), Msg.Select(1))), "Ctrl+W"), Ok(Msg.CloseTab(1)));
}

@test
fun a_closed_pin_has_no_close_button() {
    let v = sidebar.view(Model { pinned: [pin("mail")], ..two() });
    assert(click(v, "Close mail").is_err());
}

@test
fun a_pinned_apps_close_keeps_its_pin() {
    let m = Model { pinned: [pin("todo")], ..two() };
    let closed = step(m, click(sidebar.view(m), "Close todo").unwrap());
    assert_eq((closed.tabs.len, closed.pinned.len), (1, 1));
}

@test
fun plus_opens_a_new_tab() {
    let v = sidebar.view(two());
    assert_eq(click(v, "Add a tab"), Ok(Msg.NewTab));
    assert_eq(press(v, "Ctrl+T"), Ok(Msg.NewTab));
}

@test
fun each_app_has_its_menu() {
    let m = Model { pinned: [pin("mail"), pin("todo")], ..two() };
    let v = sidebar.view(m);
    // An open app that isn't pinned.
    assert_eq(pick(v, "notes", "Close"), Ok(Msg.OnTab(0, TabAction.Close)));
    assert_eq(pick(v, "notes", "Pin"), Ok(Msg.OnTab(0, TabAction.TogglePin)));
    assert_eq(pick(v, "notes", "Forget this app…"), Ok(Msg.OnTab(0, TabAction.Forget)));
    // A pinned app that's open.
    assert_eq(pick(v, "todo", "Unpin"), Ok(Msg.OnTab(1, TabAction.TogglePin)));
    // A pinned app that isn't open.
    assert_eq(pick(v, "Open mail", "Open"), Ok(Msg.OnPin("mail.wasm", None, PinAction.Open)));
    assert_eq(pick(v, "Open mail", "Unpin"), Ok(Msg.OnPin("mail.wasm", None, PinAction.Unpin)));
    assert_eq(
        pick(v, "Open mail", "Forget this app…"),
        Ok(Msg.OnPin("mail.wasm", None, PinAction.Forget)),
    );
}

@test
fun the_docks_count_stops_at_nine() {
    // PRP-033: past nine instances it reads 9+.
    assert_eq(
        (sidebar.count_text(2), sidebar.count_text(9), sidebar.count_text(10)),
        ("2", "9", "9+"),
    );
}

@test
fun the_dock_ends_with_all_apps() {
    // PRP-067: its last button opens All apps.
    assert_eq(click(sidebar.view(two()), "All apps"), Ok(Msg.OpenAllApps));
}

@test
fun all_apps_open_is_the_button_not_a_tab_in_the_dock() {
    // Its tab is the button's: not listed among the open apps.
    let engine = Engine.new();
    let m = with_pages(engine, [
        app(engine, "notes"),
        AppPage { path: "builtin:allapps", ..app(engine, "allapps") },
    ]);
    assert_eq(sidebar.dock_order(m), [m.tabs[0].id]);
}

@test
fun all_apps_opens_once() {
    // PRP-067: a tab of its own, in front; pressed again, the same tab.
    let opened = step(two(), Msg.OpenAllApps);
    let mine = opened.tabs.filter(fun(t: Tab) = t.page.path == "builtin:allapps");
    assert_eq(mine.len, 1);
    assert_eq(opened.current, Some(mine[0].id));
    let again = step(step(opened, Msg.Select(0)), Msg.OpenAllApps);
    assert_eq((again.tabs.len, again.current), (opened.tabs.len, Some(mine[0].id)));
}

@test
fun all_apps_closes_from_its_button_back_to_where_you_were() {
    // PRP-067 (the owner, 2026-11-03): pressed while it's in front, it closes,
    // and you're back on the app you were on.
    let m = step(two(), Msg.Select(1));
    let opened = step(m, Msg.OpenAllApps);
    let closed = step(opened, Msg.OpenAllApps);
    assert_eq(closed.tabs.any(fun(t: Tab) = t.page.path == "builtin:allapps"), false);
    assert_eq(closed.current, Some(1));
}

@test
fun going_to_another_app_closes_all_apps() {
    // Leaving it for any other app closes it: it's a place to find apps.
    let opened = step(two(), Msg.OpenAllApps);
    let left = step(opened, Msg.Select(1));
    assert_eq(left.tabs.any(fun(t: Tab) = t.page.path == "builtin:allapps"), false);
    assert_eq(left.current, Some(1));
}
