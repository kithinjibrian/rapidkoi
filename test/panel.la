// The info panel and the bar's ⟳ and ☆: the panel's pages, its confirms,
// Forget, and Reload keeping state. Fixture guests; no display.
import rapidkoi.panel { size };
import rapidkoi.shell { Model, with_pages, update, view };
import rapidkoi.actions { Msg, PanelPage, Confirm };
import rapidkoi.tabs { AppPage, open_module, state_of };
import rapidkoi.render;
import rapidkoi.contract { envelope };
import kivuli.testing { Lookup, click, press, texts };
import wasmtime { Engine, Module };
import support { t, echo };

fun app(engine: Engine, name: string): AppPage = open_module(
    name,
    "{name}.wasm",
    engine,
    Module.from_text(engine, echo()).unwrap(),
);

fun one(): Model {
    let engine = Engine.new();
    with_pages(engine, [app(engine, "notes")])
}

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

fun shows(m: Model, s: string): bool = texts(view(m)).any(fun(x: string) = x == s);

fun add(): Msg = Msg.Tab(0, render.Msg.Event(t("add"), None));

fun state(m: Model): Option<u8[]> = state_of(m.tabs[0].page);

@test
fun the_bar_reloads_and_pins() {
    let m = one();
    assert_eq(click(view(m), "Reload"), Ok(Msg.Reload));
    assert_eq(click(view(m), "Pin"), Ok(Msg.TogglePin));
    let pinned = step(m, Msg.TogglePin);
    assert_eq(pinned.pinned.len, 1);
    assert_eq(click(view(pinned), "Unpin"), Ok(Msg.TogglePin));
    assert_eq(step(pinned, Msg.TogglePin).pinned.len, 0);
    // Not on home.
    let home = step(m, Msg.Home);
    assert_eq(click(view(home), "Reload"), Err(Lookup.NotFound("button \"Reload\"")));
}

@test
fun the_main_page() {
    let m = step(step(one(), add()), Msg.TogglePanel);
    for s of [
        "notes",
        "No version",
        "Your settings",
        "Account",
        "Not signed in",
        "Notifications",
        "Off",
        "Access",
        "On this device",
        "Where you left off",
        "Data",
    ] {
        assert_eq(shows(m, s), true);
    }
    assert_eq(shows(m, size(envelope(t("add"), None).len)), true);
    assert_eq(click(view(m), "Forget this app"), Ok(Msg.Ask(Confirm.Forget)));
    assert_eq(click(view(m), "About this app"), Ok(Msg.PanelGo(PanelPage.About)));
    assert_eq(
        click(view(step(m, Msg.TogglePanel)), "Account"),
        Err(Lookup.NotFound("button \"Account\"")),
    );
}

@test
fun each_page_opens_and_comes_back() {
    let m = step(one(), Msg.TogglePanel);
    let pages = [
        ("Account", PanelPage.Account, "Not signed in"),
        ("Notifications", PanelPage.Notifications, "notes hasn't asked to send notifications."),
        ("Access", PanelPage.Access, "None: notes can't reach anything outside itself."),
        ("Where you left off", PanelPage.State, "Start over"),
        ("Data", PanelPage.Data, "No data yet."),
    ];
    for (label, page, inside) of pages {
        assert_eq(click(view(m), label), Ok(Msg.PanelGo(page)));
        let opened = step(m, Msg.PanelGo(page));
        assert_eq(shows(opened, inside) || click(view(opened), inside).is_ok(), true);
        assert_eq(click(view(opened), "Back"), Ok(Msg.PanelBack));
        assert_eq(shows(step(opened, Msg.PanelBack), "Your settings"), true);
    }
    let about = step(m, Msg.PanelGo(PanelPage.About));
    assert_eq(shows(about, "Not signed: a bare module"), true);
    assert_eq(shows(about, "notes.wasm"), true);
}

@test
fun start_over_asks_first() {
    let m = step(step(step(one(), add()), Msg.TogglePanel), Msg.PanelGo(PanelPage.State));
    assert_eq(click(view(m), "Start over"), Ok(Msg.Ask(Confirm.StartOver)));
    let asking = step(m, Msg.Ask(Confirm.StartOver));
    assert_eq(
        shows(asking, "Start notes over? What it saved on this device will be cleared."),
        true,
    );
    assert_eq(state(step(asking, Msg.Cancel)), Some(envelope(t("add"), None)));
    assert_eq(state(step(asking, Msg.StartOver)), Some([]));
}

@test
fun forget_asks_then_removes_everything() {
    let engine = Engine.new();
    let m = step(with_pages(engine, [app(engine, "notes"), app(engine, "other")]), Msg.TogglePin);
    let asking = step(step(m, Msg.TogglePanel), Msg.Ask(Confirm.Forget));
    assert_eq(
        shows(asking, "Forget notes? Everything it stored on this device will be deleted."),
        true,
    );
    assert_eq(step(asking, Msg.Cancel).tabs.len, 2);
    let gone = step(asking, Msg.Forget);
    assert_eq(gone.tabs.len, 1);
    assert_eq(gone.pinned.len, 0);
    assert_eq(gone.left_off.is_none(), true);
    assert_eq(gone.panel.is_none(), true);
}

@test
fun switching_tabs_drops_a_pending_confirm() {
    let engine = Engine.new();
    let m = with_pages(engine, [app(engine, "a"), app(engine, "b")]);
    let asking = step(step(m, Msg.TogglePanel), Msg.Ask(Confirm.Forget));
    assert_eq(step(asking, Msg.Select(1)).confirm.is_none(), true);
}

@test
fun reload_keeps_the_state() {
    // A fixture module isn't a file, so ⟳ can't load it again: it shows why.
    // The real reload-with-state path is tested end to end in counter.la.
    let m = step(one(), add());
    let reloaded = step(m, Msg.Reload);
    assert_eq(
        texts(view(reloaded)).any(fun(s: string) = s.starts_with("Couldn't read notes.wasm")),
        true,
    );
}

@test
fun sizes_read_plainly() {
    assert_eq(size(0), "Nothing saved");
    assert_eq(size(900), "900 B");
    assert_eq(size(12 * 1024), "12 KB");
    assert_eq(size(3565158), "3.4 MB");
}

@test
fun the_panel_opens_over_the_app_and_closes_from_outside() {
    let m = one();
    // Closed: no dim layer.
    assert_eq(
        click(view(m), "Click to close the panel"),
        Err(Lookup.NotFound("button \"Click to close the panel\"")),
    );
    let open = step(m, Msg.TogglePanel);
    // Open: the dim layer over the app closes it, by a click or Escape.
    assert_eq(click(view(open), "Click to close the panel"), Ok(Msg.TogglePanel));
    assert_eq(press(view(open), "Escape"), Ok(Msg.TogglePanel));
    assert_eq(step(open, Msg.TogglePanel).panel, None);
}
