/**
 * Helpers shared by the tests: short CBOR value builders for contract v1
 * trees, WebAssembly text for fixture guests, and `settle`, which runs a
 * command's background tasks in place. Holds no tests itself.
 *
 * Depends on: cbor, kivuli
 * Used by: contract, render, guest, shell, loading, opening, saving
 */
import cbor { Value, Entry, encode };
import kivuli { Cmd };

/**
 * Runs a command's tasks now, in order, sending each result through
 * `update` and settling what that returns, as kivuli would in the
 * background. Other commands (focus, after, quit) are dropped.
 */
public fun settle<M, Msg>(m: M, c: Cmd<Msg>, update: fun(M, Msg): (M, Cmd<Msg>)): M = match c {
    Task(job) => {
        let (next, more) = update(m, job());
        settle(next, more, update)
    }
    Batch(cmds) => {
        let mut at = m;
        for one of cmds {
            at = settle(at, one, update);
        }
        at
    }
    _ => m,
};

/** A text value. */
public fun t(s: string): Value = Value.Text(s);

/** A map from text keys, in order. */
public fun kv(pairs: (string, Value)[]): Value = Value.Map(
    pairs.map(fun(p: (string, Value)) = Entry { key: Value.Text(p.0), value: p.1 }),
);

/** A contract node without children. */
public fun leaf(kind: string, props: (string, Value)[]): Value = kv([
    ("kind", t(kind)),
    ("props", kv(props)),
]);

/** A contract container node. */
public fun parent(kind: string, props: (string, Value)[], children: Value[]): Value = kv([
    ("kind", t(kind)),
    ("props", kv(props)),
    ("children", Value.Array(children)),
]);

/** A column of `n` text nodes. */
public fun wide(n: i64): Value {
    let mut kids: Value[] = [];
    for i in 0..n {
        kids.push(leaf("text", [("text", t("{i}"))]));
    }
    parent("column", [], kids)
}

/** `depth` nodes: columns nested inside each other, a text at the bottom. */
public fun deep(depth: i64): Value {
    let mut v = leaf("text", [("text", t("bottom"))]);
    for _ in 1..depth {
        v = parent("column", [], [v]);
    }
    v
}

/** One hex digit. */
fun hex(n: u8): string = "0123456789abcdef".slice(n as i64, n as i64 + 1);

/** The bytes as a WebAssembly text data string: every byte escaped as `\hh`. */
public fun wat_bytes(bytes: u8[]): string {
    let mut parts: string[] = [];
    for b of bytes {
        parts.push("\\" + hex(b >> 4) + hex(b & 15));
    }
    parts.join("")
}

/** A (pointer, length) packed the contract's way: pointer high, length low. */
public fun pack(ptr: i64, len: i64): i64 = ptr << 32 | len;

/**
 * A guest answering with fixed bytes, as one contract `update` sees events:
 * the init event gets `{state: state}`, the opened event keeps the state it
 * was given, and any other event gets `result`; `view` returns `tree`.
 * `alloc` bumps from 65536, past the blobs, and resets after each export.
 * `rapidkoi_version` returns `version`.
 */
public fun fixed(version: i32, state: u8[], tree: u8[], result: u8[]): string {
    let first = result_of(state);
    let s = 1024;
    let v = s + first.len;
    let r = v + tree.len;
    [
        "(module (memory (export \"memory\") 4)",
        "(global $next (mut i32) (i32.const 65536))",
        "(data (i32.const {s}) \"{wat_bytes(first)}\")",
        "(data (i32.const {v}) \"{wat_bytes(tree)}\")",
        "(data (i32.const {r}) \"{wat_bytes(result)}\")",
        wrapping(60000),
        "(func (export \"rapidkoi_version\") (result i32) (i32.const {version}))",
        "(func (export \"alloc\") (param $n i32) (result i32) (local $p i32)",
        "  (local.set $p (global.get $next))",
        "  (global.set $next (i32.add (global.get $next) (local.get $n)))",
        "  (local.get $p))",
        "(func $reset (global.set $next (i32.const 65536)))",
        "(func (export \"view\") (param i32 i32) (result i64) (call $reset) (i64.const {pack(v, tree.len)}))",
        "(func (export \"handle\") (param $sp i32) (param $sl i32) (param $ep i32) (param $el i32) (result i64)",
        "  (if (i32.eq (local.get $el) (i32.const {INIT_LEN})) (then (call $reset) (return (i64.const {pack(s, first.len)}))))",
        "  (if (i32.eq (local.get $el) (i32.const {OPENED_LEN})) (then (return (call $wrap (local.get $sp) (local.get $sl)))))",
        "  (call $reset) (i64.const {pack(r, result.len)})))",
    ].join("\n")
}

/** The length of the CBOR `{event: "init"}`: how a fixture tells it apart. */
const INIT_LEN: i64 = 12;

/** The length of the CBOR `{event: "opened"}`. */
const OPENED_LEN: i64 = 14;

/**
 * A WebAssembly function `$wrap(ptr, len)` writing `{state: <those bytes>,
 * effects: []}` at `at` and returning it packed, plus the bytes it needs.
 */
fun wrapping(at: i64): string {
    let head: u8[] = [0xa2, 0x65, 115, 116, 97, 116, 101, 0x59];
    let tail: u8[] = [0x67, 101, 102, 102, 101, 99, 116, 115, 0x80];
    let out = at + 32;
    [
        "(data (i32.const {at}) \"{wat_bytes(head)}\")",
        "(data (i32.const {at + 16}) \"{wat_bytes(tail)}\")",
        "(func $wrap (param $p i32) (param $l i32) (result i64)",
        "  (memory.copy (i32.const {out}) (i32.const {at}) (i32.const 8))",
        "  (i32.store8 (i32.const {out + 8}) (i32.shr_u (local.get $l) (i32.const 8)))",
        "  (i32.store8 (i32.const {out + 9}) (local.get $l))",
        "  (memory.copy (i32.const {out + 10}) (local.get $p) (local.get $l))",
        "  (memory.copy (i32.add (i32.const {out + 10}) (local.get $l)) (i32.const {at + 16}) (i32.const 9))",
        "  (i64.or (i64.const {out << 32}) (i64.extend_i32_u (i32.add (local.get $l) (i32.const 19)))))",
    ].join("\n")
}

/** A tree: a column holding a text and a button sending "add". */
public fun counter_tree(label: string): u8[] = encode(
    parent("column", [], [
        leaf("text", [("text", t(label))]),
        leaf("button", [("label", t("Add")), ("on_press", t("add"))]),
    ]),
);

/** An update result holding `state`. */
public fun result_of(state: u8[]): u8[] = encode(
    kv([("state", Value.Bytes(state)), ("effects", Value.Array([]))]),
);

/**
 * A guest whose `update` answers each message or answer with the event's
 * own bytes as its new state, starts with an empty state, and keeps it when
 * opened; its `view` shows a button sending "add".
 */
public fun echo(): string = echoing(result_of([]), None);

/**
 * `echo` asking for things: the init event gets `init` (a `{state,
 * effects}` result), and the opened event gets `opened` when given.
 */
public fun echo_v2(init: u8[]): string = echoing(init, None);

/** `echo` that asks for things every time it's opened (`opened`, a result). */
public fun echo_opening(opened: u8[]): string = echoing(result_of([]), Some(opened));

/**
 * A contract 3 guest (PRP-030) whose `handle` keeps every event's own bytes
 * as its state, init and open too: the state is the last event it got.
 */
public fun echo_v3(): string {
    let tree = counter_tree("echo");
    [
        "(module (memory (export \"memory\") 1)",
        "(global $next (mut i32) (i32.const 8192))",
        "(data (i32.const 1024) \"{wat_bytes(tree)}\")",
        wrapping(3000),
        "(func (export \"rapidkoi_version\") (result i32) (i32.const 3))",
        "(func (export \"alloc\") (param $n i32) (result i32) (local $p i32)",
        "  (local.set $p (global.get $next))",
        "  (global.set $next (i32.add (global.get $next) (local.get $n)))",
        "  (local.get $p))",
        "(func (export \"view\") (param i32 i32) (result i64) (global.set $next (i32.const 8192)) (i64.const {(1024 << 32) | tree.len}))",
        "(func (export \"handle\") (param $sp i32) (param $sl i32) (param $ep i32) (param $el i32) (result i64)",
        "  (call $wrap (local.get $ep) (local.get $el)))",
        ")",
    ].join("\n")
}

/** The echoing guest. */
fun echoing(init: u8[], opened: Option<u8[]>): string {
    let tree = counter_tree("echo");
    let open = opened.unwrap_or([]);
    let on_open = match opened {
        Some(_) => "(return (i64.const {(5600 << 32) | open.len}))",
        None => "(return (call $wrap (local.get $sp) (local.get $sl)))",
    };
    [
        "(module (memory (export \"memory\") 1)",
        "(global $next (mut i32) (i32.const 8192))",
        "(data (i32.const 1024) \"{wat_bytes(tree)}\")",
        "(data (i32.const 5000) \"{wat_bytes(init)}\")",
        "(data (i32.const 5600) \"{wat_bytes(open)}\")",
        wrapping(3000),
        "(func (export \"rapidkoi_version\") (result i32) (i32.const 2))",
        "(func (export \"alloc\") (param $n i32) (result i32) (local $p i32)",
        "  (local.set $p (global.get $next))",
        "  (global.set $next (i32.add (global.get $next) (local.get $n)))",
        "  (local.get $p))",
        "(func (export \"view\") (param i32 i32) (result i64) (global.set $next (i32.const 8192)) (i64.const {(1024 << 32) | tree.len}))",
        "(func (export \"handle\") (param $sp i32) (param $sl i32) (param $ep i32) (param $el i32) (result i64)",
        "  (if (i32.eq (local.get $el) (i32.const {INIT_LEN})) (then (return (i64.const {(5000 << 32) | init.len}))))",
        "  (if (i32.eq (local.get $el) (i32.const {OPENED_LEN})) (then {on_open}))",
        "  (call $wrap (local.get $ep) (local.get $el)))",
        ")",
    ].join("\n")
}

/**
 * A guest whose `view` shows a counter tree and whose `update` traps on any
 * message (it starts and opens fine).
 */
public fun crashing(): string {
    let first = result_of([]);
    [
        "(module (memory (export \"memory\") 1)",
        "(data (i32.const 1024) \"{wat_bytes(counter_tree("x"))}\")",
        "(data (i32.const 2048) \"{wat_bytes(first)}\")",
        "(func (export \"rapidkoi_version\") (result i32) (i32.const 2))",
        "(func (export \"alloc\") (param i32) (result i32) (i32.const 8192))",
        "(func (export \"view\") (param i32 i32) (result i64) (i64.const {(1024 << 32) | counter_tree("x").len}))",
        "(func (export \"handle\") (param i32 i32 i32) (param $el i32) (result i64)",
        "  (if (i32.le_u (local.get $el) (i32.const {OPENED_LEN})) (then (return (i64.const {(2048 << 32) | first.len}))))",
        "  unreachable))",
    ].join("\n")
}

/** A counter tree whose root carries `title`. */
public fun titled_tree(label: string, title: string): u8[] = encode(
    parent("column", [("title", t(title))], [
        leaf("text", [("text", t(label))]),
        leaf("button", [("label", t("Add")), ("on_press", t("add"))]),
    ]),
);

/**
 * The start of a PNG declaring `w` × `h` pixels: its signature and IHDR
 * chunk header, which is all Rapidkoi reads (GTK decodes the rest).
 */
public fun png(w: i64, h: i64): u8[] {
    let mut b: u8[] = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 13, 73, 72, 68, 82];
    for v of [w, h] {
        b.push((v >> 24 & 255) as u8);
        b.push((v >> 16 & 255) as u8);
        b.push((v >> 8 & 255) as u8);
        b.push((v & 255) as u8);
    }
    // Bit depth 8, colour type 6 (RGBA), compression, filter, interlace.
    for x of [8, 6, 0, 0, 0] {
        b.push(x as u8);
    }
    b
}
