/**
 * Helpers shared by the tests: short CBOR value builders for contract 8
 * trees, WebAssembly text for fixture guests, and `settle`, which runs a
 * command's background tasks in place. Holds no tests itself.
 *
 * Depends on: cbor, kivuli, wasmtime
 * Used by: contract, render, guest, shell, loading, opening, saving, counting
 */
import cbor { Value, Entry, Limits, encode, decode };
import kivuli { Cmd };
import wasmtime { wat_to_wasm };
import rapidkoi.window.window { Model, Notice };
import rapidkoi.window.notices { shown };

/**
 * Runs a command's tasks now, in order, sending each result through
 * `update` and settling what that returns, as kivuli would in the
 * background. Other commands (focus, after, quit) are dropped.
 */
fun settle<M, Msg>(m: M, c: Cmd<Msg>, update: fun(M, Msg): (M, Cmd<Msg>)): M = match c {
    Task(job) => {
        let (next, more) = update(m, job());
        settle(next, more, update)
    }
    Batch(cmds) => {
        let mut at = m;
        for one of cmds {
            at = settle(at, one, update);
        }
        at
    }
    _ => m,
};

/** A text value. */
fun t(s: string): Value = Value.Text(s);

/** A map from text keys, in order. */
fun kv(pairs: (string, Value)[]): Value = Value.Map(
    pairs.map(fun(p: (string, Value)) = Entry { key: Value.Text(p.0), value: p.1 }),
);

/** A contract node without children. */
fun leaf(kind: string, props: (string, Value)[]): Value = kv([
    ("kind", t(kind)),
    ("props", kv(props)),
]);

/** A contract container node. */
fun parent(kind: string, props: (string, Value)[], children: Value[]): Value = kv([
    ("kind", t(kind)),
    ("props", kv(props)),
    ("children", Value.Array(children)),
]);

/** A column of `n` text nodes. */
fun wide(n: i64): Value {
    let mut kids: Value[] = [];
    for i in 0..n {
        kids.push(leaf("text", [("text", t("{i}"))]));
    }
    parent("column", [], kids)
}

/** `depth` nodes: columns nested inside each other, a text at the bottom. */
fun deep(depth: i64): Value {
    let mut v = leaf("text", [("text", t("bottom"))]);
    for _ in 1..depth {
        v = parent("column", [], [v]);
    }
    v
}

/** One hex digit. */
fun hex(n: u8): string = "0123456789abcdef".slice(n as i64, n as i64 + 1);

/** The bytes as a WebAssembly text data string: every byte escaped as `\hh`. */
fun wat_bytes(bytes: u8[]): string {
    let mut parts: string[] = [];
    for b of bytes {
        parts.push("\\" + hex(b >> 4) + hex(b & 15));
    }
    parts.join("")
}

/** A (pointer, length) packed the contract's way: pointer high, length low. */
fun pack(ptr: i64, len: i64): i64 = ptr << 32 | len;

/**
 * A guest for the tests, speaking contract 8. `on_init` answers `init`;
 * `on_open` answers `opened`, or keeps the state it was given; any other
 * event answers `other`, or, without one, becomes the state as
 * `{event: <its bytes>}`, so a test reads exactly what Rapidkoi sent
 * (`event_in`). `view` returns `tree`. `alloc` bumps from 65536 and resets
 * at each call.
 */
fun guest_of(init: u8[], opened: Option<u8[]>, other: Option<u8[]>, tree: u8[]): string {
    let o = opened.unwrap_or([]);
    let x = other.unwrap_or([]);
    let i_at = 1024;
    let o_at = i_at + init.len;
    let x_at = o_at + o.len;
    let t_at = x_at + x.len;
    if t_at + tree.len > SCRATCH {
        panic("a test guest's results and tree fit below {SCRATCH}");
    }
    let on_open = match opened {
        Some(_) => "(return (i64.const {pack(o_at, o.len)}))",
        None => "(return (call $keep (local.get $sp) (local.get $sl)))",
    };
    let on_other = match other {
        Some(_) => "(i64.const {pack(x_at, x.len)})",
        None => "(call $echo (local.get $ep) (local.get $el))",
    };
    [
        "(module (memory (export \"memory\") 4)",
        "(global $next (mut i32) (i32.const 65536))",
        "(data (i32.const {i_at}) \"{wat_bytes(init)}\")",
        "(data (i32.const {o_at}) \"{wat_bytes(o)}\")",
        "(data (i32.const {x_at}) \"{wat_bytes(x)}\")",
        "(data (i32.const {t_at}) \"{wat_bytes(tree)}\")",
        results(),
        "(func (export \"rapidkoi_version\") (result i32) (i32.const 8))",
        "(func (export \"alloc\") (param $n i32) (result i32) (local $p i32)",
        "  (local.set $p (global.get $next))",
        "  (global.set $next (i32.add (global.get $next) (local.get $n)))",
        "  (local.get $p))",
        "(func (export \"view\") (param i32 i32) (result i64) (global.set $next (i32.const 65536)) (i64.const {pack(t_at, tree.len)}))",
        "(func (export \"handle\") (param $sp i32) (param $sl i32) (param $ep i32) (param $el i32) (result i64)",
        "  (global.set $next (i32.const 65536))",
        // `{event: "on_init"}` and `{event: "on_open"}` are both 15 bytes; the 12th tells them apart.
        "  (if (i32.eq (local.get $el) (i32.const 15)) (then",
        "    (if (i32.eq (i32.load8_u (i32.add (local.get $ep) (i32.const 11))) (i32.const 105))",
        "      (then (return (i64.const {pack(i_at, init.len)}))))",
        "    {on_open}))",
        "  {on_other})",
        ")",
    ].join("\n")
}

/** Where `guest_of`'s results are written: past its data, below `alloc`'s 65536. */
const SCRATCH: i64 = 40000;

/**
 * WebAssembly functions writing a result at `SCRATCH`: `$keep(p, l)` makes
 * `{state: <those bytes>, effects: []}` of a state's own CBOR, and
 * `$echo(p, l)` makes `{state: {event: <those bytes>}, effects: []}`.
 */
fun results(): string {
    // {state: … and its end, effects: []
    let keep_head: u8[] = [0xa2, 0x65, 115, 116, 97, 116, 101];
    // {state: {event: <bytes, a 4-byte length follows>
    let echo_head: u8[] = [
        0xa2,
        0x65,
        115,
        116,
        97,
        116,
        101,
        0xa1,
        0x65,
        101,
        118,
        101,
        110,
        116,
        0x5a,
    ];
    let tail: u8[] = [0x67, 101, 102, 102, 101, 99, 116, 115, 0x80];
    let k = SCRATCH;
    let e = SCRATCH + 16;
    let t = SCRATCH + 40;
    let out = SCRATCH + 64;
    [
        "(data (i32.const {k}) \"{wat_bytes(keep_head)}\")",
        "(data (i32.const {e}) \"{wat_bytes(echo_head)}\")",
        "(data (i32.const {t}) \"{wat_bytes(tail)}\")",
        "(func $keep (param $p i32) (param $l i32) (result i64)",
        "  (memory.copy (i32.const {out}) (i32.const {k}) (i32.const 7))",
        "  (memory.copy (i32.const {out + 7}) (local.get $p) (local.get $l))",
        "  (memory.copy (i32.add (i32.const {out + 7}) (local.get $l)) (i32.const {t}) (i32.const 9))",
        "  (i64.or (i64.const {out << 32}) (i64.extend_i32_u (i32.add (local.get $l) (i32.const 16)))))",
        "(func $echo (param $p i32) (param $l i32) (result i64)",
        "  (memory.copy (i32.const {out}) (i32.const {e}) (i32.const 15))",
        "  (i32.store8 (i32.const {out + 15}) (i32.shr_u (local.get $l) (i32.const 24)))",
        "  (i32.store8 (i32.const {out + 16}) (i32.shr_u (local.get $l) (i32.const 16)))",
        "  (i32.store8 (i32.const {out + 17}) (i32.shr_u (local.get $l) (i32.const 8)))",
        "  (i32.store8 (i32.const {out + 18}) (local.get $l))",
        "  (memory.copy (i32.const {out + 19}) (local.get $p) (local.get $l))",
        "  (memory.copy (i32.add (i32.const {out + 19}) (local.get $l)) (i32.const {t}) (i32.const 9))",
        "  (i64.or (i64.const {out << 32}) (i64.extend_i32_u (i32.add (local.get $l) (i32.const 28)))))",
    ].join("\n")
}

/**
 * A guest answering with fixed results: `on_init` gets `{state}`, `on_open`
 * keeps the state it was given, and any other event gets `result`; `view`
 * returns `tree`.
 */
fun fixed(state: Value, tree: u8[], result: u8[]): string = guest_of(
    result_of(state),
    None,
    Some(result),
    tree,
);

/** A box of children, top to bottom; `props` as given. */
fun boxed(props: (string, Value)[], kids: Value[]): Value = parent("box", props, kids);

/** A text node. */
fun words(s: string): Value = leaf("text", [("text", t(s))]);

/** A pressable box labelled `label`, sending `msg`. */
fun press(label: string, msg: string): Value = parent("box", [("on_press", t(msg))], [
    words(label),
]);

/** A tree: a box holding a text and a pressable "Add" sending "add". */
fun counter_tree(label: string): u8[] = encode(boxed([], [words(label), press("Add", "add")]));

/** A counter tree whose root carries `title`. */
fun titled_tree(label: string, title: string): u8[] = encode(
    boxed([("title", t(title))], [words(label), press("Add", "add")]),
);

/** A `handle` result holding `state` (a map of named fields), asking for nothing. */
fun result_of(state: Value): u8[] = encode(kv([("state", state), ("effects", Value.Array([]))]));

/** The event an echoing guest's state holds (`guest_of` with no `other`); empty when none. */
fun event_in(state: u8[]): u8[] = match decode(state, Limits {
    max_depth: 8,
    max_items: 64,
    max_bytes: 1024 * 1024,
    max_string: 1024 * 1024,
}) {
    Ok(v) => match v.get("event") {
        Some(Bytes(b)) => b,
        _ => [],
    },
    Err(_) => [],
};

/**
 * A guest whose every event but init and open becomes its state (as
 * `{event: <bytes>}`); it starts with an empty state and keeps it when
 * opened. Its `view` shows a counter tree.
 */
fun echo(): string = guest_of(result_of(kv([])), None, None, counter_tree("echo"));

/** `echo` whose `on_init` answers `init` (a whole result, which may ask for things). */
fun echo_init(init: u8[]): string = guest_of(init, None, None, counter_tree("echo"));

/** `echo` that asks for things every time it's opened (`opened`, a whole result). */
fun echo_opening(opened: u8[]): string = guest_of(
    result_of(kv([])),
    Some(opened),
    None,
    counter_tree("echo"),
);

/** A guest that starts and opens fine and traps on any other event; its view shows a counter tree. */
fun crashing(): string {
    let first = result_of(kv([]));
    let tree = counter_tree("x");
    [
        "(module (memory (export \"memory\") 1)",
        "(data (i32.const 1024) \"{wat_bytes(tree)}\")",
        "(data (i32.const 2048) \"{wat_bytes(first)}\")",
        "(func (export \"rapidkoi_version\") (result i32) (i32.const 8))",
        "(func (export \"alloc\") (param i32) (result i32) (i32.const 8192))",
        "(func (export \"view\") (param i32 i32) (result i64) (i64.const {pack(1024, tree.len)}))",
        "(func (export \"handle\") (param i32 i32 i32) (param $el i32) (result i64)",
        // `on_init` and `on_open` are the 15-byte events.
        "  (if (i32.eq (local.get $el) (i32.const 15)) (then (return (i64.const {pack(2048, first.len)}))))",
        "  unreachable))",
    ].join("\n")
}

/**
 * A guest for links (PRP-036): `on_init` gets `init` (a whole result),
 * `on_open` keeps its state, and any other event gets `result`; `view`
 * shows a counter tree.
 */
fun linking(init: u8[], result: u8[]): string = guest_of(
    init,
    None,
    Some(result),
    counter_tree("link"),
);

/**
 * The start of a PNG declaring `w` × `h` pixels: its signature and IHDR
 * chunk header, which is all Rapidkoi reads (GTK decodes the rest).
 */
fun png(w: i64, h: i64): u8[] {
    let mut b: u8[] = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 13, 73, 72, 68, 82];
    for v of [w, h] {
        b.push((v >> 24 & 255) as u8);
        b.push((v >> 16 & 255) as u8);
        b.push((v >> 8 & 255) as u8);
        b.push((v & 255) as u8);
    }
    // Bit depth 8, colour type 6 (RGBA), compression, filter, interlace.
    for x of [8, 6, 0, 0, 0] {
        b.push(x as u8);
    }
    b
}

/**
 * A guest standing in for a real app (PRP-042): its state is
 * `{count: n}`, its view `Count: n` and an `Add` button, and each message
 * adds one. `on_init` starts at 0; every other event keeps the count. Good
 * to 9: one CBOR byte, one digit.
 */
fun counting(): string {
    let result = encode(
        kv([("state", kv([("count", Value.int(0))])), ("effects", Value.Array([]))]),
    );
    // The count is the state's last byte, before `effects: []` (9 bytes).
    let n_at = result.len - 10;
    let tree = encode(boxed([], [words("Count: 0"), press("Add", "add")]));
    let digit_at = after(tree, "Count: ".to_bytes());
    [
        "(module (memory (export \"memory\") 2)",
        "(global $next (mut i32) (i32.const 65536))",
        "(data (i32.const 1024) \"{wat_bytes(result)}\")",
        "(data (i32.const 2048) \"{wat_bytes(tree)}\")",
        "(func (export \"rapidkoi_version\") (result i32) (i32.const 8))",
        "(func (export \"alloc\") (param $n i32) (result i32) (local $p i32)",
        "  (local.set $p (global.get $next))",
        "  (global.set $next (i32.add (global.get $next) (local.get $n)))",
        "  (local.get $p))",
        // `{count: n}` ends with n; an empty state (before init) counts 0.
        "(func $count (param $sp i32) (param $sl i32) (result i32)",
        "  (if (result i32) (i32.eqz (local.get $sl)) (then (i32.const 0))",
        "    (else (i32.load8_u (i32.sub (i32.add (local.get $sp) (local.get $sl)) (i32.const 1))))))",
        "(func (export \"view\") (param $sp i32) (param $sl i32) (result i64)",
        "  (global.set $next (i32.const 65536))",
        "  (i32.store8 (i32.const {2048 + digit_at}) (i32.add (i32.const 48) (call $count (local.get $sp) (local.get $sl))))",
        "  (i64.const {pack(2048, tree.len)}))",
        "(func (export \"handle\") (param $sp i32) (param $sl i32) (param $ep i32) (param $el i32) (result i64) (local $n i32) (local $kind i32)",
        "  (global.set $next (i32.const 65536))",
        // `{event: "on_…"}`: the 12th byte is the letter after `on_`.
        "  (local.set $kind (i32.load8_u (i32.add (local.get $ep) (i32.const 11))))",
        "  (local.set $n (call $count (local.get $sp) (local.get $sl)))",
        "  (if (i32.eq (local.get $kind) (i32.const 105)) (then (local.set $n (i32.const 0))))",
        "  (if (i32.eq (local.get $kind) (i32.const 109)) (then (local.set $n (i32.add (local.get $n) (i32.const 1)))))",
        "  (i32.store8 (i32.const {1024 + n_at}) (local.get $n))",
        "  (i64.const {pack(1024, result.len)}))",
        ")",
    ].join("\n")
}

/** Writes `counting()` to `path` as WebAssembly bytes, for what reads a module from disk. */
fun write_counting(path: string) {
    write_bytes(
        path,
        wat_to_wasm(counting()).expect("the counting fixture is valid text"),
    ).unwrap();
}

/** Where `needle` ends in `hay`: the index just after its first match. */
fun after(hay: u8[], needle: u8[]): i64 {
    for i in 0..hay.len - needle.len + 1 {
        let mut same = true;
        for j in 0..needle.len {
            if hay[i + j] != needle[j] {
                same = false;
                break;
            }
        }
        if same {
            return i + needle.len;
        }
    }
    panic("the fixture's tree holds its own text")
}

/** What the notice bar says on hover now (PRP-051): the full message of the notice showing. */
fun said(m: Model): Option<string> = shown(m).map(fun(n: Notice) = n.full);
