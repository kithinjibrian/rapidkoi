// Rapidkoi's new-tab app, packed (PRP-027): the committed bundle is an
// unsigned format-1 bundle named "New tab". Skipped until scripts/newtab.sh
// has written it, so the suite never needs Rust.
import rapidkoi.bundles.bundle { read };
import std.fs;

const NEWTAB: string = "assets/apps/newtab.rkb";

@test
fun the_new_tab_bundle_is_unsigned_and_named() {
    if !fs.is_file(NEWTAB) {
        skip("run scripts/newtab.sh first");
    }
    // Format 1 is the unsigned format: read refuses a signed bundle.
    let b = read(read_bytes(NEWTAB).unwrap()).unwrap();
    assert_eq((b.manifest.name, b.manifest.version, b.manifest.contract), ("New tab", "0.1.0", 2));
}
