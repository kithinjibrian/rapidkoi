// {FIRST_NAME} and {LAST_NAME} (PRP-011), pure: filled in display text
// only, never in typing boxes; anything else in braces stays as it is.
import rapidkoi.guest.placeholders { fill };
import rapidkoi.guest.nodes { Node, Typing };
import rapidkoi.guest.styles { plain };
import rapidkoi.guest.roles { no_facts };
import cbor { Value };

fun body(s: string): Node = Node.Words(s, plain(), no_facts());

fun boxed(kids: Node[], press: Option<Value>): Node = Node.Boxed(plain(), no_facts(), press, kids);

@test
fun names_fill_texts_however_deep() {
    let tree = boxed(
        [
            body("Hello, {{FIRST_NAME}} {{LAST_NAME}}!"),
            boxed([body("Hi {{FIRST_NAME}}")], Some(Value.Text("hi"))),
        ],
        None,
    );
    assert_eq(
        fill(tree, "Brian", "Kithinji"),
        boxed(
            [body("Hello, Brian Kithinji!"), boxed([body("Hi Brian")], Some(Value.Text("hi")))],
            None,
        ),
    );
}

@test
fun an_empty_name_fills_nothing_and_other_braces_stay() {
    assert_eq(fill(body("Hello, {{FIRST_NAME}}!"), "", ""), body("Hello, !"));
    assert_eq(
        fill(body("{{NAME}} {{first_name}} {{{{FIRST_NAME}}}}"), "B", ""),
        body("{{NAME}} {{first_name}} {{B}}"),
    );
}

@test
fun typing_boxes_are_never_filled() {
    let field = Node.Field(
        Typing {
            value: "{{FIRST_NAME}}",
            placeholder: "{{LAST_NAME}}",
            label: None,
            lines: 1,
            on_change: Some(Value.Text("typed")),
            on_submit: None,
        },
        plain(),
    );
    assert_eq(fill(field, "Brian", "K"), field);
}

@test
fun a_name_that_looks_like_a_placeholder_isn_t_filled_again() {
    assert_eq(fill(body("{{FIRST_NAME}}"), "{{LAST_NAME}}", "x"), body("{{LAST_NAME}}"));
}
