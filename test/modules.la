// Compiled modules kept for the run (PRP-068, DECISION-096): the same bytes
// compile once; other bytes compile again; past the cap, the one used
// longest ago goes. Keyed by the bytes' hash, so changed code never runs
// from an older compile. No display.
import rapidkoi.guest.modules { no_modules, compiled, holds, MAX_MODULES };
import wasmtime { Engine, wat_to_wasm };
import support { echo };

/** A stand-in module whose bytes differ by `n`: an exported global's value. */
fun numbered(n: i64): u8[] = wat_to_wasm(
    "(module (global (export \"n\") i32 (i32.const {n})) (memory (export \"memory\") 1))",
).unwrap();

@test
fun the_same_bytes_compile_once() {
    let engine = Engine.new();
    let bytes = wat_to_wasm(echo()).unwrap();
    let (once, _) = compiled(no_modules(), engine, bytes, 1).unwrap();
    assert_eq(once.items.len, 1);
    // Again: from the cache, nothing added; its last use moves.
    let (twice, _) = compiled(once, engine, bytes, 2).unwrap();
    assert_eq(twice.items.len, 1);
    assert_eq(twice.items[0].2, 2);
    // Other bytes: compiled and kept too.
    let (other, _) = compiled(twice, engine, numbered(7), 3).unwrap();
    assert_eq(other.items.len, 2);
}

@test
fun past_the_cap_the_one_used_longest_ago_goes() {
    let engine = Engine.new();
    let mut m = no_modules();
    for i in 0..MAX_MODULES {
        m = compiled(m, engine, numbered(i), i).unwrap().0;
    }
    // The first used again: now the second is the oldest.
    m = compiled(m, engine, numbered(0), 100).unwrap().0;
    m = compiled(m, engine, numbered(999), 101).unwrap().0;
    assert_eq(m.items.len, MAX_MODULES);
    assert_eq((holds(m, numbered(0)), holds(m, numbered(999))), (true, true));
    assert_eq(holds(m, numbered(1)), false);
}

@test
fun bad_bytes_are_an_error_and_nothing_is_kept() {
    let r = compiled(no_modules(), Engine.new(), [0, 1, 2, 3], 1);
    assert(r.is_err());
    assert_eq(holds(no_modules(), [0, 1, 2, 3]), false);
}
