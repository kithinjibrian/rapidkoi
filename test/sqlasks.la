// Storage asks (PRP-041), pure: `sql` and `sql_batch` read from
// a `handle` result and held to their bounds. No guest, no database.
import rapidkoi.guest.contract { read_update };
import rapidkoi.guest.nodes { Effect, Query };
import rapidkoi.guest.limits { MAX_SQL, MAX_SQL_PARAMS, MAX_ROWS, MAX_STEPS };
import cbor { Value, encode };
import support { t, kv };

fun asking(effect: Value): Result<Effect[], string> {
    let result = encode(kv([("state", kv([])), ("effects", Value.Array([effect]))]));
    match read_update(result) {
        Ok(u) => Ok(u.effects),
        Err(Invalid(_, why)) => Err(why),
        Err(_) => Err("another error"),
    }
}

fun sql(text: string, params: Value[]): Value = kv([
    ("kind", t("sql")),
    ("msg", t("tasks")),
    ("sql", t(text)),
    ("params", Value.Array(params)),
]);

/** `s`, `n` times. Built as bytes and turned into a string once: adding to a string copies it every time. */
fun repeat(s: string, n: i64): string {
    let unit = s.to_bytes();
    let mut out: u8[] = [];
    for _ in 0..n {
        for b of unit {
            out.push(b);
        }
    }
    string_from_utf8(out).expect("copies of a string are valid UTF-8")
}

@test
fun a_query_reads_with_its_parameters() {
    let got = asking(
        sql("SELECT * FROM t WHERE id = ? AND done = ?", [Value.int(2), Value.Bool(false)]),
    ).unwrap();
    match got[0] {
        Sql(msg, q) => {
            assert_eq(
                (msg == t("tasks"), q.sql, q.max_rows),
                (true, "SELECT * FROM t WHERE id = ? AND done = ?", MAX_ROWS),
            );
            assert_eq(q.params == [Value.int(2), Value.Bool(false)], true);
        }
        _ => panic("expected a query"),
    }
    // max_rows is capped.
    let capped = kv([
        ("kind", t("sql")),
        ("msg", t("m")),
        ("sql", t("SELECT 1")),
        ("params", Value.Array([])),
        ("max_rows", Value.int(99999)),
    ]);
    match asking(capped).unwrap()[0] {
        Sql(_, q) => assert_eq(q.max_rows, MAX_ROWS),
        _ => panic("expected a query"),
    }
}

@test
fun a_batch_reads_its_steps() {
    let step = fun(s: string) = kv([("sql", t(s)), ("params", Value.Array([t("x")]))]);
    let batch = kv([
        ("kind", t("sql_batch")),
        ("msg", t("saved")),
        (
            "steps",
            Value.Array([step("INSERT INTO t VALUES (?)"), step("DELETE FROM t WHERE x = ?")]),
        ),
    ]);
    match asking(batch).unwrap()[0] {
        SqlBatch(msg, steps) => assert_eq(
            (msg == t("saved"), steps.len, match steps[1] {
                Statement(s) => s.sql,
                _ => "",
            }),
            (true, 2, "DELETE FROM t WHERE x = ?"),
        ),
        _ => panic("expected a batch"),
    }
}

@test
fun bad_shapes_say_why() {
    assert_eq(asking(sql(repeat("x", MAX_SQL + 1), [])), Err("an sql's text is over 100 KB"));
    let mut many: Value[] = [];
    for i in 0..MAX_SQL_PARAMS + 1 {
        many.push(Value.int(i));
    }
    assert_eq(asking(sql("SELECT 1", many)), Err("an sql takes at most 999 values"));
    assert_eq(
        asking(sql("SELECT ?", [Value.Array([])])),
        Err("an sql's values are numbers, text, bytes, true/false or null"),
    );
    assert_eq(
        asking(kv([("kind", t("sql")), ("msg", t("m")), ("params", Value.Array([]))])),
        Err("an sql needs its text"),
    );
    let mut steps: Value[] = [];
    for _ in 0..MAX_STEPS + 1 {
        steps.push(kv([("sql", t("SELECT 1")), ("params", Value.Array([]))]));
    }
    let big = kv([("kind", t("sql_batch")), ("msg", t("m")), ("steps", Value.Array(steps))]);
    assert_eq(asking(big), Err("an sql_batch takes at most 100 steps"));
}
