// Rapidkoi's theme (PRP-017): which colour goes where, and every style
// building without kivuli refusing a value. No display.
import rapidkoi.ui.themes {
    ButtonPaint,
    button_paint,
    bare,
    group,
    page,
    address,
    field,
    suggestions,
    clear,
    body,
    dim,
    title,
    heading,
    button,
    instance_colour,
    publisher_colour,
    colour_among,
};
import rapidkoi.ui.schemes { DARK, LIGHT };
import rapidkoi.ui.shield { look_colour, ShieldLook };
import rapidkoi.ui.frame_looks {
    frame,
    header,
    sidebar,
    window_controls,
    app_button,
    app_current,
    tab_close,
    tooltips,
};
import rapidkoi.guest.nodes { ButtonLook };

@test
fun primary_buttons_are_the_accent() {
    assert_eq(button_paint(DARK, ButtonLook.Primary), ButtonPaint {
        background: DARK.accent,
        hover: DARK.accent_hover,
        press: DARK.accent_hover,
        text: DARK.on_accent,
    });
}

@test
fun danger_buttons_are_the_danger_colour() {
    let p = button_paint(DARK, ButtonLook.Danger);
    assert_eq(p.background, DARK.danger);
    assert_eq(p.text, DARK.on_danger);
}

@test
fun normal_and_subtle_buttons_differ_at_rest_and_share_the_text_colour() {
    let normal = button_paint(DARK, ButtonLook.Normal);
    let subtle = button_paint(DARK, ButtonLook.Subtle);
    assert_eq(normal.background, DARK.control);
    assert_eq(normal.hover, DARK.control_hover);
    assert_eq(normal.press, DARK.control_press);
    assert_eq(subtle.background, DARK.clear);
    assert_eq(subtle.hover, DARK.subtle_hover);
    assert_eq(normal.text, DARK.text);
    assert_eq(subtle.text, DARK.text);
}

@test
fun every_style_builds() {
    // kivuli stops on a bad colour when it's read: building each style once
    // here turns a typo in the theme into a failed test, not a closed window.
    let all = [
        frame(DARK),
        header(DARK),
        sidebar(DARK),
        window_controls(DARK),
        app_button(DARK),
        app_current(DARK),
        tab_close(DARK),
        tooltips(DARK),
        bare(DARK),
        group(DARK),
        page(DARK),
        address(DARK),
        field(DARK),
        suggestions(DARK),
        clear(DARK),
        body(DARK),
        dim(DARK),
        title(DARK),
        heading(DARK),
        button(DARK, ButtonLook.Normal),
        button(DARK, ButtonLook.Primary),
        button(DARK, ButtonLook.Danger),
        button(DARK, ButtonLook.Subtle),
    ];
    for styles of all {
        assert(styles.len > 0);
    }
}

@test
fun the_frame_is_flat_grey_with_white_icons() {
    // The owner went back to the flat frame (session 118); the brand pair
    // stays in the theme.
    assert_eq(DARK.frame, "#242424");
    assert_eq((DARK.accent, DARK.accent_end), ("#ff7700", "#ff2e63"));
    assert_eq(DARK.on_frame, "#ffffff");
}

@test
fun each_instance_keeps_its_colour() {
    // PRP-033: by its stable key, so a renamed instance keeps its colour.
    let c = DARK.instances;
    assert_eq(instance_colour(DARK, ""), c[0]);
    assert_eq(instance_colour(DARK, "2"), c[1]);
    assert_eq(instance_colour(DARK, "{c.len + 1}"), c[0]);
    assert_eq(instance_colour(DARK, "x"), c[0]);
}

@test
fun each_app_at_an_address_has_a_colour_from_its_key() {
    // PRP-050: the same key, the same colour, in each scheme's palette.
    for t of [DARK, LIGHT] {
        let a = publisher_colour(t, [1; 32]);
        assert_eq(publisher_colour(t, [1; 32]), a);
        assert(t.publishers.any(fun(c: string) = c == a));
        assert(publisher_colour(t, [2; 32]) != a);
        // Never the danger colour, the brand's or caution's.
        assert(
            !t.publishers.any(fun(c: string) = c == t.danger || c == t.accent || c == t.caution),
        );
    }
}

@test
fun caution_is_its_own_colour_not_the_brands() {
    for t of [DARK, LIGHT] {
        assert(t.caution != t.accent && t.caution != t.danger);
        assert_eq(look_colour(t, ShieldLook.Caution), t.caution);
    }
}

@test
fun apps_at_one_address_never_share_a_colour() {
    // PRP-050: keys whose own colours collide (first bytes 1 and 6, five
    // colours) take the next free one, in the order the apps were met.
    let alice: u8[] = [1; 32];
    let bob: u8[] = [6; 32];
    let both = [alice, bob];
    assert_eq(colour_among(DARK, both, alice), publisher_colour(DARK, alice));
    assert(colour_among(DARK, both, bob) != colour_among(DARK, both, alice));
    // An app not met yet (being named) takes the next free one too.
    assert(colour_among(DARK, [alice], bob) != colour_among(DARK, [alice], alice));
    // With no clash, an app keeps its own.
    assert_eq(colour_among(DARK, [alice, [2; 32]], [2; 32]), publisher_colour(DARK, [2; 32]));
}
