// Addresses, pure: local development addresses and remote HTTPS hosts,
// what each one fetches, and the plain reason when one can't open.
import rapidkoi.net.address {
    Address,
    AddressError,
    parse,
    without_link,
    url,
    site_url,
    shown,
    is_address,
    reason,
    link_of,
};

fun ok(text: string): Address = parse(text).unwrap();

fun why(text: string): string = match parse(text) {
    Err(e) => reason(e),
    Ok(_) => "ok",
};

@test
fun local_rapidkoi_addresses() {
    let a = ok("rapidkoi://localhost:8000");
    assert_eq((a.host, a.port, a.route, a.http), ("localhost", 8000, "/", false));
    assert_eq(ok("rapidkoi://localhost:8000/folder/42").route, "/folder/42");
    assert_eq(ok("rapidkoi://127.0.0.1:4000").host, "127.0.0.1");
    assert_eq(ok("rapidkoi://[::1]:4000").host, "[::1]");
}

@test
fun local_http_addresses() {
    let a = ok("http://localhost:8000/apps/counter.rkb");
    assert_eq((a.host, a.port, a.route, a.http), ("localhost", 8000, "/apps/counter.rkb", true));
}

@test
fun what_each_one_fetches() {
    assert_eq(
        url(ok("rapidkoi://localhost:8000/folder/42")),
        "http://localhost:8000/.well-known/rapidkoi/app.rkb",
    );
    assert_eq(url(ok("http://127.0.0.1:9000/x.rkb")), "http://127.0.0.1:9000/x.rkb");
    // An http:// link names no bundle: it's the site's own address (PRP-036).
    assert_eq(
        url(ok("http://localhost:8000/@0.3.0?count=3")),
        "http://localhost:8000/.well-known/rapidkoi/app.rkb",
    );
    assert_eq(shown(ok("rapidkoi://localhost:8000/a")), "localhost:8000");
}

@test
fun remote_hosts_open_over_https() {
    let a = ok("rapidkoi://counter.dafifi.net");
    assert_eq(
        (a.host, a.port, a.remote, a.secure, a.http),
        ("counter.dafifi.net", 443, true, true, false),
    );
    assert_eq(shown(a), "counter.dafifi.net");
    assert_eq(
        site_url(a, "/.well-known/rapidkoi/key"),
        "https://counter.dafifi.net/.well-known/rapidkoi/key",
    );
    // https:// opens the same app; a port other than 443 is kept.
    assert_eq(shown(ok("https://counter.dafifi.net")), "counter.dafifi.net");
    let b = ok("rapidkoi://notes.acme.com:8443/a/b");
    assert_eq((shown(b), b.route), ("notes.acme.com:8443", "/a/b"));
    assert_eq(site_url(b, "/x"), "https://notes.acme.com:8443/x");
}

@test
fun local_addresses_are_unchanged_and_https_is_allowed_locally() {
    let a = ok("rapidkoi://localhost:8000");
    assert_eq((a.remote, a.secure), (false, false));
    assert_eq(site_url(a, "/x"), "http://localhost:8000/x");
    let t = ok("https://localhost:8443");
    assert_eq((t.remote, t.secure, t.http, shown(t)), (false, true, false, "localhost:8443"));
    assert_eq(site_url(t, "/x"), "https://localhost:8443/x");
}

@test
fun remote_hosts_refuse_plain_http_and_ip_addresses() {
    assert_eq(
        why("http://counter.dafifi.net/a.rkb"),
        "Remote apps open over HTTPS only: rapidkoi://counter.dafifi.net",
    );
    assert_eq(why("rapidkoi://174.138.43.152"), "Open apps by their host name, not an IP address");
    assert_eq(why("https://192.168.1.4:8000"), "Open apps by their host name, not an IP address");
    assert_eq(why("rapidkoi://[2001:db8::1]"), "Open apps by their host name, not an IP address");
    assert_eq(why("rapidkoi://Notes.Acme.com"), "This address has no host");
    assert_eq(why("rapidkoi://intranet"), "This address has no host");
}

@test
fun malformed_addresses() {
    assert_eq(
        why("rapidkoi://localhost"),
        "This address needs a port, like rapidkoi://localhost:8000",
    );
    assert_eq(why("rapidkoi://localhost:0"), "The port must be a number from 1 to 65535");
    assert_eq(why("rapidkoi://localhost:70000"), "The port must be a number from 1 to 65535");
    assert_eq(why("rapidkoi://localhost:80a"), "The port must be a number from 1 to 65535");
    assert_eq(why("rapidkoi://"), "This address has no host");
    assert_eq(why("rapidkoi://[::1"), "This address has no host");
}

@test
fun what_counts_as_an_address() {
    assert_eq(is_address("rapidkoi://x"), true);
    assert_eq(is_address("http://x"), true);
    assert_eq(is_address("https://x"), true);
    assert_eq(is_address("counter.rkb"), false);
    assert_eq(is_address("my notes"), false);
}

@test
fun a_link_carries_a_version_and_fields() {
    // PRP-036: https://host/@version?fields, a real web address.
    let a = ok("https://counter.dafifi.net/@0.3.0?count=3&filter=work%20items");
    assert_eq(
        (a.host, a.version, a.fields),
        ("counter.dafifi.net", Some("0.3.0"), [("count", "3"), ("filter", "work items")]),
    );
    // The route is what's left: the bundle's own URL is unchanged.
    assert_eq(ok("http://localhost:8000/@1.0.0?count=3").route, "/");
    assert_eq(ok("http://localhost:8000/@1.0.0?count=3").version, Some("1.0.0"));
    // rapidkoi:// has the same shape: the hand-off from a browser.
    assert_eq(ok("rapidkoi://counter.dafifi.net/@0.3.0?count=3").fields, [("count", "3")]);
    // No version, no fields: as today.
    let plain = ok("https://counter.dafifi.net");
    assert_eq((plain.version, plain.fields.len), (None, 0));
}

@test
fun a_bad_link_says_why() {
    assert_eq(
        why("https://counter.dafifi.net/@0.3?count=3"),
        "A link's version must be like 1.4.0",
    );
    assert_eq(
        why("https://counter.dafifi.net/?Count=3"),
        "A link's field names are lowercase letters, digits and _",
    );
    assert_eq(why("https://counter.dafifi.net/?count=3&count=4"), "A link names count twice");
    let mut many = "https://counter.dafifi.net/?";
    for i in 0..17 {
        many = many + "f{i}=1&";
    }
    assert_eq(why(many), "A link has at most 16 fields");
    // host@version is a web login, not a version: refused as a host.
    assert_eq(why("https://counter.dafifi.net@0.3.0/"), "This address has no host");
}

@test
fun a_link_is_written_back_the_same_way() {
    let a = ok("https://counter.dafifi.net");
    assert_eq(
        link_of(a, Some("0.3.0"), [("count", "3")]),
        "https://counter.dafifi.net/@0.3.0?count=3",
    );
    assert_eq(link_of(a, Some("0.3.0"), []), "https://counter.dafifi.net/@0.3.0");
    assert_eq(link_of(a, None, [("q", "a b&c")]), "https://counter.dafifi.net/?q=a%20b%26c");
    let local = ok("rapidkoi://localhost:8000");
    assert_eq(
        link_of(local, Some("1.0.0"), [("count", "3")]),
        "rapidkoi://localhost:8000/@1.0.0?count=3",
    );
    // A development server's bundle keeps its own path, after the version.
    assert_eq(
        link_of(ok("http://localhost:8000/counter.rkb"), Some("1.0.0"), [("count", "3")]),
        "http://localhost:8000/@1.0.0/counter.rkb?count=3",
    );
}

@test
fun a_window_is_kept_under_its_address_without_the_link() {
    assert_eq(
        without_link("https://counter.dafifi.net/@0.3.0?count=3"),
        "https://counter.dafifi.net",
    );
    assert_eq(without_link("rapidkoi://localhost:8000?count=3"), "rapidkoi://localhost:8000");
    assert_eq(
        without_link("http://localhost:8000/@1.0.0/counter.rkb?count=3"),
        "http://localhost:8000/counter.rkb",
    );
    assert_eq(without_link("rapidkoi://localhost:8000"), "rapidkoi://localhost:8000");
}
