// Opening signed apps from their kept copies (PRP-043), through the window
// with no display: sites published into test/tmp/ and served on local
// sockets, one port per test; a port nothing serves stands in for offline.
import rapidkoi.window.window { Model };
import rapidkoi.ui.layout { view };
import rapidkoi.window.actions { Msg };
import rapidkoi.window.tabs { AppPage, Cached };
import rapidkoi.data.kept { old_for, keep };
import rapidkoi.commands.publish { withdraw_version };
import kivuli.testing { click };
import std.fs;
import support { write_counting };
import sites {
    clean,
    folder,
    started,
    step,
    shows,
    page,
    version,
    site,
    republish,
    served,
    kept_by_hand,
    kept_count,
    done,
};

fun reached(m: Model): Option<bool> = page(m).cached.map(fun(c: Cached) = c.reached);

@test
fun offline_a_kept_app_opens_and_says_it_wasnt_checked() {
    let s = folder("offline");
    let dir = site(18811, "1.0.0");
    kept_by_hand(s, dir, 18811);
    // Nothing serves 18811.
    let m = started(s, ["./main", "rapidkoi://localhost:18811"]);
    assert(shows(m, "Count: 0"));
    assert_eq(reached(m), Some(false));
    done(s, dir);
}

@test
fun the_first_open_keeps_it_and_the_next_opens_from_it() {
    let s = folder("first");
    let dir = site(18812, "1.0.0");
    served(dir, 18812);
    let first = started(s, ["./main", "rapidkoi://localhost:18812"]);
    assert((shows(first, "Count: 0"), kept_count(s) == 1) == (true, true));
    let again = started(s, ["./main", "rapidkoi://localhost:18812"]);
    assert(shows(again, "Count: 0"));
    // Opened from the copy, then checked against the live site.
    assert_eq(reached(again), Some(true));
    done(s, dir);
}

@test
fun a_newer_version_is_used_from_the_next_open_silently() {
    let s = folder("newer");
    let dir = site(18813, "1.0.0");
    served(dir, 18813);
    started(s, ["./main", "rapidkoi://localhost:18813"]);
    republish(dir, 18813, "2.0.0");
    // This open runs the kept 1.0.0; its check keeps 2.0.0 for next time.
    let second = started(s, ["./main", "rapidkoi://localhost:18813"]);
    assert_eq((version(second), second.notice), ("1.0.0", None));
    // A routine update changes nothing for the person: no notice.
    let third = started(s, ["./main", "rapidkoi://localhost:18813"]);
    assert_eq((version(third), third.notice), ("2.0.0", None));
    done(s, dir);
}

@test
fun a_withdrawn_running_version_stops_its_window_and_reload_opens_the_newest() {
    let s = folder("withdrawn");
    let dir = site(18814, "1.0.0");
    served(dir, 18814);
    started(s, ["./main", "rapidkoi://localhost:18814"]);
    republish(dir, 18814, "2.0.0");
    withdraw_version(dir, "1.0.0", "it lost data").unwrap();
    let m = started(s, ["./main", "rapidkoi://localhost:18814"]);
    assert(!shows(m, "Count: 0"));
    assert(shows(m, "Counting 1.0.0 was withdrawn: it lost data"));
    let reloaded = step(m, Msg.Reload);
    assert((shows(reloaded, "Count: 0"), version(reloaded)) == (true, "2.0.0"));
    done(s, dir);
}

@test
fun with_every_version_withdrawn_the_copy_goes() {
    let s = folder("gone");
    let dir = site(18815, "1.0.0");
    served(dir, 18815);
    started(s, ["./main", "rapidkoi://localhost:18815"]);
    withdraw_version(dir, "1.0.0", "it lost data").unwrap();
    let m = started(s, ["./main", "rapidkoi://localhost:18815"]);
    assert(shows(m, "Counting 1.0.0 was withdrawn: it lost data"));
    assert_eq(kept_count(s), 0);
    done(s, dir);
}

@test
fun reload_goes_to_the_site_first() {
    let s = folder("reload");
    let dir = site(18816, "1.0.0");
    served(dir, 18816);
    let m = started(s, ["./main", "rapidkoi://localhost:18816"]);
    republish(dir, 18816, "2.0.0");
    assert_eq(version(step(m, Msg.Reload)), "2.0.0");
    done(s, dir);
}

@test
fun a_link_to_another_version_runs_it_without_keeping_it() {
    let s = folder("link");
    let dir = site(18817, "1.0.0");
    republish(dir, 18817, "2.0.0");
    served(dir, 18817);
    started(s, ["./main", "rapidkoi://localhost:18817"]);
    let m = started(s, ["./main", "rapidkoi://localhost:18817/@1.0.0"]);
    assert_eq(version(m), "1.0.0");
    // The copy is still the current version.
    assert_eq(version(started(s, ["./main", "rapidkoi://localhost:18817"])), "2.0.0");
    done(s, dir);
}

@test
fun offline_a_link_to_another_version_opens_the_kept_one_with_a_notice() {
    let s = folder("link-offline");
    // The site lists 0.9.0 and 1.0.0; only 1.0.0, the current one, is kept.
    let dir = site(18818, "0.9.0");
    let builds = "{dir}/site/.well-known/rapidkoi/builds";
    let before = fs.list_dir(builds).unwrap();
    republish(dir, 18818, "1.0.0");
    let current = fs.list_dir(builds).unwrap().filter(
        fun(n: string) = !before.any(fun(b: string) = b == n),
    );
    let root = "{dir}/site/.well-known/rapidkoi";
    keep(
        old_for(s, "localhost:18818"),
        read_bytes("{root}/key").unwrap(),
        read_bytes("{root}/index").unwrap(),
        read_bytes("{builds}/{current[0]}").unwrap(),
    ).unwrap();
    let m = started(s, ["./main", "rapidkoi://localhost:18818/@0.9.0"]);
    assert_eq(version(m), "1.0.0");
    assert_eq(m.notice, Some("0.9.0 isn't available offline; opened 1.0.0"));
    done(s, dir);
}

@test
fun unsigned_apps_and_files_are_never_kept() {
    let s = folder("unsigned");
    write_counting("test/tmp/keeping-file.wasm");
    let m = started(s, ["./main", "test/tmp/keeping-file.wasm"]);
    assert(shows(m, "Count: 0"));
    assert(!fs.exists("{s.dir}/kept"));
    fs.remove_file("test/tmp/keeping-file.wasm").unwrap();
    clean(s.dir);
}

@test
fun forget_removes_the_kept_copy() {
    let s = folder("forget");
    let dir = site(18819, "1.0.0");
    kept_by_hand(s, dir, 18819);
    let m = started(s, ["./main", "rapidkoi://localhost:18819"]);
    step(m, Msg.Forget);
    assert_eq(kept_count(s), 0);
    done(s, dir);
}

@test
fun restore_opens_from_the_kept_copy() {
    let s = folder("restore");
    let dir = site(18820, "1.0.0");
    kept_by_hand(s, dir, 18820);
    let m = started(s, ["./main", "rapidkoi://localhost:18820"]);
    step(m, click(view(m), "Add").unwrap());
    let restored = step(started(s, ["./main"]), Msg.RestoreSession);
    assert(shows(restored, "Count: 1"));
    done(s, dir);
}

@test
fun the_data_page_counts_the_kept_app() {
    let s = folder("size");
    let dir = site(18821, "1.0.0");
    kept_by_hand(s, dir, 18821);
    let m = started(s, ["./main", "rapidkoi://localhost:18821"]);
    assert(page(m).cached.map(fun(c: Cached) = c.size).unwrap_or(0) > 0);
    done(s, dir);
}

/** The upgrade button's tooltip, which also finds it (PRP-044). */
const UPGRADE: string = "A new version of this app is available: upgrade";

fun offers(m: Model): bool = click(view(m), UPGRADE).is_ok();

fun newer(m: Model): Option<string> = page(m).cached.and_then(fun(c: Cached) = c.newer);

@test
fun a_kept_newer_version_offers_the_upgrade_which_carries_the_state() {
    let s = folder("upgrade");
    let dir = site(18822, "1.0.0");
    served(dir, 18822);
    let first = started(s, ["./main", "rapidkoi://localhost:18822"]);
    assert(!offers(first));
    republish(dir, 18822, "2.0.0");
    // Opened from the kept 1.0.0; its check keeps 2.0.0 and offers it.
    let ready = started(s, ["./main", "rapidkoi://localhost:18822"]);
    assert_eq((version(ready), newer(ready)), ("1.0.0", Some("2.0.0")));
    assert_eq(click(view(ready), UPGRADE), Ok(Msg.Reload));
    let counted = step(ready, click(view(ready), "Add").unwrap());
    let upgraded = step(counted, Msg.Reload);
    assert_eq(version(upgraded), "2.0.0");
    assert(shows(upgraded, "Count: 1"));
    assert(!offers(upgraded));
    done(s, dir);
}

@test
fun up_to_date_or_offline_offers_nothing() {
    let s = folder("no-upgrade");
    let dir = site(18823, "1.0.0");
    served(dir, 18823);
    started(s, ["./main", "rapidkoi://localhost:18823"]);
    // From the copy, checked, and still current.
    assert(!offers(started(s, ["./main", "rapidkoi://localhost:18823"])));
    done(s, dir);
    let t = folder("no-upgrade-offline");
    let away = site(18824, "1.0.0");
    kept_by_hand(t, away, 18824);
    assert(!offers(started(t, ["./main", "rapidkoi://localhost:18824"])));
    done(t, away);
}

@test
fun every_window_of_the_app_on_the_old_version_offers_it() {
    let s = folder("upgrade-both");
    let dir = site(18825, "1.0.0");
    served(dir, 18825);
    started(s, ["./main", "rapidkoi://localhost:18825"]);
    let opened = started(s, ["./main", "rapidkoi://localhost:18825"]);
    // A second window, then 2.0.0 published, then a check from the first.
    let two = step(opened, Msg.NewInstance);
    republish(dir, 18825, "2.0.0");
    let checked = step(two, Msg.CheckForUpdates(0));
    let offered = checked.tabs.filter(
        fun(t) = t.page.cached.and_then(fun(c: Cached) = c.newer) == Some("2.0.0"),
    );
    assert_eq(offered.len, 2);
    done(s, dir);
}

@test
fun an_open_app_is_checked_while_it_stays_open() {
    let s = folder("periodic");
    let dir = site(18826, "1.0.0");
    served(dir, 18826);
    // Opened from the site: nothing to check yet.
    let m = started(s, ["./main", "rapidkoi://localhost:18826"]);
    republish(dir, 18826, "2.0.0");
    let checked = step(m, Msg.CheckForUpdates(0));
    assert_eq(newer(checked), Some("2.0.0"));
    assert(offers(checked));
    done(s, dir);
}

@test
fun an_open_app_is_checked_when_the_window_comes_back_to_the_front() {
    // kivuli 0.56 (DECISION-054): back to the front checks; going behind doesn't.
    let s = folder("window-front");
    let dir = site(18828, "1.0.0");
    served(dir, 18828);
    let m = started(s, ["./main", "rapidkoi://localhost:18828"]);
    republish(dir, 18828, "2.0.0");
    assert_eq(newer(step(m, Msg.WindowActive(false))), None);
    let checked = step(m, Msg.WindowActive(true));
    assert_eq(newer(checked), Some("2.0.0"));
    done(s, dir);
}

@test
fun a_withdrawn_window_offers_the_newer_version_kept() {
    let s = folder("withdrawn-upgrade");
    let dir = site(18827, "1.0.0");
    served(dir, 18827);
    started(s, ["./main", "rapidkoi://localhost:18827"]);
    republish(dir, 18827, "2.0.0");
    withdraw_version(dir, "1.0.0", "it lost data").unwrap();
    let m = started(s, ["./main", "rapidkoi://localhost:18827"]);
    assert(shows(m, "Counting 1.0.0 was withdrawn: it lost data"));
    assert(offers(m));
    assert_eq(version(step(m, Msg.Reload)), "2.0.0");
    done(s, dir);
}
