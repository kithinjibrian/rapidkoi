// What the address box suggests (PRP-015): open tabs, pins and recent
// places whose apps are closed (PRP-062), matched by name or title. Pure;
// no display.
import rapidkoi.ui.suggestions { Suggestion, suggest };
import rapidkoi.window.recent { Place };
import rapidkoi.window.tabs { Tab, Pin, AppPage, open_module };
import rapidkoi.window.actions { Msg };
import wasmtime { Engine, Module };
import support { fixed, titled_tree, result_of, kv };
import cbor { Value };

/** A counter app whose screen is titled "Sprint 3". */
fun counter(): AppPage {
    let engine = Engine.new();
    let wat = fixed(
        kv([("count", Value.int(1))]),
        titled_tree("Count: 0", "Sprint 3"),
        result_of(kv([("count", Value.int(2))])),
    );
    open_module("counter", "apps/counter.wasm", engine, Module.from_text(engine, wat).unwrap())
}

fun pin(name: string): Pin = Pin { name: name, path: "{name}.wasm", icon: None, origin: None };

/** A recent place of the app `name`, at its file. */
fun place(name: string): Place = Place {
    address: "{name}.wasm",
    path: "{name}.wasm",
    origin: None,
    name: name,
    title: None,
    seen: 1,
};

fun messages(found: Suggestion[]): Msg[] = found.map(fun(s: Suggestion) = s.msg);

@test
fun an_empty_query_suggests_nothing() {
    let open = [Tab { id: 1, page: counter() }];
    assert_eq(suggest("", open, [pin("notes")], [place("mail")]).len, 0);
    assert_eq(suggest("   ", open, [pin("notes")], [place("mail")]).len, 0);
}

@test
fun an_open_tab_matches_by_name_or_title_ignoring_case() {
    let open = [Tab { id: 7, page: counter() }];
    let by_name = suggest("COUNT", open, [], []);
    assert_eq(messages(by_name), [Msg.Select(7)]);
    assert_eq(by_name[0].label, "counter");
    assert_eq(by_name[0].detail, Some("Sprint 3"));
    assert_eq(messages(suggest("sprint", open, [], [])), [Msg.Select(7)]);
    assert_eq(suggest("mail", open, [], []).len, 0);
}

@test
fun a_pin_matches() {
    let found = suggest("not", [], [pin("notes"), pin("mail")], []);
    assert_eq(messages(found), [Msg.OpenPinned("notes.wasm", None)]);
    assert_eq(found[0].label, "notes");
    assert_eq(found[0].detail, None);
}

@test
fun a_recent_place_matches_unless_its_app_is_open() {
    assert_eq(messages(suggest("ma", [], [], [place("mail")])), [Msg.OpenPlace("mail.wasm", None)]);
    let open = [Tab { id: 3, page: counter() }];
    let its_place = Place { path: "apps/counter.wasm", ..place("counter") };
    assert_eq(messages(suggest("count", open, [], [its_place])), [Msg.Select(3)]);
}

@test
fun tabs_come_first_then_pins_then_recent_places() {
    let open = [Tab { id: 2, page: counter() }];
    let found = suggest("c", open, [pin("clock")], [place("calendar")]);
    assert_eq(messages(found), [
        Msg.Select(2),
        Msg.OpenPinned("clock.wasm", None),
        Msg.OpenPlace("calendar.wasm", None),
    ]);
}
