// Loading from a development server, over a real local socket: a server
// on a spawned green thread, a client in the test. Each test has its own
// port (tests run in parallel processes). Writes only under test/tmp/.
import rapidkoi.bundles.loader { load, fetch, why };
import rapidkoi.trust.verify { keyring };
import rapidkoi.net.address { parse };
import rapidkoi.commands.serve { handle };
import rapidkoi.bundles.bundle { Bundle, Manifest, write };
import rapidkoi.shell { update };
import rapidkoi.window.window { Model, with_pages };
import rapidkoi.window.navigate { reload };
import rapidkoi.window.tabs { open_path };
import std.http { Request };
import wasmtime { Engine };
import std.task { sleep };
import support { settle };

/** Writes a bundle of `version` to test/tmp and gives its path. */
fun bundle_file(tag: string, version: string): string {
    let p = "test/tmp/{tag}.rkb";
    let m = Manifest {
        contract: 7,
        name: "Served",
        version: version,
        description: None,
        state_version: 1,
        icon: None,
        banners: [],
        servers: [],
        permissions: [],
        controls: None,
    };
    write_bytes(
        p,
        write(Bundle { manifest: m, module: [0, 97, 115, 109, 1, 0, 0, 0], assets: [] }).unwrap(),
    ).unwrap();
    p
}

/** Serves `file` on 127.0.0.1:`port` on a green thread, and gives it time to listen. */
fun serving(file: string, port: i64) {
    spawn http.serve("127.0.0.1:{port}", fun(r: Request) = handle(file, port, r));
    sleep(100);
}

fun version_of(m: Model): string {
    for tab of m.tabs {
        if let Some(man) = tab.page.manifest {
            return man.version;
        }
    }
    "none"
}

@test
fun a_bundle_loads_from_a_development_server() {
    serving(bundle_file("loader-ok", "1.0.0"), 18731);
    let loaded = load(Engine.new(), keyring(), "rapidkoi://localhost:18731/some/route");
    match loaded {
        Ok(l) => assert_eq(l.name, "Served"),
        Err(r) => panic("expected a bundle, got: {why(r)}"),
    }
}

@test
fun an_http_address_to_the_bundle_loads_too() {
    serving(bundle_file("loader-http", "1.0.0"), 18732);
    assert_eq(
        load(
            Engine.new(),
            keyring(),
            "http://127.0.0.1:18732/.well-known/rapidkoi/app.rkb",
        ).is_ok(),
        true,
    );
}

@test
fun failures_are_plain() {
    serving(bundle_file("loader-404", "1.0.0"), 18733);
    assert_eq(
        fetch(parse("http://localhost:18733/nothing.rkb").unwrap()),
        Err("The development server answered 404"),
    );
    // Nothing listens on 18739.
    let gone = fetch(parse("rapidkoi://localhost:18739").unwrap());
    assert_eq(
        gone.map_err(fun(e: string) = e.starts_with("Couldn't reach rapidkoi://localhost:18739")),
        Err(true),
    );
    // Refused before any connection: remote apps are HTTPS only.
    match load(Engine.new(), keyring(), "http://example.com/a.rkb") {
        Err(r) => assert_eq(why(r), "Remote apps open over HTTPS only: rapidkoi://example.com"),
        Ok(_) => panic("expected a refusal"),
    }
}

@test
fun a_response_too_large_is_refused() {
    // 33 MB of zeros, served raw: std.http stops reading past MAX_BUNDLE.
    let big: u8[] = [0; 33 * 1024 * 1024];
    spawn http.serve("127.0.0.1:18734", fun(_: Request) = http.bytes(200, big));
    sleep(100);
    assert_eq(
        fetch(parse("rapidkoi://localhost:18734").unwrap()).map_err(
            fun(e: string) = e.contains("too large"),
        ),
        Err(true),
    );
}

@test
fun reload_fetches_the_new_build() {
    let file = bundle_file("loader-reload", "1.0.0");
    serving(file, 18735);
    let engine = Engine.new();
    let m = with_pages(engine, [open_path(engine, keyring(), "rapidkoi://localhost:18735")]);
    assert_eq(version_of(m), "1.0.0");
    bundle_file("loader-reload", "1.1.0");
    let (loading, cmd) = reload(m);
    assert_eq(version_of(settle(loading, cmd, update)), "1.1.0");
}
