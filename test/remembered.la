// The trust and open files, and `recall`: each round trips, and every way one can be
// wrong is Broken (naming the field) or Newer, never a panic. Writes only
// under test/tmp/.
import rapidkoi.data.remembered {
    Unreadable,
    Recalled,
    trust_file,
    read_trust,
    recall,
    Open,
    OpenTab,
    MAX_OPEN,
    open_file,
    read_open,
};
import rapidkoi.data.pinfiles { pins_file, read_pins };
import rapidkoi.trust.verify { Identity };
import rapidkoi.data.store { Store, store_at, save };
import cbor { Value, Entry, encode };
import std.fs;
import support { png };

fun id(host: string, n: u8): Identity = Identity {
    host: host,
    key: [n; 32],
    sequence: 3,
    separate: false,
    since: 1_760_000_000_000,
    origin: [n; 32],
    name: None,
    default: false,
};

fun entry(k: string, v: Value): Entry = Entry { key: Value.Text(k), value: v };

fun broken<T>(r: Result<T, Unreadable>): string = match r {
    Err(Broken(why)) => why,
    Err(Newer(n)) => "newer {n}",
    Ok(_) => "ok",
};

fun trust_with(entries: Value[]): u8[] = encode(
    Value.Map([
        entry("format", Value.int(1)),
        entry("kind", Value.Text("rapidkoi trust")),
        entry("entries", Value.Array(entries)),
    ]),
);

fun one(host: string, key: u8[]): Value = Value.Map([
    entry("host", Value.Text(host)),
    entry("key", Value.Bytes(key)),
    entry("sequence", Value.int(1)),
    entry("separate", Value.Bool(false)),
]);

@test
fun trust_round_trips() {
    let ids = [id("localhost:8000", 1), Identity { separate: true, ..id("localhost:8000", 2) }];
    assert_eq(read_trust(trust_file(ids)), Ok(ids));
    assert_eq(read_trust(trust_file([])), Ok([]));
}

@test
fun the_default_app_round_trips() {
    // PRP-050: the app an address opens.
    let chosen = Identity { default: true, ..id("localhost:8000", 2) };
    assert_eq(read_trust(trust_file([chosen])), Ok([chosen]));
}

@test
fun a_separate_apps_name_round_trips_and_a_bad_one_is_broken() {
    // PRP-049: the name the person gave a separate app.
    let named = Identity { separate: true, name: Some("Bob's Notes"), ..id("localhost:8000", 2) };
    assert_eq(read_trust(trust_file([named])), Ok([named]));
    let empty = Identity { name: Some(""), ..named };
    assert_eq(broken(read_trust(trust_file([empty]))), "an entry's name is empty or too long");
    let mut n65 = "";
    for _ of range(0, 65) {
        n65 = "{n65}n";
    }
    let long = Identity { name: Some(n65), ..named };
    assert_eq(broken(read_trust(trust_file([long]))), "an entry's name is empty or too long");
}

@test
fun bad_trust_is_broken_naming_the_field() {
    assert_eq(broken(read_trust([1, 2, 3])).starts_with("not CBOR"), true);
    assert_eq(
        broken(read_trust(trust_with([one("Bad Host", [1; 32])]))),
        "an entry's host isn't a host name",
    );
    assert_eq(
        broken(read_trust(trust_with([one("a.example", [1; 31])]))),
        "an entry's key isn't 32 bytes",
    );
    assert_eq(broken(read_trust(trust_with([Value.int(1)]))), "an entry isn't a map");
    // Another kind of file in its place.
    assert_eq(broken(read_trust(pins_file([]))), "it isn't Rapidkoi's trust file");
    let mut many: Value[] = [];
    for _ in 0..10_001 {
        many.push(one("a.example", [1; 32]));
    }
    assert_eq(broken(read_trust(trust_with(many))), "it has more than 10,000 entries");
}

fun fresh(name: string): Store {
    let dir = "test/tmp/remembered-{name}";
    if fs.is_dir(dir) {
        for f of fs.list_dir(dir).unwrap() {
            fs.remove_file("{dir}/{f}").unwrap();
        }
        fs.remove_dir(dir).unwrap();
    }
    store_at(dir)
}

fun done(s: Store) {
    for f of fs.list_dir(s.dir).unwrap() {
        fs.remove_file("{s.dir}/{f}").unwrap();
    }
    fs.remove_dir(s.dir).unwrap();
}

@test
fun recalling_each_outcome() {
    let s = fresh("recall");
    match recall(s, "trust", 1024, read_trust) {
        Fresh => {}
        _ => panic("expected fresh"),
    }
    save(s, "trust", trust_file([id("a.example", 1)])).unwrap();
    match recall(s, "trust", 1024 * 1024, read_trust) {
        Read(ids) => assert_eq(ids.len, 1),
        _ => panic("expected read"),
    }
    // Over its cap: set aside like any broken file.
    match recall(s, "trust", 10, read_trust) {
        Broken(aside, why) => {
            assert_eq(aside, "{s.dir}/trust.broken");
            assert_eq(why.contains("too large"), true);
        }
        _ => panic("expected broken"),
    }
    save(s, "pins", [7, 7]).unwrap();
    match recall(s, "pins", 1024, read_pins) {
        Broken(aside, _) => assert_eq(read_bytes(aside).unwrap(), [7, 7]),
        _ => panic("expected broken"),
    }
    // Newer: left exactly where it is.
    let newer = encode(
        Value.Map([entry("format", Value.int(9)), entry("kind", Value.Text("rapidkoi pins"))]),
    );
    save(s, "pins", newer).unwrap();
    match recall(s, "pins", 1024, read_pins) {
        Newer(n) => assert_eq(n, 9),
        _ => panic("expected newer"),
    }
    assert_eq(read_bytes("{s.dir}/pins").unwrap(), newer);
    done(s);
}

@test
fun trust_format_1_still_reads_with_no_date() {
    let old = encode(
        Value.Map([
            entry("format", Value.int(1)),
            entry("kind", Value.Text("rapidkoi trust")),
            entry("entries", Value.Array([one("localhost:8000", [1; 32])])),
        ]),
    );
    let ids = read_trust(old).unwrap();
    assert_eq((ids.len, ids[0].since), (1, 0));
    // Written back as format 2, the date travels.
    assert_eq(read_trust(trust_file([id("a.example", 1)])).unwrap()[0].since, 1_760_000_000_000);
    let three = encode(
        Value.Map([entry("format", Value.int(6)), entry("kind", Value.Text("rapidkoi trust"))]),
    );
    assert_eq(broken(read_trust(three)), "newer 6");
}

fun tab(path: string, instance: string, label: Option<string>, seen: i64): OpenTab = OpenTab {
    link: [],
    path: path,
    instance: instance,
    label: label,
    seen: seen,
    origin: None,
};

@test
fun the_open_tabs_round_trip() {
    // PRP-034: what's open when Rapidkoi closes, to reopen at launch.
    let o = Open {
        tabs: [
            tab("rapidkoi://counter.dafifi.net", "", None, 3),
            tab("rapidkoi://counter.dafifi.net", "2", Some("Work"), 5),
            tab("/home/amina/notes.rkb", "", None, 1),
        ],
        current: Some(1),
    };
    assert_eq(read_open(open_file(o)).unwrap() == o, true);
    // A window keeps the fields its address names (PRP-036).
    let linked = Open {
        tabs: [
            OpenTab { link: ["count", "filter"], ..tab("rapidkoi://localhost:8000", "", None, 1) },
        ],
        current: Some(0),
    };
    assert_eq(read_open(open_file(linked)).unwrap() == linked, true);
    let none = Open { tabs: [], current: None };
    assert_eq(read_open(open_file(none)).unwrap() == none, true);
}

@test
fun a_bad_open_file_is_broken_naming_why() {
    let one = fun(t: OpenTab) = open_file(Open { tabs: [t], current: Some(0) });
    assert_eq(broken(read_open(one(tab("", "", None, 0)))), "a tab's path is empty or too long");
    assert_eq(
        broken(read_open(one(tab("a.wasm", "1", None, 0)))),
        "a tab's instance isn't one Rapidkoi gave",
    );
    assert_eq(
        broken(read_open(one(tab("a.wasm", "", Some(""), 0)))),
        "a tab's name is empty or too long",
    );
    let twice = Open {
        tabs: [tab("a.wasm", "", None, 0), tab("a.wasm", "", None, 1)],
        current: None,
    };
    assert_eq(broken(read_open(open_file(twice))), "an instance is listed twice");
    let named = fun(names: string[]) = broken(
        read_open(one(OpenTab { link: names, ..tab("a.wasm", "", None, 0) })),
    );
    assert_eq(named(["Count"]), "a tab's link isn't field names");
    assert_eq(named(["count", "count"]), "a tab's link isn't field names");
    let off = Open { tabs: [tab("a.wasm", "", None, 0)], current: Some(3) };
    assert_eq(broken(read_open(open_file(off))), "the tab in front isn't one of them");
    let mut many: OpenTab[] = [];
    for i in 0..MAX_OPEN + 1 {
        many.push(tab("a{i}.wasm", "", None, i));
    }
    assert_eq(
        broken(read_open(open_file(Open { tabs: many, current: None }))),
        "it lists more than 64 tabs",
    );
    assert_eq(broken(read_open(trust_file([]))), "it isn't Rapidkoi's open file");
}
