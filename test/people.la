// You to each app (PRP-011): sign-in settings, names, permissions, looks
// and forgotten apps, through the people file and back. Pure.
import rapidkoi.people.people {
    People,
    Person,
    nobody,
    person,
    with_person,
    forget_person,
    name_in,
    setting_of,
    with_setting,
    known,
    looks_of,
    with_looks,
};
import rapidkoi.people.people_codec { people_file, read_people };
import rapidkoi.people.account { generation_for, forget_app };
import rapidkoi.people.identity { Master };
import rapidkoi.data.remembered { Unreadable };
import rapidkoi.bundles.permissions { Permission, Setting };
import cbor { Value, Entry, encode };

const HOST: string = "notes.acme.com";

fun broken(r: Result<People, Unreadable>): string = match r {
    Err(Broken(w)) => w,
    Err(Newer(n)) => "newer {n}",
    Ok(_) => "ok",
};

fun entry(k: string, v: Value): Entry = Entry { key: Value.Text(k), value: v };

@test
fun an_app_never_seen_has_the_defaults() {
    let p = person(nobody(), HOST, [1; 32]);
    assert_eq((p.generation, p.signs_in, p.first, p.last), (0, true, "", ""));
    assert_eq((p.off.len, p.seen.len), (0, 0));
    assert_eq(known(nobody(), HOST, [1; 32]), false);
}

@test
fun switches_and_seen_servers_round_trip() {
    let ps = with_person(nobody(), Person {
        off: ["api.acme.com", HOST],
        seen: ["api.acme.com", "localhost:9000"],
        fresh: ["localhost:9000"],
        ..person(nobody(), HOST, [1; 32]),
    });
    assert_eq(known(ps, HOST, [1; 32]), true);
    let back = read_people(people_file(ps)).unwrap();
    assert_eq(back == ps, true);
    assert_eq(person(back, HOST, [1; 32]).off, ["api.acme.com", HOST]);
}

@test
fun settings_round_trip_and_forgetting_removes_one_app() {
    let mut ps = People {
        first: "Brian",
        last: "Kithinji",
        apps: [],
        grants: [],
        looks: [],
        forgotten: [],
    };
    ps = with_person(ps, Person {
        generation: 2,
        signs_in: false,
        first: "B",
        ..person(ps, HOST, [1; 32]),
    });
    ps = with_person(ps, Person { signs_in: false, ..person(ps, "chat.example", [2; 32]) });
    let back = read_people(people_file(ps)).unwrap();
    assert_eq(back == ps, true);
    assert_eq(person(back, HOST, [1; 32]).generation, 2);
    let forgot = forget_person(back, HOST, [1; 32]);
    assert_eq((forgot.apps.len, person(forgot, HOST, [1; 32]).generation), (1, 0));
}

@test
fun an_app_s_own_name_wins_else_the_one_for_every_app() {
    let mut ps = People {
        first: "Brian",
        last: "Kithinji",
        apps: [],
        grants: [],
        looks: [],
        forgotten: [],
    };
    assert_eq(name_in(ps, HOST, [1; 32]), ("Brian", "Kithinji"));
    ps = with_person(ps, Person { first: "Bee", ..person(ps, HOST, [1; 32]) });
    // Only the first name is overridden here: the last stays the one for every app.
    assert_eq(name_in(ps, HOST, [1; 32]), ("Bee", "Kithinji"));
    assert_eq(name_in(ps, "chat.example", [2; 32]), ("Brian", "Kithinji"));
}

@test
fun permission_settings_round_trip_by_app() {
    // PRP-031: a built-in app is keyed apart from any host.
    let mut ps = nobody();
    assert_eq(setting_of(ps, "builtin:newtab", Permission.ReadPins), Setting.Allowed);
    ps = with_setting(ps, "builtin:newtab", Permission.ReadPins, Setting.Blocked);
    ps = with_setting(ps, "builtin:newtab", Permission.OpenApps, Setting.Ask);
    let back = read_people(people_file(ps)).unwrap();
    assert_eq(setting_of(back, "builtin:newtab", Permission.ReadPins), Setting.Blocked);
    assert_eq(setting_of(back, "builtin:newtab", Permission.OpenApps), Setting.Ask);
    assert_eq(setting_of(back, "builtin:other", Permission.ReadPins), Setting.Allowed);
    // Back to the default: nothing kept for it.
    let reset = with_setting(back, "builtin:newtab", Permission.ReadPins, Setting.Allowed);
    assert_eq(reset.grants.len, 1);
}

@test
fun an_app_s_own_looks_switches_round_trip() {
    // PRP-038: Use my colours, Use my text size, per app; off by default.
    let mut ps = nobody();
    assert_eq(looks_of(ps, "notes.acme.com"), (false, false));
    ps = with_looks(ps, "notes.acme.com", true, false);
    ps = with_looks(ps, "builtin:newtab", true, true);
    let back = read_people(people_file(ps)).unwrap();
    assert_eq(
        (looks_of(back, "notes.acme.com"), looks_of(back, "builtin:newtab")),
        ((true, false), (true, true)),
    );
    // Both off: nothing kept.
    assert_eq(with_looks(back, "notes.acme.com", false, false).looks.len, 1);
}

fun me(): Master = Master { secret: [7; 32] };

@test
fun forgetting_an_app_keeps_its_next_generation() {
    let ps = with_person(nobody(), Person { generation: 2, ..person(nobody(), HOST, [1; 32]) });
    assert_eq(generation_for(ps, me(), HOST, [1; 32]).unwrap(), 2);
    let gone = forget_app(ps, Some(me()), HOST, [1; 32]).unwrap();
    assert_eq(known(gone, HOST, [1; 32]), false);
    // Reopened, it's a new Person at 0, and its key is the next one: 3.
    assert_eq(generation_for(gone, me(), HOST, [1; 32]).unwrap(), 3);
    let again = forget_app(gone, Some(me()), HOST, [1; 32]).unwrap();
    assert_eq(generation_for(again, me(), HOST, [1; 32]).unwrap(), 4);
    assert_eq(again.forgotten.len, 1);
    // Another app is untouched.
    assert_eq(generation_for(again, me(), "chat.example", [2; 32]).unwrap(), 0);
}

@test
fun forgetting_with_no_master_secret_records_nothing() {
    // No secret: no key was ever made, so there's nothing to move past.
    let ps = with_person(nobody(), person(nobody(), HOST, [1; 32]));
    let gone = forget_app(ps, None, HOST, [1; 32]).unwrap();
    assert_eq((gone.apps.len, gone.forgotten.len), (0, 0));
}

@test
fun format_5_round_trips_signing_in_and_forgotten_apps() {
    let ps = with_person(nobody(), Person { signs_in: false, ..person(nobody(), HOST, [1; 32]) });
    let gone = forget_app(
        with_person(ps, person(ps, "chat.example", [2; 32])),
        Some(me()),
        "chat.example",
        [2; 32],
    ).unwrap();
    let back = read_people(people_file(gone)).unwrap();
    assert_eq(back == gone, true);
    assert_eq(person(back, HOST, [1; 32]).signs_in, false);
    assert_eq(generation_for(back, me(), "chat.example", [2; 32]).unwrap(), 1);
}
