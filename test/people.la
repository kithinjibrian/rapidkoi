// The people file (PRP-011): each app's sign-in settings and your name,
// read as hostile input. Pure.
import rapidkoi.people.people {
    People,
    Person,
    nobody,
    person,
    with_person,
    forget_person,
    name_in,
    people_file,
    read_people,
    setting_of,
    with_setting,
    known,
    looks_of,
    with_looks,
};
import rapidkoi.data.remembered { Unreadable };
import rapidkoi.bundles.permissions { Permission, Setting };
import cbor { Value, Entry, encode };

const HOST: string = "notes.acme.com";

fun broken(r: Result<People, Unreadable>): string = match r {
    Err(Broken(w)) => w,
    Err(Newer(n)) => "newer {n}",
    Ok(_) => "ok",
};

fun entry(k: string, v: Value): Entry = Entry { key: Value.Text(k), value: v };

@test
fun an_app_never_seen_has_the_defaults() {
    let p = person(nobody(), HOST, [1; 32]);
    assert_eq((p.generation, p.auto, p.signed_out, p.first, p.last), (0, true, false, "", ""));
    assert_eq((p.off.len, p.seen.len), (0, 0));
    assert_eq(known(nobody(), HOST, [1; 32]), false);
}

@test
fun switches_and_seen_servers_round_trip() {
    let ps = with_person(nobody(), Person {
        off: ["api.acme.com", HOST],
        seen: ["api.acme.com", "localhost:9000"],
        fresh: ["localhost:9000"],
        ..person(nobody(), HOST, [1; 32]),
    });
    assert_eq(known(ps, HOST, [1; 32]), true);
    let back = read_people(people_file(ps)).unwrap();
    assert_eq(back == ps, true);
    assert_eq(person(back, HOST, [1; 32]).off, ["api.acme.com", HOST]);
}

/** A people file of `format` with one app whose extra fields are `extra`. */
fun one_app(format: i64, extra: Entry[]): u8[] {
    let mut fields = [
        entry("host", Value.Text(HOST)),
        entry("origin", Value.Bytes([1; 32])),
        entry("generation", Value.int(0)),
        entry("auto", Value.Bool(true)),
        entry("signed_out", Value.Bool(false)),
        entry("first", Value.Text("")),
        entry("last", Value.Text("")),
    ];
    for e of extra {
        fields.push(e);
    }
    encode(
        Value.Map([
            entry("format", Value.int(format)),
            entry("kind", Value.Text("rapidkoi people")),
            entry("first", Value.Text("")),
            entry("last", Value.Text("")),
            entry("apps", Value.Array([Value.Map(fields)])),
        ]),
    )
}

@test
fun format_1_reads_with_nothing_switched_off() {
    let back = read_people(one_app(1, [])).unwrap();
    assert_eq((back.apps[0].off.len, back.apps[0].seen.len), (0, 0));
}

@test
fun bad_server_lists_are_broken() {
    let names = fun(xs: string[]) = Value.Array(xs.map(fun(x: string) = Value.Text(x)));
    let seen = entry("seen", names([]));
    let fresh = entry("fresh", names([]));
    assert_eq(
        broken(read_people(one_app(2, [entry("off", names(["api.acme.com"])), seen, fresh]))),
        "ok",
    );
    assert_eq(
        broken(read_people(one_app(2, [entry("off", names(["10.0.0.1"])), seen, fresh]))),
        "an app's servers aren't server names",
    );
    assert_eq(
        broken(read_people(one_app(2, [entry("off", Value.Text("x")), seen, fresh]))),
        "an app's servers aren't server names",
    );
    let mut lots: string[] = [];
    for i in 0..34 {
        lots.push("s{i}.acme.com");
    }
    assert_eq(
        broken(read_people(one_app(2, [entry("off", names(lots)), seen, fresh]))),
        "an app's servers aren't server names",
    );
}

@test
fun settings_round_trip_and_forgetting_removes_one_app() {
    let mut ps = People { first: "Brian", last: "Kithinji", apps: [], grants: [], looks: [] };
    ps = with_person(ps, Person {
        generation: 2,
        auto: false,
        first: "B",
        ..person(ps, HOST, [1; 32]),
    });
    ps = with_person(ps, Person { signed_out: true, ..person(ps, "chat.example", [2; 32]) });
    let back = read_people(people_file(ps)).unwrap();
    assert_eq(back == ps, true);
    assert_eq(person(back, HOST, [1; 32]).generation, 2);
    let forgot = forget_person(back, HOST, [1; 32]);
    assert_eq((forgot.apps.len, person(forgot, HOST, [1; 32]).generation), (1, 0));
}

@test
fun an_app_s_own_name_wins_else_the_one_for_every_app() {
    let mut ps = People { first: "Brian", last: "Kithinji", apps: [], grants: [], looks: [] };
    assert_eq(name_in(ps, HOST, [1; 32]), ("Brian", "Kithinji"));
    ps = with_person(ps, Person { first: "Bee", ..person(ps, HOST, [1; 32]) });
    // Only the first name is overridden here: the last stays the one for every app.
    assert_eq(name_in(ps, HOST, [1; 32]), ("Bee", "Kithinji"));
    assert_eq(name_in(ps, "chat.example", [2; 32]), ("Brian", "Kithinji"));
}

@test
fun bad_files_are_broken_naming_the_field() {
    assert_eq(broken(read_people([1, 2])).starts_with("not CBOR"), true);
    let long = encode(
        Value.Map([
            entry("format", Value.int(1)),
            entry("kind", Value.Text("rapidkoi people")),
            entry("first", Value.Text(many(65))),
            entry("last", Value.Text("")),
            entry("apps", Value.Array([])),
        ]),
    );
    assert_eq(broken(read_people(long)), "a name is longer than 64 characters");
    let newer = encode(
        Value.Map([entry("format", Value.int(5)), entry("kind", Value.Text("rapidkoi people"))]),
    );
    assert_eq(broken(read_people(newer)), "newer 5");
}

fun many(n: i64): string {
    let mut s = "";
    for _ in 0..n {
        s = s + "x";
    }
    s
}

@test
fun permission_settings_round_trip_by_app() {
    // PRP-031: a built-in app is keyed apart from any host.
    let mut ps = nobody();
    assert_eq(setting_of(ps, "builtin:newtab", Permission.ReadPins), Setting.Allowed);
    ps = with_setting(ps, "builtin:newtab", Permission.ReadPins, Setting.Blocked);
    ps = with_setting(ps, "builtin:newtab", Permission.OpenApps, Setting.Ask);
    let back = read_people(people_file(ps)).unwrap();
    assert_eq(setting_of(back, "builtin:newtab", Permission.ReadPins), Setting.Blocked);
    assert_eq(setting_of(back, "builtin:newtab", Permission.OpenApps), Setting.Ask);
    assert_eq(setting_of(back, "builtin:other", Permission.ReadPins), Setting.Allowed);
    // Back to the default: nothing kept for it.
    let reset = with_setting(back, "builtin:newtab", Permission.ReadPins, Setting.Allowed);
    assert_eq(reset.grants.len, 1);
}

@test
fun format_2_reads_with_every_permission_at_its_default() {
    let old = encode(
        Value.Map([
            entry("format", Value.int(2)),
            entry("kind", Value.Text("rapidkoi people")),
            entry("first", Value.Text("")),
            entry("last", Value.Text("")),
            entry("apps", Value.Array([])),
        ]),
    );
    assert_eq(read_people(old).unwrap().grants.len, 0);
}

@test
fun bad_permission_settings_are_broken() {
    let with_grants = fun(g: Value) = encode(
        Value.Map([
            entry("format", Value.int(3)),
            entry("kind", Value.Text("rapidkoi people")),
            entry("first", Value.Text("")),
            entry("last", Value.Text("")),
            entry("apps", Value.Array([])),
            entry("grants", g),
        ]),
    );
    let grant = fun(app: string, permission: string, setting: string) = Value.Map([
        entry("app", Value.Text(app)),
        entry("permission", Value.Text(permission)),
        entry("setting", Value.Text(setting)),
    ]);
    assert_eq(
        read_people(
            with_grants(Value.Array([grant("builtin:newtab", "read_pins", "blocked")])),
        ).is_ok(),
        true,
    );
    assert_eq(
        broken(
            read_people(with_grants(Value.Array([grant("builtin:newtab", "read_pins", "maybe")]))),
        ),
        "a permission setting isn't allowed, ask or blocked",
    );
    assert_eq(
        broken(read_people(with_grants(Value.Text("x")))),
        "its permission settings aren't a list",
    );
}

@test
fun an_app_s_own_looks_switches_round_trip() {
    // PRP-038: Use my colours, Use my text size, per app; off by default.
    let mut ps = nobody();
    assert_eq(looks_of(ps, "notes.acme.com"), (false, false));
    ps = with_looks(ps, "notes.acme.com", true, false);
    ps = with_looks(ps, "builtin:newtab", true, true);
    let back = read_people(people_file(ps)).unwrap();
    assert_eq(
        (looks_of(back, "notes.acme.com"), looks_of(back, "builtin:newtab")),
        ((true, false), (true, true)),
    );
    // Both off: nothing kept.
    assert_eq(with_looks(back, "notes.acme.com", false, false).looks.len, 1);
}

@test
fun format_3_reads_with_both_switches_off() {
    let old = encode(
        Value.Map([
            entry("format", Value.int(3)),
            entry("kind", Value.Text("rapidkoi people")),
            entry("first", Value.Text("")),
            entry("last", Value.Text("")),
            entry("apps", Value.Array([])),
            entry("grants", Value.Array([])),
        ]),
    );
    assert_eq(read_people(old).unwrap().looks.len, 0);
}
