// Contract 7's results, pure: what `handle` returns (state, effects, the
// address's fields and their kinds) and a request's reply. No guest and no
// display. The screen's tests are in tree.la.
import rapidkoi.guest.contract { ContractError, read_update, reply, Effect, Update, LinkChange };
import cbor { Value, Entry, encode, decode, Limits };
import rapidkoi.net.network { Request, Reply };
import support { t, kv };

@test
fun an_update_result_gives_its_state() {
    let state = kv([("count", Value.int(3))]);
    let ok = encode(kv([("state", state), ("effects", Value.Array([]))]));
    assert_eq(read_update(ok).map(fun(u: Update) = u.state), Ok(encode(state)));
}

@test
fun bad_update_results_are_contract_errors() {
    let shown = fun(v: Value): string = match read_update(encode(v)) {
        Err(Invalid(path, what)) => "{path}: {what}",
        Err(e) => "{e}",
        Ok(_) => "ok",
    };
    assert_eq(shown(kv([("effects", Value.Array([]))])), "update: \"state\" is missing");
    assert_eq(
        shown(kv([("state", Value.Bytes([1])), ("effects", Value.Array([]))])),
        "update: \"state\" must be a map of named fields",
    );
    assert_eq(shown(kv([("state", kv([]))])), "update: \"effects\" is missing");
    assert_eq(
        shown(kv([("state", kv([])), ("effects", Value.Null)])),
        "update: \"effects\" must be an array",
    );
    assert_eq(shown(Value.Array([])), "update: the result must be a map");
}

// What an app may ask for in its result's effects (PRP-011).

fun v2(effects: Value[]): u8[] = encode(
    Value.Map([
        Entry { key: t("state"), value: kv([("n", Value.int(1))]) },
        Entry { key: t("effects"), value: Value.Array(effects) },
    ]),
);

fun ask(kind: string, extra: (string, Value)[]): Value {
    let mut fields = [("kind", t(kind)), ("msg", t("got"))];
    for e of extra {
        fields.push(e);
    }
    kv(fields)
}

fun v2_why(bytes: u8[]): string = match read_update(bytes) {
    Err(Invalid(_, problem)) => problem,
    Err(e) => "{e}",
    Ok(_) => "ok",
};

@test
fun v2_effects_decode() {
    let u = read_update(
        v2([ask("identity", []), ask("sign", [("challenge", Value.Bytes([7, 7]))])]),
    ).unwrap();
    assert_eq(u.state, encode(kv([("n", Value.int(1))])));
    assert_eq(u.effects, [Effect.Identity(t("got")), Effect.Sign(t("got"), [7, 7])]);
    assert_eq(read_update(v2([])).unwrap().effects, []);
}

@test
fun v2_effects_are_checked() {
    assert_eq(v2_why(v2([ask("email", [])])).contains("unknown effect \"email\""), true);
    assert_eq(v2_why(v2([ask("sign", [])])).contains("a challenge of 1 to 1024 bytes"), true);
    assert_eq(
        v2_why(v2([ask("sign", [("challenge", Value.Bytes([]))])])).contains(
            "a challenge of 1 to 1024 bytes",
        ),
        true,
    );
    assert_eq(
        v2_why(v2([ask("sign", [("challenge", Value.Bytes([0; 1025]))])])).contains(
            "a challenge of 1 to 1024 bytes",
        ),
        true,
    );
    let mut nine: Value[] = [];
    for _ in 0..9 {
        nine.push(ask("identity", []));
    }
    assert_eq(v2_why(v2(nine)).contains("at most 8 effects"), true);
    assert_eq(v2_why(v2([kv([("kind", t("identity"))])])).contains("needs a msg"), true);
}

@test
fun a_fetch_effect_decodes() {
    let get = ask("fetch", [("method", t("GET")), ("url", t("https://api.acme.com/q"))]);
    assert_eq(read_update(v2([get])).unwrap().effects, [
        Effect.Fetch(t("got"), Request {
            method: "GET",
            url: "https://api.acme.com/q",
            headers: [],
            body: [],
        }),
    ]);
    let post = ask("fetch", [
        ("method", t("POST")),
        ("url", t("https://api.acme.com/notes")),
        ("headers", kv([("content-type", t("application/json"))])),
        ("body", Value.Bytes([123, 125])),
    ]);
    assert_eq(read_update(v2([post])).unwrap().effects, [
        Effect.Fetch(t("got"), Request {
            method: "POST",
            url: "https://api.acme.com/notes",
            headers: [("content-type", "application/json")],
            body: [123, 125],
        }),
    ]);
}

@test
fun a_fetch_effects_shape_is_checked() {
    let url = ("url", t("https://a.example/"));
    let method = ("method", t("GET"));
    assert_eq(v2_why(v2([ask("fetch", [url])])), "a fetch needs a method and a url");
    assert_eq(v2_why(v2([ask("fetch", [method])])), "a fetch needs a method and a url");
    assert_eq(
        v2_why(v2([ask("fetch", [method, url, ("headers", t("x"))])])),
        "a fetch's headers must map text to text",
    );
    assert_eq(
        v2_why(v2([ask("fetch", [method, url, ("headers", kv([("a", Value.int(1))]))])])),
        "a fetch's headers must map text to text",
    );
    assert_eq(
        v2_why(v2([ask("fetch", [method, url, ("body", t("x"))])])),
        "a fetch's body must be bytes",
    );
    let long = string_from_utf8([97; 8193]).unwrap();
    assert_eq(
        v2_why(v2([ask("fetch", [method, ("url", t("https://a.example/{long}"))])])),
        "a fetch's url is at most 8192 bytes",
    );
    let mut many: (string, Value)[] = [];
    for i in 0..65 {
        many.push(("x-{i}", t("v")));
    }
    assert_eq(
        v2_why(v2([ask("fetch", [method, url, ("headers", kv(many))])])),
        "a fetch has at most 64 headers, each at most 8192 bytes",
    );
    assert_eq(
        v2_why(v2([ask("fetch", [method, url, ("headers", kv([("a", t(long))]))])])),
        "a fetch has at most 64 headers, each at most 8192 bytes",
    );
}

@test
fun a_reply_is_a_response_or_an_error() {
    let got = reply(Reply.Got(200, #{"content-type": "text/plain"}, [104, 105]));
    assert_eq(
        encode(got),
        encode(
            kv([
                ("status", Value.int(200)),
                ("headers", kv([("content-type", t("text/plain"))])),
                ("body", Value.Bytes([104, 105])),
            ]),
        ),
    );
    assert_eq(encode(reply(Reply.Failed("no"))), encode(kv([("error", t("no"))])));
}

@test
fun the_new_tabs_asks_decode() {
    let u = read_update(
        v2([
            ask("pins", []),
            ask("left_off", []),
            ask("open_pin", [("index", Value.int(2))]),
            ask("continue", []),
            ask("session", []),
            ask("restore_session", []),
        ]),
    ).unwrap();
    assert_eq(u.effects, [
        Effect.Pins(t("got")),
        Effect.LeftOff(t("got")),
        Effect.OpenPin(t("got"), 2),
        Effect.Continue(t("got")),
        Effect.Session(t("got")),
        Effect.RestoreSession(t("got")),
    ]);
}

@test
fun open_pin_needs_an_index() {
    assert_eq(
        v2_why(v2([ask("open_pin", [])])).contains("an open_pin needs an index of 0 or more"),
        true,
    );
    assert_eq(
        v2_why(v2([ask("open_pin", [("index", Value.int(-1))])])).contains(
            "an open_pin needs an index of 0 or more",
        ),
        true,
    );
}

/** A result with the given `link` and `kinds`. */
fun linked(link: Value, kinds: Value): u8[] = encode(
    kv([("state", kv([])), ("effects", Value.Array([])), ("link", link), ("kinds", kinds)]),
);

@test
fun kinds_say_what_each_link_field_is() {
    let u = read_update(
        linked(
            Value.Array([t("note"), t("editor.task")]),
            kv([("note", t("number")), ("editor.task", t("number")), ("query", t("text"))]),
        ),
    ).unwrap();
    assert_eq(u.link, LinkChange.Set(["note", "editor.task"]));
    assert_eq(u.kinds, [("note", "number"), ("editor.task", "number"), ("query", "text")]);
    let none = encode(kv([("state", kv([])), ("effects", Value.Array([]))]));
    assert_eq(read_update(none).unwrap().kinds, []);
}

@test
fun bad_kinds_stop_the_app() {
    let why = fun(kinds: Value): string = match read_update(linked(Value.Array([]), kinds)) {
        Err(Invalid(_, problem)) => problem,
        _ => "ok",
    };
    assert_eq(why(t("note")), "\"kinds\" must be a map of field paths to kinds");
    assert_eq(why(kv([("note", t("date"))])), "\"kinds\": note must be number, text or bool");
    assert_eq(why(kv([("note", Value.int(1))])), "\"kinds\" maps field paths to kinds, as text");
    assert_eq(why(kv([("Note!", t("text"))])).starts_with("\"kinds\": "), true);
    let mut many: (string, Value)[] = [];
    for i in 0..17 {
        many.push(("f{i}", t("text")));
    }
    assert_eq(why(kv(many)), "\"kinds\" names at most 16 fields");
}
