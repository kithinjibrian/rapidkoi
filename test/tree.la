// Screens (contract 7; boxes, texts and styles since PRP-037), pure: boxes,
// texts and typing boxes, their styles and roles, and the limits.
import rapidkoi.guest.tree { read_tree };
import rapidkoi.guest.nodes {
    Node,
    Typing,
    Role,
    Colour,
    ContractError,
    Described,
    Part,
    Which,
    Show,
};
import rapidkoi.guest.limits { MAX_NODES, MAX_NODE_DEPTH };
import cbor { Value, encode };
import support { t, kv, leaf, parent };

fun read(v: Value): Result<Node, ContractError> = read_tree(encode(v)).map(fun(d) = d.root);

fun why(v: Value): string = match read_tree(encode(v)) {
    Err(Invalid(path, problem)) => "{path}: {problem}",
    Err(_) => "another error",
    Ok(_) => "ok",
};

@test
fun a_counter_reads() {
    let add = parent(
        "box",
        [
            ("role", t("button")),
            ("on_press", t("add")),
            ("style", kv([("background", t("accent"))])),
        ],
        [leaf("text", [("text", t("Add"))])],
    );
    let root = parent("box", [("title", t("Counter"))], [
        leaf("text", [("text", t("Count: 3")), ("role", t("heading"))]),
        add,
    ]);
    let d = read_tree(encode(root)).unwrap();
    assert_eq(d.title, Some("Counter"));
    match d.root {
        Boxed(_, _, None, kids) => {
            assert_eq(kids.len, 2);
            match kids[0] {
                Words(s, _, f) => assert_eq((s, f.role == Some(Role.Heading)), ("Count: 3", true)),
                _ => panic("expected a text"),
            }
            match kids[1] {
                Boxed(l, f, Some(msg), inner) => {
                    assert_eq(
                        (msg == t("add"), f.role == Some(Role.Button), inner.len),
                        (true, true, 1),
                    );
                    assert_eq(l.background == Some(Colour.Named("accent")), true);
                }
                _ => panic("expected a pressable box"),
            }
        }
        _ => panic("expected a box"),
    }
}

@test
fun typing_boxes_read() {
    let one = read(
        leaf("input", [
            ("value", t("Buy")),
            ("placeholder", t("What needs doing?")),
            ("on_change", t("draft")),
            ("on_submit", t("add")),
        ]),
    ).unwrap();
    match one {
        Field(f, _) => {
            assert_eq((f.value, f.placeholder, f.lines), ("Buy", "What needs doing?", 1));
            assert_eq(
                (f.on_change == Some(t("draft")), f.on_submit == Some(t("add"))),
                (true, true),
            );
        }
        _ => panic("expected a field"),
    }
    match read(leaf("input", [("value", t("")), ("lines", Value.int(5))])).unwrap() {
        Field(f, _) => assert_eq((f.lines, f.on_change.is_none()), (5, true)),
        _ => panic("expected a field"),
    }
    assert_eq(
        why(leaf("input", [("value", t("")), ("lines", Value.int(21))])),
        "root > input: lines must be 1 to 20",
    );
}

@test
fun other_kinds_are_placeholders_and_their_children_still_count() {
    // Box, text and input; anything else (contract 4's button included) is shown as unsupported.
    match read(leaf("button", [("label", t("Old"))])).unwrap() {
        Unsupported(kind) => assert_eq(kind, "button"),
        _ => panic("expected a placeholder"),
    }
    let mut kids: Value[] = [];
    for _ in 0..MAX_NODES {
        kids.push(leaf("text", [("text", t("x"))]));
    }
    assert_eq(why(parent("chart", [], kids)).contains("more than {MAX_NODES} nodes"), true);
}

@test
fun a_typing_box_may_have_a_label() {
    match read(leaf("input", [("value", t("")), ("label", t("Search notes"))])).unwrap() {
        Field(f, _) => assert_eq(f.label, Some("Search notes")),
        _ => panic("expected a field"),
    }
    match read(leaf("input", [("value", t(""))])).unwrap() {
        Field(f, _) => assert_eq(f.label, None),
        _ => panic("expected a field"),
    }
    assert_eq(
        why(leaf("input", [("value", t("")), ("label", t(""))])),
        "root > input: label must be text of 1 to 200 bytes",
    );
    assert_eq(
        why(leaf("input", [("value", t("")), ("label", Value.int(3))])),
        "root > input: label must be text of 1 to 200 bytes",
    );
}

@test
fun the_root_may_carry_a_title_and_only_the_root() {
    let titled = read_tree(encode(parent("box", [("title", t("Sprint 3"))], [])));
    assert_eq(titled.map(fun(d: Described) = d.title), Ok(Some("Sprint 3")));
    let nested = read_tree(
        encode(parent("box", [], [leaf("text", [("text", t("a")), ("title", t("ignored"))])])),
    );
    assert_eq(nested.map(fun(d: Described) = d.title), Ok(None));
    assert_eq(why(leaf("box", [("title", Value.int(3))])), "root > box: \"title\" must be text");
}

/** A text of `n` copies of "x". */
fun xs(n: i64): string {
    let bytes: u8[] = [120; n];
    string_from_utf8(bytes).unwrap()
}

@test
fun string_and_size_limits() {
    assert_eq(read(leaf("text", [("text", t(xs(65536)))])).is_ok(), true);
    let long = read_tree(encode(leaf("text", [("text", t(xs(65537)))])));
    assert_eq(long.is_err(), true);
    let big: u8[] = [0; 4 * 1024 * 1024 + 1];
    match read_tree(big) {
        Err(TooLong(what, n)) => assert_eq((what, n), ("the screen description", 4194305)),
        _ => panic("expected too long"),
    }
    match read_tree([0xa1]) {
        Err(Decode(_)) => {}
        _ => panic("expected bad CBOR"),
    }
}

@test
fun a_bad_style_or_role_stops_it_with_where() {
    let bad_style = parent("box", [], [
        leaf("text", [("text", t("x")), ("style", kv([("width", Value.int(-1))]))]),
    ]);
    assert_eq(why(bad_style), "root > box > text[0]: style.width must be 0–4096 px");
    assert_eq(
        why(leaf("box", [("role", t("task"))])).starts_with("root > box: role must be"),
        true,
    );
    assert_eq(why(leaf("text", [])), "root > text: a text needs \"text\" or \"parts\"");
}

@test
fun the_limits_still_hold() {
    let mut kids: Value[] = [];
    for _ in 0..MAX_NODES {
        kids.push(leaf("text", [("text", t("x"))]));
    }
    assert_eq(why(parent("box", [], kids)).contains("more than {MAX_NODES} nodes"), true);
    let mut v = leaf("text", [("text", t("bottom"))]);
    for _ in 0..MAX_NODE_DEPTH + 1 {
        v = parent("box", [], [v]);
    }
    assert_eq(why(v).contains("deeper than {MAX_NODE_DEPTH} nodes"), true);
}

/** A box with `scroll` along `axis`, holding `kids`. */
fun scrolling(axis: string, kids: Value[]): Value = parent(
    "box",
    [("style", kv([("scroll", t(axis))]))],
    kids,
);

@test
fun a_scroll_inside_a_scroll_the_same_way_is_refused() {
    // PRP-046: never a dead scroll that silently doesn't.
    let inner = scrolling("vertical", [leaf("text", [("text", t("x"))])]);
    assert_eq(
        why(scrolling("vertical", [parent("box", [], [inner])])),
        "root > box > box[0] > box[0]: This app put a scrolling box inside another that scrolls the same way",
    );
    assert_eq(
        why(scrolling("both", [scrolling("horizontal", [])])).ends_with("scrolls the same way"),
        true,
    );
    assert_eq(
        why(scrolling("horizontal", [scrolling("both", [])])).ends_with("scrolls the same way"),
        true,
    );
    // Across is fine: a row of thumbnails in a list.
    assert_eq(why(scrolling("vertical", [scrolling("horizontal", [])])), "ok");
    // Side by side, each scrolls.
    assert_eq(why(parent("box", [], [scrolling("vertical", []), scrolling("vertical", [])])), "ok");
}

/** A text node made of `parts`. */
fun parts(xs: Value[]): Value = leaf("text", [("parts", Value.Array(xs))]);

fun moment(ms: i64, show: string): Value = kv([("time", Value.int(ms)), ("show", t(show))]);

@test
fun a_text_may_be_made_of_parts() {
    // PRP-053: plain words, a name, a moment; Rapidkoi fills them in.
    let v = parts([
        t("Hello, "),
        kv([("name", t("first"))]),
        t(", "),
        moment(1730374320000, "relative"),
    ]);
    match read(v) {
        Ok(Parts(ps, _, _)) => assert_eq(ps, [
            Part.Plain("Hello, "),
            Part.Name(Which.First),
            Part.Plain(", "),
            Part.Time(1730374320000, Show.Relative),
        ]),
        _ => assert(false),
    }
    for show of ["time", "date", "date_time", "relative", "weekday"] {
        assert_eq(why(parts([moment(0, show)])), "ok");
    }
    assert_eq(why(parts([kv([("name", t("last"))])])), "ok");
}

@test
fun bad_parts_stop_it_with_where() {
    let here = "root > text: ";
    assert_eq(
        why(leaf("text", [("text", t("x")), ("parts", Value.Array([]))])),
        "{here}a text has \"text\" or \"parts\", not both",
    );
    let mut many: Value[] = [];
    for _ in 0..65 {
        many.push(t("x"));
    }
    assert_eq(why(parts(many)), "{here}more than 64 parts");
    assert_eq(why(parts([Value.int(3)])), "{here}a part must be text, a name or a time");
    assert_eq(
        why(parts([kv([("name", t("middle"))])])),
        "{here}a name part is \"first\" or \"last\"",
    );
    // 0001-01-01 and 9999-12-31 are the ends.
    assert_eq(why(parts([moment(-62135596800000, "time")])), "ok");
    assert_eq(why(parts([moment(253402300799999, "time")])), "ok");
    let out = "{here}a time part is whole milliseconds within years 1 to 9999";
    assert_eq(why(parts([moment(-62135596800001, "time")])), out);
    assert_eq(why(parts([moment(253402300800000, "time")])), out);
    assert_eq(why(parts([kv([("time", Value.Float(1.5)), ("show", t("time"))])])), out);
    assert_eq(
        why(parts([moment(0, "soon")])),
        "{here}show must be time, date, date_time, relative or weekday",
    );
}
