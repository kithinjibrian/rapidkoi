// The frame (PRP-014, PRP-015): the header bar with the address box, the
// sidebar, and the content area showing the current app. No display.
import rapidkoi.shell { Model, start, with_pages, update, view };
import rapidkoi.layout;
import rapidkoi.actions { Msg };
import rapidkoi.tabs { AppPage, open_module };
import kivuli.testing { click, pick, texts };
import wasmtime { Engine, Module };
import support { echo };

fun app(engine: Engine, name: string): AppPage = open_module(
    name,
    "{name}.wasm",
    engine,
    Module.from_text(engine, echo()).unwrap(),
);

/** A window with two echo apps open and a notice showing. */
fun busy(): Model {
    let engine = Engine.new();
    let m = with_pages(engine, [app(engine, "a"), app(engine, "b")]);
    Model { notice: Some("Something happened"), ..m }
}

@test
fun a_fresh_window_shows_no_text() {
    let (m, _) = start(["main"], None);
    assert_eq(texts(layout.view(m)).len, 0);
}

@test
fun no_tabs_rail_or_notice_above_the_page() {
    let v = layout.view(busy());
    assert(!texts(v).any(fun(s: string) = s == "Something happened"));
    assert(click(v, "New tab").is_err());
    assert(pick(v, "a", "Close tab").is_err());
}

@test
fun the_content_area_shows_the_current_app() {
    let v = layout.view(busy());
    assert(texts(v).any(fun(s: string) = s == "echo"));
    assert(click(v, "Add").is_ok());
}

@test
fun homes_content_area_is_empty() {
    let (m, _) = update(busy(), Msg.Home);
    let v = layout.view(Model { notice: None, ..m });
    assert(!texts(v).any(fun(s: string) = s == "echo"));
    assert(click(v, "Add").is_err());
}

@test
fun the_shell_shows_the_layout() {
    let m = busy();
    assert_eq(texts(view(m)), texts(layout.view(m)));
}
