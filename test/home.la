// What the new tab reads (PRP-030): your pins and where you left off, as
// Rapidkoi answers them, and what open_pin and continue open. Pure apart
// from fixture guests; no display.
import rapidkoi.guest.home {
    place_of,
    pins_of,
    left_off_of,
    pin_msg,
    continue_msg,
    session_of,
    recent_of,
    recent_msg,
};
import rapidkoi.data.remembered { Open, OpenTab, Face };
import rapidkoi.window.recent { Place, Recent };
import rapidkoi.ui.themes { publisher_colour };
import rapidkoi.data.saving { open_of };
import rapidkoi.shell { update };
import rapidkoi.window.window { Model, with_pages };
import rapidkoi.window.actions { Msg };
import rapidkoi.window.tabs { AppPage, Pin, open_module };
import wasmtime { Engine, Module };
import cbor { Value };
import support { t, kv, echo };

fun app(engine: Engine, name: string): AppPage = open_module(
    name,
    "apps/{name}.wasm",
    engine,
    Module.from_text(engine, echo()).unwrap(),
);

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

fun pin(name: string, path: string, icon: Option<u8[]>): Pin = Pin {
    name: name,
    path: path,
    icon: icon,
    origin: None,
};

@test
fun a_place_is_a_host_or_a_bare_file_name() {
    assert_eq(place_of("rapidkoi://quote.dafifi.net"), "quote.dafifi.net");
    assert_eq(place_of("rapidkoi://localhost:8000/"), "localhost:8000");
    assert_eq(place_of("/home/amina/apps/counter.rkb"), "counter.rkb");
    assert_eq(place_of("counter.wasm"), "counter.wasm");
}

@test
fun pins_are_listed_in_order_without_paths() {
    let m = Model {
        pinned: [
            pin("Quote", "rapidkoi://quote.dafifi.net", Some([1, 2])),
            pin("Counter", "/home/amina/counter.rkb", None),
        ],
        ..with_pages(Engine.new(), []),
    };
    assert_eq(
        pins_of(m),
        Value.Array([
            // PRP-060: an icon is named for Rapidkoi to draw (`icon:`), never sent as bytes.
            kv([
                ("name", t("Quote")),
                ("place", t("quote.dafifi.net")),
                ("icon", t("icon:quote.dafifi.net")),
            ]),
            kv([("name", t("Counter")), ("place", t("counter.rkb")), ("icon", t("icon:counter.rkb"))]),
        ]),
    );
    assert_eq(pins_of(with_pages(Engine.new(), [])), Value.Array([]));
}

@test
fun at_most_64_pins_are_listed() {
    let mut many: Pin[] = [];
    for i of range(0, 70) {
        many.push(pin("p{i}", "p{i}.wasm", None));
    }
    let listed = pins_of(Model { pinned: many, ..with_pages(Engine.new(), []) });
    assert_eq(listed.as_array().map(fun(xs: Value[]) = xs.len), Some(64));
}

@test
fun left_off_and_continue_answer_from_the_newest_place() {
    // DECISION-044: kept for contract 11 apps, from your recent places.
    let engine = Engine.new();
    let m = step(with_pages(engine, [app(engine, "notes")]), Msg.NewTab);
    let notes = kv([
        ("name", t("notes")),
        ("place", t("notes.wasm")),
        ("icon", t("icon:notes.wasm")),
    ]);
    // It left the front: it's your newest place.
    assert_eq(left_off_of(m), notes);
    assert_eq(continue_msg(m), Some(Msg.OpenPlace("apps/notes.wasm", None)));
    let closed = step(m, Msg.CloseTab(0));
    assert_eq(left_off_of(closed), notes);
}

@test
fun recent_answers_newest_first_and_opens_a_place() {
    // PRP-062: at most 64, each with its icon to show, its address, and when; no folders.
    let engine = Engine.new();
    let m = step(
        step(with_pages(engine, [app(engine, "notes"), app(engine, "quote")]), Msg.Select(1)),
        Msg.CloseTab(1),
    );
    assert_eq(
        recent_of(m),
        kv([
            (
                "places",
                Value.Array([
                    kv([
                        ("name", t("quote")),
                        ("place", t("quote.wasm")),
                        ("icon", t("icon:quote.wasm")),
                        ("address", t("quote.wasm")),
                        ("seen", Value.int(m.recent.places[0].seen)),
                        // No colour named: the palette's, by its name (PRP-063).
                        ("colors", kv([("primary", t(publisher_colour(m.theme, "quote".to_bytes())))])),
                    ]),
                    kv([
                        ("name", t("notes")),
                        ("place", t("notes.wasm")),
                        ("icon", t("icon:notes.wasm")),
                        ("address", t("notes.wasm")),
                        ("seen", Value.int(m.recent.places[1].seen)),
                        ("colors", kv([("primary", t(publisher_colour(m.theme, "notes".to_bytes())))])),
                    ]),
                ]),
            ),
        ]),
    );
    assert_eq(recent_msg(m, 1), Some(Msg.OpenPlace("apps/notes.wasm", None)));
    assert_eq(recent_msg(m, 2), None);
    assert_eq(recent_of(with_pages(engine, [])), kv([("places", Value.Array([]))]));
}

@test
fun nothing_left_off_is_null() {
    let m = with_pages(Engine.new(), []);
    assert_eq(left_off_of(m), Value.Null);
    assert_eq(continue_msg(m), None);
}

@test
fun open_pin_is_checked_against_the_pins_now() {
    let m = Model {
        pinned: [pin("Quote", "rapidkoi://quote.dafifi.net", None)],
        ..with_pages(Engine.new(), []),
    };
    assert_eq(pin_msg(m, 0), Some(Msg.OpenPinned("rapidkoi://quote.dafifi.net", None)));
    assert_eq(pin_msg(m, 1), None);
}

@test
fun the_last_session_is_its_size_and_its_apps() {
    // PRP-035: what "Restore previous session" will bring back.
    let tab = fun(path: string, instance: string) = OpenTab {
        link: [],
        path: path,
        instance: instance,
        label: None,
        seen: 0,
        origin: None,
    };
    let m = Model {
        previous: Some(Open {
            apps: [
                Face {
                    path: "rapidkoi://quote.dafifi.net",
                    name: "Quote",
                    icon: None,
                    colour: None,
                },
            ],
            tabs: [
                tab("rapidkoi://quote.dafifi.net", ""),
                tab("apps/notes.wasm", ""),
                tab("apps/notes.wasm", "2"),
            ],
            current: None,
        }),
        ..with_pages(Engine.new(), []),
    };
    assert_eq(
        session_of(m),
        // PRP-060: each app once, by its name (its place when the session didn't keep one) and its icon.
        kv([
            ("count", Value.int(3)),
            (
                "apps",
                Value.Array([
                    kv([("name", t("Quote")), ("place", t("quote.dafifi.net")), ("icon", t("icon:quote.dafifi.net"))]),
                    kv([("name", t("notes.wasm")), ("place", t("notes.wasm")), ("icon", t("icon:notes.wasm"))]),
                ]),
            ),
        ]),
    );
    assert_eq(session_of(with_pages(Engine.new(), [])), Value.Null);
}

@test
fun the_session_saved_keeps_each_app_s_name_and_icon_once() {
    // PRP-060: what the new tab's Restore will show, kept as the session's apps.
    let engine = Engine.new();
    let notes = AppPage { icon: Some([1, 2]), ..app(engine, "notes") };
    let m = with_pages(engine, [notes, app(engine, "quote"), notes]);
    assert_eq(open_of(m).apps, [
        Face { path: "apps/notes.wasm", name: "notes", icon: Some([1, 2]), colour: None },
        Face { path: "apps/quote.wasm", name: "quote", icon: None, colour: None },
    ]);
}

@test
fun recent_lists_each_app_once_by_its_newest_place() {
    // The owner, 2026-11-02: "only one app can be in recents".
    let place = fun(address: string, path: string, name: string, seen: i64) = Place {
        address: address,
        path: path,
        origin: None,
        name: name,
        title: None,
        seen: seen,
    };
    let m = Model {
        recent: Recent {
            places: [
                place(
                    "rapidkoi://notes.dafifi.net/@0.9.0?note=5",
                    "rapidkoi://notes.dafifi.net",
                    "Notes",
                    3,
                ),
                place(
                    "rapidkoi://notes.dafifi.net/@0.9.0?note=4",
                    "rapidkoi://notes.dafifi.net",
                    "Notes",
                    2,
                ),
                place("counter.wasm", "counter.wasm", "Counter", 1),
            ],
            apps: [],
        },
        ..with_pages(Engine.new(), []),
    };
    let listed = match recent_of(m).get("places") {
        Some(Array(xs)) => xs.map(
            fun(x: Value) = x.get("address").and_then(fun(a: Value) = a.as_text()).unwrap_or(""),
        ),
        _ => [],
    };
    assert_eq(listed, ["rapidkoi://notes.dafifi.net/@0.9.0?note=5", "counter.wasm"]);
    // The index is into that list: 1 is Counter, not Notes' older place.
    assert_eq(recent_msg(m, 1), Some(Msg.OpenPlace("counter.wasm", None)));
    assert_eq(recent_msg(m, 2), None);
}

@test
fun a_place_carries_its_app_s_primary_colour() {
    // PRP-063: the colour the app names, kept with its recent places.
    let p = Place {
        address: "notes.wasm",
        path: "notes.wasm",
        origin: None,
        name: "Notes",
        title: None,
        seen: 1,
    };
    let m = Model {
        recent: Recent {
            places: [p],
            apps: [Face { path: "notes.wasm", name: "Notes", icon: None, colour: Some("#14b8a6") }],
        },
        ..with_pages(Engine.new(), []),
    };
    let colour = match recent_of(m).get("places") {
        Some(Array(xs)) => xs[0].get("colors").and_then(fun(c: Value) = c.get("primary")),
        _ => None,
    };
    assert_eq(colour, Some(t("#14b8a6")));
}
