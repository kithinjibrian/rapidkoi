// The frame, home and the info panel, pure: what each shows and sends,
// checked through kivuli.testing with no display.
import rapidkoi.frame { Bar, bar, rail, label, initial, icon_of, marker };
import rapidkoi.panel { first_trusted };
import rapidkoi.verify { Trust, Standing };
import rapidkoi.home { Card, matches };
import rapidkoi.tabs { Page, Tab, Pin, AppPage, open_module };
import rapidkoi.bundle { Manifest };
import rapidkoi.actions { Msg };
import rapidkoi.render;
import kivuli { View, Image, row, hex };
import kivuli.testing { Lookup, click, is_disabled, press, submit, texts, tooltip, type_into };
import wasmtime { Engine, Module };
import rapidkoi.themes { DARK, Look, surface };
import support { png, fixed, titled_tree, result_of };

fun counter(): AppPage {
    let engine = Engine.new();
    let wat = fixed(1, [1], titled_tree("Count: 0", "Counter"), result_of([2]));
    open_module("counter", "apps/counter.wasm", engine, Module.from_text(engine, wat).unwrap())
}

/** The bar's parts in one row, as the header bar shows them. */
fun shown(b: Bar): View<Msg> {
    let mut all = b.start;
    all.push(b.title);
    for e of b.end {
        all.push(e);
    }
    row(all)
}

fun pins(n: i64): Pin[] {
    let mut out: Pin[] = [];
    for i in 0..n {
        out.push(Pin { name: "app{i}", path: "app{i}.wasm", icon: None });
    }
    out
}

@test
fun the_bar_on_home() {
    let v = shown(bar(Page.Home, "", false, false));
    assert_eq(is_disabled(v, "Back (comes with links)"), Ok(true));
    assert_eq(is_disabled(v, "Forward (comes with links)"), Ok(true));
    assert_eq(is_disabled(v, "Share (comes with links)"), Ok(true));
    assert_eq(click(v, "App info"), Err(Lookup.NotFound("button \"App info\"")));
    assert_eq(press(v, "Ctrl+K"), Ok(Msg.FocusSearch));
    assert_eq(type_into(v, "address", "count"), Ok(Msg.Draft("count")));
    assert_eq(submit(v, "address"), Ok(Msg.Go));
}

@test
fun the_bar_on_an_app_page() {
    let v = shown(bar(Page.App(counter()), "", false, false));
    assert_eq(click(v, "App info"), Ok(Msg.TogglePanel));
    assert_eq(click(v, "Home"), Ok(Msg.Home));
    assert_eq(click(v, "📄 counter.wasm · local file"), Ok(Msg.EditAddress));
    assert_eq(press(v, "Ctrl+K"), Ok(Msg.EditAddress));
    // Editing turns the address back into the box.
    assert_eq(
        submit(shown(bar(Page.App(counter()), "apps/counter.wasm", true, false)), "address"),
        Ok(Msg.Go),
    );
}

@test
fun the_rail() {
    let open = [Tab { id: 2, page: counter() }];
    let v = rail(open, Some(2));
    // Home isn't a tab: the rail lists apps only.
    assert_eq(click(v, "Home tab"), Err(Lookup.NotFound("button \"Home tab\"")));
    assert_eq(click(v, "counter · Counter"), Ok(Msg.Select(2)));
    assert_eq(click(rail(open, None), "counter · Counter"), Ok(Msg.Select(2)));
    assert_eq(click(v, "New tab"), Ok(Msg.NewTab));
    assert_eq(is_disabled(v, "Settings (coming soon)"), Ok(true));
    assert_eq(is_disabled(v, "More (coming soon)"), Ok(true));
}

@test
fun labels_and_initials() {
    assert_eq(label(counter()), "counter · Counter");
    assert_eq(initial("counter"), "C");
    assert_eq(initial(""), "?");
}

@test
fun an_empty_home_explains_how_to_start() {
    let v = home.view("", [], None, []);
    assert_eq(texts(v), [
        "◯",
        "Rapidkoi",
        "Open an app: type the path of a .wasm file above, then press Enter.",
    ]);
}

@test
fun home_shows_where_you_left_off_and_pinned() {
    let c = Card { name: "counter", title: Some("Counter"), msg: Msg.Select(3), icon: None };
    let v = home.view("", pins(5), Some(c), []);
    assert_eq(texts(v)[2], "Where you left off");
    assert_eq(texts(v)[3], "counter · Counter");
    assert_eq(click(v, "Continue"), Ok(Msg.Select(3)));
    assert_eq(texts(v)[4], "Pinned");
    assert_eq(click(v, "Open app4"), Ok(Msg.OpenPinned("app4.wasm")));
}

@test
fun searching_filters_home() {
    let open = [Tab { id: 7, page: counter() }];
    let v = home.view("COUNT", pins(3), None, open);
    assert_eq(click(v, "Open counter"), Ok(Msg.Select(7)));
    assert_eq(click(v, "Open app1"), Err(Lookup.NotFound("button \"Open app1\"")));
    let closed = Card { name: "counter", title: Some("Counter"), msg: Msg.Continue, icon: None };
    let by_title = home.view("counter", [], Some(closed), []);
    assert_eq(click(by_title, "Open counter"), Ok(Msg.Continue));
    assert_eq(texts(home.view("zzz", pins(3), None, [])), [
        "◯",
        "Rapidkoi",
        "Nothing matches “zzz”",
    ]);
}

@test
fun matching_ignores_case_and_reads_titles() {
    assert_eq(matches("COUNT", "counter", None), true);
    assert_eq(matches("sprint", "board", Some("Sprint 3")), true);
    assert_eq(matches("mail", "board", Some("Sprint 3")), false);
}

@test
fun the_dark_theme() {
    assert_eq(surface(DARK, Look.Frame).background, Some(hex("#242424")));
    assert_eq(surface(DARK, Look.Page).background, Some(hex("#161616")));
    // Only the top-right corner curves.
    assert_eq(surface(DARK, Look.Page).radius_top_right, Some(12));
    assert_eq(surface(DARK, Look.Page).radius, None);
    assert_eq(surface(DARK, Look.Page).radius_top_left, None);
    // Only backgrounds: text and borders stay the GTK theme's.
    assert_eq(surface(DARK, Look.Page).text, None);
    assert_eq(surface(DARK, Look.Frame).radius, None);
    // The frame is flat: no theme shadow under the header bar.
    assert_eq(surface(DARK, Look.Frame).flat, Some(true));
    assert_eq(surface(DARK, Look.Page).flat, None);
}

@test
fun an_app_with_an_icon_shows_it_on_its_tab_and_tile() {
    let page = AppPage { icon: Some(png(64, 64)), ..counter() };
    let v = rail([Tab { id: 2, page: page }], Some(2));
    // Found by its tooltip; there's no letter on it any more.
    assert_eq(click(v, "counter · Counter"), Ok(Msg.Select(2)));
    assert_eq(click(v, "C"), Err(Lookup.NotFound("button \"C\"")));
    let pins = [Pin { name: "counter", path: "apps/counter.rkb", icon: Some(png(64, 64)) }];
    let h = home.view("", pins, None, []);
    assert_eq(click(h, "Open counter"), Ok(Msg.OpenPinned("apps/counter.rkb")));
    assert_eq(click(h, "C"), Err(Lookup.NotFound("button \"C\"")));
}

@test
fun icons_are_keyed_by_file() {
    assert_eq(
        icon_of("apps/counter.rkb", Some([1])),
        Some(Image.Bytes("apps/counter.rkb#icon", [1])),
    );
    assert_eq(icon_of("apps/counter.rkb", None), None);
}

/** A page from `path` signed by a key trusted `standing`, first trusted at `since`. */
fun signed_page(path: string, host: string, standing: Standing, since: i64): AppPage = AppPage {
    path: path,
    trust: Some(Trust {
        host: host,
        key: [7; 32],
        standing: standing,
        build: [1; 32],
        separate: false,
        since: since,
    }),
    ..counter(),
};

@test
fun the_marker_says_development_only_for_this_machine() {
    let remote = signed_page(
        "rapidkoi://counter.dafifi.net",
        "counter.dafifi.net",
        Standing.Verified,
        0,
    );
    assert_eq(marker(remote, "x"), "✓ counter.dafifi.net · verified");
    let local = signed_page("rapidkoi://localhost:8000", "localhost:8000", Standing.Verified, 0);
    assert_eq(marker(local, "x"), "✓ localhost:8000 · verified (development)");
}

@test
fun about_says_when_a_key_was_first_trusted() {
    // 18 October 2026, 09:00 UTC.
    assert_eq(first_trusted(1_792_314_000_000), "Trusted since 18 Oct 2026, first use");
    assert_eq(first_trusted(0), "Trusted on first use (date not recorded)");
    assert_eq(first_trusted(951_782_400_000), "Trusted since 29 Feb 2000, first use");
}
