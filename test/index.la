// The signed index and the public key file, pure apart from std.crypto:
// signing, verifying, versions, pruning, withdrawing, and key rotations.
import rapidkoi.trust.index {
    Index,
    Version,
    KeyFile,
    IndexError,
    sign_index,
    read_index,
    add,
    prune,
    withdraw,
    key_file,
    read_key_file,
    rotate,
    follow,
    reason,
};
import rapidkoi.trust.keys { SecretKey };
import std.crypto { ed25519_keypair, sha256 };
import cbor { Value, Entry, Limits, decode, encode };

fun key(host: string): SecretKey {
    let (secret, pk) = ed25519_keypair().unwrap();
    SecretKey { host: host, secret: secret, public_key: pk }
}

fun empty(host: string): Index = Index { host: host, sequence: 0, current: "", versions: [] };

fun hash(n: u8): u8[] = sha256([n]);

fun why<T>(r: Result<T, IndexError>): string = match r {
    Err(e) => reason(e),
    Ok(_) => "ok",
};

@test
fun an_index_round_trips() {
    let k = key("a.example");
    let ix = add(
        add(empty("a.example"), "1.0.0", hash(1), 10).unwrap(),
        "1.1.0",
        hash(2),
        20,
    ).unwrap();
    assert_eq((ix.sequence, ix.current, ix.versions.len), (2, "1.1.0", 2));
    let back = read_index(sign_index(ix, k).unwrap(), k.public_key, "a.example").unwrap();
    assert_eq(back == ix, true);
}

@test
fun a_tampered_or_foreign_index_is_refused() {
    let k = key("a.example");
    let signed = sign_index(add(empty("a.example"), "1.0.0", hash(1), 10).unwrap(), k).unwrap();
    assert_eq(
        why(read_index(signed, key("a.example").public_key, "a.example")),
        "The app's index isn't signed by its publisher's key",
    );
    assert_eq(
        why(read_index(signed, k.public_key, "b.example")),
        "The app's index is for a.example, not b.example",
    );
    let root = decode(signed, Limits.default()).unwrap();
    let mut body = root.get("body").unwrap().as_bytes().unwrap();
    body[body.len - 1] = body[body.len - 1] ^ 1;
    let tampered = encode(
        Value.Map(
            root.as_map().unwrap().map(
                fun(e: Entry) = if e.key == Value.Text("body") {
                    Entry { key: e.key, value: Value.Bytes(body) }
                } else {
                    e
                },
            ),
        ),
    );
    assert_eq(
        why(read_index(tampered, k.public_key, "a.example")),
        "The app's index isn't signed by its publisher's key",
    );
    assert_eq(
        why(read_index([1, 2], k.public_key, "a.example")).starts_with(
            "The app's index can't be read",
        ),
        true,
    );
}

@test
fun versions_are_never_reused_for_other_bytes() {
    let ix = add(empty("a.example"), "1.0.0", hash(1), 10).unwrap();
    assert_eq(
        why(add(ix, "1.0.0", hash(9), 10)),
        "Version 1.0.0 is already published with different bytes",
    );
    let same = add(ix, "1.0.0", hash(1), 10).unwrap();
    assert_eq((same.sequence, same.versions.len), (1, 1));
    assert_eq(
        why(add(ix, "1.0", hash(2), 10)),
        "1.0 isn't a version: use MAJOR.MINOR.PATCH, like 1.4.0",
    );
}

@test
fun pruning_keeps_current_and_withdrawn() {
    let mut ix = empty("a.example");
    for i in 0..5 {
        ix = add(ix, "1.{i}.0", hash(i as u8), 10).unwrap();
    }
    ix = withdraw(ix, "1.0.0", "broken").unwrap();
    let (kept, removed) = prune(ix, 2);
    assert_eq(kept.versions.map(fun(v: Version) = v.version), ["1.0.0", "1.3.0", "1.4.0"]);
    assert_eq(removed, [hash(1), hash(2)]);
    assert_eq(kept.current, "1.4.0");
}

@test
fun withdrawing_marks_a_version_and_moves_the_sequence() {
    let ix = add(empty("a.example"), "1.0.0", hash(1), 10).unwrap();
    let w = withdraw(ix, "1.0.0", "Security fix in 1.0.1").unwrap();
    assert_eq(w.versions[0].withdrawn, Some("Security fix in 1.0.1"));
    assert_eq(w.sequence, ix.sequence + 1);
    assert_eq(why(withdraw(ix, "9.9.9", "x")), "There's no version 9.9.9 to withdraw");
}

@test
fun a_key_file_round_trips() {
    let k = key("a.example");
    let kf = KeyFile { host: "a.example", key: k.public_key, rotations: [] };
    assert_eq(read_key_file(key_file(kf)).unwrap() == kf, true);
    assert_eq(why(read_key_file([0])).starts_with("The app's key file can't be read"), true);
}

@test
fun rotations_signed_by_the_old_key_are_followed() {
    let old = key("a.example");
    let mid = key("a.example");
    let new = key("a.example");
    let kf = KeyFile {
        host: "a.example",
        key: new.public_key,
        rotations: [rotate(old, mid.public_key).unwrap(), rotate(mid, new.public_key).unwrap()],
    };
    assert_eq(follow(old.public_key, kf), Ok(new.public_key));
    assert_eq(follow(new.public_key, kf), Ok(new.public_key));
    // A trail that isn't signed by the trusted key leads nowhere.
    let stranger = key("a.example");
    assert_eq(
        why(follow(stranger.public_key, kf)),
        "The app's key changed without its old key's approval",
    );
    let forged = KeyFile {
        host: "a.example",
        key: new.public_key,
        rotations: [rotate(stranger, new.public_key).unwrap()],
    };
    assert_eq(
        why(follow(old.public_key, forged)),
        "The app's key changed without its old key's approval",
    );
}
