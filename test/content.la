// The content area (PRP-047): each picture drawn as its page has it.

import rapidkoi.ui.content { with_shown, screen_key };
import rapidkoi.ui.paint { Own };
import rapidkoi.ui.schemes { DARK, LIGHT, Theme };
import rapidkoi.window.downloaded { Kept };
import rapidkoi.guest.nodes { Node, Picture, Fitting, Shown };
import rapidkoi.guest.styles { plain };
import rapidkoi.guest.roles { no_facts };

fun picture(source: string): Node = Node.Pictured(
    Picture {
        source: source,
        fit: Fitting.Contain,
        colour: None,
        label: None,
        on_load: None,
        on_fail: None,
        shown: Shown.Waiting,
    },
    plain(),
);

fun shown(n: Node): Shown[] = match n {
    Pictured(p, _) => [p.shown],
    Boxed(_, _, _, kids) => {
        let mut out: Shown[] = [];
        for k of kids {
            out = out + shown(k);
        }
        out
    }
    _ => [],
};

@test
fun each_picture_is_drawn_as_its_page_has_it() {
    let root = Node.Boxed(plain(), no_facts(), None, [
        picture("asset:a.svg"),
        picture("asset:missing.svg"),
        picture("https://a.com/here.png"),
        picture("https://a.com/coming.png"),
        picture("https://a.com/gone.png"),
        picture("https://a.com/unasked.png"),
    ]);
    let assets: (string, u8[])[] = [("a.svg", [1, 2])];
    let kept = [
        ("https://a.com/here.png", Kept.Here([3, 4], 16, 1)),
        ("https://a.com/coming.png", Kept.Coming),
        ("https://a.com/gone.png", Kept.Gone),
    ];
    assert_eq(
        shown(with_shown(root, assets, kept)) == [
            Shown.Ready([1, 2]),
            Shown.Broken,
            Shown.Ready([3, 4]),
            Shown.Waiting,
            Shown.Broken,
            Shown.Waiting,
        ],
        true,
    );
}

@test
fun an_apps_screen_is_rebuilt_only_when_what_it_shows_changes() {
    // The lazy fix (the owner, 2026-10-31): a popover, a notice or the dock
    // leaves this key as it was, so the app's screen is neither rebuilt
    // nor compared; anything the screen shows changes it.
    let mine = Own { colours: false, text_size: false };
    let none: (string, Kept)[] = [];
    let key = fun(
        id: i64,
        state: u8[],
        t: Theme,
        own: Own,
        first: string,
        pics: (string, Kept)[],
    ) = screen_key(id, state, t, own, first, "", pics);
    let base = key(1, [1, 2, 3], DARK, mine, "Amina", none);
    assert_eq(key(1, [1, 2, 3], DARK, mine, "Amina", none), base);
    assert(key(2, [1, 2, 3], DARK, mine, "Amina", none) != base);
    assert(key(1, [1, 2, 4], DARK, mine, "Amina", none) != base);
    assert(key(1, [1, 2, 3], LIGHT, mine, "Amina", none) != base);
    assert(key(1, [1, 2, 3], Theme { scale: 1.5, ..DARK }, mine, "Amina", none) != base);
    assert(key(1, [1, 2, 3], DARK, Own { colours: true, ..mine }, "Amina", none) != base);
    assert(key(1, [1, 2, 3], DARK, Own { text_size: true, ..mine }, "Amina", none) != base);
    assert(key(1, [1, 2, 3], DARK, mine, "Juma", none) != base);
    let coming = key(1, [1, 2, 3], DARK, mine, "Amina", [("a.png", Kept.Coming)]);
    assert(coming != base);
    let here = key(1, [1, 2, 3], DARK, mine, "Amina", [("a.png", Kept.Here([9], 4, 1))]);
    assert(here != coming);
    // When a picture was last on screen is no part of what it shows.
    assert_eq(key(1, [1, 2, 3], DARK, mine, "Amina", [("a.png", Kept.Here([9], 4, 7))]), here);
}
