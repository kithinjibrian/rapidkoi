// Pages in tabs: starting a guest, events and Restart, leaving a page and
// resuming it with its saved state. Fixture guests; no display.
import rapidkoi.bundles.bundle { Bundle, Manifest, write };
import rapidkoi.window.tabs { AppPage, open_module, open_path, handle, state_of };
import rapidkoi.window.restarts { resume };
import rapidkoi.window.leftoff { leave };
import rapidkoi.ui.render { Msg };
import rapidkoi.guest.events { Happened, event_for };
import cbor { Value, encode };
import wasmtime { Engine, Module };
import rapidkoi.trust.verify { keyring };
import support { t, kv, fixed, counter_tree, result_of, echo, event_in, titled_tree, crashing };

fun page(wat: string): AppPage {
    let engine = Engine.new();
    open_module("fixture", "fixture.wasm", engine, Module.from_text(engine, wat).unwrap())
}

fun reason_of(p: AppPage): string = match p.screen {
    Stopped(r, _) => r,
    Refused(r) => r,
    _ => "running",
};

/** The event pressing an echo app's "Add" sends it. */
fun added(): u8[] = event_for(Happened.Message(t("add"), None));

@test
fun a_page_starts_and_keeps_its_title() {
    let five = kv([("count", Value.int(5))]);
    let p = page(
        fixed(five, titled_tree("Count: 0", "Counter"), result_of(kv([("count", Value.int(6))]))),
    );
    assert_eq(state_of(p), Some(encode(five)));
    assert_eq(p.title, Some("Counter"));
    assert_eq(p.name, "fixture");
}

@test
fun events_and_restart() {
    let p = page(echo());
    let next = handle(p, Msg.Event(t("add"), None));
    assert_eq(state_of(next).map(event_in), Some(added()));
    let again = handle(next, Msg.Restart);
    assert_eq(state_of(again).map(event_in), Some([]));
}

@test
fun a_crash_stops_the_page_and_events_are_then_ignored() {
    let p = handle(page(crashing()), Msg.Event(t("add"), None));
    assert_eq(reason_of(p).starts_with("This app crashed"), true);
    assert_eq(reason_of(handle(p, Msg.Event(t("add"), None))), reason_of(p));
    assert_eq(state_of(p), None);
}

@test
fun leaving_keeps_the_state_and_resume_restores_it() {
    let p = handle(page(echo()), Msg.Event(t("add"), None));
    let left = leave(p);
    assert_eq(left.state.map(event_in), Some(added()));
    // `init` would give an empty state, so this one can only come from `view(saved)`.
    assert_eq(state_of(resume(left)).map(event_in), Some(added()));
}

@test
fun leaving_a_stopped_page_resumes_fresh() {
    let p = handle(page(crashing()), Msg.Event(t("add"), None));
    let left = leave(p);
    assert_eq(left.state, None);
    assert_eq(state_of(resume(left)).map(event_in), Some([]));
}

@test
fun opening_paths() {
    let engine = Engine.new();
    assert_eq(
        reason_of(open_path(engine, keyring(), "no/such/app.wasm")).starts_with(
            "Couldn't read no/such/app.wasm",
        ),
        true,
    );
    let not_wasm = open_path(engine, keyring(), "lugha.toml");
    assert_eq(reason_of(not_wasm).starts_with("This file isn't a WebAssembly app"), true);
    assert_eq(not_wasm.name, "lugha.toml");
    // Restart can't help when the module never loaded.
    match not_wasm.screen {
        Stopped(_, can_restart) => assert_eq(can_restart, false),
        _ => panic("expected a stopped page"),
    }
}

/** Writes a bundle to test/tmp, its manifest speaking contract `speaks`, and gives its path. */
fun rkb(tag: string, speaks: i64): string {
    let path = "test/tmp/{tag}.rkb";
    let m = Manifest {
        contract: speaks,
        name: "Bundled",
        version: "2.0.1",
        description: Some("A bundle"),
        state_version: 4,
        icon: None,
        banners: [],
        servers: [],
        permissions: [],
        controls: None,
    };
    // An empty module: it compiles, then stops for want of `memory`.
    let bytes = write(Bundle {
        manifest: m,
        module: [0, 97, 115, 109, 1, 0, 0, 0],
        assets: [],
    }).unwrap();
    write_bytes(path, bytes).unwrap();
    path
}

@test
fun opening_a_bundle_uses_its_manifest() {
    let p = open_path(Engine.new(), keyring(), rkb("opening", 7));
    assert_eq(p.name, "Bundled");
    assert_eq(p.manifest.map(fun(m: Manifest) = m.version), Some("2.0.1"));
    // The module compiled; the empty module has no memory, so it stops with Restart offered.
    assert_eq(reason_of(p), "This app is missing \"memory\"");
    assert_eq(leave(p).state_version, 4);
}

@test
fun a_bundle_for_a_newer_contract_says_so() {
    let p = open_path(Engine.new(), keyring(), rkb("newer", 8));
    assert_eq(reason_of(p), "This app needs a newer version of Rapidkoi");
    assert_eq(p.name, "Bundled");
}

@test
fun a_bundle_for_an_older_contract_is_to_be_rebuilt() {
    // DECISION-056: refused before its module is touched.
    for v of [2, 6] {
        let p = open_path(Engine.new(), keyring(), rkb("older-{v}", v));
        assert_eq(reason_of(p), "This app needs to be rebuilt for this Rapidkoi");
    }
}

@test
fun a_broken_bundle_shows_why() {
    write_bytes("test/tmp/broken.rkb", [1, 2, 3]).unwrap();
    let p = open_path(Engine.new(), keyring(), "test/tmp/broken.rkb");
    assert_eq(reason_of(p).starts_with("This file isn't a Rapidkoi bundle"), true);
    assert_eq(p.name, "broken.rkb");
    assert_eq(p.manifest.is_none(), true);
}
