// An app's account (PRP-011, PRP-052): who you are to it, Sign in, your
// name, and Forget: reopened, it sees someone new. The facts the Account page
// will show, checked on the model: its page comes back natively later
// (DECISION-030). Writes only under test/tmp/.
import rapidkoi.shell { update };
import rapidkoi.window.window { Model, with_pages };
import rapidkoi.people.account { Account, account_of };
import rapidkoi.data.saving { restore };
import rapidkoi.window.actions { Msg, PanelPage, Confirm, NameScope, NamePart };
import rapidkoi.window.tabs { AppPage, open_module, state_of };
import rapidkoi.trust.verify { Trust, Standing };
import rapidkoi.people.people { person };
import rapidkoi.people.identity { master, public_key, user_label };
import rapidkoi.guest.events { Happened, event_for };
import rapidkoi.data.store { Store, store_at };
import cbor { Value, Entry, encode };
import std.fs;
import rapidkoi.data.databases { path_for };
import wasmtime { Engine, Module };
import support { echo_init, t, kv, echo, event_in };

const HOST: string = "notes.acme.com";

fun clean(path: string) {
    if fs.is_dir(path) {
        for name of fs.list_dir(path).unwrap() {
            clean("{path}/{name}");
        }
        fs.remove_dir(path).unwrap();
    } else if fs.exists(path) {
        fs.remove_file(path).unwrap();
    }
}

fun folder(name: string): Store {
    let dir = "test/tmp/account-{name}";
    clean(dir);
    store_at(dir)
}

fun asking(): u8[] = encode(
    Value.Map([
        Entry { key: t("state"), value: kv([]) },
        Entry {
            key: t("effects"),
            value: Value.Array([kv([("kind", t("identity")), ("msg", t("me"))])]),
        },
    ]),
);

fun trust(): Trust = Trust {
    host: HOST,
    key: [3; 32],
    standing: Standing.Verified,
    build: [0; 32],
    separate: false,
    since: 0,
    origin: [3; 32],
};

/** Notes, signed and asking for its key at init, in a window on `s`, its Account page open. */
fun notes(s: Store): Model {
    let engine = Engine.new();
    let p = AppPage {
        trust: Some(trust()),
        ..open_module(
            "Notes",
            "rapidkoi://notes.acme.com",
            engine,
            Module.from_text(engine, echo_init(asking())).unwrap(),
        ),
    };
    let (m, _) = update(restore(with_pages(engine, [p]), s), Msg.TogglePanel);
    step(m, Msg.PanelGo(PanelPage.Name))
}

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

/** Who you are to the first tab's app: the facts the Account page will show. */
fun facts(m: Model): Account = account_of(m, m.tabs[0].page);

fun key(s: Store, generation: i64): u8[] = public_key(
    master(s).unwrap(),
    HOST,
    [3; 32],
    generation,
).unwrap();

/** The event Rapidkoi sends with an answer. */
fun answer(msg: Value, value: Value): u8[] = event_for(Happened.Answer(msg, value));

@test
fun it_says_who_you_are_to_this_app() {
    let s = folder("who");
    // A message lets the app's init ask; then the page shows the key's label.
    let m = step(notes(s), Msg.PanelGo(PanelPage.Name));
    assert_eq(facts(m).label, Some(user_label(key(s, 0))));
    clean(s.dir);
}

@test
fun the_sign_in_switch() {
    let s = folder("out");
    let m = notes(s);
    let off = step(m, Msg.SetSignIn(false));
    assert_eq(person(off.people, HOST, [3; 32]).signs_in, false);
    assert_eq(person(step(off, Msg.SetSignIn(true)).people, HOST, [3; 32]).signs_in, true);
    clean(s.dir);
}

@test
fun a_forgotten_app_sees_someone_new_every_time() {
    let s = folder("forget");
    // Its init asked, and got the first key.
    let m = notes(s);
    assert_eq(
        state_of(m.tabs[0].page).map(event_in),
        Some(answer(t("me"), Value.Bytes(key(s, 0)))),
    );
    let gone = step(step(m, Msg.Ask(Confirm.Forget)), Msg.Forget);
    assert_eq(gone.people.apps.len, 0);
    // Opened again on the same folder: the next key, never the first.
    let again = notes(s);
    assert_eq(
        state_of(again.tabs[0].page).map(event_in),
        Some(answer(t("me"), Value.Bytes(key(s, 1)))),
    );
    step(step(again, Msg.Ask(Confirm.Forget)), Msg.Forget);
    assert_eq(
        state_of(notes(s).tabs[0].page).map(event_in),
        Some(answer(t("me"), Value.Bytes(key(s, 2)))),
    );
    clean(s.dir);
}

@test
fun a_failed_removal_still_forgets_who_you_were() {
    let s = folder("stuck");
    let m = notes(s);
    // A folder where its database would be: removing it fails.
    let path = path_for(s, m.tabs[0].page).unwrap();
    fs.make_dirs(path).unwrap();
    let gone = step(step(m, Msg.Ask(Confirm.Forget)), Msg.Forget);
    assert_eq(gone.notice.map(fun(n) = n.short), Some("Notes's data couldn't be removed"));
    // Its next key was kept all the same.
    assert_eq(
        state_of(notes(s).tabs[0].page).map(event_in),
        Some(answer(t("me"), Value.Bytes(key(s, 1)))),
    );
    clean(s.dir);
}

@test
fun your_name_in_this_app() {
    let s = folder("name");
    let m = notes(s);
    // This app's name only: a name for every app is a Rapidkoi setting, not this app's.
    let named = step(
        step(m, Msg.SetName(NameScope.ThisApp, NamePart.First, "Brian")),
        Msg.SetName(NameScope.ThisApp, NamePart.Last, "K"),
    );
    let x = person(named.people, HOST, [3; 32]);
    assert_eq((x.first, x.last, named.people.first), ("Brian", "K", ""));
    // Forgetting the app forgets its name too.
    let forgot = step(step(named, Msg.Ask(Confirm.Forget)), Msg.Forget);
    assert_eq(forgot.people.apps.len, 0);
    clean(s.dir);
}

@test
fun an_unsigned_app_can_t_have_an_account() {
    let engine = Engine.new();
    let p = open_module("Plain", "plain.wasm", engine, Module.from_text(engine, echo()).unwrap());
    let m = step(step(with_pages(engine, [p]), Msg.TogglePanel), Msg.PanelGo(PanelPage.Name));
    assert_eq(facts(m).person.is_none(), true);
}

@test
fun after_a_restart_the_page_still_knows_who_you_are() {
    let s = folder("restart");
    // The first run made the master secret when Notes asked.
    notes(s);
    // A new window on the same folder: Notes is resumed and doesn't ask,
    // yet the page shows the same label.
    let engine = Engine.new();
    let p = AppPage {
        trust: Some(trust()),
        ..open_module(
            "Notes",
            "rapidkoi://notes.acme.com",
            engine,
            Module.from_text(engine, echo()).unwrap(),
        ),
    };
    let again = step(
        step(restore(with_pages(engine, [p]), s), Msg.TogglePanel),
        Msg.PanelGo(PanelPage.Name),
    );
    assert_eq(facts(again).label, Some(user_label(key(s, 0))));
    clean(s.dir);
}

@test
fun no_master_secret_is_made_until_an_app_asks() {
    let s = folder("none");
    let engine = Engine.new();
    let p = AppPage {
        trust: Some(trust()),
        ..open_module(
            "Notes",
            "rapidkoi://notes.acme.com",
            engine,
            Module.from_text(engine, echo()).unwrap(),
        ),
    };
    let m = step(
        step(restore(with_pages(engine, [p]), s), Msg.TogglePanel),
        Msg.PanelGo(PanelPage.Name),
    );
    assert_eq((facts(m).label, fs.exists("{s.dir}/identity")), (None, false));
    clean(s.dir);
}
