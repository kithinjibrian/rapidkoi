// The window: tabs (apps only; home isn't a tab), the address box, pins,
// "where you left off", the info panel, and failing safely per tab.
// Fixture guests; no display.
import rapidkoi.shell { Model, start, with_pages, update, view, title_of };
import rapidkoi.window { card };
import rapidkoi.actions { Msg, Confirm };
import rapidkoi.tabs { AppPage, open_module, state_of };
import rapidkoi.render;
import rapidkoi.contract { envelope };
import kivuli.testing { click, texts, type_into };
import wasmtime { Engine, Module };
import support { t, fixed, echo, crashing, titled_tree, result_of };

fun app(engine: Engine, name: string, wat: string): AppPage = open_module(
    name,
    "{name}.wasm",
    engine,
    Module.from_text(engine, wat).unwrap(),
);

/** A window with two echo apps, tabs 0 and 1, tab 0 current. */
fun two(): Model {
    let engine = Engine.new();
    with_pages(engine, [app(engine, "a", echo()), app(engine, "b", echo())])
}

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

fun page(m: Model, id: i64): AppPage {
    for tab of m.tabs {
        if tab.id == id {
            return tab.page;
        }
    }
    panic("no tab {id}")
}

fun add(id: i64): Msg = Msg.Tab(id, render.Msg.Event(t("add"), None));

fun shows(m: Model, s: string): bool = texts(view(m)).any(fun(x: string) = x == s);

@test
fun booting_without_an_app_shows_home_with_no_tabs() {
    let (m, _) = start(["./main"], None);
    assert_eq(m.tabs.len, 0);
    assert_eq(m.current, None);
    assert_eq(shows(m, "Rapidkoi"), true);
    assert_eq(title_of(m), "Rapidkoi");
}

@test
fun booting_a_bad_file_shows_why_in_its_tab() {
    let (m, _) = start(["./main", "lugha.toml"], None);
    assert_eq(m.tabs.len, 1);
    assert_eq(
        texts(view(m)).any(fun(s: string) = s.starts_with("This file isn't a WebAssembly app")),
        true,
    );
}

@test
fun an_event_reaches_only_its_tab() {
    let m = step(two(), add(0));
    assert_eq(state_of(page(m, 0)), Some(envelope(t("add"), None)));
    assert_eq(state_of(page(m, 1)), Some([]));
}

@test
fun a_crash_stays_in_its_tab_and_restart_brings_it_back() {
    let engine = Engine.new();
    let m = with_pages(engine, [app(engine, "bad", crashing()), app(engine, "good", echo())]);
    let crashed = step(m, add(0));
    assert_eq(state_of(page(crashed, 0)), None);
    assert_eq(state_of(page(crashed, 1)), Some([]));
    assert_eq(state_of(page(step(crashed, Msg.Tab(0, render.Msg.Restart)), 0)), Some([]));
}

@test
fun new_tab_and_home_show_home_and_keep_every_app() {
    let m = step(step(two(), add(0)), Msg.NewTab);
    assert_eq(m.current, None);
    assert_eq(m.tabs.len, 2);
    let home = step(step(m, Msg.Select(1)), Msg.Home);
    assert_eq(home.current, None);
    assert_eq(home.tabs.len, 2);
    // The app kept its state while home showed.
    assert_eq(state_of(page(home, 0)), Some(envelope(t("add"), None)));
}

@test
fun where_you_left_off_selects_an_open_app() {
    let m = step(step(two(), Msg.Select(1)), Msg.Home);
    assert_eq(card(m).map(fun(c) = c.msg), Some(Msg.Select(1)));
    assert_eq(shows(m, "Where you left off"), true);
    assert_eq(step(m, click(view(m), "Continue").unwrap()).current, Some(1));
}

@test
fun a_closed_app_reopens_with_its_state() {
    let closed = step(step(two(), add(0)), Msg.CloseTab(0));
    assert_eq(closed.current, Some(1));
    let home = step(closed, Msg.Home);
    // Tab 1 is still open and was visited last, so it's the card; close it too.
    let both = step(step(home, Msg.Select(1)), Msg.CloseTab(1));
    assert_eq(both.current, None);
    assert_eq(card(both).map(fun(c) = c.msg), Some(Msg.Continue));
    let back = step(both, Msg.Continue);
    assert_eq(back.tabs.len, 1);
    assert_eq(back.left_off.is_none(), true);
}

@test
fun continue_restores_the_closed_apps_state() {
    let closed = step(step(two(), add(0)), Msg.CloseTab(0));
    let back = step(step(closed, Msg.Home), Msg.Continue);
    let reopened = page(back, back.current.unwrap());
    // init gives [], so this state comes from view(saved state).
    assert_eq(state_of(reopened), Some(envelope(t("add"), None)));
}

@test
fun closing_tabs_picks_a_neighbour_then_home() {
    let m = step(two(), Msg.CloseTab(0));
    assert_eq(m.current, Some(1));
    assert_eq(state_of(page(step(m, add(0)), 1)), Some([]));
    let none = step(m, Msg.CloseTab(1));
    assert_eq(none.tabs.len, 0);
    assert_eq(none.current, None);
}

@test
fun the_address_box() {
    let (m, _) = start(["./main"], None);
    let typed = step(m, type_into(view(m), "address", "rapidkoi://notes.acme.com").unwrap());
    assert_eq(
        step(typed, Msg.Go).notice,
        Some("Only local development addresses (localhost) can be opened yet"),
    );
    assert_eq(
        step(step(m, Msg.Draft("no/such/app.wasm")), Msg.Go).notice,
        Some("No app or file called “no/such/app.wasm”"),
    );
    // From home a file opens in a new tab.
    let opened = step(step(m, Msg.Draft("lugha.toml")), Msg.Go);
    assert_eq(opened.tabs.len, 1);
    assert_eq(page(opened, 0).name, "lugha.toml");
    assert_eq(opened.draft, "");
}

@test
fun the_address_box_on_an_app_replaces_its_app() {
    let editing = step(two(), Msg.EditAddress);
    assert_eq(editing.draft, "a.wasm");
    let replaced = step(step(editing, Msg.Draft("lugha.toml")), Msg.Go);
    assert_eq(replaced.tabs.len, 2);
    assert_eq(page(replaced, 0).name, "lugha.toml");
    assert_eq(replaced.left_off.map(fun(l) = l.name), Some("a"));
}

@test
fun pinning_and_opening_a_pin() {
    let m = step(two(), Msg.TogglePin);
    assert_eq(m.pinned.len, 1);
    // The pin's file doesn't exist here, so its new tab shows why.
    let opened = step(m, Msg.OpenPinned("a.wasm"));
    assert_eq(opened.tabs.len, 3);
    assert_eq(
        texts(view(opened)).any(fun(s: string) = s.starts_with("Couldn't read a.wasm")),
        true,
    );
    assert_eq(step(m, Msg.TogglePin).pinned.len, 0);
}

@test
fun the_info_panel_opens_beside_the_app() {
    let m = step(two(), Msg.TogglePanel);
    assert_eq(shows(m, "Your settings"), true);
    assert_eq(click(view(m), "Forget this app"), Ok(Msg.Ask(Confirm.Forget)));
    assert_eq(shows(step(m, Msg.TogglePanel), "Your settings"), false);
}

@test
fun window_titles() {
    let engine = Engine.new();
    let titled = with_pages(engine, [
        app(engine, "counter", fixed(1, [], titled_tree("0", "Counter"), result_of([]))),
    ]);
    assert_eq(title_of(titled), "Rapidkoi — Counter");
    assert_eq(title_of(two()), "Rapidkoi — a");
}
