// The window: tabs (apps only; home isn't a tab), the address box, pins,
// "where you left off", the info panel, and failing safely per tab.
// Fixture guests; no display.
import rapidkoi.shell { start, update };
import rapidkoi.ui.layout { view };
import rapidkoi.window.window { page_of, Model, with_pages, title_of };
import rapidkoi.window.recent { Place };
import rapidkoi.window.yourapps { App, Apps, no_apps, opened, app_of };
import rapidkoi.window.actions { Msg, Confirm, PanelPage };
import rapidkoi.window.backupcard { BackupCard, Card, Step };
import rapidkoi.bundles.bundle { Manifest };
import rapidkoi.bundles.permissions { Permission, Setting };
import rapidkoi.people.people { nobody, with_setting };
import rapidkoi.window.tabs { AppPage, Tab, open_module, state_of };
import rapidkoi.ui.render;
import rapidkoi.guest.events { Happened, event_for };
import kivuli { Cmd };
import kivuli.testing { texts, type_into };
import wasmtime { Engine, Module };
import support { t, fixed, echo, event_in, crashing, titled_tree, result_of, kv, said };

fun app(engine: Engine, name: string, wat: string): AppPage = open_module(
    name,
    "{name}.wasm",
    engine,
    Module.from_text(engine, wat).unwrap(),
);

/** The event an echo page got last, as its state holds it (`support.event_in`). */
fun ev(p: AppPage): Option<u8[]> = state_of(p).map(event_in);

/** The event pressing an echo app's "Add" sends it. */
fun added(): u8[] = event_for(Happened.Message(t("add"), None));

/** A window with two echo apps, tabs 0 and 1, tab 0 current. */
fun two(): Model {
    let engine = Engine.new();
    with_pages(engine, [app(engine, "a", echo()), app(engine, "b", echo())])
}

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

fun page(m: Model, id: i64): AppPage {
    for tab of m.tabs {
        if tab.id == id {
            return tab.page;
        }
    }
    panic("no tab {id}")
}

fun add(id: i64): Msg = Msg.Tab(id, render.Msg.Event(t("add"), None));

fun on_home(m: Model): bool = match page_of(m) {
    Home => true,
    App(_) => false,
};

fun shows(m: Model, s: string): bool = texts(view(m)).any(fun(x: string) = x == s);

@test
fun booting_without_an_app_shows_one_empty_tab() {
    let (m, _) = start(["./main"], None);
    // PRP-024: the window always has a tab; an empty one to start.
    assert_eq((m.tabs.len, m.blanks.len), (0, 1));
    assert(on_home(m));
    assert_eq(title_of(m), "Rapidkoi");
}

@test
fun booting_a_bad_file_shows_why_in_its_tab() {
    let (m, _) = start(["./main", "lugha.toml"], None);
    assert_eq(m.tabs.len, 1);
    assert_eq(
        texts(view(m)).any(fun(s: string) = s.starts_with("This file isn't a WebAssembly app")),
        true,
    );
}

@test
fun an_event_reaches_only_its_tab() {
    let m = step(two(), add(0));
    assert_eq(ev(page(m, 0)), Some(added()));
    assert_eq(ev(page(m, 1)), Some([]));
}

@test
fun a_crash_stays_in_its_tab_and_restart_brings_it_back() {
    let engine = Engine.new();
    let m = with_pages(engine, [app(engine, "bad", crashing()), app(engine, "good", echo())]);
    let crashed = step(m, add(0));
    assert_eq(ev(page(crashed, 0)), None);
    assert_eq(ev(page(crashed, 1)), Some([]));
    assert_eq(ev(page(step(crashed, Msg.Tab(0, render.Msg.Restart)), 0)), Some([]));
}

@test
fun new_tab_and_home_show_an_empty_tab_and_keep_every_app() {
    let m = step(step(two(), add(0)), Msg.NewTab);
    assert(on_home(m));
    assert_eq(m.tabs.len, 2);
    let home = step(step(m, Msg.Select(1)), Msg.Home);
    assert(on_home(home));
    assert_eq(home.tabs.len, 2);
    // The app kept its state while home showed.
    assert_eq(ev(page(home, 0)), Some(added()));
}

/** Your recent places' app names, newest first. */
fun names(m: Model): string[] = m.recent.places.map(fun(p: Place) = p.name);

@test
fun leaving_and_closing_apps_record_their_places() {
    // PRP-062: where you were, newest first; nothing revives a closed window.
    let m = step(two(), Msg.Select(1));
    assert_eq(names(m), ["a"]);
    let closed = step(m, Msg.CloseTab(1));
    assert_eq(names(closed), ["b", "a"]);
    assert_eq(closed.recent.places[0].address, "b.wasm");
}

@test
fun a_recent_place_opens_fresh_at_its_address() {
    // DECISION-044: a place opens a new window at its link; the closed window's state is gone.
    let closed = step(step(two(), add(0)), Msg.CloseTab(0));
    let back = step(closed, Msg.OpenPlace(closed.recent.places[0].address, None));
    assert_eq(back.tabs.len, 2);
    // Its file doesn't exist here, so the new window shows why: it was opened anew.
    assert_eq(texts(view(back)).any(fun(s: string) = s.starts_with("Couldn't read a.wasm")), true);
}

@test
fun closing_tabs_picks_a_neighbour_then_home() {
    let m = step(two(), Msg.CloseTab(0));
    assert_eq(m.current, Some(1));
    // Brought to the front, the other tab heard on_resume (PRP-030).
    assert_eq(ev(page(step(m, add(0)), 1)), Some(event_for(Happened.Resume)));
    // The last tab closed: one empty tab remains (PRP-024).
    let none = step(m, Msg.CloseTab(1));
    assert_eq((none.tabs.len, none.blanks.len), (0, 1));
    assert_eq(none.current, Some(none.blanks[0]));
}

@test
fun the_address_box() {
    let (m, _) = start(["./main"], None);
    let typed = step(m, type_into(view(m), "address", "rapidkoi://10.0.0.7").unwrap());
    assert_eq(said(step(typed, Msg.Go)), Some("Open apps by their host name, not an IP address"));
    assert_eq(
        said(step(step(m, Msg.Draft("no/such/app.wasm")), Msg.Go)),
        Some("No app or file called “no/such/app.wasm”"),
    );
    // From home a file opens in a new tab.
    let opened = step(step(m, Msg.Draft("lugha.toml")), Msg.Go);
    assert_eq(opened.tabs.len, 1);
    assert_eq(page(opened, 0).name, "lugha.toml");
    assert_eq(opened.draft, "");
}

@test
fun the_address_box_on_an_app_replaces_its_app() {
    let editing = step(two(), Msg.EditAddress);
    assert_eq(editing.draft, "a.wasm");
    let replaced = step(step(editing, Msg.Draft("lugha.toml")), Msg.Go);
    assert_eq(replaced.tabs.len, 2);
    assert_eq(page(replaced, 0).name, "lugha.toml");
    // The app it replaced is kept as a recent place (PRP-062).
    assert_eq(names(replaced).any(fun(n: string) = n == "a"), true);
}

@test
fun pinning_and_opening_a_pin() {
    let m = step(two(), Msg.TogglePin);
    assert_eq(m.pinned.len, 1);
    // Open already: its tab is shown, not a second copy (PRP-026).
    let shown = step(step(m, Msg.Select(1)), Msg.OpenPinned("a.wasm", None));
    assert_eq((shown.tabs.len, shown.current), (2, Some(0)));
    // Closed: it opens again; its file doesn't exist here, so its tab shows why.
    let opened = step(step(m, Msg.CloseTab(0)), Msg.OpenPinned("a.wasm", None));
    assert_eq(opened.tabs.len, 2);
    assert_eq(
        texts(view(opened)).any(fun(s: string) = s.starts_with("Couldn't read a.wasm")),
        true,
    );
    assert_eq(step(m, Msg.TogglePin).pinned.len, 0);
}

@test
fun the_info_panel_opens_and_closes() {
    let m = step(two(), Msg.TogglePanel);
    assert_eq(m.panel, Some(PanelPage.Main));
    assert_eq(step(m, Msg.TogglePanel).panel, None);
}

@test
fun window_titles() {
    let engine = Engine.new();
    let titled = with_pages(engine, [
        app(engine, "counter", fixed(kv([]), titled_tree("0", "Counter"), result_of(kv([])))),
    ]);
    assert_eq(title_of(titled), "Rapidkoi — Counter");
    assert_eq(title_of(two()), "Rapidkoi — a");
}

@test
fun each_panel_page_opens_and_comes_back() {
    let m = step(two(), Msg.TogglePanel);
    for p of [PanelPage.Key, PanelPage.Name, PanelPage.Access] {
        let opened = step(m, Msg.PanelGo(p));
        assert_eq(opened.panel, Some(p));
        assert_eq(step(opened, Msg.PanelBack).panel, Some(PanelPage.Main));
    }
}

@test
fun forget_asks_then_removes_everything() {
    let m = step(two(), Msg.TogglePin);
    let asking = step(step(m, Msg.TogglePanel), Msg.Ask(Confirm.Forget(m.current.unwrap())));
    assert_eq(asking.confirm, Some(Confirm.Forget(m.current.unwrap())));
    assert_eq(step(asking, Msg.Cancel).tabs.len, 2);
    let gone = step(asking, Msg.Forget);
    assert_eq(gone.tabs.len, 1);
    assert_eq(gone.pinned.len, 0);
    // Its places go too (PRP-062).
    assert_eq(gone.recent.places.len, 0);
    // And it's no longer one of your apps (PRP-067); the other stays.
    let both = asking.tabs.fold(no_apps(), fun(a: Apps, t: Tab) = opened(a, app_of(t.page, 1)));
    let left = step(Model { apps: both, ..asking }, Msg.Forget).apps.items;
    assert_eq(left.map(fun(x: App) = x.path), gone.tabs.map(fun(t: Tab) = t.page.path));
    assert_eq(gone.panel.is_none(), true);
}

@test
fun switching_tabs_keeps_a_question_on_its_own_tab() {
    // PRP-057: it waits on its tab, and Forget forgets that tab wherever you are.
    let m = two();
    let tab = m.current.unwrap();
    let asking = step(step(m, Msg.TogglePanel), Msg.Ask(Confirm.Forget(tab)));
    let away = step(asking, Msg.Select(1));
    assert_eq(away.confirm, Some(Confirm.Forget(tab)));
    let gone = step(away, Msg.Forget);
    assert_eq(gone.tabs.any(fun(t: Tab) = t.id == tab), false);
    assert_eq(gone.tabs.len, 1);
}

@test
fun reload_keeps_the_window_running_when_the_file_is_gone() {
    // A fixture module isn't a file, so ⟳ can't load it again: the window
    // keeps running, and the notice bar says so above it (PRP-048, PRP-051).
    // The real reload-with-state path is tested end to end in counter.la.
    let added = step(two(), add(0));
    let reloaded = step(added, Msg.Reload);
    let mut expected = ["a couldn't be reloaded"];
    for x of texts(view(added)) {
        expected.push(x);
    }
    assert_eq(texts(view(reloaded)), expected);
    assert_eq(
        said(reloaded).map(fun(s: string) = s.starts_with("Couldn't read a.wasm")),
        Some(true),
    );
}

/** Every `Cmd.scroll_to` in `c`, batches opened. */
fun scrolls(c: Cmd<Msg>): string[] = match c {
    ScrollTo(name) => [name],
    Batch(cs) => {
        let mut all: string[] = [];
        for inner of cs {
            for n of scrolls(inner) {
                all.push(n);
            }
        }
        all
    }
    _ => [],
};

fun scrolled(m: Model, msg: Msg): string[] {
    let (_, c) = update(m, msg);
    scrolls(c)
}

@test
fun the_current_tab_is_scrolled_into_view() {
    // PRP-028: whenever the current tab changes, the sidebar shows it.
    let m = two();
    assert_eq(scrolled(m, Msg.Select(1)), ["tab-1"]);
    assert_eq(scrolled(m, Msg.NewTab), ["tab-2"]);
    // Closing the current tab: its neighbour is current now.
    assert_eq(scrolled(m, Msg.CloseTab(0)), ["tab-1"]);
    // Opening a file from an empty tab fills it: the same id.
    let blank = step(m, Msg.NewTab);
    assert_eq(scrolled(step(blank, Msg.Draft("lugha.toml")), Msg.Go), []);
}

@test
fun nothing_scrolls_when_the_current_tab_stays() {
    let m = two();
    assert_eq(scrolled(m, Msg.Draft("rapid")), []);
    assert_eq(scrolled(m, Msg.Select(0)), []);
}

fun last_event(m: Model, id: i64): Option<u8[]> = ev(page(m, id));

fun v3(h: Happened): Option<u8[]> = Some(event_for(h));

/** What an echo page holds when nothing reached it since it opened. */
fun quiet(): Option<u8[]> = Some([]);

@test
fun a_tab_brought_back_hears_on_resume() {
    // PRP-030: back to the front while running.
    let m = two();
    assert_eq(last_event(m, 1), quiet());
    let back = step(m, Msg.Select(1));
    assert_eq(last_event(back, 1), v3(Happened.Resume));
    // The tab that was current, and selecting it again, hear nothing.
    assert_eq(last_event(back, 0), quiet());
    assert_eq(last_event(step(back, Msg.Select(1)), 1), v3(Happened.Resume));
    // Closing the tab in front brings the other back.
    let closed = step(back, Msg.CloseTab(1));
    assert_eq(last_event(closed, 0), v3(Happened.Resume));
}

@test
fun the_new_tab_hears_on_resume_when_the_empty_tab_shows() {
    let engine = Engine.new();
    let m = Model { newtab: Some(app(engine, "newtab", echo())), ..two() };
    let home = step(m, Msg.NewTab);
    assert_eq(home.newtab.and_then(fun(p: AppPage) = ev(p)), v3(Happened.Resume));
}

/** An echo app on tab 0, current, declaring `permissions`. */
fun reading(declared: string[]): Model {
    let engine = Engine.new();
    let p = app(engine, "a", echo());
    let declared = AppPage {
        manifest: Some(Manifest {
            contract: 11,
            name: "a",
            version: "1.0.0",
            description: None,
            state_version: 1,
            icon: None,
            banners: [],
            servers: [],
            permissions: declared,
            controls: None,
            primary_color: None,
            widgets: [],
        }),
        ..p,
    };
    with_pages(engine, [declared, app(engine, "b", echo())])
}

@test
fun the_page_in_front_hears_on_change() {
    // PRP-031: pinning it while it's in front changes your pins.
    let m = reading(["read_pins"]);
    let pinned = step(m, Msg.TogglePin);
    assert_eq(last_event(pinned, 0), v3(Happened.Change));
    // Without the permission, nothing to tell.
    let blind = step(reading([]), Msg.TogglePin);
    assert_eq(last_event(blind, 0), quiet());
    // Blocked: nothing it can read moved.
    let blocked = Model {
        people: with_setting(nobody(), "a.wasm", Permission.ReadPins, Setting.Blocked),
        ..m,
    };
    assert_eq(last_event(step(blocked, Msg.TogglePin), 0), quiet());
}

@test
fun its_own_setting_changing_is_a_change() {
    let m = reading(["read_pins"]);
    let set = step(m, Msg.SetPermission("read_pins", Setting.Ask));
    assert_eq(last_event(set, 0), v3(Happened.Change));
}

@test
fun the_backup_card_closing_is_a_change_for_who_reads_you() {
    // PRP-076: Settings re-reads `you` and sees it's backed up.
    let open = fun(m: Model): Model = Model {
        backup: Some(BackupCard { tab: 0, card: Card.Showing([]) }),
        ..m,
    };
    let closed = step(open(reading(["read_you"])), Msg.Backup(Step.Close));
    assert_eq(last_event(closed, 0), v3(Happened.Change));
    assert_eq(last_event(step(open(reading([])), Msg.Backup(Step.Close)), 0), quiet());
}

@test
fun closing_the_card_never_reopens_it() {
    // Session 171: the popover closing itself (a dialog taking the focus)
    // can say so twice; a toggle reopened it, holding every click.
    let m = step(two(), Msg.TogglePanel);
    let closed = step(step(m, Msg.ClosePanel), Msg.ClosePanel);
    assert_eq(closed.panel, None);
}

@test
fun a_fresh_start_knows_the_time() {
    // A place recorded before the first tick has a real time, not 1970 (the owner, 2026-11-02).
    let (m, _) = start(["./main"], None);
    assert_eq(m.now > 1_700_000_000_000, true);
}
