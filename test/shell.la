// The window: tabs, the address box, home, pins, "where you left off", the
// info panel, and failing safely per tab. Fixture guests; no display.
import rapidkoi.shell { Model, boot, with_pages, update, view, title_of };
import rapidkoi.actions { Msg };
import rapidkoi.tabs { Page, AppPage, open_module, state_of };
import rapidkoi.render;
import rapidkoi.contract { envelope };
import kivuli.testing { click, texts, type_into };
import wasmtime { Engine, Module };
import support { t, fixed, echo, crashing, titled_tree, result_of };

fun app(engine: Engine, name: string, wat: string): Page = Page.App(
    open_module(name, "{name}.wasm", engine, Module.from_text(engine, wat).unwrap()),
);

/** A window with two echo apps, tabs 0 and 1. */
fun two(): Model {
    let engine = Engine.new();
    with_pages(engine, [app(engine, "a", echo()), app(engine, "b", echo())])
}

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

fun page(m: Model, id: i64): AppPage {
    for tab of m.tabs {
        if tab.id == id {
            if let App(a) = tab.page {
                return a;
            }
        }
    }
    panic("tab {id} isn't an app")
}

fun is_home(m: Model, id: i64): bool {
    for tab of m.tabs {
        if tab.id == id {
            return match tab.page {
                Home => true,
                App(_) => false,
            };
        }
    }
    false
}

fun add(): Msg = Msg.Tab(0, render.Msg.Event(t("add"), None));

@test
fun booting_without_an_app_shows_home() {
    let (m, _) = boot(["./main"]);
    assert_eq(m.tabs.len, 1);
    assert_eq(is_home(m, 0), true);
    assert_eq(texts(view(m))[1], "Rapidkoi");
}

@test
fun booting_a_bad_file_shows_why_in_its_tab() {
    let (m, _) = boot(["./main", "lugha.toml"]);
    assert_eq(
        texts(view(m)).any(fun(s: string) = s.starts_with("This file isn't a WebAssembly app")),
        true,
    );
}

@test
fun an_event_reaches_only_its_tab() {
    let m = step(two(), add());
    assert_eq(state_of(page(m, 0)), Some(envelope(t("add"), None)));
    assert_eq(state_of(page(m, 1)), Some([]));
}

@test
fun a_crash_stays_in_its_tab_and_restart_brings_it_back() {
    let engine = Engine.new();
    let m = with_pages(engine, [app(engine, "bad", crashing()), app(engine, "good", echo())]);
    let crashed = step(m, add());
    assert_eq(state_of(page(crashed, 0)), None);
    assert_eq(state_of(page(crashed, 1)), Some([]));
    let back = step(crashed, Msg.Tab(0, render.Msg.Restart));
    assert_eq(state_of(page(back, 0)), Some([]));
}

@test
fun tabs_open_select_and_close() {
    let m = step(two(), Msg.NewTab);
    assert_eq(m.tabs.len, 3);
    assert_eq(m.current, 2);
    assert_eq(is_home(m, 2), true);
    let picked = step(m, Msg.Select(0));
    assert_eq(picked.current, 0);
    // Closing the current tab picks the one to its right.
    let closed = step(picked, Msg.CloseTab(0));
    assert_eq(closed.current, 1);
    assert_eq(closed.left_off.map(fun(l) = l.name), Some("a"));
    // A message for a closed tab finds nothing.
    assert_eq(state_of(page(step(closed, add()), 1)), Some([]));
    // Closing the last tab at the end picks the one to its left.
    let end = step(step(closed, Msg.Select(2)), Msg.CloseTab(2));
    assert_eq(end.current, 1);
}

@test
fun closing_every_tab_leaves_home() {
    let m = step(step(two(), Msg.CloseTab(0)), Msg.CloseTab(1));
    assert_eq(m.tabs.len, 1);
    assert_eq(is_home(m, m.current), true);
}

@test
fun home_then_continue_restores_the_state() {
    let m = step(two(), add());
    let home = step(m, Msg.Home);
    assert_eq(is_home(home, 0), true);
    assert_eq(texts(view(home)).any(fun(s: string) = s == "Where you left off"), true);
    let back = step(home, Msg.Continue);
    // init gives [], so this state comes from view(saved state).
    assert_eq(state_of(page(back, 0)), Some(envelope(t("add"), None)));
    assert_eq(back.left_off.is_none(), true);
}

@test
fun the_address_box() {
    let (m, _) = boot(["./main"]);
    let typed = step(m, type_into(view(m), "address", "rapidkoi://notes.acme.com").unwrap());
    assert_eq(step(typed, Msg.Go).notice, Some("Links come in a later step"));
    let missing = step(step(m, Msg.Draft("no/such/app.wasm")), Msg.Go);
    assert_eq(missing.notice, Some("No app or file called “no/such/app.wasm”"));
    let words = step(step(m, Msg.Draft("my notes")), Msg.Go);
    assert_eq(words.notice, Some("No app or file called “my notes”"));
    // A real file opens in this tab (this one isn't an app, so it shows why).
    let opened = step(step(m, Msg.Draft("lugha.toml")), Msg.Go);
    assert_eq(page(opened, 0).name, "lugha.toml");
    assert_eq(opened.draft, "");
}

@test
fun editing_the_address_of_an_app_page() {
    let m = step(two(), Msg.EditAddress);
    assert_eq(m.editing, true);
    assert_eq(m.draft, "a.wasm");
}

@test
fun pinning_and_opening_a_pin() {
    let m = step(two(), Msg.Pin);
    assert_eq(m.pinned.len, 1);
    assert_eq(step(m, Msg.Pin).pinned.len, 1);
    // The pin's file doesn't exist here, so opening it shows why.
    let opened = step(step(m, Msg.NewTab), Msg.OpenPinned("a.wasm"));
    assert_eq(
        texts(view(opened)).any(fun(s: string) = s.starts_with("Couldn't read a.wasm")),
        true,
    );
    assert_eq(step(m, Msg.Unpin("a.wasm")).pinned.len, 0);
}

@test
fun the_info_panel_opens_beside_the_app() {
    let m = step(two(), Msg.TogglePanel);
    assert_eq(texts(view(m)).any(fun(s: string) = s == "Contract v1"), true);
    assert_eq(click(view(m), "Close tab"), Ok(Msg.CloseTab(0)));
    assert_eq(
        texts(view(step(m, Msg.TogglePanel))).any(fun(s: string) = s == "Contract v1"),
        false,
    );
}

@test
fun window_titles() {
    let engine = Engine.new();
    let titled = with_pages(engine, [
        app(engine, "counter", fixed(1, [], titled_tree("0", "Counter"), result_of([]))),
    ]);
    assert_eq(page(titled, 0).title, Some("Counter"));
    assert_eq(title_of(titled), "Rapidkoi — Counter");
    let engine2 = Engine.new();
    let plain = with_pages(engine2, [app(engine2, "plain", echo())]);
    assert_eq(title_of(plain), "Rapidkoi — plain");
    let (home, _) = boot(["./main"]);
    assert_eq(title_of(home), "Rapidkoi");
}
