// Rapidkoi's Settings (PRP-038): the built-in app ☰ opens, the one that may
// change the person's choices, and those choices remembered across
// restarts. The real bundle built into ./main; no display. Writes only
// under test/tmp/.
import rapidkoi.shell { start, update };
import rapidkoi.window.window { Model, with_pages };
import rapidkoi.window.tabs { Tab, Pin };
import rapidkoi.window.recent { Place };
import rapidkoi.ui.layout { view };
import rapidkoi.window.actions { Msg };
import rapidkoi.window.settings_app { SETTINGS_KEY, BUNDLE };
import rapidkoi.bundles.bundle { read };
import rapidkoi.data.store { Store, store_at };
import kivuli.testing { click, texts };
import wasmtime { Engine };
import std.fs;

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

fun clean(path: string) {
    if fs.is_dir(path) {
        for name of fs.list_dir(path).unwrap() {
            clean("{path}/{name}");
        }
        fs.remove_dir(path).unwrap();
    } else if fs.exists(path) {
        fs.remove_file(path).unwrap();
    }
}

@test
fun the_built_in_bundle_may_change_settings() {
    let b = read(BUNDLE).unwrap();
    assert_eq((b.manifest.name, b.manifest.permissions), ("Settings", ["change_settings"]));
}

@test
fun the_menu_opens_settings_once() {
    let m = step(with_pages(Engine.new(), []), Msg.OpenSettings);
    assert_eq(m.tabs.len, 1);
    assert_eq(m.tabs[0].page.path, SETTINGS_KEY);
    assert_eq(texts(view(m)).any(fun(s: string) = s == "Text size"), true);
    // Again: its tab is shown, not a second one.
    assert_eq(step(m, Msg.OpenSettings).tabs.len, 1);
}

@test
fun its_controls_change_the_person_s_choices_at_once() {
    let m = step(with_pages(Engine.new(), []), Msg.OpenSettings);
    let light = step(m, click(view(m), "Light").unwrap());
    assert_eq((light.prefs.light, light.theme.name), (true, "light"));
    let bigger = step(light, click(view(light), "+").unwrap());
    assert_eq((bigger.prefs.text_size, bigger.theme.scale), (110, 1.1));
    // The app read the change back: its view says so.
    assert_eq(texts(view(bigger)).any(fun(s: string) = s == "110%"), true);
}

@test
fun choices_are_remembered_across_restarts() {
    let dir = "test/tmp/settings-app";
    clean(dir);
    let s = store_at(dir);
    let (m, _) = start(["./main"], Some(s));
    let opened = step(m, Msg.OpenSettings);
    step(opened, click(view(opened), "Light").unwrap());
    let (again, _) = start(["./main"], Some(s));
    assert_eq((again.prefs.light, again.theme.name), (true, "light"));
    clean(dir);
}

@test
fun settings_opens_by_its_path_and_is_a_recent_place() {
    // PRP-064: from a pin or a recent card, as the menu opens it; and kept in Recent.
    let pinned = step(with_pages(Engine.new(), []), Msg.OpenPinned(SETTINGS_KEY, None));
    assert_eq(pinned.tabs.any(fun(t: Tab) = t.page.path == SETTINGS_KEY), true);
    // Its tab again, not a second one.
    let again = step(pinned, Msg.OpenPlace(SETTINGS_KEY, None));
    assert_eq(again.tabs.filter(fun(t: Tab) = t.page.path == SETTINGS_KEY).len, 1);
    // Left for a new tab: its place is kept, unlike the new tab's.
    let left = step(again, Msg.NewTab);
    assert_eq(left.recent.places.map(fun(p: Place) = p.address), [SETTINGS_KEY]);
}

@test
fun a_first_run_starts_with_settings_pinned() {
    // PRP-064: no pins file yet; once you change your pins, that's what's kept.
    let dir = "test/tmp/settings-pinned";
    clean(dir);
    let first = started(store_at(dir));
    assert_eq(first.pinned.map(fun(p: Pin) = p.path), [SETTINGS_KEY]);
    assert_eq(first.pinned[0].icon.is_some(), true);
    // Unpinned (here, from its open tab), it stays unpinned after a restart.
    let unpinned = step(step(first, Msg.OpenSettings), Msg.TogglePin);
    assert_eq(unpinned.pinned.len, 0);
    assert_eq(started(store_at(dir)).pinned.len, 0);
    clean(dir);
    // With no data folder, no pins.
    let (none, _) = start(["./main"], None);
    assert_eq(none.pinned.len, 0);
}

fun started(s: Store): Model {
    let (m, _) = start(["./main"], Some(s));
    m
}
