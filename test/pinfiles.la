// The pins and left-off files (`data.pinfiles`): each round trips, and every
// way one can be wrong is Broken (naming the field) or Newer, never a panic.
import rapidkoi.data.remembered { Unreadable, trust_file };
import rapidkoi.data.pinfiles { pins_file, read_pins };
import rapidkoi.window.tabs { Pin };
import cbor { Value, Entry, encode };
import support { png };

fun entry(k: string, v: Value): Entry = Entry { key: Value.Text(k), value: v };

fun broken<T>(r: Result<T, Unreadable>): string = match r {
    Err(Broken(why)) => why,
    Err(Newer(n)) => "newer {n}",
    Ok(_) => "ok",
};

@test
fun a_newer_format_is_newer() {
    let newer = encode(
        Value.Map([entry("format", Value.int(2)), entry("kind", Value.Text("rapidkoi pins"))]),
    );
    assert_eq(broken(read_pins(newer)), "newer 2");
}

@test
fun pins_round_trip_and_a_bad_icon_drops_only_the_icon() {
    let pins = [
        Pin { name: "Notes", path: "/apps/notes.rkb", icon: Some(png(32, 32)), origin: None },
        Pin { name: "Counter", path: "counter.wasm", icon: None, origin: None },
    ];
    assert_eq(read_pins(pins_file(pins)), Ok(pins));
    let bad = [
        Pin { name: "Big", path: "big.rkb", icon: Some(png(5000, 5000)), origin: None },
        Pin { name: "Junk", path: "junk.rkb", icon: Some([1, 2, 3]), origin: None },
    ];
    assert_eq(
        read_pins(pins_file(bad)),
        Ok([
            Pin { name: "Big", path: "big.rkb", icon: None, origin: None },
            Pin { name: "Junk", path: "junk.rkb", icon: None, origin: None },
        ]),
    );
}
