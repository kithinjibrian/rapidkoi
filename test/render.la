// Rendering, pure: decoded trees become kivuli views, checked through
// kivuli.testing with no display.
import rapidkoi.guest.contract { Node };
import rapidkoi.ui.render { Msg, screen, stopped };
import rapidkoi.ui.themes { DARK };
import kivuli.testing { Lookup, click, is_disabled, is_field_disabled, type_into, submit, texts };
import rapidkoi.guest.nodes { Look, Facts, Role, Colour, Typing };
import rapidkoi.guest.styles { plain };
import rapidkoi.guest.roles { no_facts };
import support { t };

@test
fun an_unsupported_kind_shows_a_placeholder() {
    let v = screen(
        plain_box([Node.Unsupported("map"), Node.Words("after", plain(), no_facts())]),
        DARK,
    );
    assert_eq(texts(v), ["Unsupported component: map", "after"]);
}

@test
fun the_error_screen_offers_restart() {
    let v = stopped("This app stopped responding", true, DARK);
    assert_eq(texts(v), ["This app stopped working", "This app stopped responding"]);
    assert_eq(click(v, "Restart"), Ok(Msg.Restart));
}

@test
fun no_restart_when_the_app_never_loaded() {
    let v = stopped("Couldn't read app.wasm", false, DARK);
    assert_eq(click(v, "Restart"), Err(Lookup.NotFound("button \"Restart\"")));
}

fun plain_box(kids: Node[]): Node = Node.Boxed(plain(), no_facts(), None, kids);

@test
fun contract_5_texts_and_boxes_appear() {
    // PRP-037: boxes and texts, styled or not.
    let styled = Look { color: Some(Colour.Named("accent")), ..plain() };
    let v = screen(
        plain_box([
            Node.Words("Counter", styled, no_facts()),
            Node.Words("3", plain(), no_facts()),
        ]),
        DARK,
    );
    assert_eq(texts(v), ["Counter", "3"]);
}

@test
fun a_pressable_box_is_a_button() {
    let add = Node.Boxed(
        Look { background: Some(Colour.Named("accent")), ..plain() },
        Facts { role: Some(Role.Button), ..no_facts() },
        Some(t("add")),
        [Node.Words("Add", plain(), no_facts())],
    );
    let v = screen(plain_box([add]), DARK);
    assert_eq(click(v, "Add"), Ok(Msg.Event(t("add"), None)));
    let off = Node.Boxed(plain(), Facts { disabled: true, ..no_facts() }, Some(t("add")), [
        Node.Words("Add", plain(), no_facts()),
    ]);
    assert_eq(is_disabled(screen(off, DARK), "Add"), Ok(true));
}

@test
fun a_typing_box_sends_edits_and_enter() {
    let f = Typing {
        value: "Buy milk",
        placeholder: "What needs doing?",
        label: None,
        lines: 1,
        on_change: Some(t("draft")),
        on_submit: Some(t("add")),
    };
    let v = screen(Node.Field(f, plain()), DARK);
    assert_eq(type_into(v, "What needs doing?", "Buy"), Ok(Msg.Event(t("draft"), Some("Buy"))));
    assert_eq(submit(v, "What needs doing?"), Ok(Msg.Event(t("add"), Some("Buy milk"))));
    let silent = Typing { on_change: None, on_submit: None, ..f };
    assert_eq(
        is_field_disabled(screen(Node.Field(silent, plain()), DARK), "What needs doing?"),
        Ok(true),
    );
}

@test
fun a_box_of_several_lines_is_found_by_its_placeholder() {
    // kivuli draws no placeholder in a text area (DECISION-055), so it's named by it.
    let f = Typing {
        value: "",
        placeholder: "Write something",
        label: None,
        lines: 20,
        on_change: Some(t("body")),
        on_submit: None,
    };
    let v = screen(Node.Field(f, plain()), DARK);
    assert_eq(type_into(v, "Write something", "Sukuma"), Ok(Msg.Event(t("body"), Some("Sukuma"))));
}

@test
fun a_typing_box_is_named_by_its_label() {
    // DECISION-056: the label names it; the placeholder only when there's none.
    let f = Typing {
        value: "",
        placeholder: "Search",
        label: Some("Search notes"),
        lines: 1,
        on_change: Some(t("search")),
        on_submit: None,
    };
    let v = screen(Node.Field(f, plain()), DARK);
    assert_eq(type_into(v, "Search notes", "garden"), Ok(Msg.Event(t("search"), Some("garden"))));
    let area = screen(Node.Field(Typing { lines: 10, label: Some("Note"), ..f }, plain()), DARK);
    assert_eq(type_into(area, "Note", "Sukuma"), Ok(Msg.Event(t("search"), Some("Sukuma"))));
}
