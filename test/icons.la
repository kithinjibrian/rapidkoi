// Rapidkoi's own icons (PRP-019): the Iconsax SVGs built in from
// assets/icons/ (PRP-029), each drawn in a theme colour. No display.
import rapidkoi.ui.icons { Icon, ALL, svg, icon, recolour };
import kivuli { Image };

@test
fun every_icon_is_an_svg_recolouring_can_colour() {
    for i of ALL {
        assert(svg(i).starts_with("<svg"));
        // Iconsax ships them white: the colour recolour swaps.
        assert(svg(i).contains("#ffffff"));
    }
}

@test
fun recolouring_swaps_the_white_fill_and_nothing_else() {
    let drawn = recolour("<svg fill=\"#ffffff\"><path fill=\"#ffffff\"/></svg>", "#e8e8e8");
    assert_eq(drawn, "<svg fill=\"#e8e8e8\"><path fill=\"#e8e8e8\"/></svg>");
    assert_eq(recolour("<svg/>", "#e8e8e8"), "<svg/>");
}

@test
fun an_icon_is_keyed_by_its_name_and_colour() {
    let expected = Image.Bytes(
        "icon:home.svg:#e8e8e8",
        recolour(svg(Icon.Home), "#e8e8e8").to_bytes(),
    );
    assert_eq(icon(Icon.Home, "#e8e8e8"), expected);
}
