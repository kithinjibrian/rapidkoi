// Events (contract 9, docs/specs/contract-9.md): what Rapidkoi sends an
// app's `handle`, named `on_…`. Pure; no guest, no display.
import rapidkoi.guest.events { Happened, event_for };
import rapidkoi.guest.contract { reply };
import rapidkoi.net.network { Reply };
import cbor { Value, encode };
import support { t, kv };

@test
fun events_are_named_on_() {
    let named = fun(h: Happened) = event_for(h);
    assert_eq(named(Happened.Init), encode(kv([("event", t("on_init"))])));
    assert_eq(named(Happened.Open), encode(kv([("event", t("on_open"))])));
    assert_eq(named(Happened.Resume), encode(kv([("event", t("on_resume"))])));
    assert_eq(named(Happened.Change), encode(kv([("event", t("on_change"))])));
    assert_eq(
        named(Happened.Message(t("name"), Some("Amina"))),
        encode(kv([("event", t("on_message")), ("msg", t("name")), ("value", t("Amina"))])),
    );
    assert_eq(
        named(Happened.Message(t("add"), None)),
        encode(kv([("event", t("on_message")), ("msg", t("add"))])),
    );
    assert_eq(
        named(Happened.Answer(t("me"), Value.Bytes([1]))),
        encode(kv([("event", t("on_answer")), ("msg", t("me")), ("value", Value.Bytes([1]))])),
    );
    let got = reply(Reply.Got(200, #{"content-type": "text/plain"}, [7]));
    assert_eq(
        named(Happened.Answer(t("q"), got)),
        encode(kv([("event", t("on_response")), ("msg", t("q")), ("value", got)])),
    );
    let failed = reply(Reply.Failed("off"));
    assert_eq(
        named(Happened.Answer(t("q"), failed)),
        encode(kv([("event", t("on_fail")), ("msg", t("q")), ("value", failed)])),
    );
}

@test
fun a_data_change_names_its_tables() {
    assert_eq(
        event_for(Happened.DataChanged(["notes"])),
        encode(kv([("event", t("on_change")), ("tables", Value.Array([t("notes")]))])),
    );
}
