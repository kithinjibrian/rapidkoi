// Permissions (PRP-030): their names on the wire, their tiers, and reading
// a manifest's list. Pure; no display.
import rapidkoi.bundles.permissions {
    Permission,
    PermissionError,
    Tier,
    Setting,
    default_of,
    setting_name,
    setting_words,
    parse_setting,
    label_of,
    wish_of,
    SETTINGS,
    name_of,
    tier_of,
    words_of,
    parse,
    ALL,
};

@test
fun each_permission_has_its_name_tier_and_words() {
    assert_eq(ALL.map(fun(p: Permission) = name_of(p)), [
        "read_pins",
        "read_left_off",
        "open_apps",
        "restore_session",
        "change_settings",
    ]);
    for p of ALL {
        assert_eq(tier_of(p), Tier.BuiltIn);
    }
    assert_eq(words_of(Permission.ReadPins), "reading your pins");
    assert_eq(words_of(Permission.ReadLeftOff), "reading where you left off");
    assert_eq(words_of(Permission.OpenApps), "opening your apps");
    assert_eq(label_of(Permission.ReadLeftOff), "Reading where you left off");
    assert_eq(wish_of(Permission.ReadPins), "read your pins");
    // PRP-035.
    assert_eq(words_of(Permission.RestoreSession), "restoring your last session");
    assert_eq(wish_of(Permission.RestoreSession), "restore your last session");
    // PRP-038.
    assert_eq(words_of(Permission.ChangeSettings), "changing Rapidkoi's settings");
}

@test
fun a_list_parses_in_order() {
    assert_eq(parse(["open_apps", "read_pins"]), Ok([Permission.OpenApps, Permission.ReadPins]));
    assert_eq(parse([]), Ok([]));
}

@test
fun an_unknown_name_is_named() {
    assert_eq(parse(["read_pins", "camera"]), Err(PermissionError.Unknown("camera")));
}

@test
fun each_setting_has_its_name_and_words() {
    // PRP-031: the person decides; built-in permissions start allowed.
    for p of ALL {
        assert_eq(default_of(p), Setting.Allowed);
    }
    assert_eq(SETTINGS.map(fun(s: Setting) = setting_name(s)), ["allowed", "ask", "blocked"]);
    assert_eq(SETTINGS.map(fun(s: Setting) = setting_words(s)), [
        "Always allowed",
        "Needs approval",
        "Blocked",
    ]);
    assert_eq(parse_setting("ask"), Some(Setting.Ask));
    assert_eq(parse_setting("sometimes"), None);
}
