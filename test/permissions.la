// Permissions (PRP-030): their names on the wire, their tiers, and reading
// a manifest's list. Pure; no display.
import rapidkoi.bundles.permissions {
    Permission,
    PermissionError,
    Tier,
    Setting,
    default_of,
    setting_name,
    setting_words,
    parse_setting,
    label_of,
    wish_of,
    SETTINGS,
    name_of,
    tier_of,
    words_of,
    parse,
    ALL,
};

@test
fun each_permission_has_its_name_tier_and_words() {
    assert_eq(ALL.map(fun(p: Permission) = name_of(p)), [
        "read_pins",
        "read_left_off",
        "open_apps",
        "restore_session",
        "change_settings",
        "notifications",
        "read_notifications",
        "read_apps",
        "manage_pins",
        "show_widgets",
        "read_you",
        "read_publishers",
    ]);
    // Any app may send you notifications (PRP-065); everything else is Rapidkoi's own apps'.
    for p of ALL {
        assert_eq(tier_of(p), if p == Permission.Notify { Tier.Any } else { Tier.BuiltIn });
    }
    assert_eq(words_of(Permission.Notify), "sending you notifications");
    assert_eq(label_of(Permission.Notify), "Sending you notifications");
    assert_eq(wish_of(Permission.Notify), "send you notifications");
    assert_eq(words_of(Permission.ReadNotifications), "reading your notifications");
    // PRP-067: All apps.
    assert_eq(words_of(Permission.ReadApps), "reading your apps");
    assert_eq(label_of(Permission.ManagePins), "Changing your pins");
    assert_eq(wish_of(Permission.ManagePins), "change your pins");
    assert_eq(words_of(Permission.ReadPins), "reading your pins");
    assert_eq(words_of(Permission.ReadLeftOff), "reading your recent places");
    assert_eq(words_of(Permission.OpenApps), "opening your apps");
    assert_eq(label_of(Permission.ReadLeftOff), "Reading your recent places");
    assert_eq(wish_of(Permission.ReadPins), "read your pins");
    // PRP-035.
    assert_eq(words_of(Permission.RestoreSession), "restoring your last session");
    assert_eq(wish_of(Permission.RestoreSession), "restore your last session");
    // PRP-038.
    assert_eq(words_of(Permission.ChangeSettings), "changing Rapidkoi's settings");
    // PRP-073: the new tab's slot, never its widgets' contents.
    assert_eq(label_of(Permission.ShowWidgets), "Showing your widgets");
    assert_eq(wish_of(Permission.ShowWidgets), "show your widgets");
    // PRP-075: Settings' You and Publishers.
    assert_eq(label_of(Permission.ReadYou), "Reading who you are to your apps");
    assert_eq(wish_of(Permission.ReadPublishers), "read the keys you trust");
    assert_eq(
        parse(["read_you", "read_publishers"]),
        Ok([Permission.ReadYou, Permission.ReadPublishers]),
    );
}

@test
fun a_list_parses_in_order() {
    assert_eq(parse(["open_apps", "read_pins"]), Ok([Permission.OpenApps, Permission.ReadPins]));
    assert_eq(parse([]), Ok([]));
    assert_eq(
        parse(["notifications", "read_notifications"]),
        Ok([Permission.Notify, Permission.ReadNotifications]),
    );
}

@test
fun an_unknown_name_is_named() {
    assert_eq(parse(["read_pins", "camera"]), Err(PermissionError.Unknown("camera")));
}

@test
fun each_setting_has_its_name_and_words() {
    // PRP-031: the person decides; built-in permissions start allowed, and
    // notifications ask first (PRP-065).
    for p of ALL {
        assert_eq(
            default_of(p),
            if p == Permission.Notify { Setting.Ask } else { Setting.Allowed },
        );
    }
    assert_eq(SETTINGS.map(fun(s: Setting) = setting_name(s)), ["allowed", "ask", "blocked"]);
    assert_eq(SETTINGS.map(fun(s: Setting) = setting_words(s)), [
        "Always allowed",
        "Needs approval",
        "Blocked",
    ]);
    assert_eq(parse_setting("ask"), Some(Setting.Ask));
    assert_eq(parse_setting("sometimes"), None);
}
