// What a tab's and a pin's menu items do (PRP-010): select the tab first,
// then act as the bar or panel would. The menus themselves come back with
// the redesign's tabs and new tab (DECISION-030). Fixture guests; no
// display, no network.
import rapidkoi.shell { update };
import rapidkoi.window.window { Model, with_pages, page_of };
import rapidkoi.window.actions { Msg, ShieldPage, PanelPage, Confirm, TabAction, PinAction };
import rapidkoi.window.tabs { AppPage, open_module };
import wasmtime { Engine, Module };
import support { echo };
import rapidkoi.ui.header { menu_card };
import rapidkoi.ui.layout { view };
import rapidkoi.window.navigate { open_file };
import kivuli.testing { texts, click, press, chooser, answer_chooser };

fun app(engine: Engine, name: string): AppPage = open_module(
    name,
    "{name}.wasm",
    engine,
    Module.from_text(engine, echo()).unwrap(),
);

/** Two tabs, notes (id 0) and todo (id 1); notes is current. */
fun two(): Model {
    let engine = Engine.new();
    with_pages(engine, [app(engine, "notes"), app(engine, "todo")])
}

fun step(m: Model, msg: Msg): Model {
    let (next, _) = update(m, msg);
    next
}

@test
fun picking_an_item_selects_that_tab_then_acts() {
    let m = two();
    let about = step(m, Msg.OnTab(1, TabAction.About));
    // About this app opens the shield's card (PRP-022: the old About page is gone).
    assert_eq((about.current, about.shield), (Some(1), Some(ShieldPage.Main)));
    let pinned = step(m, Msg.OnTab(1, TabAction.TogglePin));
    assert_eq(
        (pinned.current, pinned.pinned.len, pinned.pinned[0].path),
        (Some(1), 1, "todo.wasm"),
    );
    let closed = step(m, Msg.OnTab(1, TabAction.Close));
    assert_eq(closed.tabs.len, 1);
    // Forget still asks first.
    let asked = step(m, Msg.OnTab(1, TabAction.Forget));
    assert_eq(
        (asked.current, asked.panel, asked.confirm),
        // Asked over site settings, which the menu opened, so they stay open
        // on the newly shown tab (session 165).
        (Some(1), Some(PanelPage.Main), Some(Confirm.Forget(1))),
    );
    assert_eq(asked.tabs.len, 2);
    let reloaded = step(m, Msg.OnTab(1, TabAction.Reload));
    assert_eq(reloaded.current, Some(1));
    // A tab that's gone: nothing happens.
    let gone = step(m, Msg.OnTab(9, TabAction.Close));
    assert_eq((gone.tabs.len, gone.current), (2, Some(0)));
}

@test
fun a_pin_s_actions() {
    let pinned = step(step(two(), Msg.TogglePin), Msg.Home);
    let unpinned = step(pinned, Msg.OnPin("notes.wasm", None, PinAction.Unpin));
    // Still on the empty tab Home showed (PRP-024).
    assert_eq((unpinned.pinned.len, unpinned.blanks.len), (0, 1));
    // Forget shows it (its open tab, PRP-026), with the question.
    let asked = step(pinned, Msg.OnPin("notes.wasm", None, PinAction.Forget));
    assert_eq((asked.panel, asked.confirm), (Some(PanelPage.Main), Some(Confirm.Forget(0))));
    assert_eq(asked.current, Some(0));
    // Unpinning a path that isn't pinned changes nothing.
    assert_eq(step(pinned, Msg.OnPin("other.wasm", None, PinAction.Unpin)).pinned.len, 1);
}

@test
fun open_app_opens_the_chooser_from_the_menu_and_ctrl_o() {
    // PRP-058: first in ☰'s card, and Ctrl+O from anywhere.
    let m = two();
    let card = menu_card(m.theme, false);
    assert_eq(texts(card)[0], "Open App…");
    assert_eq(click(card, "Open App…"), Ok(Msg.OpenApp));
    assert_eq(press(view(m), "Ctrl+O"), Ok(Msg.OpenApp));
    let (shut, cmd) = update(Model { menu: true, ..m }, Msg.OpenApp);
    assert_eq(shut.menu, false);
    let c = chooser(cmd).unwrap();
    assert_eq(c.title, "Open an app");
    assert_eq((c.filters[0].name, c.filters[0].patterns), ("Rapidkoi apps", ["*.rkb", "*.wasm"]));
}

@test
fun a_chosen_app_opens_as_a_typed_path_does() {
    let m = two();
    let (_, cmd) = update(m, Msg.OpenApp);
    let chosen = step(m, answer_chooser(cmd, Some("test/tmp/menus-chosen.wasm")).unwrap());
    let (typed, _) = open_file(m, "test/tmp/menus-chosen.wasm");
    let path = fun(x: Model) = match page_of(x) {
        App(a) => a.path,
        Home => "",
    };
    assert_eq((path(chosen), chosen.tabs.len), (path(typed), typed.tabs.len));
    // Cancelled: nothing changes.
    let kept = step(m, answer_chooser(cmd, None).unwrap());
    assert_eq((kept.current, kept.tabs.len), (m.current, m.tabs.len));
}
