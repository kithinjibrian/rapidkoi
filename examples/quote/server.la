/**
 * The quote-of-the-day demo's server (PRP-012): it serves the app's signed
 * site (as `./main serve` does), signs people in exactly as
 * `docs/server-sign-in.md` says, and gives the day's quote, naming who's
 * signed in. Everything is in memory: a restart signs everyone out.
 *
 *     lughac build examples/quote/server.la -o quote-server
 *     ./quote-server --site examples/quote/site --host localhost:8000 --port 8000
 *
 * `--host` is the app's host as its address shows it: the sign-in message
 * is rebuilt with it, never with anything a request says. `--listen`
 * (default 127.0.0.1) is where it accepts connections; a container behind
 * a TLS proxy uses 0.0.0.0.
 *
 * Depends on: rapidkoi.serve, rapidkoi.identity, cbor, std.crypto, std.http, std.time
 */
import rapidkoi.serve { handle };
import rapidkoi.identity { sign_in_message, user_label };
import rapidkoi.keys { hex };
import cbor { Value, Entry, Limits, decode, encode };
import std.crypto { ed25519_verify, ed25519_keypair, ed25519_sign, random_bytes, equal };
import std.http { Request, Response };
import std.time;

/** How long a challenge may wait for its proof, in milliseconds. */
const CHALLENGE_MS: i64 = 5 * 60 * 1000;

/** The most challenges or sessions kept; the oldest go first. */
const MAX_KEPT: i64 = 10_000;

/** A challenge handed out and not yet used. */
struct Issued {
    challenge: u8[],
    until: i64,
}

/** A signed-in person: their token, and their key for this app. */
struct Session {
    token: string,
    key: u8[],
}

/** The server's memory. */
struct State {
    host: string,
    site: string,
    port: i64,
    issued: Ref<Issued[]>,
    sessions: Ref<Session[]>,
}

fun quotes(): (string, string)[] = [
    ("Simplicity is prerequisite for reliability.", "Edsger W. Dijkstra"),
    ("The best way to predict the future is to invent it.", "Alan Kay"),
    ("Premature optimization is the root of all evil.", "Donald Knuth"),
    ("Programs must be written for people to read.", "Harold Abelson"),
    ("Make it work, make it right, make it fast.", "Kent Beck"),
    ("Talk is cheap. Show me the code.", "Linus Torvalds"),
    ("Controlling complexity is the essence of computer programming.", "Brian Kernighan"),
];

/** Answers one request: a challenge, a sign-in, the quote, or the site. */
fun answer(s: State, r: Request, now: i64): Response {
    if r.method == "GET" && r.path == "/rapidkoi/challenge" {
        return challenge(s, now);
    }
    if r.method == "POST" && r.path == "/rapidkoi/sign-in" {
        return sign_in(s, r.body, now);
    }
    if r.method == "GET" && r.path == "/quote" {
        return quote(s, r, now);
    }
    handle(s.site, s.port, r)
}

fun challenge(s: State, now: i64): Response {
    let c = random_bytes(32).expect("OpenSSL gives 32 random bytes");
    s.issued.update(
        fun(xs: Issued[]) = kept(xs.filter(fun(i: Issued) = i.until > now), Issued {
            challenge: c,
            until: now + CHALLENGE_MS,
        }),
    );
    Response { headers: #{"cache-control": "no-store"}, ..http.bytes(200, c) }
}

/** The checks of `docs/server-sign-in.md`, in its order. */
fun sign_in(s: State, body: u8[], now: i64): Response {
    let proof = match decode(body, Limits.default()) {
        Ok(v) => v,
        Err(_) => {
            return http.text(400, "The proof isn't CBOR");
        }
    };
    let (key, c, signature) = match (
        proof.get("key"),
        proof.get("challenge"),
        proof.get("signature"),
    ) {
        (Some(Bytes(k)), Some(Bytes(c)), Some(Bytes(sig))) if k.len == 32 && sig.len == 64 => (
            k,
            c,
            sig,
        ),
        _ => {
            return http.text(
                400,
                "The proof needs a 32-byte key, the challenge and a 64-byte signature",
            );
        }
    };
    // 1. One this server issued, not expired, and used once: it goes now, pass or fail.
    let fresh = s.issued.get().any(fun(i: Issued) = i.until > now && equal(i.challenge, c));
    s.issued.update(fun(xs: Issued[]) = xs.filter(fun(i: Issued) = !equal(i.challenge, c)));
    if !fresh {
        return http.text(401, "That challenge is unknown, expired or used");
    }
    // 2 and 3. Over this server's own host, verified with the posted key.
    if !ed25519_verify(key, sign_in_message(s.host, c), signature) {
        return http.text(401, "The signature doesn't match");
    }
    let token = hex(random_bytes(16).expect("OpenSSL gives 16 random bytes"));
    s.sessions.update(fun(xs: Session[]) = kept(xs, Session { token: token, key: key }));
    Response { headers: #{"cache-control": "no-store"}, ..http.text(200, token) }
}

/** Today's quote; `x-signed-in` names who the token belongs to, if it's one. */
fun quote(s: State, r: Request, now: i64): Response {
    let all = quotes();
    let (words, by) = all[now / (24 * 60 * 60 * 1000) % all.len];
    let mut headers: Map<string, string> = #{
        "content-type": "text/plain",
        "cache-control": "no-store",
    };
    if let Some(key) = who(s, r.header("authorization").unwrap_or("")) {
        headers["x-signed-in"] = user_label(key);
    }
    Response { headers: headers, ..http.text(200, "{words}\n— {by}") }
}

fun who(s: State, authorization: string): Option<u8[]> {
    if !authorization.starts_with("Bearer ") {
        return None;
    }
    let token = authorization.slice(7, authorization.len);
    for x of s.sessions.get() {
        if x.token == token {
            return Some(x.key);
        }
    }
    None
}

/** `xs` with `x` added, dropping the oldest past `MAX_KEPT`. */
fun kept<T>(xs: T[], x: T): T[] {
    let mut out: T[] = [];
    let start = if xs.len + 1 > MAX_KEPT { xs.len + 1 - MAX_KEPT } else { 0 };
    for i in start..xs.len {
        out.push(xs[i]);
    }
    out.push(x);
    out
}

fun flag(argv: string[], name: string, default: string): string {
    for i in 0..argv.len {
        if argv[i] == name && i + 1 < argv.len {
            return argv[i + 1];
        }
    }
    default
}

fun main(): i32 {
    let argv = args();
    let port = match parse_i64(flag(argv, "--port", "8000")) {
        Some(p) if p > 0 && p < 65536 => p,
        _ => {
            eprintln("--port takes a port number");
            return 2;
        }
    };
    let s = State {
        host: flag(argv, "--host", "localhost:{port}"),
        site: flag(argv, "--site", "examples/quote/site"),
        port: port,
        issued: Ref.new([]),
        sessions: Ref.new([]),
    };
    let listen = flag(argv, "--listen", "127.0.0.1");
    println("Quote server for {s.host}, serving {s.site} on {listen}:{port}");
    match http.serve("{listen}:{port}", fun(r: Request) = answer(s, r, time.now_ms())) {
        Ok(_) => 0,
        Err(e) => {
            eprintln("can't serve: {e}");
            1
        }
    }
}

// Tests: `lughac test examples/quote/server.la`. The sign-in rules
// themselves are checked against Rapidkoi's signing in test/signin.la.

fun state(): State = State {
    host: "quote.example",
    site: "/nonexistent",
    port: 8000,
    issued: Ref.new([]),
    sessions: Ref.new([]),
};

fun proof(key: u8[], c: u8[], sig: u8[]): u8[] = encode(
    Value.Map([
        Entry { key: Value.Text("key"), value: Value.Bytes(key) },
        Entry { key: Value.Text("challenge"), value: Value.Bytes(c) },
        Entry { key: Value.Text("signature"), value: Value.Bytes(sig) },
    ]),
);

fun get(path: string, headers: Map<string, string>): Request = Request {
    method: "GET",
    path: path,
    query: "",
    headers: headers,
    body: [],
    peer: "127.0.0.1:1",
};

@test
fun a_challenge_signs_in_once_and_names_who_on_the_quote() {
    let s = state();
    let (secret, key) = ed25519_keypair().unwrap();
    let c = challenge(s, 1000).body;
    let sig = ed25519_sign(secret, sign_in_message("quote.example", c)).unwrap();
    let ok = sign_in(s, proof(key, c, sig), 2000);
    assert_eq(ok.status, 200);
    assert_eq(sign_in(s, proof(key, c, sig), 2000).status, 401);
    let token = string_from_utf8(ok.body).unwrap();
    let asked = get("/quote", #{"authorization": "Bearer {token}"});
    assert_eq(quote(s, asked, 0).headers.get("x-signed-in"), Some(user_label(key)));
    assert_eq(quote(s, get("/quote", #{}), 0).headers.get("x-signed-in"), None);
}

@test
fun expired_foreign_and_malformed_proofs_are_refused() {
    let s = state();
    let (secret, key) = ed25519_keypair().unwrap();
    let late = challenge(s, 0).body;
    let sig = ed25519_sign(secret, sign_in_message("quote.example", late)).unwrap();
    assert_eq(sign_in(s, proof(key, late, sig), CHALLENGE_MS + 1).status, 401);
    let c = challenge(s, 0).body;
    let elsewhere = ed25519_sign(secret, sign_in_message("other.example", c)).unwrap();
    assert_eq(sign_in(s, proof(key, c, elsewhere), 1).status, 401);
    assert_eq(sign_in(s, [1, 2, 3], 1).status, 400);
    assert_eq(kept([1, 2], 3), [1, 2, 3]);
}
