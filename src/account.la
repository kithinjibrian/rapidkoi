/**
 * The info panel's Account page (PRP-011): who you are to this app ("User
 * 4f9a"), signing out and in, signing in automatically, starting over as
 * someone new, and the name apps may show with `{FIRST_NAME}` and
 * `{LAST_NAME}` (for every app, or this one). Pure view and model changes;
 * keys are worked out from the cached master secret, never read here.
 *
 * Depends on: kivuli, actions, tabs, window, people, identity, theme
 * Used by: panel, shell
 */
import kivuli { View, Align, ButtonStyle, button, checkbox, column, input, row, text };
import actions { Msg, Confirm, NameScope, NamePart };
import tabs { AppPage, Page, handle };
import window { Model, with_tab, page_of };
import people { Person, MAX_NAME, person, with_person, forget_person };
import identity { public_key, user_label };
import render;
import theme { SPACE_XS, SPACE_SM, PANEL_CHARS };

/** What the Account page shows for one app. */
public struct Account {
    /** The app's name. */
    public app: string,
    /** You to this app; `None` for an unsigned app (no account possible). */
    public person: Option<Person>,
    /** "User 4f9a", once the app has asked and the key is known. */
    public label: Option<string>,
    /** Your name for every app, first and last. */
    public everywhere: (string, string),
}

/**
 * Works out the Account page's facts for an app page.
 *
 * Example:
 *     account_of(m, page)
 */
public fun account_of(m: Model, p: AppPage): Account {
    let everywhere = (m.people.first, m.people.last);
    match p.trust {
        None => Account { app: p.name, person: None, label: None, everywhere: everywhere },
        Some(t) => {
            let x = person(m.people, t.host, t.origin);
            // The label needs the master secret, which is read only when an app asks.
            let label = match m.master {
                Some(mm) => public_key(mm, t.host, t.origin, x.generation).ok().map(user_label),
                None => None,
            };
            Account { app: p.name, person: Some(x), label: label, everywhere: everywhere }
        }
    }
}

/**
 * The main page's one-line summary for the Account row.
 *
 * Example:
 *     summary(account)
 */
public fun summary(a: Account): string = match a.person {
    None => "No account",
    Some(x) => if x.signed_out { "Signed out" } else { a.label.unwrap_or("Not signed in yet") },
};

/**
 * The Account page's parts.
 *
 * @param confirm Start over as someone new, waiting for "yes"
 *
 * Example:
 *     page(account, m.confirm)
 */
public fun page(a: Account, confirm: Option<Confirm>): View<Msg>[] {
    let x = match a.person {
        None => {
            return [
                left(
                    text("{a.app} isn't signed, so it can't have an account.").wrap_at(PANEL_CHARS),
                ),
            ];
        }
        Some(x) => x,
    };
    let who = if x.signed_out {
        "Signed out"
    } else {
        match a.label {
            Some(l) => "Signed in as {l}",
            None => "Signed in when {a.app} asks",
        }
    };
    let (first, last) = a.everywhere;
    let mut parts = [
        left(text("How {a.app} knows you").dim()),
        left(text(who)),
        left(checkbox("Sign in automatically", x.auto, fun(_: bool) = Msg.ToggleAutoSignIn)),
        left(
            if x.signed_out {
                button("Sign in", Msg.SignIn)
            } else {
                button("Sign out", Msg.SignOut)
            },
        ),
        left(text("Your name").dim()),
        left(text("Apps can show your name; they never see it.").dim().wrap_at(PANEL_CHARS)),
        field("First name", first, NameScope.Everywhere, NamePart.First),
        field("Last name", last, NameScope.Everywhere, NamePart.Last),
        field("First name in {a.app} only", x.first, NameScope.ThisApp, NamePart.First),
        field("Last name in {a.app} only", x.last, NameScope.ThisApp, NamePart.Last),
        left(
            text("Your key for {a.app} is kept on this computer only.").dim().wrap_at(PANEL_CHARS),
        ),
    ];
    parts.push(match confirm {
        Some(StartOverIdentity) => column([
            text(
                "{a.app} will see you as a new person, and starts again. Your old account there can't be used from Rapidkoi again.",
            ).wrap_at(PANEL_CHARS),
            row([
                button("Cancel", Msg.Cancel),
                button("Start over", Msg.StartOverIdentity).button_style(ButtonStyle.Danger),
            ]).spacing(SPACE_SM),
        ]).spacing(SPACE_SM),
        _ => left(
            button("Start over as someone new", Msg.Ask(Confirm.StartOverIdentity)).button_style(
                ButtonStyle.Danger,
            ),
        ),
    });
    parts
}

/**
 * Applies an Account page message to the current app (the panel's app).
 * A message for an unsigned app, or with no app open, changes nothing.
 *
 * Example:
 *     on_account(m, Msg.SignOut)
 */
public fun on_account(m: Model, msg: Msg): Model {
    // Your name for every app needs no app.
    if let SetName(Everywhere, part, s) = msg {
        let clipped = clip(s);
        return Model {
            people: match part {
                First => {
                    let mut p = m.people;
                    p.first = clipped;
                    p
                }
                Last => {
                    let mut p = m.people;
                    p.last = clipped;
                    p
                }
            },
            ..m,
        };
    }
    let (id, a) = match (m.current, page_of(m)) {
        (Some(id), App(a)) => (id, a),
        _ => {
            return m;
        }
    };
    let t = match a.trust {
        Some(t) => t,
        None => {
            return m;
        }
    };
    let x = person(m.people, t.host, t.origin);
    let next = match msg {
        SetName(_, First, s) => Person { first: clip(s), ..x },
        SetName(_, Last, s) => Person { last: clip(s), ..x },
        ToggleAutoSignIn => Person { auto: !x.auto, ..x },
        SignOut => Person { signed_out: true, ..x },
        SignIn => Person { signed_out: false, ..x },
        StartOverIdentity => Person { generation: x.generation + 1, signed_out: false, ..x },
        _ => x,
    };
    let saved = Model { people: with_person(m.people, next), confirm: None, ..m };
    match msg {
        // A new person: the app starts again, so its init asks for the new key.
        StartOverIdentity => with_tab(saved, id, fun(p: AppPage) = handle(p, render.Msg.Restart)),
        _ => saved,
    }
}

/**
 * Forget this app: its Account settings and name go too (the name for
 * every app stays).
 *
 * @param before the model with the app still current
 * @param after the model `window.forget` gave
 *
 * Example:
 *     forget_account(m, window.forget(m))
 */
public fun forget_account(before: Model, after: Model): Model = match page_of(before) {
    App(a) => match a.trust {
        Some(t) => Model { people: forget_person(after.people, t.host, t.origin), ..after },
        None => after,
    },
    _ => after,
};

/** A name field: what it holds, its hint, and what typing sends. */
fun field(hint: string, value: string, scope: NameScope, part: NamePart): View<Msg> = input(
    value,
    fun(s: string) = Msg.SetName(scope, part, s),
).placeholder(hint);

/** At most `MAX_NAME` characters. */
fun clip(s: string): string {
    let mut out = "";
    let mut count = 0;
    for c of s.chars() {
        if count < MAX_NAME {
            out = out + "{c}";
            count += 1;
        }
    }
    out
}

fun left(v: View<Msg>): View<Msg> = row([v]).align(Align.Start);
