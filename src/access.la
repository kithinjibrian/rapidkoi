/**
 * The info panel's Access page (PRP-012): what an app can reach (its own
 * server, then the servers its manifest declares), a switch for each on a
 * signed app, "New" beside servers an update added, and the one-time
 * notice that says so. Pure view and model changes; requests themselves
 * are `requests.la`'s.
 *
 * Depends on: kivuli, actions, tabs, window, people, requests, theme
 * Used by: panel, shell
 */
import kivuli { View, Align, checkbox, column, row, text };
import actions { Msg, PanelPage };
import tabs { AppPage, Page, Tab };
import window { Model, page_of };
import people { Person, person, with_person, known };
import requests { allowed };
import theme { SPACE_XS, SPACE_MD, PANEL_CHARS };

/** What the Access page shows for one app. */
public struct Access {
    /** The app's name. */
    public app: string,
    /** Its own server, if it has one. */
    public own: Option<string>,
    /** The other servers it can reach. */
    public servers: string[],
    /** Those you switched off. */
    public off: string[],
    /** Those an update added that you haven't looked at yet. */
    public fresh: string[],
    /** Whether it has switches: only a signed app's settings are kept. */
    public switches: bool,
}

/**
 * Works out the Access page's facts for an app page.
 *
 * Example:
 *     access_of(m, page)
 */
public fun access_of(m: Model, p: AppPage): Access {
    let a = allowed(m, p);
    let fresh = match p.trust {
        Some(t) => person(m.people, t.host, t.origin).fresh,
        None => [],
    };
    Access {
        app: p.name,
        own: a.own,
        servers: a.servers,
        off: a.off,
        fresh: fresh,
        switches: p.trust.is_some(),
    }
}

/**
 * The main page's one-line summary for the Access row: "None", "1
 * server", "3 servers, 1 off".
 *
 * Example:
 *     summary(access)
 */
public fun summary(a: Access): string {
    let all = listed(a);
    if all.len == 0 {
        return "None";
    }
    let noun = if all.len == 1 { "server" } else { "servers" };
    let off = all.filter(fun(s: string) = has(a.off, s)).len;
    if off == 0 { "{all.len} {noun}" } else { "{all.len} {noun}, {off} off" }
}

/**
 * The Access page's parts.
 *
 * Example:
 *     page(access)
 */
public fun page(a: Access): View<Msg>[] {
    let all = listed(a);
    if all.len == 0 {
        return [
            left(text("None: {a.app} can't reach anything outside itself.").wrap_at(PANEL_CHARS)),
        ];
    }
    let mut parts = [left(text("What {a.app} can reach").dim())];
    for s of all {
        let own = a.own == Some(s);
        let name: View<Msg> = if a.switches {
            checkbox(s, !has(a.off, s), fun(_: bool) = Msg.ToggleServer(s))
        } else {
            text(s)
        };
        let mut lines = [left(name)];
        if own {
            lines.push(left(text("Its own server").dim()));
        }
        if has(a.fresh, s) {
            lines.push(left(text("New").bold()));
        }
        parts.push(column(lines).spacing(SPACE_XS));
    }
    parts.push(
        left(
            text(
                if a.switches {
                    "{a.app} can only reach these. Switched off, it's told so, and nothing is sent."
                } else {
                    "{a.app} isn't signed, so it can only reach servers on this computer."
                },
            ).dim().wrap_at(PANEL_CHARS),
        ),
    );
    parts
}

/**
 * Applies a switch to the current app (the panel's app): off if it was on,
 * on if it was off. Nothing for an unsigned app, or with no app open.
 *
 * Example:
 *     on_access(m, "api.acme.com")
 */
public fun on_access(m: Model, server: string): Model = match page_of(m) {
    App(p) => match p.trust {
        Some(t) => {
            let x = person(m.people, t.host, t.origin);
            let off = if has(x.off, server) {
                x.off.filter(fun(s: string) = s != server)
            } else {
                let mut more = x.off;
                more.push(server);
                more
            };
            Model { people: with_person(m.people, Person { off: off, ..x }), ..m }
        }
        None => m,
    },
    _ => m,
};

/**
 * Clears "New" for the app whose Access page was just left.
 *
 * @param before the model before the message, its panel maybe on Access
 * @param after the model after it
 *
 * Example:
 *     looked(m, next)
 */
public fun looked(before: Model, after: Model): Model {
    let was = match before.panel {
        Some(Access) => true,
        _ => false,
    };
    let still = match after.panel {
        Some(Access) => true,
        _ => false,
    };
    if !was || still {
        return after;
    }
    match page_of(before) {
        App(p) => match p.trust {
            Some(t) => {
                let x = person(after.people, t.host, t.origin);
                if x.fresh.len == 0 {
                    return after;
                }
                Model { people: with_person(after.people, Person { fresh: [], ..x }), ..after }
            }
            None => after,
        },
        _ => after,
    }
}

/**
 * Notes what each signed app declares: on its first open, silently; after
 * an update adds servers, once, with the notice "Notes can now also reach
 * X" and "New" on its Access page.
 *
 * Example:
 *     news(m)
 */
public fun news(m: Model): Model {
    let mut at = m;
    for t of m.tabs {
        at = noted(at, t.page);
    }
    at
}

fun noted(m: Model, p: AppPage): Model {
    let (t, declared) = match (p.trust, p.manifest) {
        (Some(t), Some(man)) => (t, man.servers),
        _ => {
            return m;
        }
    };
    let x = person(m.people, t.host, t.origin);
    if !known(m.people, t.host, t.origin) {
        return Model { people: with_person(m.people, Person { seen: declared, ..x }), ..m };
    }
    let added = declared.filter(fun(s: string) = !has(x.seen, s));
    if added.len == 0 {
        return m;
    }
    let mut seen = x.seen;
    let mut fresh = x.fresh;
    for s of added {
        seen.push(s);
        fresh.push(s);
    }
    let said = "{p.name} can now also reach {added.join(", ")}";
    Model {
        people: with_person(m.people, Person { seen: seen, fresh: fresh, ..x }),
        notice: Some(match m.notice {
            Some(n) => "{n} · {said}",
            None => said,
        }),
        ..m,
    }
}

/** The own server first, then the others. */
fun listed(a: Access): string[] {
    let mut all: string[] = [];
    if let Some(o) = a.own {
        all.push(o);
    }
    for s of a.servers {
        if !has(all, s) {
            all.push(s);
        }
    }
    all
}

fun has(xs: string[], s: string): bool = xs.any(fun(x: string) = x == s);

fun left(v: View<Msg>): View<Msg> = row([v]).align(Align.Start);
