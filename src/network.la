/**
 * Which requests an app may make (PRP-012), pure: its own host and the
 * servers its signed manifest declares, by name over HTTPS; plain HTTP to
 * this machine only for apps from this machine; never a switched-off
 * server; and the request's own method, headers and size. And what a name
 * may point to (PRP-013): never this computer or the local network.
 * Nothing is sent or looked up from here (`dialing.la` does both).
 *
 * Depends on: address, limits
 * Used by: bundle, nodes, contract, effects, requests
 */
import address { parse, shown, site_url };
import limits { MAX_BODY_UP };

/** One request an app asks for. */
public struct Request {
    /** GET, POST, PUT, PATCH or DELETE. */
    public method: string,
    /** Where: `https://host[:port]/path?query` (or `http://localhost:PORT/…` from this machine). */
    public url: string,
    /** Its own headers, name and value. */
    public headers: (string, string)[],
    /** The body, at most `MAX_BODY_UP` bytes. */
    public body: u8[],
}

/** What one app may reach. */
public struct Allowed {
    /** Its own host, as addresses show it (`counter.dafifi.net`, `localhost:8000`); none for a bare file. */
    public own: Option<string>,
    /** What its manifest declares. */
    public servers: string[],
    /** What the person switched off for it. */
    public off: string[],
    /** Whether the app itself came from this machine (a local file or address). */
    public local: bool,
}

/** Why a request wasn't sent. */
public enum NetworkError {
    /** Not its own host and not declared. */
    NotListed(string),
    /** Switched off on the Access page. */
    Off(string),
    /** A remote app asking for this machine. */
    Local,
    /** Plain HTTP to another computer. */
    NotHttps,
    /** An IP address instead of a name. */
    IpAddress,
    /** Not an http(s) URL. */
    BadUrl,
    /** A method other than the five. */
    BadMethod(string),
    /** A header it can't set. */
    BadHeader(string),
    /** A body over the cap. */
    TooLarge,
    /** Too many in flight for this app. */
    TooMany,
    /** The name points to this computer or the local network (PRP-013). */
    PointsLocal(string),
    /** The name has no address. */
    NoAddress(string),
    /** The name couldn't be looked up: the name, the resolver's reason. */
    Lookup(string, string),
}

/** What came back for one request, answered to the app. */
public enum Reply {
    /** The server's answer: status, headers (names in lower case), body. */
    Got(i64, Map<string, string>, u8[]),
    /** It wasn't sent, or didn't come back: the sentence the app gets. */
    Failed(string),
}

/**
 * Checks a server a manifest declares: a host name with a dot (an
 * optional port), or `localhost:PORT` for development; never an IP.
 *
 * Example:
 *     check_server("api.notes.acme.com")?
 */
public fun check_server(name: string): Result<(), string> = match parse("https://{name}") {
    Ok(a) if shown(a) == name || "{shown(a)}:443" == name => Ok(()),
    _ => Err("\"{name}\" isn't a server name (like api.example.com)"),
};

/**
 * Checks one request against what the app may reach.
 *
 * @returns the request to send, its URL as Rapidkoi rebuilt it; or why not
 *
 * Example:
 *     check_request(request, allowed)?
 */
public fun check_request(r: Request, a: Allowed): Result<Request, NetworkError> {
    let methods = ["GET", "POST", "PUT", "PATCH", "DELETE"];
    if !methods.any(fun(m: string) = m == r.method) {
        return Err(NetworkError.BadMethod(r.method));
    }
    if !(r.url.starts_with("https://") || r.url.starts_with("http://")) {
        return Err(NetworkError.BadUrl);
    }
    let at = match parse(r.url) {
        Ok(at) => at,
        Err(NotSecure(_)) => {
            return Err(NetworkError.NotHttps);
        }
        Err(IpAddress(_)) => {
            return Err(NetworkError.IpAddress);
        }
        Err(_) => {
            return Err(NetworkError.BadUrl);
        }
    };
    // This computer is reachable only by apps that came from it.
    if !at.remote && !a.local {
        return Err(NetworkError.Local);
    }
    let host = shown(at);
    let listed = a.own == Some(host) || a.servers.any(fun(s: string) = s == host);
    if !listed {
        return Err(NetworkError.NotListed(host));
    }
    if a.off.any(fun(s: string) = s == host) {
        return Err(NetworkError.Off(host));
    }
    for (name, value) of r.headers {
        if !token(name) || forbidden(name) || !clean(value) {
            return Err(NetworkError.BadHeader(name));
        }
    }
    if r.body.len > MAX_BODY_UP {
        return Err(NetworkError.TooLarge);
    }
    // Rebuilt from what was checked, so nothing unchecked rides along.
    Ok(Request { url: site_url(at, at.route), ..r })
}

/**
 * Returns a plain sentence for a refused request, naming the app.
 *
 * Example:
 *     reason(e, "Counter")
 */
public fun reason(e: NetworkError, app: string): string = match e {
    NotListed(h) => "{h} isn't one of {app}'s servers",
    Off(h) => "You turned off {h} for {app}",
    Local => "Apps from the internet can't reach this computer",
    NotHttps => "Requests to other computers use HTTPS",
    IpAddress => "Requests go to a server's name, not its IP address",
    BadUrl => "That isn't a web address",
    BadMethod(m) => "Requests can't use {m}",
    BadHeader(h) => "Requests can't set {h}",
    TooLarge => "A request's body is at most 1 MB",
    TooMany => "Too many requests at once; try again",
    PointsLocal(h) => "{h} points to this computer or your local network, so Rapidkoi won't connect to it",
    NoAddress(h) => "{h} has no address",
    Lookup(h, why) => "Couldn't look up {h}: {why}",
};

/**
 * Checks every address a name points to: all must be public, or the name
 * is refused whole (a mixed answer is a sign of trickery, PRP-013).
 *
 * @param host the name, as messages show it
 * @param addresses what the lookup gave
 * @returns the addresses to try, in order; or why not
 *
 * Example:
 *     check_addresses("api.acme.com", resolved)?
 */
public fun check_addresses(host: string, addresses: string[]): Result<string[], NetworkError> {
    if addresses.len == 0 {
        return Err(NetworkError.NoAddress(host));
    }
    if addresses.any(local_address) {
        return Err(NetworkError.PointsLocal(host));
    }
    Ok(addresses)
}

/**
 * Says whether an address is on this computer or the local network, or
 * otherwise not a public one: loopback, unspecified, private, link-local,
 * shared ISP space, multicast, broadcast, documentation and reserved
 * ranges, IPv6's own, and IPv4 inside IPv6 judged as IPv4. Text that isn't
 * an address counts as local, so it's refused rather than guessed.
 *
 * Example:
 *     local_address("169.254.169.254")
 */
public fun local_address(ip: string): bool {
    if let Some(v) = ipv4(ip) {
        return local_v4(v);
    }
    // A zone (`fe80::1%eth0`) only exists on link-local addresses; judge the rest.
    let bare = ip.split("%")[0];
    match ipv6(bare) {
        Some(g) => local_v6(g),
        None => true,
    }
}

/** The IPv4 ranges that aren't public, as (first address, prefix length). */
fun local_v4(v: i64): bool {
    let ranges = [
        (0x00000000, 8), // this network
        (0x0a000000, 8), // private
        (0x64400000, 10), // shared ISP space (CGNAT)
        (0x7f000000, 8), // this computer
        (0xa9fe0000, 16), // link-local, cloud metadata
        (0xac100000, 12), // private
        (0xc0000000, 24), // IETF protocol assignments
        (0xc0000200, 24), // documentation
        (0xc0a80000, 16), // private
        (0xc6120000, 15), // benchmarking
        (0xc6336400, 24), // documentation
        (0xcb007100, 24), // documentation
        (0xe0000000, 4), // multicast
        (0xf0000000, 4), // reserved, broadcast
    ];
    ranges.any(fun(r: (i64, i64)) = v >> 32 - r.1 == r.0 >> 32 - r.1)
}

/** The IPv6 ranges that aren't public, on its eight 16-bit groups. */
fun local_v6(g: i64[]): bool {
    let zeros = fun(n: i64) = range(0, n).all(fun(i: i64) = g[i] == 0);
    let v4 = g[6] << 16 | g[7];
    // IPv4 inside IPv6: mapped (::ffff:a.b.c.d), compatible (::a.b.c.d, which
    // includes :: and ::1), and NAT64 (64:ff9b::a.b.c.d).
    if zeros(5) && g[5] == 0xffff || zeros(6) {
        return local_v4(v4);
    }
    if g[0] == 0x64 && g[1] == 0xff9b && range(2, 6).all(fun(i: i64) = g[i] == 0) {
        return local_v4(v4);
    }
    g[0] & 0xfe00 == 0xfc00 // unique local
        || g[0] & 0xffc0 == 0xfe80 // link-local
        || g[0] & 0xffc0 == 0xfec0 // site-local (deprecated)
        || g[0] & 0xff00 == 0xff00 // multicast
        || g[0] == 0x2001 && g[1] == 0x0db8 // documentation
}

/** Dotted IPv4 text as a 32-bit number: four decimal parts of 0 to 255. */
fun ipv4(s: string): Option<i64> {
    let parts = s.split(".");
    if parts.len != 4 {
        return None;
    }
    let mut v = 0;
    for p of parts {
        if p.len == 0 || p.len > 3 || !p.chars().all(fun(c: char) = c.is_digit()) {
            return None;
        }
        let n = parse_i64(p)?;
        if n > 255 {
            return None;
        }
        v = v << 8 | n;
    }
    Some(v)
}

/** IPv6 text as eight 16-bit groups: `::` once at most, an IPv4 tail allowed. */
fun ipv6(s: string): Option<i64[]> {
    let halves = s.split("::");
    if halves.len > 2 {
        return None;
    }
    let head = groups(halves[0], halves.len == 1)?;
    let tail = if halves.len == 2 { groups(halves[1], true)? } else { [] };
    let missing = 8 - head.len - tail.len;
    // Without `::` all eight are written; with it, it stands for at least one.
    if halves.len == 1 && missing != 0 || halves.len == 2 && missing < 1 {
        return None;
    }
    let mut out = head;
    for _ in 0..missing {
        out.push(0);
    }
    for x of tail {
        out.push(x);
    }
    Some(out)
}

/** One side of `::`: hex groups, the last of which may be dotted IPv4 when `last` is. */
fun groups(s: string, last: bool): Option<i64[]> {
    let mut out: i64[] = [];
    if s.len == 0 {
        return Some(out);
    }
    let parts = s.split(":");
    for i in 0..parts.len {
        let p = parts[i];
        if last && i == parts.len - 1 && p.contains(".") {
            let v = ipv4(p)?;
            out.push(v >> 16);
            out.push(v & 0xffff);
        } else {
            out.push(hex16(p)?);
        }
    }
    Some(out)
}

/** One to four hex digits. */
fun hex16(p: string): Option<i64> {
    if p.len == 0 || p.len > 4 {
        return None;
    }
    let mut v = 0;
    for c of p.chars() {
        let n = c as i64;
        // 0-9, a-f, A-F.
        let d = if n >= 48 && n <= 57 {
            n - 48
        } else if n >= 97 && n <= 102 {
            n - 87
        } else if n >= 65 && n <= 70 {
            n - 55
        } else {
            return None;
        };
        v = v * 16 + d;
    }
    Some(v)
}

/** Headers only Rapidkoi sets: the connection's own, and cookies (there's no cookie jar). */
fun forbidden(name: string): bool {
    let n = lower(name);
    n == "host" || n == "cookie" || n == "content-length" || n == "connection" || n == "transfer-encoding" || n == "upgrade"
}

/** An HTTP token: letters, digits and !#$%&'*+-.^_`|~. */
fun token(s: string): bool {
    if s.len == 0 {
        return false;
    }
    for c of s.chars() {
        let ok = c.is_alphabetic() && (c as u32) < 128 || c.is_digit() || "!#$%&'*+-.^_`|~".contains(
            "{c}",
        );
        if !ok {
            return false;
        }
    }
    true
}

/** No control characters (so no line breaks to smuggle a second header). */
fun clean(s: string): bool {
    for c of s.chars() {
        if (c as u32) < 32 || c as u32 == 127 {
            return false;
        }
    }
    true
}

fun lower(s: string): string {
    let mut out = "";
    for c of s.chars() {
        out = out + "{c.to_lower()}";
    }
    out
}
