/**
 * An app's calls to its database (PRP-041): each `sql`, `sql_batch`,
 * `blob_get` or `blob_list` ask sent in a `Cmd.task`, never in `update`;
 * its result answered to the app when it arrives; and the app's other
 * windows told which tables a write changed. An app's writes run one at a
 * time, across its windows (PRP-054): a write's blob files and the sweep
 * after it must not race another write. Reads run beside them. Mirrors
 * `net.requests`.
 *
 * Depends on: kivuli, cbor, guest.nodes, guest.pictures, window.downloaded, data.databases, window.window, window.tabs, window.actions, guest.contract, guest.limits, net.network, ui.render
 * Used by: guest.effects, shell
 */
import kivuli { Cmd };
import cbor { Value };
import guest.nodes { BatchStep };
import guest.pictures { blob_of };
import window.downloaded { Kept };
import data.databases { Call, Queried, path_for, call };
import window.window { Model, app, with_tab };
import window.tabs { AppPage, Tab, handle, data_changed };
import window.actions { Msg };
import guest.contract { reply };
import guest.limits { MAX_IN_FLIGHT };
import net.network { Reply };
import ui.render;

/**
 * Asks for one call to the database of the app in tab `id`, or refuses
 * one asked by the new tab (`None`), which keeps no data.
 *
 * @returns as `ask`
 *
 * Example:
 *     ask_in(m, Some(id), msg, Call.Read(query))
 */
fun ask_in(
    m: Model,
    tab: Option<i64>,
    msg: Value,
    c: Call,
): (Model, Option<Value>, Cmd<Msg>) = match tab {
    Some(id) => ask(m, id, msg, c),
    None => (m, Some(reply(Reply.Failed("The new tab keeps no data"))), Cmd.none()),
};

/**
 * Asks for one call to tab `id`'s app's database: refused at once (with
 * the sentence the app gets), or counted in flight and returned as a task.
 * A write while another of the app's writes runs waits its turn (`wrote`).
 *
 * @returns the model; the answer to give now, if refused; the task
 *
 * Example:
 *     ask(m, id, msg, Call.Read(query))
 */
fun ask(m: Model, id: i64, msg: Value, c: Call): (Model, Option<Value>, Cmd<Msg>) {
    let p = match app(m, id) {
        Some(p) => p,
        None => {
            return (m, None, Cmd.none());
        }
    };
    let nothing: Cmd<Msg> = Cmd.none();
    let refuse = fun(why: string) = (m, Some(reply(Reply.Failed(why))), nothing);
    let path = match m.store.and_then(fun(s) = path_for(s, p)) {
        Some(at) => at,
        None => {
            return refuse("This app can't keep data here");
        }
    };
    if p.in_flight >= MAX_IN_FLIGHT {
        return refuse("This app asked for too much at once");
    }
    let load = p.load;
    let counted = with_tab(
        m,
        id,
        fun(page: AppPage) = AppPage { in_flight: page.in_flight + 1, ..page },
    );
    match c {
        Write(steps) => {
            let mut writing = counted.writing;
            if let Some(queue) = writing.get(path) {
                let mut longer = queue;
                longer.push((id, load, msg, steps));
                writing[path] = longer;
                return (Model { writing: writing, ..counted }, None, Cmd.none());
            }
            writing[path] = [];
            (Model { writing: writing, ..counted }, None, writing_task(path, id, load, msg, steps))
        }
        // Plain data for the task: the file and the call.
        _ => (
            counted,
            None,
            Cmd.task(
                fun(): Queried = call(path, c),
                fun(got: Queried) = Msg.Queried(id, load, msg, got),
            ),
        ),
    }
}

/**
 * Takes a write's result (as `arrive`), then starts the next write
 * waiting on the same database, skipping any whose tab closed or loaded
 * again since.
 *
 * @returns the model, and the next write's task (none when nothing waits)
 *
 * Example:
 *     wrote(m, path, id, load, msg, got)
 */
fun wrote(m: Model, path: string, id: i64, load: i64, msg: Value, got: Queried): (Model, Cmd<Msg>) {
    let after = arrive(m, id, load, msg, got);
    let mut writing = after.writing;
    let mut queue = writing.get(path).unwrap_or([]);
    while queue.len > 0 {
        let (next_id, next_load, next_msg, steps) = queue[0];
        let mut rest: (i64, i64, Value, BatchStep[])[] = [];
        for i in 1..queue.len {
            rest.push(queue[i]);
        }
        queue = rest;
        let live = match app(after, next_id) {
            Some(p) => p.load == next_load,
            None => false,
        };
        if live {
            writing[path] = queue;
            return (
                Model { writing: writing, ..after },
                writing_task(path, next_id, next_load, next_msg, steps),
            );
        }
    }
    writing.remove(path);
    (Model { writing: writing, ..after }, Cmd.none())
}

/** A write's task, answered with `Wrote` so the next write there can start. */
fun writing_task(
    path: string,
    id: i64,
    load: i64,
    msg: Value,
    steps: BatchStep[],
): Cmd<Msg> = Cmd.task(
    fun(): Queried = call(path, Call.Write(steps)),
    fun(got: Queried) = Msg.Wrote(path, id, load, msg, got),
);

/**
 * Takes a call's result: dropped when its tab closed or loaded again
 * since; otherwise answered to the app (`on_answer`, or `on_fail` with
 * the sentence), and, when it changed tables, each other running window of
 * the same app told (`on_change` with the tables).
 *
 * Example:
 *     arrive(m, id, load, msg, got)
 */
fun arrive(m: Model, id: i64, load: i64, msg: Value, got: Queried): Model {
    let p = match app(m, id) {
        Some(p) if p.load == load => p,
        _ => {
            return m;
        }
    };
    let (answer, tables) = match got {
        Answer(v, ts) => (v, ts),
        Failed(why) => (reply(Reply.Failed(why)), []),
    };
    let answered = with_tab(m, id, fun(page: AppPage) {
        let less = AppPage {
            in_flight: if page.in_flight > 0 { page.in_flight - 1 } else { 0 },
            ..page,
        };
        handle(less, render.Msg.Answer(msg, answer))
    });
    if tables.len == 0 {
        return answered;
    }
    let mine = match answered.store.and_then(fun(s) = path_for(s, p)) {
        Some(at) => at,
        None => {
            return answered;
        }
    };
    // Rapidkoi names its own table when blobs changed (PRP-055): every window
    // of the app reads its `blob:` pictures again. Apps hear only their tables.
    let blobs = tables.any(fun(t: string) = t == "rapidkoi_blobs");
    let theirs = tables.filter(fun(t: string) = t != "rapidkoi_blobs");
    // The same database is the same app: only its own windows hear of it.
    let mut told = answered;
    for t of answered.tabs {
        let same = answered.store.and_then(fun(s) = path_for(s, t.page)) == Some(mine);
        if !same {
            continue;
        }
        if blobs {
            told = with_tab(
                told,
                t.id,
                fun(page: AppPage) = AppPage {
                    pictures: page.pictures.filter(fun(e: (string, Kept)) = blob_of(e.0).is_none()),
                    ..page,
                },
            );
        }
        if t.id != id && theirs.len > 0 {
            told = with_tab(told, t.id, fun(page: AppPage) = data_changed(page, theirs));
        }
    }
    told
}
