/**
 * The pins file (split from `data.remembered`, PRP-049): `pins` (name,
 * path, icon, which app), read as hostile, every field checked. The
 * left-off file it held too went with DECISION-044 (`data.recentfile`).
 *
 * Depends on: cbor, data.remembered, window.tabs, bundles.rules
 * Used by: data.saving
 */
import cbor { Value };
import data.remembered { Unreadable, file, list, root, icon, entry, text, blob };
import window.tabs { Pin };
import bundles.rules { check_host };

/** The most pins the pins file holds. */
const MAX_PINS: i64 = 256;

/** The pins file's cap in bytes (icons are kept with their pins). */
const MAX_PINS_FILE: i64 = 32 * 1024 * 1024;

/**
 * Encodes the pins file.
 *
 * Example:
 *     save(s, "pins", pins_file(m.pinned))?
 */
fun pins_file(pins: Pin[]): u8[] = file("pins", "pins", Value.Array(pins.map(fun(p: Pin) {
    let mut fields = [entry("name", Value.Text(p.name)), entry("path", Value.Text(p.path))];
    if let Some(icon) = p.icon {
        fields.push(entry("icon", Value.Bytes(icon)));
    }
    // Which app at the address (PRP-049).
    if let Some(o) = p.origin {
        fields.push(entry("origin", Value.Bytes(o)));
    }
    Value.Map(fields)
})));

/**
 * Reads the pins file. An icon that fails the bundle's icon rules is
 * dropped, keeping the pin.
 *
 * Example:
 *     read_pins(bytes)?
 */
fun read_pins(bytes: u8[]): Result<Pin[], Unreadable> {
    let items = list(bytes, "pins", "pins", 4, 16 * MAX_PINS, MAX_PINS_FILE)?;
    if items.len > MAX_PINS {
        return Err(Unreadable.Broken("it has more than 256 pins"));
    }
    let mut pins: Pin[] = [];
    for v of items {
        let name = text(v, "name").ok_or(Unreadable.Broken("a pin has no name"))?;
        let path = text(v, "path").ok_or(Unreadable.Broken("a pin has no path"))?;
        // A pin made before PRP-049 names no app: the only one at its address, or "Which app?".
        let origin = match blob(v, "origin") {
            Some(o) if o.len == 32 => Some(o),
            None => None,
            _ => {
                return Err(Unreadable.Broken("a pin's app key isn't 32 bytes"));
            }
        };
        pins.push(Pin { name: name, path: path, icon: icon(blob(v, "icon")), origin: origin });
    }
    Ok(pins)
}
