    verb: "were",
    it: "them",
    after: "",
};

const RECENT: Part = Part {
    file: "recent",
    noun: "your recent places",
    title: "Your recent places",
    verb: "were",
    it: "them",
    after: "",
};

const APPS: Part = Part {
    file: "apps",
