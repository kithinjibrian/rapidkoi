/**
 * Each app's database (PRP-041): where it lives in the data
 * folder, one call run against it, its size, and Clear. A file is named by
 * a hash of the app (its host and origin key, or its local address or
 * file), so nothing an app says becomes a path. Every connection is guarded
 * as SQL from an app must be (`lugha-sqlite`'s `Guard.untrusted()`), with
 * `rapidkoi_` names reserved for Rapidkoi's own (PRP-054). A write's blobs
 * are placed first, then committed with its rows; then owners are checked
 * and unnamed files swept. `call`, `size_of` and `clear` touch the disk:
 * run them in a task.
 *
 * Depends on: sqlite, cbor, std.fs, std.crypto, data.store, data.blobs, data.blobmap, guest.nodes, guest.limits, trust.keys, window.tabs, net.address
 * Used by: data.queries, shell
 */
import sqlite { Database, Guard, Kind, SqliteError };
import cbor { Value, Entry };
import std.fs;
import std.crypto { sha256 };
import data.store { Store };
import data.blobs { BlobError, blob_sentence, folder_for, place, piece, sweep, remove_all };
import data.blobmap;
import guest.nodes { Query, BatchStep, BlobRead };
import guest.limits {
    DATABASE_BYTES,
    QUERY_MS,
    MAX_SQL,
    MAX_SQL_VALUE,
    MAX_ANSWER,
    MAX_BLOB,
    BLOBS_BYTES,
    MAX_BLOBS,
};
import trust.keys { hex };
import window.tabs { AppPage };
import net.address { parse };

/** One call an app asked for: a read of one statement, a write of several steps as one transaction, or a blob read or listed (PRP-054). */
enum Call {
    Read(Query),
    Write(BatchStep[]),
    BlobGet(BlobRead),
    /** The keys starting with this prefix. */
    BlobList(string),
}

/** What a call came to: the app's answer and the tables it changed, or why not. */
enum Queried {
    /** `{columns, rows, cut}` for a read, `{changes, last_rowid}` for a write; the tables changed. */
    Answer(Value, string[]),
    /** The sentence the app gets. */
    Failed(string),
}

/**
 * Returns where an app's database lives: `databases/<sha256>.db` in the
 * data folder, by its host and origin key when signed, else its local
 * server's host and port or its file's path. Rapidkoi's own apps keep none.
 *
 * Example:
 *     path_for(store, page)
 */
fun path_for(s: Store, p: AppPage): Option<string> {
    let name: u8[] = match p.trust {
        Some(t) => {
            let mut b = "signed\n{t.host}\n".to_bytes();
            for x of t.origin {
                b.push(x);
            }
            b
        }
        None => {
            if p.path.starts_with("builtin:") {
                return None;
            }
            // A development server is one app however its address is
            // written (`rapidkoi://`, `http://`, a bundle's path): by host
            // and port, so typing it another way finds the same data.
            match parse(p.path) {
                Ok(a) => "local\n{a.host}:{a.port}".to_bytes(),
                Err(_) => "file\n{p.path}".to_bytes(),
            }
        }
    };
    Some("{s.dir}/databases/{hex(sha256(name))}.db")
}

/**
 * Runs one call against the database at `path`, made if missing: guarded,
 * bounded, closed after. Safe to run in a task; never call it from `update`.
 *
 * @returns the answer and the tables changed, or the app's sentence why not
 *
 * Example:
 *     call(path, Call.Read(query))
 */
fun call(path: string, c: Call): Queried {
    if let Err(why) = folder_of(path) {
        return Queried.Failed(why);
    }
    let db = match Database.open(path) {
        Ok(d) => d,
        Err(e) => {
            return Queried.Failed(sentence(e));
        }
    };
    let guard = Guard {
        time_limit_ms: QUERY_MS,
        max_bytes: DATABASE_BYTES,
        max_sql: MAX_SQL,
        max_value: MAX_SQL_VALUE,
        reserved: "rapidkoi_",
        ..Guard.untrusted(),
    };
    if let Err(e) = db.guard(guard) {
        db.close();
        return Queried.Failed(sentence(e));
    }
    let tables: Ref<string[]> = Ref.new([]);
    db.on_change(fun(table: string, _rowid: i64) {
        if !tables.get().any(fun(x: string) = x == table) {
            tables.update(fun(xs: string[]) {
                let mut next = xs;
                next.push(table);
                next
            });
        }
    });
    let folder = folder_for(path);
    let outcome = match c {
        Read(q) => read(db, q),
        Write(steps) => write(db, folder, steps),
        BlobGet(r) => got(db, folder, r).map_err(blob_sentence),
        BlobList(prefix) => listed(db, prefix).map_err(blob_sentence),
    };
    // Rapidkoi's own tables are no app's news.
    let changed = tables.get().filter(fun(t: string) = !blobmap.reserved(t));
    // A plain `sql` can delete an owner row too: its blobs' keys go now,
    // their files at the next write's sweep (only writes sweep, one at a time).
    if let Read(_) = c {
        if changed.len > 0 && blobmap.ours(db) == Ok(true) {
            let _ = blobmap.check_owners(db);
        }
    }
    db.close();
    match outcome {
        Ok(v) => Queried.Answer(v, changed),
        Err(why) => Queried.Failed(why),
    }
}

/**
 * Returns how big an app's database is, in bytes: 0 when it has none.
 * Reads the file; run it in a task.
 *
 * Example:
 *     size_of(path)
 */
fun size_of(path: string): i64 {
    if !fs.exists(path) {
        return 0;
    }
    match Database.open_read_only(path) {
        Ok(db) => {
            let count = number(db.query("PRAGMA page_count", [], 1));
            let size = number(db.query("PRAGMA page_size", [], 1));
            // Its blobs count too: one total for the person (PRP-054). No table is 0.
            let kept = number(db.query("SELECT coalesce(sum(size), 0) FROM rapidkoi_blobs", [], 1));
            db.close();
            count * size + kept
        }
        Err(_) => 0,
    }
}

/**
 * Removes an app's database, the files SQLite keeps beside it, and its
 * blobs (PRP-054). Nothing there is nothing to do.
 *
 * Example:
 *     clear(path)?
 */
fun clear(path: string): Result<(), string> {
    for f of [path, "{path}-journal", "{path}-wal", "{path}-shm"] {
        if fs.exists(f) {
            fs.remove_file(f).map_err(
                fun(e: string) = "Rapidkoi couldn't remove this app's data: {e}",
            )?;
        }
    }
    remove_all(folder_for(path))
}

/** The data folder's `databases/`, made if missing. */
fun folder_of(path: string): Result<(), string> {
    let parts = path.split("/");
    let mut dir: string[] = [];
    for i in 0..parts.len - 1 {
        dir.push(parts[i]);
    }
    fs.make_dirs(dir.join("/")).map_err(
        fun(e: string) = "Rapidkoi couldn't make a place for this app's data: {e}",
    )?;
    Ok(())
}

/** One statement, its rows answered up to `max_rows` and `MAX_ANSWER` bytes. */
fun read(db: Database, q: Query): Result<Value, string> {
    let rows = db.query(q.sql, cells(q.params)?, q.max_rows).map_err(sentence)?;
    let mut out: Value[] = [];
    let mut bytes = 0;
    let mut cut = rows.cut;
    for row of rows.values {
        let values = row.map(value_of);
        bytes += row.map(size).iter().sum();
        if bytes > MAX_ANSWER {
            cut = true;
            break;
        }
        out.push(Value.Array(values));
    }
    Ok(
        Value.Map([
            entry("columns", Value.Array(rows.columns.map(fun(c: string) = Value.Text(c)))),
            entry("rows", Value.Array(out)),
            entry("cut", Value.Bool(cut)),
        ]),
    )
}

/**
 * Steps as one transaction: the blobs checked and placed first, then the
 * app's statements and Rapidkoi's own rows committed together; then, past
 * the commit, owners checked and unnamed files swept. What changed, or
 * the first failure (no row kept; a placed file is swept later).
 */
fun write(db: Database, folder: string, steps: BatchStep[]): Result<Value, string> {
    let has_blobs = steps.any(fun(s: BatchStep) = match s {
        Statement(_) => false,
        _ => true,
    });
    // An app's own table renamed into Rapidkoi's name is never adopted.
    let kept = match blobmap.ours(db) {
        Ok(b) => b,
        Err(e) => {
            if has_blobs {
                return Err(blob_sentence(e));
            }
            false
        }
    };
    let mut batch: sqlite.Step[] = [];
    if has_blobs {
        checked(db, kept, steps).map_err(blob_sentence)?;
        if !kept {
            batch = blobmap.made();
        }
    }
    for s of steps {
        batch.push(match s {
            Statement(q) => sqlite.Step.Untrusted(q.sql, cells(q.params)?),
            BlobSet(key, bytes, owner) => {
                let hash = place(folder, bytes).map_err(blob_sentence)?;
                let at = match owner {
                    Some(o) => Some((o.table, cells([o.key])?[0])),
                    None => None,
                };
                blobmap.set_step(key, hash, bytes.len, at)
            }
            BlobDelete(key) => blobmap.delete_step(key),
        });
    }
    let ran = db.batch_steps(batch).map_err(sentence)?;
    if kept || has_blobs {
        // Cleanup only: a failure here leaves a leak the next write removes, never a missing blob.
        let _ = blobmap.check_owners(db);
        if let Ok(names) = blobmap.named(db) {
            sweep(folder, names);
        }
    }
    Ok(
        Value.Map([
            entry("changes", Value.int(ran.changes)),
            entry("last_rowid", Value.int(ran.last_rowid)),
        ]),
    )
}

/** A batch's blobs against the limits, as they'd stand after it, and each owner table; `kept`: the table exists. */
fun checked(db: Database, kept: bool, steps: BatchStep[]): Result<(), BlobError> {
    let (start_count, start_bytes) = if kept { blobmap.totals(db)? } else { (0, 0) };
    let mut count = start_count;
    let mut bytes = start_bytes;
    // Each key's size as the batch leaves it, so a key set twice counts once.
    let mut sizes: Map<string, i64> = #{};
    for s of steps {
        match s {
            BlobSet(key, b, owner) => {
                if b.len > MAX_BLOB {
                    return Err(BlobError.TooBig);
                }
                if let Some(o) = owner {
                    blobmap.owner_column(db, o.table)?;
                }
                let before = size_now(db, kept, sizes, key)?;
                match before {
                    Some(n) => {
                        bytes -= n;
                    }
                    None => {
                        count += 1;
                    }
                }
                bytes += b.len;
                sizes[key] = b.len;
            }
            BlobDelete(key) => {
                if let Some(n) = size_now(db, kept, sizes, key)? {
                    count -= 1;
                    bytes -= n;
                }
                sizes[key] = -1;
            }
            Statement(_) => {}
        }
    }
    if count > MAX_BLOBS {
        return Err(BlobError.TooMany);
    }
    if bytes > BLOBS_BYTES {
        return Err(BlobError.Full);
    }
    Ok(())
}

/** A key's size before this step: from earlier in the batch (-1: deleted there), else as stored. */
fun size_now(
    db: Database,
    kept: bool,
    sizes: Map<string, i64>,
    key: string,
): Result<Option<i64>, BlobError> {
    match sizes.get(key) {
        Some(n) => Ok(if n < 0 { None } else { Some(n) }),
        None if !kept => Ok(None),
        None => Ok(blobmap.stored(db, key)?.map(fun(found: (u8[], i64)) = found.1)),
    }
}

/** A `blob_get`: the piece, the whole blob's size and its hash, checked against the hash a later piece expects. */
fun got(db: Database, folder: string, r: BlobRead): Result<Value, BlobError> {
    if !blobmap.ours(db)? {
        return Err(BlobError.NoSuchKey);
    }
    let (hash, size) = match blobmap.stored(db, r.key)? {
        Some(found) => found,
        None => {
            return Err(BlobError.NoSuchKey);
        }
    };
    if let Some(h) = r.hash {
        if h != hash {
            return Err(BlobError.Changed);
        }
    }
    if r.from > size {
        return Err(BlobError.PastEnd);
    }
    let bytes = piece(folder, hash, r.from, r.len)?;
    Ok(
        Value.Map([
            entry("bytes", Value.Bytes(bytes)),
            entry("from", Value.int(r.from)),
            entry("size", Value.int(size)),
            entry("hash", Value.Bytes(hash)),
        ]),
    )
}

/** A `blob_list`: none kept yet is an empty list. */
fun listed(db: Database, prefix: string): Result<Value, BlobError> {
    if !blobmap.ours(db)? {
        return Ok(Value.Map([entry("blobs", Value.Array([])), entry("cut", Value.int(0))]));
    }
    blobmap.listed(db, prefix, MAX_BLOBS)
}

/** The app's values as SQLite's: true and false are 1 and 0, as SQLite keeps them. */
fun cells(params: Value[]): Result<sqlite.Value[], string> {
    let mut out: sqlite.Value[] = [];
    for p of params {
        out.push(match p {
            Unsigned(_) | Negative(_) => match p.as_i64() {
                Some(n) => sqlite.Value.Integer(n),
                None => {
                    return Err("This app's number is too large for its data");
                }
            },
            Float(x) => sqlite.Value.Real(x),
            Bool(b) => sqlite.Value.Integer(if b { 1 } else { 0 }),
            Text(s) => sqlite.Value.Text(s),
            Bytes(b) => sqlite.Value.Bytes(b),
            _ => sqlite.Value.Null,
        });
    }
    Ok(out)
}

/** SQLite's value as the app's. */
fun value_of(c: sqlite.Value): Value = match c {
    Integer(n) => Value.int(n),
    Real(x) => Value.Float(x),
    Text(s) => Value.Text(s),
    Bytes(b) => Value.Bytes(b),
    Null => Value.Null,
};

/** About how many bytes a value takes in an answer. */
fun size(c: sqlite.Value): i64 = match c {
    Text(s) => s.len + 9,
    Bytes(b) => b.len + 9,
    _ => 9,
};

/** The first column of a one-row answer, as a number; 0 otherwise. */
fun number(r: Result<sqlite.Rows, SqliteError>): i64 = match r {
    Ok(rows) if rows.values.len > 0 => match rows.values[0][0] {
        Integer(n) => n,
        _ => 0,
    },
    _ => 0,
};

/** The sentence an app gets for a failure. */
fun sentence(e: SqliteError): string = match e.kind {
    Full => "This app has no room left (100 MB)",
    Interrupted => "This app's query took longer than a second",
    Denied => "This app's SQL asked for something apps can't do",
    TooBig => "This app's SQL or a value is too long",
    Busy => "This app's data is busy; try again",
    // Its own SQL's mistake, in SQLite's words.
    _ => e.message,
};

fun entry(key: string, v: Value): Entry = Entry { key: Value.Text(key), value: v };
