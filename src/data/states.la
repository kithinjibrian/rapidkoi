/**
 * Each signed app's state, kept across restarts by its identity: host and
 * key (PRP-007 amendment 2). One file per app under `states/`, named by
 * the SHA-256 of its identity, holding the state, its version and when it
 * was last used. A file must hold the identity it's named for. At most
 * `MAX_APPS`: past that, the one used longest ago is removed. Unsigned
 * apps have no identity, so nothing here.
 *
 * Depends on: std.fs, std.crypto, cbor, data.store, data.remembered, trust.keys, bundles.rules, guest.limits
 * Used by: window.navigate, data.saving
 */
import std.fs;
import std.crypto { sha256, equal };
import cbor { Value, Entry, Limits, decode, encode };
import data.store { Store, StoreError, store_at, save, remove, ensure };
import data.remembered { Unreadable, Recalled, recall, FORMAT };
import trust.keys { hex };
import bundles.rules { check_host };
import guest.limits { MAX_STATE };

/** One signed app's saved state. */
struct Saved {
    /** The app's host. */
    host: string,
    /** Its publisher's 32-byte key. */
    key: u8[],
    /** The version of the state's shape. */
    state_version: i64,
    /** The state. */
    state: u8[],
    /** When it was last saved, in milliseconds since 1970. */
    used: i64,
}

/** The most apps whose state is kept. */
const MAX_APPS: i64 = 256;

/** A state file's cap: the state and a little more. */
const MAX_FILE: i64 = MAX_STATE + 64 * 1024;

/**
 * Returns the file name for an identity: the SHA-256 of `[host, key]` as
 * CBOR, in hex. Exact bytes, so no two identities share a name.
 *
 * Example:
 *     state_name("notes.acme.com", key)
 */
fun state_name(host: string, key: u8[]): string = hex(
    sha256(encode(Value.Array([Value.Text(host), Value.Bytes(key)]))),
);

/**
 * Returns the file name for one instance of an app (PRP-033): the first
 * instance's ("") is `state_name`'s, so the state apps always had is
 * theirs; the others hash the instance's key in too.
 *
 * Example:
 *     instance_name("notes.acme.com", key, "2")
 */
fun instance_name(host: string, key: u8[], instance: string): string = if instance == "" {
    state_name(host, key)
} else {
    hex(sha256(encode(Value.Array([Value.Text(host), Value.Bytes(key), Value.Text(instance)]))))
};

/**
 * Encodes a state file.
 *
 * Example:
 *     state_file(saved)
 */
fun state_file(sv: Saved): u8[] = state_file_in(sv, "");

/** A state file for one instance: the first instance's names none. */
fun state_file_in(sv: Saved, instance: string): u8[] {
    let mut fields = [
        entry("format", Value.int(FORMAT)),
        entry("kind", Value.Text("rapidkoi state")),
        entry("host", Value.Text(sv.host)),
        entry("key", Value.Bytes(sv.key)),
        entry("state_version", Value.int(sv.state_version)),
        entry("state", Value.Bytes(sv.state)),
        entry("used", Value.int(sv.used)),
    ];
    if instance != "" {
        fields.push(entry("instance", Value.Text(instance)));
    }
    encode(Value.Map(fields))
}

/**
 * Reads a state file, which must be for `host` and `key`.
 *
 * Example:
 *     read_state(bytes, "notes.acme.com", key)?
 */
fun read_state(bytes: u8[], host: string, key: u8[]): Result<Saved, Unreadable> = read_state_in(
    bytes,
    host,
    key,
    "",
);

/** A state file, which must be for `host`, `key` and `instance`. */
fun read_state_in(
    bytes: u8[],
    host: string,
    key: u8[],
    instance: string,
): Result<Saved, Unreadable> {
    let bounds = Limits { max_depth: 2, max_items: 32, max_bytes: MAX_FILE, max_string: MAX_FILE };
    let v = decode(bytes, bounds).map_err(fun(e) = Unreadable.Broken("not CBOR ({e})"))?;
    let format = v.get("format").map(fun(n: Value) = n.as_i64().unwrap_or(-1)).unwrap_or(-1);
    if format > FORMAT {
        return Err(Unreadable.Newer(format));
    }
    if format != FORMAT || text(v, "kind") != Some("rapidkoi state") {
        return Err(Unreadable.Broken("it isn't a Rapidkoi state file"));
    }
    let found_host = text(v, "host").unwrap_or("");
    let found_key = blob(v, "key").unwrap_or([]);
    // Named for one identity, holding another's: never hand it over.
    let found_instance = text(v, "instance").unwrap_or("");
    if found_host != host || !equal(found_key, key) || check_host(
        found_host,
    ).is_err() || found_instance != instance {
        return Err(Unreadable.Broken("it's another app's state"));
    }
    let state = blob(v, "state").ok_or(Unreadable.Broken("it has no state"))?;
    if state.len > MAX_STATE {
        return Err(Unreadable.Broken("its state is too large"));
    }
    let version = whole(v, "state_version");
    if version < 1 {
        return Err(Unreadable.Broken("its state version isn't a whole number from 1"));
    }
    Ok(Saved { host: host, key: key, state_version: version, state: state, used: whole(v, "used") })
}

/**
 * Saves an app's state (safely, as every file), then keeps the folder to
 * `MAX_APPS`, removing the app used longest ago.
 *
 * Example:
 *     keep(s, Saved { …, used: time.now_ms() })?
 */
fun keep(s: Store, sv: Saved): Result<(), StoreError> = keep_in(s, sv, "");

/**
 * Saves one instance's state (PRP-033), as `keep` saves the first's.
 *
 * Example:
 *     keep_in(s, saved, "2")?
 */
fun keep_in(s: Store, sv: Saved, instance: string): Result<(), StoreError> {
    // The data folder first, so it's made owner-only before states/ inside it.
    ensure(s)?;
    let sub = folder(s);
    save(sub, instance_name(sv.host, sv.key, instance), state_file_in(sv, instance))?;
    let names = files(sub);
    if names.len <= MAX_APPS {
        return Ok(());
    }
    let mut oldest = "";
    let mut when = 0;
    for n of names {
        let used = match read_bytes("{sub.dir}/{n}") {
            Ok(b) => match decode(b, Limits {
                max_depth: 2,
                max_items: 32,
                max_bytes: MAX_FILE,
                max_string: MAX_FILE,
            }) {
                Ok(v) => whole(v, "used"),
                Err(_) => -1,
            },
            Err(_) => -1,
        };
        if oldest == "" || used < when {
            oldest = n;
            when = used;
        }
    }
    remove(sub, oldest)
}

/**
 * Reads an app's saved state: Fresh when there's none, Broken (set aside)
 * when it can't be used.
 *
 * Example:
 *     saved_state(s, trust.host, trust.key)
 */
fun saved_state(s: Store, host: string, key: u8[]): Recalled<Saved> = saved_state_in(
    s,
    host,
    key,
    "",
);

/**
 * Reads one instance's saved state (PRP-033), as `saved_state` reads the first's.
 *
 * Example:
 *     saved_state_in(s, trust.host, trust.key, page.instance)
 */
fun saved_state_in(s: Store, host: string, key: u8[], instance: string): Recalled<Saved> = recall(
    folder(s),
    instance_name(host, key, instance),
    MAX_FILE,
    fun(b: u8[]) = read_state_in(b, host, key, instance),
);

/**
 * Removes an app's saved state (Forget).
 *
 * Example:
 *     drop_state(s, trust.host, trust.key)?
 */
fun drop_state(s: Store, host: string, key: u8[]): Result<(), StoreError> = remove(
    folder(s),
    state_name(host, key),
);

/**
 * Removes every instance's saved state for an app (Forget, PRP-033).
 *
 * Example:
 *     drop_app(s, trust.host, trust.key)?
 */
fun drop_app(s: Store, host: string, key: u8[]): Result<(), StoreError> {
    for instance of saved_instances(s, host, key) {
        remove(folder(s), instance_name(host, key, instance))?;
    }
    Ok(())
}

/**
 * Removes one instance's saved state (PRP-035): a closed extra window's.
 *
 * Example:
 *     drop_state_in(s, trust.host, trust.key, "2")?
 */
fun drop_state_in(
    s: Store,
    host: string,
    key: u8[],
    instance: string,
): Result<(), StoreError> = remove(folder(s), instance_name(host, key, instance));

/**
 * Removes an instance's saved state for a host, whatever its key (PRP-035):
 * a dropped session knows its windows by address, not by key.
 *
 * Example:
 *     drop_host_instance(s, "notes.acme.com", "2")?
 */
fun drop_host_instance(s: Store, host: string, instance: string): Result<(), StoreError> {
    let sub = folder(s);
    for n of files(sub) {
        if let Ok(b) = read_bytes("{sub.dir}/{n}") {
            let bounds = Limits {
                max_depth: 2,
                max_items: 32,
                max_bytes: MAX_FILE,
                max_string: MAX_FILE,
            };
            if let Ok(v) = decode(b, bounds) {
                let named = text(v, "instance").unwrap_or("");
                if text(v, "host") == Some(host) && named == instance && instance != "" {
                    remove(sub, n)?;
                }
            }
        }
    }
    Ok(())
}

/**
 * Moves an app's state, every instance's, to its new key after a
 * rotation its old key signed. Nothing saved: nothing to do.
 *
 * Example:
 *     move_state(s, host, old, new)?
 */
fun move_state(s: Store, host: string, old: u8[], new: u8[]): Result<(), StoreError> {
    for instance of saved_instances(s, host, old) {
        if let Read(sv) = saved_state_in(s, host, old, instance) {
            keep_in(s, Saved { key: new, ..sv }, instance)?;
            remove(folder(s), instance_name(host, old, instance))?;
        }
    }
    Ok(())
}

/** The instances of an app with a state file: each file read for its host, key and instance. */
fun saved_instances(s: Store, host: string, key: u8[]): string[] {
    let sub = folder(s);
    let mut out: string[] = [];
    for n of files(sub) {
        if let Ok(b) = read_bytes("{sub.dir}/{n}") {
            let bounds = Limits {
                max_depth: 2,
                max_items: 32,
                max_bytes: MAX_FILE,
                max_string: MAX_FILE,
            };
            if let Ok(v) = decode(b, bounds) {
                let mine = text(v, "host") == Some(host) && blob(v, "key").map(
                    fun(k: u8[]) = equal(k, key),
                ).unwrap_or(false);
                // Only a file named for what it holds counts.
                let instance = text(v, "instance").unwrap_or("");
                if mine && n == instance_name(host, key, instance) {
                    out.push(instance);
                }
            }
        }
    }
    out
}

fun folder(s: Store): Store = store_at("{s.dir}/states");

/** The state files: names of 64 hex digits (no `.tmp`, no `.broken`). */
fun files(sub: Store): string[] = match fs.list_dir(sub.dir) {
    Ok(all) => all.filter(fun(n: string) = n.len == 64 && !n.contains(".")),
    Err(_) => [],
};

fun whole(v: Value, field: string): i64 = v.get(field).map(
    fun(n: Value) = n.as_i64().unwrap_or(-1),
).unwrap_or(-1);

fun entry(key: string, v: Value): Entry = Entry { key: Value.Text(key), value: v };

fun text(v: Value, field: string): Option<string> = match v.get(field) {
    Some(Text(s)) => Some(s),
    _ => None,
};

fun blob(v: Value, field: string): Option<u8[]> = match v.get(field) {
    Some(Bytes(b)) => Some(b),
    _ => None,
};
