/**
 * Remembering across restarts: `restore` reads trust, pins and where you
 * left off (the app used last, open or closed) into a new window's model; `persist` saves whichever of them a
 * message changed, right away (PRP-007). Broken files are set aside and a
 * newer Rapidkoi's are left alone, each with a notice; a failed save is a
 * notice too, never a crash.
 *
 * Depends on: std.env, std.time, data.store, data.states, people.people, people.identity, data.remembered, trust.verify, window.window, window.leftoff
 * Used by: shell
 */
import std.env;
import std.time;
import data.states { Saved, move_state, keep_in, drop_app, drop_state_in };
import people.people { People, Person, nobody, people_file, read_people, MAX_PEOPLE_FILE };
import people.identity { existing, reason as identity_reason };
import data.store {
    Store,
    StoreError,
    data_dir,
    store_at,
    save,
    remove,
    skipping,
    reason as store_reason,
};
import data.remembered {
    Recalled,
    MAX_TRUST_FILE,
    MAX_PINS_FILE,
    MAX_LEFT_FILE,
    recall,
    read_trust,
    read_pins,
    read_left,
    trust_file,
    pins_file,
    left_file,
    Open,
    OpenTab,
    MAX_OPEN_FILE,
    open_file,
    read_open,
};
import trust.verify { keyring, keyring_of, identities, changes, moves };
import window.window { Model, used_last };
import window.tabs { Tab, state_of, state_version_of };
import window.leftoff { LeftOff, signer_of };

/** How the notices name one remembered file. */
struct Part {
    file: string,
    /** "your pins", as the middle of a sentence. */
    noun: string,
    /** "Your pins", to start one. */
    title: string,
    /** "were" or "was". */
    verb: string,
    /** "them" or "it". */
    it: string,
    /** What else the person should know when it's set aside. */
    after: string,
}

const TRUST: Part = Part {
    file: "trust",
    noun: "your trusted keys",
    title: "Your trusted keys",
    verb: "were",
    it: "them",
    after: "; sites will be trusted on first use again",
};

const PINS: Part = Part {
    file: "pins",
    noun: "your pins",
    title: "Your pins",
    verb: "were",
    it: "them",
    after: "",
};

const STATE: Part = Part {
    file: "states",
    noun: "this app's state",
    title: "This app's state",
    verb: "was",
    it: "it",
    after: "",
};

const PEOPLE: Part = Part {
    file: "people",
    noun: "your sign-in settings",
    title: "Your sign-in settings",
    verb: "were",
    it: "them",
    after: "",
};

const OPEN: Part = Part {
    file: "open",
    noun: "your open apps",
    title: "Your open apps",
    verb: "were",
    it: "them",
    after: "",
};

const LEFT: Part = Part {
    file: "left-off",
    noun: "where you left off",
    title: "Where you left off",
    verb: "was",
    it: "it",
    after: "",
};

/**
 * This session's data folder, from `$XDG_DATA_HOME` and `$HOME`.
 *
 * Example:
 *     session_store()?
 */
public fun session_store(): Result<Store, StoreError> = data_dir(
    env.get("XDG_DATA_HOME"),
    env.get("HOME"),
).map(store_at);

/**
 * Reads what was remembered into a window: the keyring, the pins and where
 * you left off. Each part that can't be read starts empty, with a notice.
 *
 * @param m a new window's model
 * @param s the data folder
 * @returns the model with its store; the notices joined with " · "
 *
 * Example:
 *     restore(with_pages(engine, []), session_store()?)
 */
public fun restore(m: Model, s: Store): Model {
    let notes: Ref<string[]> = Ref.new([]);
    let held: Ref<Store> = Ref.new(s);
    let ids = settle(
        recall(s, TRUST.file, MAX_TRUST_FILE, read_trust),
        TRUST,
        notes,
        held,
    ).unwrap_or([]);
    let pins = settle(recall(s, PINS.file, MAX_PINS_FILE, read_pins), PINS, notes, held).unwrap_or(
        [],
    );
    let left = settle(recall(s, LEFT.file, MAX_LEFT_FILE, read_left), LEFT, notes, held);
    let known = settle(
        recall(s, PEOPLE.file, MAX_PEOPLE_FILE, read_people),
        PEOPLE,
        notes,
        held,
    ).unwrap_or(nobody());
    // An app you don't sign in to automatically starts each run signed out.
    let folks = People {
        apps: known.apps.map(
            fun(x: Person) = if x.auto { x } else { Person { signed_out: true, ..x } },
        ),
        ..known,
    };
    let secret = match existing(s) {
        Ok(found) => found,
        Err(e) => {
            say_to(notes, identity_reason(e));
            None
        }
    };
    let said = notes.get();
    Model {
        ring: if ids.len == 0 { keyring() } else { keyring_of(ids) },
        pinned: pins,
        left_off: left,
        people: folks,
        // Read now if it exists (never made here), so the Account page can
        // name you though no app has asked yet this run.
        master: secret,
        store: Some(held.get()),
        notice: if said.len == 0 { m.notice } else { Some(said.join(" · ")) },
        ..m,
    }
}

/** Where the shared keyring was before a message: `before` can't tell, since every copy shares it. */
public struct Mark {
    changes: i64,
    moves: i64,
}

/**
 * Marks the keyring before a message, for `persist`.
 *
 * Example:
 *     let at = mark(m);
 */
public fun mark(m: Model): Mark = Mark { changes: changes(m.ring), moves: moves(m.ring).len };

/**
 * Saves whatever a message changed: the pins; trust (when the keyring's
 * change count moved), moving a signed app's state after a rotation; the
 * app used last's state, when it's signed; and which app that was. A
 * failed save becomes the notice.
 *
 * @param before the model before the message
 * @param after the model after it
 * @param at the keyring before it
 *
 * Example:
 *     persist(m, next, at)
 */
public fun persist(before: Model, after: Model, at: Mark): Model {
    let s = match after.store {
        Some(s) => s,
        None => {
            return after;
        }
    };
    let mut failed: string[] = [];
    if after.pinned != before.pinned {
        if let Some(e) = problem(save(s, PINS.file, pins_file(after.pinned)), PINS) {
            failed.push(e);
        }
    }
    if after.people != before.people {
        if let Some(e) = problem(save(s, PEOPLE.file, people_file(after.people)), PEOPLE) {
            failed.push(e);
        }
    }
    if changes(after.ring) != at.changes {
        if let Some(e) = problem(save(s, TRUST.file, trust_file(identities(after.ring))), TRUST) {
            failed.push(e);
        }
    }
    // A rotation signed by the old key: the app's state follows its key.
    let moved = moves(after.ring);
    for i in at.moves..moved.len {
        let (host, old, new) = moved[i];
        if let Some(e) = problem(move_state(s, host, old, new), STATE) {
            failed.push(e);
        }
    }
    // What's open, to reopen at launch (PRP-034): saved as it changes.
    let open = open_of(after);
    if open != open_of(before) {
        if let Some(e) = problem(save(s, OPEN.file, open_file(open)), OPEN) {
            failed.push(e);
        }
    }
    // A closed window ends there, whichever it is: its state goes with it.
    // What should last belongs in storage, not a window's state (the
    // owner, session 189).
    for t of before.tabs {
        let gone = !after.tabs.any(fun(a: Tab) = a.id == t.id);
        if let Some(tr) = t.page.trust {
            if gone {
                if let Some(e) = problem(
                    drop_state_in(s, tr.host, tr.key, t.page.instance),
                    STATE,
                ) {
                    failed.push(e);
                }
            }
        }
    }
    // Every open signed instance's state as it changes, so each reopens as
    // it was (PRP-034); the one used last is also kept below, as before.
    for t of after.tabs {
        if let (Some(tr), Some(state)) = (t.page.trust, state_of(t.page)) {
            let was = before.tabs.filter(fun(b: Tab) = b.id == t.id).map(
                fun(b: Tab) = state_of(b.page),
            );
            if was.len == 0 || was[0] != Some(state) {
                let sv = Saved {
                    host: tr.host,
                    key: tr.key,
                    state_version: state_version_of(t.page),
                    state: state,
                    used: time.now_ms(),
                };
                if let Some(e) = problem(keep_in(s, sv, t.page.instance), STATE) {
                    failed.push(e);
                }
            }
        }
    }
    // Which app was used last, open or closed, for where you left off.
    let left = used_last(after);
    let was = used_last(before);
    // Which app that was: only a signed one can be continued after a
    // restart; an unsigned one leaves the file as it was.
    let signed = left.map(fun(l: LeftOff) = signer_of(l).is_some()).unwrap_or(true);
    if signed && which(left) != which(was) {
        let done = match left {
            Some(l) => save(s, LEFT.file, left_file(l)),
            None => remove(s, LEFT.file),
        };
        if let Some(e) = problem(done, LEFT) {
            failed.push(e);
        }
    }
    if failed.len == 0 { after } else { Model { notice: Some(failed.join(" · ")), ..after } }
}

/**
 * Forget this app: removes a signed app's saved state too. Its trusted key
 * stays (PRP-007), so a swapped key still asks first.
 *
 * @param before the model with the app still current
 * @param after the model `window.forget` gave
 *
 * Example:
 *     forgotten(m, window.forget(m))
 */
public fun forgotten(before: Model, after: Model): Model {
    let (s, l) = match (after.store, used_last(before)) {
        (Some(s), Some(l)) => (s, l),
        _ => {
            return after;
        }
    };
    match signer_of(l) {
        // Every instance's (PRP-033).
        Some((host, key)) => match problem(drop_app(s, host, key), STATE) {
            Some(e) => Model { notice: Some(e), ..after },
            None => after,
        },
        None => after,
    }
}

/**
 * One file's outcome: its value when read; otherwise a notice, and (when
 * newer or unreadable) the file is never written this session.
 */
fun settle<T>(r: Recalled<T>, p: Part, notes: Ref<string[]>, held: Ref<Store>): Option<T> {
    let say = fun(s: string) = notes.update(fun(all: string[]) {
        let mut next = all;
        next.push(s);
        next
    });
    match r {
        Read(v) => {
            return Some(v);
        }
        Fresh => {}
        Broken(aside, _) => say(
            "Rapidkoi couldn't read {p.noun}, so it set {p.it} aside in {aside}{p.after}",
        ),
        Newer(_) => {
            say("{p.title} {p.verb} saved by a newer Rapidkoi; changes this session won't be kept");
            held.update(fun(s: Store) = skipping(s, p.file));
        }
        // Not even readable (permissions?): don't overwrite what couldn't be read.
        Failed(why) => {
            say("Rapidkoi couldn't read {p.noun} ({why}); changes this session won't be kept");
            held.update(fun(s: Store) = skipping(s, p.file));
        }
    }
    None
}

/** A failed save's notice, or nothing. */
fun problem(r: Result<(), StoreError>, p: Part): Option<string> = match r {
    Err(e) => Some("Rapidkoi couldn't save {p.noun}: {store_reason(e)}"),
    Ok(()) => None,
};

/** Which app it is, as `left-off` records it. */
fun which(
    l: Option<LeftOff>,
): Option<(string, string, Option<string>, Option<(string, u8[])>, string, Option<string>)> = l.map(
    fun(x: LeftOff) = (x.name, x.path, x.title, signer_of(x), x.instance, x.label),
);

fun say_to(notes: Ref<string[]>, s: string) = notes.update(fun(all: string[]) {
    let mut next = all;
    next.push(s);
    next
});

/**
 * Returns what's open, as the open file keeps it (PRP-034): the app tabs
 * in the order they were made, each with its instance, name and when it
 * was last in front, and which is in front (none on an empty tab).
 *
 * Example:
 *     open_of(m)
 */
public fun open_of(m: Model): Open {
    let mut current: Option<i64> = None;
    let mut i = 0;
    for t of m.tabs {
        if m.current == Some(t.id) {
            current = Some(i);
        }
        i += 1;
    }
    Open {
        tabs: m.tabs.map(
            fun(t: Tab) = OpenTab {
                path: t.page.path,
                instance: t.page.instance,
                label: t.page.label,
                seen: t.page.seen,
            },
        ),
        current: current,
    }
}

/**
 * Reads the open file into what to reopen (PRP-034): a broken one is set
 * aside and a newer one left alone, each with a notice, as for pins.
 *
 * @param m the window, its data folder restored
 * @param s the data folder
 * @returns the window with any notice, and what was open (`None` when nothing was saved or it couldn't be read)
 *
 * Example:
 *     let (m, open) = restore_open(restore(m, s), s);
 */
public fun restore_open(m: Model, s: Store): (Model, Option<Open>) {
    let notes: Ref<string[]> = Ref.new([]);
    let held: Ref<Store> = Ref.new(m.store.unwrap_or(s));
    let open = settle(recall(s, OPEN.file, MAX_OPEN_FILE, read_open), OPEN, notes, held);
    let said = notes.get();
    let notice = match (m.notice, said.len > 0) {
        (Some(a), true) => Some("{a} · {said.join(" · ")}"),
        (None, true) => Some(said.join(" · ")),
        (n, false) => n,
    };
    (Model { store: Some(held.get()), notice: notice, ..m }, open)
}
