/**
 * Remembering across restarts: what's read at start is `data.restoring`'s
 * (PRP-068); `persist` records the places a message moved you through and saves whichever of them a
 * message changed, right away (PRP-007). Broken files are set aside and a
 * newer Rapidkoi's are left alone, each with a notice; a failed save is a
 * notice too, never a crash.
 *
 * Depends on: std.env, std.time, data.store, data.states, data.remembered, data.restoring, data.recentfile, data.notificationsfile, data.yourappsfile, data.parts, trust.verify, window.window, window.remembering
 * Used by: shell
 */
import data.preferences { prefs_file };
import std.env;
import std.time;
import data.states { Saved, move_state, keep_in, drop_app, drop_state_in };
import people.people_codec { people_file };
import data.store {
    Store,
    StoreError,
    data_dir,
    store_at,
    save,
    remove,
    load,
    reason as store_reason,
};
import data.remembered {
    recall,
    trust_file,
    Open,
    OpenTab,
    MAX_OPEN_FILE,
    open_file,
    read_open,
    Face,
};
import data.pinfiles { pins_file };
import data.recentfile { recent_file };
import data.notificationsfile { notifications_file };
import data.parts { Part, TRUST, PINS, STATE, PEOPLE, OPEN, PREFS, RECENT, NOTIFICATIONS, APPS };
import data.restoring { Reading, settle };
import data.yourappsfile { apps_file };
import window.remembering { noted };
import trust.verify { identities, changes, moves };
import window.window { Model, Notice, page_of };
import window.notices { joined, with_more, couldnt_save };
import window.tabs { Tab, state_of, state_version_of };

/**
 * This session's data folder, from `$XDG_DATA_HOME` and `$HOME`.
 *
 * Example:
 *     session_store()?
 */
fun session_store(): Result<Store, StoreError> = data_dir(
    env.get("XDG_DATA_HOME"),
    env.get("HOME"),
).map(store_at);

/** Where the shared keyring was before a message: `before` can't tell, since every copy shares it. */
struct Mark {
    changes: i64,
    moves: i64,
}

/**
 * Marks the keyring before a message, for `persist`.
 *
 * Example:
 *     let at = mark(m);
 */
fun mark(m: Model): Mark = Mark { changes: changes(m.ring), moves: moves(m.ring).len };

/**
 * Saves whatever a message changed: the pins; trust (when the keyring's
 * change count moved), moving a signed app's state after a rotation; the
 * app used last's state, when it's signed; and which app that was. A
 * failed save becomes the notice.
 *
 * @param before the model before the message
 * @param after the model after it
 * @param at the keyring before it
 *
 * Example:
 *     persist(m, next, at)
 */
fun persist(before: Model, given: Model, at: Mark): Model {
    // The places this message moved you through, kept with or without a folder (PRP-062).
    let after = noted(before, given);
    let s = match after.store {
        Some(s) => s,
        None => {
            return after;
        }
    };
    let mut failed: Notice[] = [];
    if after.pinned != before.pinned {
        if let Some(e) = problem(save(s, PINS.file, pins_file(after.pinned)), PINS) {
            failed.push(e);
        }
    }
    if after.prefs != before.prefs {
        if let Some(e) = problem(save(s, PREFS.file, prefs_file(after.prefs)), PREFS) {
            failed.push(e);
        }
    }
    if after.people != before.people {
        if let Some(e) = problem(save(s, PEOPLE.file, people_file(after.people)), PEOPLE) {
            failed.push(e);
        }
    }
    if changes(after.ring) != at.changes {
        if let Some(e) = problem(save(s, TRUST.file, trust_file(identities(after.ring))), TRUST) {
            failed.push(e);
        }
    }
    // A rotation signed by the old key: the app's state follows its key.
    let moved = moves(after.ring);
    for i in at.moves..moved.len {
        let (host, old, new) = moved[i];
        if let Some(e) = problem(move_state(s, host, old, new), STATE) {
            failed.push(e);
        }
    }
    // What's open, to reopen at launch (PRP-034): saved as it changes.
    let open = open_of(after);
    if open != open_of(before) {
        if let Some(e) = problem(save(s, OPEN.file, open_file(open)), OPEN) {
            failed.push(e);
        }
    }
    // A closed window ends there, whichever it is: its state goes with it.
    // What should last belongs in storage, not a window's state (the
    // owner, session 189).
    for t of before.tabs {
        let gone = !after.tabs.any(fun(a: Tab) = a.id == t.id);
        if let Some(tr) = t.page.trust {
            if gone {
                if let Some(e) = problem(
                    drop_state_in(s, tr.host, tr.key, t.page.instance),
                    STATE,
                ) {
                    failed.push(e);
                }
            }
        }
    }
    // Every open signed instance's state as it changes, so each reopens as
    // it was (PRP-034); the one used last is also kept below, as before.
    for t of after.tabs {
        if let (Some(tr), Some(state)) = (t.page.trust, state_of(t.page)) {
            let was = before.tabs.filter(fun(b: Tab) = b.id == t.id).map(
                fun(b: Tab) = state_of(b.page),
            );
            if was.len == 0 || was[0] != Some(state) {
                let sv = Saved {
                    host: tr.host,
                    key: tr.key,
                    state_version: state_version_of(t.page),
                    state: state,
                    used: time.now_ms(),
                };
                if let Some(e) = problem(keep_in(s, sv, t.page.instance), STATE) {
                    failed.push(e);
                }
            }
        }
    }
    if after.recent != before.recent {
        if let Some(e) = problem(save(s, RECENT.file, recent_file(after.recent)), RECENT) {
            failed.push(e);
        }
    }
    // What apps told you (PRP-065); the rate's memory isn't kept.
    if after.notifications.items != before.notifications.items {
        let bytes = notifications_file(after.notifications);
        if let Some(e) = problem(save(s, NOTIFICATIONS.file, bytes), NOTIFICATIONS) {
            failed.push(e);
        }
    }
    // Your apps (PRP-067).
    if after.apps != before.apps {
        if let Some(e) = problem(save(s, APPS.file, apps_file(after.apps)), APPS) {
            failed.push(e);
        }
    }
    Model { notice: with_more(after.notice, joined(failed)), ..after }
}

/**
 * Forget this app: removes a signed app's saved state too. Its trusted key
 * stays (PRP-007), so a swapped key still asks first.
 *
 * @param before the model with the app still current
 * @param after the model `window.forget` gave
 *
 * Example:
 *     forgotten(m, window.forget(m))
 */
fun forgotten(before: Model, after: Model): Model {
    // The app forgotten is the one that was in front.
    let (s, a) = match (after.store, page_of(before)) {
        (Some(s), App(a)) => (s, a),
        _ => {
            return after;
        }
    };
    match a.trust.map(fun(t) = (t.host, t.key)) {
        // Every instance's (PRP-033).
        Some((host, key)) => match problem(drop_app(s, host, key), STATE) {
            Some(e) => Model { notice: Some(e), ..after },
            None => after,
        },
        None => after,
    }
}

/** A failed save's notice, or nothing. */
fun problem(r: Result<(), StoreError>, p: Part): Option<Notice> = match r {
    Err(e) => Some(couldnt_save(p.noun, store_reason(e))),
    Ok(()) => None,
};

/**
 * Returns what's open, as the open file keeps it (PRP-034): the app tabs
 * in the order they were made, each with its instance, name and when it
 * was last in front, and which is in front (none on an empty tab).
 *
 * Example:
 *     open_of(m)
 */
fun open_of(m: Model): Open {
    // All apps is where you find apps: never part of a session (PRP-067).
    let kept = m.tabs.filter(fun(t: Tab) = t.page.path != "builtin:allapps");
    let mut current: Option<i64> = None;
    let mut i = 0;
    for t of kept {
        if m.current == Some(t.id) {
            current = Some(i);
        }
        i += 1;
    }
    Open {
        tabs: kept.map(
            fun(t: Tab) = OpenTab {
                path: t.page.path,
                instance: t.page.instance,
                label: t.page.label,
                seen: t.page.seen,
                link: t.page.link,
                // A window still loading is saved as the app it loads (PRP-049).
                origin: match (t.page.trust, t.page.screen) {
                    (Some(tr), _) => Some(tr.origin),
                    (None, Loading(p)) => p.origin,
                    _ => None,
                },
            },
        ),
        current: current,
        apps: faces_of(kept),
    }
}

/** Each app of these tabs once, in the order of its first, with its name and icon (PRP-060). */
fun faces_of(open: Tab[]): Face[] {
    let mut out: Face[] = [];
    for t of open {
        if !out.any(fun(f: Face) = f.path == t.page.path) {
            out.push(Face {
                path: t.page.path,
                name: t.page.name,
                icon: t.page.icon,
                colour: t.page.manifest.and_then(fun(m) = m.primary_color),
            });
        }
    }
    out
}

/**
 * Reads the open file into what to reopen (PRP-034): a broken one is set
 * aside and a newer one left alone, each with a notice, as for pins.
 *
 * @param m the window, its data folder restored
 * @param s the data folder
 * @returns the window with any notice, and what was open (`None` when nothing was saved or it couldn't be read)
 *
 * Example:
 *     let (m, open) = restore_open(restore(m, s), s);
 */
fun restore_open(m: Model, s: Store): (Model, Option<Open>) {
    let r = Reading { store: s, notes: Ref.new([]), held: Ref.new(m.store.unwrap_or(s)) };
    let open = settle(recall(s, OPEN.file, MAX_OPEN_FILE, read_open), OPEN, r);
    let notice = with_more(m.notice, joined(r.notes.get()));
    (Model { store: Some(r.held.get()), notice: notice, ..m }, open)
}
