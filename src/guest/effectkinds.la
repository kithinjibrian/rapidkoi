/**
 * What an app asks Rapidkoi for, in its result's `effects`, and the shape
 * of a result (`Update`): moved from `guest.nodes` at its size (PRP-076).
 * Data only; reading them is `guest.contract` and the `*asks` modules.
 *
 * Depends on: cbor, net.network, guest.nodes
 * Used by: guest.contract, guest.effects, guest.needs, the *asks and *answers modules, window.tabs
 */
import cbor { Value };
import net.network { Request };
import guest.nodes { Node };

/** Something an app asks Rapidkoi for, in its result's `effects` (PRP-011). */
enum Effect {
    /** Your public key for this app; answered with `msg`. */
    Identity(Value),
    /** A sign-in signature over this challenge (1 to 1024 bytes); answered with `msg`. */
    Sign(Value, u8[]),
    /** A request to one of its servers (PRP-012), shaped but not yet allowed; answered with `msg`. */
    Fetch(Value, Request, Option<string>),
    /** Your pins (PRP-030, needs `read_pins`); answered with `msg`. */
    Pins(Value),
    /** Where you left off: the newest recent place (needs `read_left_off`; to go at the next contract); answered with `msg`. */
    LeftOff(Value),
    /** Your recent places (PRP-062, needs `read_left_off`); answered with `msg`. */
    Recent(Value),
    /** Open your recent place at this index, as they are now (PRP-062, needs `open_apps`); not answered. */
    OpenRecent(Value, i64),
    /** Open your pin at this index, as your pins are now (needs `open_apps`); not answered. */
    OpenPin(Value, i64),
    /** Open the newest recent place (needs `open_apps`; to go at the next contract); not answered. */
    Continue(Value),
    /** Your last session, if there's one to restore (PRP-035, needs `restore_session`); answered with `msg`. */
    Session(Value),
    /** Restore your last session (needs `restore_session`); not answered. */
    RestoreSession(Value),
    /** The person's choices: theme, more contrast, text size (PRP-038, any app); answered with `msg`. */
    Preferences(Value),
    /** The time now in UTC, to the second (PRP-053, any app); answered with `msg`. */
    Now(Value),
    /** Change one of them (needs `change_settings`): its name and value; not answered. */
    SetPreference(Value, string, Value),
    /** One statement against the app's database (PRP-041); answered with rows or why not. */
    Sql(Value, Query),
    /** Statements and blob steps run as one transaction; answered with what changed or why not. */
    SqlBatch(Value, BatchStep[]),
    /** A blob's bytes, whole or a piece (PRP-054); answered with them or why not. */
    BlobGet(Value, BlobRead),
    /** The app's blob keys starting with a prefix; answered with them or why not. */
    BlobList(Value, string),
    /** One of the person's files, chosen in Rapidkoi's dialog, into a blob (PRP-056); answered with its name and size (and a handle), or null. */
    FileOpen(Value, FileOpen),
    /** A blob's bytes saved back over the file a handle names; answered with its size or why not. */
    FileSave(Value, string, string),
    /** A blob's bytes saved to a file the person chooses; answered with its name, size and handle, or null. */
    FileSaveAs(Value, FileSaveAs),
    /** A notification (PRP-065, needs `notifications`): its sentence, its place's fields, its key; not answered. */
    Notify(Value, string, (string, string)[], Option<string>),
    /** Take back its notification with this key (PRP-065); not answered. */
    Withdraw(Value, string),
    /** Your notifications (PRP-065, needs `read_notifications`); answered with `msg`. */
    Notifications(Value),
    /** Open your notification at this index, as they're listed now (needs `read_notifications`); not answered. */
    OpenNotification(Value, i64),
    /** Remove your notification at this index (needs `read_notifications`); not answered. */
    DismissNotification(Value, i64),
    /**
     * One of the app's widgets filled (PRP-073): its name, its card's bytes
     * and tree, checked, and its place's fields; not answered.
     */
    Widget(Value, string, u8[], Node, (string, string)[]),
    /** Your apps, A–Z (PRP-067, needs `read_apps`); answered with `msg`. */
    Apps(Value),
    /** Open your app at this index, as listed now (needs `open_apps`); not answered. */
    OpenApp(Value, i64),
    /** Pin your app at this index to the dock (needs `manage_pins`); not answered. */
    PinApp(Value, i64),
    /** Unpin your app at this index (needs `manage_pins`); not answered. */
    UnpinApp(Value, i64),
    /** Show Rapidkoi's App info on your app at this index (needs `open_apps`, PRP-072); not answered. */
    AppInfo(Value, i64),
    /** Open your app at this index with Rapidkoi's "Forget this app?" (needs `open_apps`); not answered. */
    ForgetApp(Value, i64),
    /** Your name and the apps you're signed in to (PRP-075, needs `read_you`); answered with `msg`. */
    You(Value),
    /** The publishers' keys you trust (PRP-075, needs `read_publishers`); answered with `msg`. */
    Publishers(Value),
    /** Change the name every app shows: first, last (PRP-075, needs `change_settings`); not answered. */
    SetName(Value, string, string),
    /** Rapidkoi's own card for your backup words: showing them (`false`) or taking them (`true`) (PRP-076, needs `manage_identity`); not answered. */
    BackupCard(Value, bool),
}

/** One statement an app asks its database to run (PRP-041), its shape checked. */
struct Query {
    /** The SQL: one statement, values as `?`. */
    sql: string,
    /** The values, in order: numbers, text, bytes, true/false or null. */
    params: Value[],
    /** The most rows to answer with (a read). */
    max_rows: i64,
}

/** One step of an `sql_batch` (PRP-054): one of the app's statements, or a blob stored or removed. */
enum BatchStep {
    /** One of the app's statements. */
    Statement(Query),
    /** Stores bytes under a key (1 to `MAX_BLOB_KEY` bytes), owned by a row or not. */
    BlobSet(string, u8[], Option<Owner>),
    /** Removes a key; none is nothing to do. */
    BlobDelete(string),
    /** Gives an existing blob (one a file was opened into) an owner row (PRP-056). */
    BlobOwn(string, Owner),
}

/** A `file_open` (PRP-056): the blob key the file goes into, the extensions offered, whether it opens to be modified. */
struct FileOpen {
    key: string,
    accept: string[],
    edit: bool,
}

/** A `file_save_as`: the blob key whose bytes are saved, the suggested name, the extensions offered. */
struct FileSaveAs {
    key: string,
    name: string,
    accept: string[],
}

/** The row a blob belongs to: its table's name and its primary key's value. */
struct Owner {
    table: string,
    key: Value,
}

/** A `blob_get` (PRP-054): which key, where to start and how much, in bytes, and the hash a later piece expects. */
struct BlobRead {
    key: string,
    from: i64,
    len: i64,
    hash: Option<u8[]>,
}

/** What `handle` returned: the new state and what it asks for. */
struct Update {
    /** The new state. */
    state: u8[],
    /** What it asks for, in order (at most `MAX_EFFECTS`). */
    effects: Effect[],
    /** Which fields go in the window's address (PRP-036). */
    link: LinkChange,
    /** What kind each link field is, path and `number`/`text`/`bool`, so a link can set one that's empty (DECISION-056). */
    kinds: (string, string)[],
}

/** What a result says about the window's address (PRP-036). */
enum LinkChange {
    /** No `link`: the address keeps the fields it had. */
    Keep,
    /** `link: null`: the address names no fields. */
    Clear,
    /** These top-level fields of the state, in this order. */
    Set(string[]),
}
