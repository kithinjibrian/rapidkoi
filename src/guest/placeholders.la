/**
 * Parts filled in (PRP-053; names since PRP-011), pure: a text made of
 * parts becomes words while Rapidkoi draws it: the person's name for this
 * app, and moments in their zone (`guest.times`). The app never receives
 * the result, so it can show these but never know them. Typing boxes are
 * never filled (editing one would send the value back), nor are screen
 * titles (the window title is visible outside Rapidkoi): parts exist only
 * on texts. Not how offsets are found (`window.zones`).
 *
 * Depends on: guest.nodes, guest.times
 * Used by: ui.content
 */
import guest.nodes { Node, Part };
import guest.times { words };

/**
 * Fills a screen's parts into words.
 *
 * @param first your first name for this app ("" for none)
 * @param last your last name for this app ("" for none)
 * @param offsets each moment's offset in your zone, in seconds east of
 *     UTC; a moment missing is drawn in UTC, " UTC" after it
 * @param now the time now, in milliseconds since 1970
 *
 * Example:
 *     fill(described.root, "Brian", "Kithinji", m.offsets, m.now)
 */
fun fill(n: Node, first: string, last: string, offsets: Map<i64, i64>, now: i64): Node = match n {
    Parts(ps, look, facts) => Node.Words(
        ps.fold("", fun(out: string, p: Part) = out + said(p, first, last, offsets, now)),
        look,
        facts,
    ),
    Boxed(look, facts, press, kids) => Node.Boxed(
        look,
        facts,
        press,
        kids.map(fun(k: Node) = fill(k, first, last, offsets, now)),
    ),
    // Plain words, typing boxes and anything else: as the app gave them.
    _ => n,
};

/** One part's words. */
fun said(p: Part, first: string, last: string, offsets: Map<i64, i64>, now: i64): string = match p {
    Plain(s) => s,
    Name(First) => first,
    Name(Last) => last,
    Time(at, show) => words(at, show, offsets.get(at), now),
};
