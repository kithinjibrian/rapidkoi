/**
 * Contract 9's results, pure: reads what a guest's `handle` returned (its
 * state of named fields, what it asks for, its address's fields and their
 * kinds), checked against every limit (`limits.la`), and encodes a reply
 * to a request. Never calls a guest or GTK. The screen is `tree.la`'s; the
 * types live in `nodes.la` and are re-exported here.
 *
 * Depends on: cbor, guest.limits, guest.nodes, guest.links, guest.sqlasks, guest.blobasks, net.network
 * Used by: guest.running, guest.effects, window.tabs
 */
import cbor { Value, Entry, Limits, decode, encode };
import guest.limits {
    MAX_UPDATE,
    MAX_STATE,
    MAX_EFFECTS,
    MAX_CHALLENGE,
    MAX_URL,
    MAX_HEADERS,
    MAX_STATE_DEPTH,
};
import net.network { Request, Reply };
import guest.nodes {
    ButtonLook,
    Node,
    Described,
    ContractError,
    Effect,
    Update,
    LinkChange,
    Query,
};
import guest.links { read_link, read_kinds };
import guest.sqlasks { sql_of, batch_of };
import guest.blobasks { blob_get_of, blob_list_of };

/**
 * Decodes a `handle` result and takes out its state, checking its shape: a
 * map with array `effects` and a `state` that's a map with text keys, kept
 * as its CBOR. The state is the app's own data, bounded by its size (every
 * item is at least a byte).
 */
fun read_state(bytes: u8[]): Result<(Value, u8[]), ContractError> {
    if bytes.len > MAX_UPDATE {
        return Err(ContractError.TooLong("the update result", bytes.len));
    }
    let bounds = Limits {
        max_depth: MAX_STATE_DEPTH,
        max_items: MAX_UPDATE,
        max_bytes: MAX_UPDATE,
        max_string: MAX_STATE,
    };
    let value = decode(bytes, bounds).map_err(ContractError.Decode)?;
    if value.as_map().is_none() {
        return Err(nodes.invalid("update", "the result must be a map"));
    }
    let state = match value.get("state") {
        Some(Map(entries)) => {
            if !entries.all(fun(e: Entry) = e.key.as_text().is_some()) {
                return Err(nodes.invalid("update", "\"state\"'s field names must be text"));
            }
            encode(Value.Map(entries))
        }
        Some(_) => {
            return Err(nodes.invalid("update", "\"state\" must be a map of named fields"));
        }
        None => {
            return Err(nodes.invalid("update", "\"state\" is missing"));
        }
    };
    match value.get("effects") {
        Some(Array(_)) => Ok((value, state)),
        Some(_) => Err(nodes.invalid("update", "\"effects\" must be an array")),
        None => Err(nodes.invalid("update", "\"effects\" is missing")),
    }
}

/**
 * Reads what the guest's `handle` returned: the state and what it asks
 * for, its address's fields and their kinds, checked (at most `MAX_EFFECTS`; `identity`, `sign`, `fetch`, and
 * PRP-030's `pins`, `left_off`, `open_pin` and `continue`, whose
 * permissions `effects` checks; a challenge of 1 to `MAX_CHALLENGE` bytes;
 * every one with a `msg`).
 *
 * @returns the update; `Err(TooLong)`, `Err(Decode)`, or `Err(Invalid)`
 *
 * Example:
 *     read_update(bytes)?
 */
fun read_update(bytes: u8[]): Result<Update, ContractError> {
    let (value, state) = read_state(bytes)?;
    let link = read_link(value.get("link"))?;
    let kinds = read_kinds(value.get("kinds"))?;
    let items = match value.get("effects") {
        Some(Array(xs)) => xs,
        _ => [],
    };
    if items.len > MAX_EFFECTS {
        return Err(nodes.invalid("update", "at most 8 effects at once"));
    }
    let mut effects: Effect[] = [];
    for e of items {
        let msg = e.get("msg").ok_or(nodes.invalid("update", "an effect needs a msg"))?;
        let kind = e.get("kind").map(fun(k: Value) = k.as_text().unwrap_or("")).unwrap_or("");
        if kind == "identity" {
            effects.push(Effect.Identity(msg));
        } else if kind == "pins" {
            effects.push(Effect.Pins(msg));
        } else if kind == "left_off" {
            effects.push(Effect.LeftOff(msg));
        } else if kind == "continue" {
            effects.push(Effect.Continue(msg));
        } else if kind == "session" {
            effects.push(Effect.Session(msg));
        } else if kind == "restore_session" {
            effects.push(Effect.RestoreSession(msg));
        } else if kind == "sql" {
            effects.push(Effect.Sql(msg, sql_of(e)?));
        } else if kind == "sql_batch" {
            effects.push(Effect.SqlBatch(msg, batch_of(e)?));
        } else if kind == "blob_get" {
            effects.push(Effect.BlobGet(msg, blob_get_of(e)?));
        } else if kind == "blob_list" {
            effects.push(Effect.BlobList(msg, blob_list_of(e)?));
        } else if kind == "preferences" {
            effects.push(Effect.Preferences(msg));
        } else if kind == "now" {
            effects.push(Effect.Now(msg));
        } else if kind == "set_preference" {
            // What the value may be is `preferences.apply`'s question, once it's allowed.
            match (e.get("name"), e.get("value")) {
                (Some(Text(n)), Some(v)) if n.len <= 32 => effects.push(
                    Effect.SetPreference(msg, n, v),
                ),
                _ => {
                    return Err(
                        nodes.invalid("update", "a set_preference needs a name and a value"),
                    );
                }
            }
        } else if kind == "open_pin" {
            match e.get("index").map(fun(i: Value) = i.as_i64()) {
                Some(Some(i)) if i >= 0 => effects.push(Effect.OpenPin(msg, i)),
                _ => {
                    return Err(nodes.invalid("update", "an open_pin needs an index of 0 or more"));
                }
            }
        } else if kind == "fetch" {
            effects.push(Effect.Fetch(msg, fetch_of(e)?));
        } else if kind == "sign" {
            match e.get("challenge") {
                Some(Bytes(c)) if c.len >= 1 && c.len <= MAX_CHALLENGE => effects.push(
                    Effect.Sign(msg, c),
                ),
                _ => {
                    return Err(
                        nodes.invalid(
                            "update",
                            "a sign effect needs a challenge of 1 to 1024 bytes",
                        ),
                    );
                }
            }
        } else {
            return Err(nodes.invalid("update", "unknown effect \"{kind}\""));
        }
    }
    Ok(Update { state: state, effects: effects, link: link, kinds: kinds })
}

/**
 * Reads a fetch effect's shape: a method and a URL as text, headers as a
 * text→text map, a body as bytes; bounded so a hostile one can't grow.
 * Whether it may be sent is `network.check_request`'s question.
 */
fun fetch_of(e: Value): Result<Request, ContractError> {
    let shape = fun(p: string) = nodes.invalid("update", p);
    let (method, url) = match (e.get("method"), e.get("url")) {
        (Some(Text(m)), Some(Text(u))) => (m, u),
        _ => {
            return Err(shape("a fetch needs a method and a url"));
        }
    };
    if url.len > MAX_URL {
        return Err(shape("a fetch's url is at most {MAX_URL} bytes"));
    }
    let mut headers: (string, string)[] = [];
    if let Some(given) = e.get("headers") {
        let entries = given.as_map().ok_or(shape("a fetch's headers must map text to text"))?;
        for h of entries {
            match (h.key, h.value) {
                (Text(name), Text(value)) => headers.push((name, value)),
                _ => {
                    return Err(shape("a fetch's headers must map text to text"));
                }
            }
        }
    }
    let wide = headers.any(fun(h: (string, string)) = h.0.len > MAX_URL || h.1.len > MAX_URL);
    if headers.len > MAX_HEADERS || wide {
        return Err(
            shape("a fetch has at most {MAX_HEADERS} headers, each at most {MAX_URL} bytes"),
        );
    }
    let body = match e.get("body") {
        Some(Bytes(b)) => b,
        Some(_) => {
            return Err(shape("a fetch's body must be bytes"));
        }
        None => [],
    };
    Ok(Request { method: method, url: url, headers: headers, body: body })
}

/**
 * Returns a fetch's answer value: `{status, headers, body}` from the
 * server, or `{error}` with the sentence when it wasn't sent or failed.
 *
 * Example:
 *     answer(msg, reply(Reply.Failed("You turned off api.acme.com for Notes")))
 */
fun reply(r: Reply): Value = match r {
    Got(status, headers, body) => {
        let mut named: Entry[] = [];
        for (k, v) of headers {
            named.push(Entry { key: Value.Text(k), value: Value.Text(v) });
        }
        Value.Map([
            Entry { key: Value.Text("status"), value: Value.int(status) },
            Entry { key: Value.Text("headers"), value: Value.Map(named) },
            Entry { key: Value.Text("body"), value: Value.Bytes(body) },
        ])
    }
    Failed(why) => Value.Map([Entry { key: Value.Text("error"), value: Value.Text(why) }]),
};
