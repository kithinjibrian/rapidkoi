/**
 * UI contract v1, pure: decodes a guest's screen description into a `Node`
 * tree, reads `update`'s result, and encodes the event envelope sent back.
 * Never calls a guest or GTK, so it is tested headlessly. Every limit on a
 * description is enforced here (`limits.la`). The types live in `nodes.la`
 * and are re-exported here, so callers import them from `contract`.
 *
 * Depends on: cbor, guest.limits, guest.nodes, guest.props
 * Used by: ui.render, ui.tokens, shell
 */
import cbor { Value, Entry, Limits, decode, encode };
import guest.limits {
    MAX_VIEW,
    MAX_UPDATE,
    MAX_NODES,
    MAX_NODE_DEPTH,
    MAX_STRING,
    MAX_STATE,
    MAX_EFFECTS,
    MAX_CHALLENGE,
    MAX_URL,
    MAX_HEADERS,
};
import net.network { Request, Reply };
import guest.props { text, optional_text, maybe_text, text_style, button_look, space };
public import guest.nodes {
    TextStyle,
    ButtonLook,
    Space,
    Node,
    Described,
    ContractError,
    Effect,
    Update,
};

/**
 * Decodes a screen description into a tree and its title.
 *
 * @param bytes what the guest's `view` returned
 * @returns the tree and the root's optional `title`; `Err(TooLong)` over
 *     `MAX_VIEW` (checked before decoding), `Err(Decode)` for bad CBOR or a
 *     decoder limit, `Err(Invalid)` for a node breaking contract v1 or the
 *     node limits
 *
 * Example:
 *     read_tree(bytes)?.root
 */
public fun read_tree(bytes: u8[]): Result<Described, ContractError> {
    if bytes.len > MAX_VIEW {
        return Err(ContractError.TooLong("the screen description", bytes.len));
    }
    // Each node level is two CBOR levels (the node's map, then its
    // `children` array): 2 × 64 = 128, plus 8 for the props map and the
    // message values nested inside it. 16 items is a generous bound for one
    // node (kind, props, a handful of props, a message), so 16 × 10,000.
    // Node depth and count are then checked exactly while walking.
    let bounds = Limits {
        max_depth: 2 * MAX_NODE_DEPTH + 8,
        max_items: 16 * MAX_NODES,
        max_bytes: MAX_VIEW,
        max_string: MAX_STRING,
    };
    let value = decode(bytes, bounds).map_err(ContractError.Decode)?;
    let count = Ref.new(0);
    let root = node(value, "", 0, 1, count)?;
    // `title` is read on the root only; on other nodes it's an unknown prop.
    let title = match (value.get("kind"), value.get("props")) {
        (Some(Text(kind)), Some(given)) => maybe_text(given, "title", "root > {kind}")?,
        _ => None,
    };
    Ok(Described { root: root, title: title })
}

/** The state out of a `handle` result, checking its shape: a map with byte-string `state` and array `effects`. */
fun read_state(bytes: u8[]): Result<u8[], ContractError> {
    if bytes.len > MAX_UPDATE {
        return Err(ContractError.TooLong("the update result", bytes.len));
    }
    // A shallow map; `effects` may hold anything, so its depth and items are
    // still bounded, but loosely: v1 never reads them.
    let bounds = Limits {
        max_depth: 32,
        max_items: 10_000,
        max_bytes: MAX_UPDATE,
        max_string: MAX_STATE,
    };
    let value = decode(bytes, bounds).map_err(ContractError.Decode)?;
    if value.as_map().is_none() {
        return Err(nodes.invalid("update", "the result must be a map"));
    }
    let state = match value.get("state") {
        Some(Bytes(b)) => b,
        Some(_) => {
            return Err(nodes.invalid("update", "\"state\" must be bytes"));
        }
        None => {
            return Err(nodes.invalid("update", "\"state\" is missing"));
        }
    };
    match value.get("effects") {
        Some(Array(_)) => Ok(state),
        Some(_) => Err(nodes.invalid("update", "\"effects\" must be an array")),
        None => Err(nodes.invalid("update", "\"effects\" is missing")),
    }
}

/**
 * Reads what the guest's `handle` returned: the state and what it asks
 * for, checked (at most `MAX_EFFECTS`; `identity` and `sign` only; a
 * challenge of 1 to `MAX_CHALLENGE` bytes; every one with a `msg`).
 *
 * @returns the update; `Err(TooLong)`, `Err(Decode)`, or `Err(Invalid)`
 *
 * Example:
 *     read_update(bytes)?
 */
public fun read_update(bytes: u8[]): Result<Update, ContractError> {
    let state = read_state(bytes)?;
    let bounds = Limits {
        max_depth: 32,
        max_items: 10_000,
        max_bytes: MAX_UPDATE,
        max_string: MAX_STATE,
    };
    let value = decode(bytes, bounds).map_err(ContractError.Decode)?;
    let items = match value.get("effects") {
        Some(Array(xs)) => xs,
        _ => [],
    };
    if items.len > MAX_EFFECTS {
        return Err(nodes.invalid("update", "at most 8 effects at once"));
    }
    let mut effects: Effect[] = [];
    for e of items {
        let msg = e.get("msg").ok_or(nodes.invalid("update", "an effect needs a msg"))?;
        let kind = e.get("kind").map(fun(k: Value) = k.as_text().unwrap_or("")).unwrap_or("");
        if kind == "identity" {
            effects.push(Effect.Identity(msg));
        } else if kind == "fetch" {
            effects.push(Effect.Fetch(msg, fetch_of(e)?));
        } else if kind == "sign" {
            match e.get("challenge") {
                Some(Bytes(c)) if c.len >= 1 && c.len <= MAX_CHALLENGE => effects.push(
                    Effect.Sign(msg, c),
                ),
                _ => {
                    return Err(
                        nodes.invalid(
                            "update",
                            "a sign effect needs a challenge of 1 to 1024 bytes",
                        ),
                    );
                }
            }
        } else {
            return Err(nodes.invalid("update", "unknown effect \"{kind}\""));
        }
    }
    Ok(Update { state: state, effects: effects })
}

/**
 * Reads a fetch effect's shape: a method and a URL as text, headers as a
 * text→text map, a body as bytes; bounded so a hostile one can't grow.
 * Whether it may be sent is `network.check_request`'s question.
 */
fun fetch_of(e: Value): Result<Request, ContractError> {
    let shape = fun(p: string) = nodes.invalid("update", p);
    let (method, url) = match (e.get("method"), e.get("url")) {
        (Some(Text(m)), Some(Text(u))) => (m, u),
        _ => {
            return Err(shape("a fetch needs a method and a url"));
        }
    };
    if url.len > MAX_URL {
        return Err(shape("a fetch's url is at most {MAX_URL} bytes"));
    }
    let mut headers: (string, string)[] = [];
    if let Some(given) = e.get("headers") {
        let entries = given.as_map().ok_or(shape("a fetch's headers must map text to text"))?;
        for h of entries {
            match (h.key, h.value) {
                (Text(name), Text(value)) => headers.push((name, value)),
                _ => {
                    return Err(shape("a fetch's headers must map text to text"));
                }
            }
        }
    }
    let wide = headers.any(fun(h: (string, string)) = h.0.len > MAX_URL || h.1.len > MAX_URL);
    if headers.len > MAX_HEADERS || wide {
        return Err(
            shape("a fetch has at most {MAX_HEADERS} headers, each at most {MAX_URL} bytes"),
        );
    }
    let body = match e.get("body") {
        Some(Bytes(b)) => b,
        Some(_) => {
            return Err(shape("a fetch's body must be bytes"));
        }
        None => [],
    };
    Ok(Request { method: method, url: url, headers: headers, body: body })
}

/**
 * Returns a fetch's answer value: `{status, headers, body}` from the
 * server, or `{error}` with the sentence when it wasn't sent or failed.
 *
 * Example:
 *     answer(msg, reply(Reply.Failed("You turned off api.acme.com for Notes")))
 */
public fun reply(r: Reply): Value = match r {
    Got(status, headers, body) => {
        let mut named: Entry[] = [];
        for (k, v) of headers {
            named.push(Entry { key: Value.Text(k), value: Value.Text(v) });
        }
        Value.Map([
            Entry { key: Value.Text("status"), value: Value.int(status) },
            Entry { key: Value.Text("headers"), value: Value.Map(named) },
            Entry { key: Value.Text("body"), value: Value.Bytes(body) },
        ])
    }
    Failed(why) => Value.Map([Entry { key: Value.Text("error"), value: Value.Text(why) }]),
};

/**
 * Encodes Rapidkoi's answer to an effect, sent to the guest's `handle`:
 * `{event: "answer", msg, value}`. The value is bytes (a key, a
 * signature), null (not signed in, an unsigned app), or a fetch's `reply`.
 *
 * Example:
 *     answer(msg, Value.Bytes(public_key))
 */
public fun answer(msg: Value, value: Value): u8[] = encode(
    Value.Map([
        Entry { key: Value.Text("event"), value: Value.Text("answer") },
        Entry { key: Value.Text("msg"), value: msg },
        Entry { key: Value.Text("value"), value: value },
    ]),
);

/**
 * Encodes one of the app's own moments, sent to `handle`: `{event:
 * "init"}` (make a first state) or `{event: "opened"}` (every open).
 *
 * Example:
 *     lifecycle("opened")
 */
public fun lifecycle(name: string): u8[] = encode(
    Value.Map([Entry { key: Value.Text("event"), value: Value.Text(name) }]),
);

/**
 * Encodes a message event sent to the guest's `handle`: a node's message
 * (a click, typing).
 *
 * @param msg the message the node carried, exactly as decoded
 * @param value the event's data: an input's new text, or `None`
 * @returns the CBOR of `{event: "message", msg}` or `{event: "message", msg, value: text}`
 *
 * Example:
 *     envelope(msg, Some("Amina"))
 */
public fun envelope(msg: Value, value: Option<string>): u8[] {
    let mut entries = [
        Entry { key: Value.Text("event"), value: Value.Text("message") },
        Entry { key: Value.Text("msg"), value: msg },
    ];
    if let Some(text) = value {
        entries.push(Entry { key: Value.Text("value"), value: Value.Text(text) });
    }
    encode(Value.Map(entries))
}

/**
 * Decodes one node, counting it (and its subtree) in `count`. `parent` is
 * the parent's path and `index` the node's place among its siblings; the
 * root has parent `""`. Paths read `root > column > button[1]`.
 */
fun node(
    v: Value,
    parent: string,
    index: i64,
    depth: i64,
    count: Ref<i64>,
): Result<Node, ContractError> {
    let path = if parent == "" { "root" } else { "{parent} > [{index}]" };
    if v.as_map().is_none() {
        return Err(nodes.invalid(path, "a node must be a map"));
    }
    let kind = match v.get("kind") {
        Some(Text(k)) => k,
        Some(_) => {
            return Err(nodes.invalid(path, "\"kind\" must be text"));
        }
        None => {
            return Err(nodes.invalid(path, "\"kind\" is missing"));
        }
    };
    let here = if parent == "" { "root > {kind}" } else { "{parent} > {kind}[{index}]" };
    count.set(count.get() + 1);
    if count.get() > MAX_NODES {
        return Err(nodes.invalid(here, "more than {MAX_NODES} nodes"));
    }
    if depth > MAX_NODE_DEPTH {
        return Err(nodes.invalid(here, "deeper than {MAX_NODE_DEPTH} nodes"));
    }
    let given = match v.get("props") {
        Some(Map(_)) => v.get("props").unwrap(),
        None => Value.Map([]),
        Some(_) => {
            return Err(nodes.invalid(here, "\"props\" must be a map"));
        }
    };
    match kind {
        "text" => Ok(Node.Text(text(given, "text", here)?, text_style(given, here)?)),
        "button" => Ok(
            Node.Button(
                text(given, "label", here)?,
                button_look(given, here)?,
                given.get("on_press"),
            ),
        ),
        "input" => {
            let value = text(given, "value", here)?;
            let placeholder = optional_text(given, "placeholder", here)?;
            // No `on_change` means disabled (kivuli 0.1.1, DECISION-016).
            Ok(Node.Input(value, placeholder, given.get("on_change")))
        }
        "column" => Ok(
            Node.Column(
                space(given, "spacing", here)?,
                space(given, "padding", here)?,
                children(v, here, depth, count)?,
            ),
        ),
        "row" => Ok(
            Node.Row(
                space(given, "spacing", here)?,
                space(given, "padding", here)?,
                children(v, here, depth, count)?,
            ),
        ),
        _ => {
            // Unknown kinds aren't read, but their subtree still counts
            // against the limits, so it can't hide an oversized tree.
            tally(v, here, depth, count)?;
            Ok(Node.Unsupported(kind))
        }
    }
}

/** Decodes a container's `children`, each at the next depth. */
fun children(v: Value, here: string, depth: i64, count: Ref<i64>): Result<Node[], ContractError> {
    let items = match v.get("children") {
        Some(Array(xs)) => xs,
        None => [],
        Some(_) => {
            return Err(nodes.invalid(here, "\"children\" must be an array"));
        }
    };
    let mut out: Node[] = [];
    let mut i = 0;
    for item of items {
        out.push(node(item, here, i, depth + 1, count)?);
        i += 1;
    }
    Ok(out)
}

/** Counts an unknown node's subtree without reading it. */
fun tally(v: Value, here: string, depth: i64, count: Ref<i64>): Result<(), ContractError> {
    if let Some(Array(items)) = v.get("children") {
        let mut i = 0;
        for item of items {
            if item.as_map().is_some() {
                let kind = item.get("kind").map(
                    fun(k: Value) = k.as_text().unwrap_or("?"),
                ).unwrap_or("?");
                let at = "{here} > {kind}[{i}]";
                count.set(count.get() + 1);
                if count.get() > MAX_NODES {
                    return Err(nodes.invalid(at, "more than {MAX_NODES} nodes"));
                }
                if depth + 1 > MAX_NODE_DEPTH {
                    return Err(nodes.invalid(at, "deeper than {MAX_NODE_DEPTH} nodes"));
                }
                tally(item, at, depth + 1, count)?;
            }
            i += 1;
        }
    }
    Ok(())
}
