/**
 * The types of UI contract v1's decoded form: the node tree, its meaning
 * words, and why a description was refused. Data only; reading bytes into
 * them is `contract.la`, reading props is `props.la`.
 *
 * Depends on: cbor
 * Used by: guest.contract, props (and, through contract's re-export, ui.render, ui.tokens, shell)
 */
import cbor { Value, DecodeError };
import net.network { Request };

/** How a text reads: the contract's `style` words. */
public enum TextStyle {
    /** The theme's ordinary text (no `style`, or `"body"`). */
    Body,
    /** A view's title (`"title"`). */
    Title,
    /** A section heading (`"heading"`). */
    Heading,
    /** Secondary text (`"dim"`). */
    Dim,
}

/** What a button means: the contract's button `style` words. */
public enum ButtonLook {
    /** An ordinary action (no `style`, or `"normal"`). */
    Normal,
    /** The one main action in a view (`"primary"`). */
    Primary,
    /** Deletes or discards (`"danger"`). */
    Danger,
    /** Low emphasis (`"subtle"`). */
    Subtle,
}

/** A spacing or padding word; sizes come from `ui/tokens.la`. */
public enum Space {
    /** `"none"`, or the prop left out. */
    Zero,
    /** `"xs"`. */
    Xs,
    /** `"sm"`. */
    Sm,
    /** `"md"`. */
    Md,
    /** `"lg"`. */
    Lg,
    /** `"xl"`. */
    Xl,
}

/** One decoded node. Messages stay CBOR values the shell never looks inside. */
public enum Node {
    /** A text and its style. */
    Text(string, TextStyle),
    /** A label, its look, and the message a press sends (`None`: disabled). */
    Button(string, ButtonLook, Option<Value>),
    /** The text shown, the placeholder, and the message each edit sends. */
    Input(string, string, Option<Value>),
    /** Spacing, padding, and the children top to bottom. */
    Column(Space, Space, Self[]),
    /** Spacing, padding, and the children left to right. */
    Row(Space, Space, Self[]),
    /** A kind this shell doesn't know: shown as a placeholder. */
    Unsupported(string),
    /** Contract 5 (PRP-037): a box, its look, what it is, the message a press sends, and its children. */
    Boxed(Look, Facts, Option<Value>, Self[]),
    /** Contract 5: a text, its look and what it is. */
    Words(string, Look, Facts),
    /** Contract 5: a typing box. */
    Field(Typing, Look),
}

/** A contract 5 typing box (PRP-037). */
public struct Typing {
    /** The text in it. */
    public value: string,
    /** What it shows while empty. */
    public placeholder: string,
    /** 1 for one line; 2 to 20 for a box of several lines. */
    public lines: i64,
    /** The message each edit sends (`None`: disabled). */
    public on_change: Option<Value>,
    /** The message Enter sends, on one line. */
    public on_submit: Option<Value>,
}

/** Which way a box lays out its children. */
public enum Direction {
    /** Top to bottom: the default. */
    Column,
    /** Left to right. */
    Row,
}

/** Where a node sits across its parent. */
public enum Place {
    /** At the start. */
    Start,
    /** In the middle. */
    Center,
    /** At the end. */
    End,
    /** Across the whole width (in a column) or height (in a row). */
    Stretch,
}

/** A colour in a contract 5 style: Rapidkoi's name, the app's own, or a mix of two. */
public enum Colour {
    /** One of Rapidkoi's names (`accent`, `text`…): its value is never given to the app. */
    Named(string),
    /** Red, green, blue and alpha, each 0–255. */
    Raw(i64, i64, i64, i64),
    /** The first colour moved towards the second by 0 to 1. */
    Mix(Self, Self, f64),
}

/** A length in a contract 5 style: one of Rapidkoi's names (`md`, `small`…) or pixels. */
public enum Measure {
    /** A token's name. */
    Named(string),
    /** Pixels. */
    Px(i64),
}

/** A text size: one of Rapidkoi's (`title`…), points, or a multiple of the body size. */
public enum TextSize {
    /** `title`, `heading`, `body` or `small`. */
    Named(string),
    /** Points. */
    Pt(i64),
    /** Times the body size. */
    Rem(f64),
}

/** A contract 5 node's style, checked (PRP-037): everything optional, as the app gave it. */
public struct Look {
    public direction: Direction,
    public gap: Option<Measure>,
    /** Vertical and horizontal. */
    public padding: Option<(Measure, Measure)>,
    public align: Option<Place>,
    public grow: bool,
    public width: Option<i64>,
    public height: Option<i64>,
    public min_width: Option<i64>,
    public max_width: Option<i64>,
    public min_height: Option<i64>,
    public max_height: Option<i64>,
    public background: Option<Colour>,
    public color: Option<Colour>,
    /** Its width and colour. */
    public border: Option<(i64, Colour)>,
    public corner: Option<Measure>,
    /** Its width and colour. */
    public outline: Option<(i64, Colour)>,
    /** `none`, `sm`, `md` or `lg`. */
    public shadow: Option<string>,
    public opacity: Option<f64>,
    public size: Option<TextSize>,
    /** `normal`, `medium` or `bold`. */
    public weight: Option<string>,
    /** `body`, `mono`, `serif` or `sans`. */
    public font: Option<string>,
    public italic: bool,
    /** Looks for `hover`, `pressed`, `focus`, `disabled` and `checked`, none of which has its own. */
    public states: (string, Self)[],
}

/** What a contract 5 node is (PRP-037): AccessKit's names. */
public enum Role {
    Button,
    Checkbox,
    Switch,
    Tab,
    TabList,
    Heading,
    List,
    ListItem,
    Group,
    Separator,
}

/** What a contract 5 node is, and its state: what keyboards and screen readers need. */
public struct Facts {
    public role: Option<Role>,
    /** A checkbox's or switch's. */
    public checked: Option<bool>,
    /** A tab's or list item's. */
    public selected: Option<bool>,
    public disabled: bool,
    /** What a screen reader says, when the text isn't enough. */
    public label: Option<string>,
}

/** A decoded screen: its tree, and the title its root carries (contract v1, optional). */
public struct Described {
    /** The root node. */
    public root: Node,
    /** The screen's title, from the root's `props.title`. */
    public title: Option<string>,
}

/** Why a description or result was refused. */
public enum ContractError {
    /** The bytes aren't CBOR this shell accepts (or pass a decoder limit). */
    Decode(DecodeError),
    /** What was too long, and its length in bytes. */
    TooLong(string, i64),
    /** Where in the tree (`root > column > button[1]`), and what's wrong. */
    Invalid(string, string),
}

/** A contract error at `path`. */
fun invalid(path: string, problem: string): ContractError = ContractError.Invalid(path, problem);

/** Something a contract v2 app asks Rapidkoi for, in its result's `effects` (PRP-011). */
public enum Effect {
    /** Your public key for this app; answered with `msg`. */
    Identity(Value),
    /** A sign-in signature over this challenge (1 to 1024 bytes); answered with `msg`. */
    Sign(Value, u8[]),
    /** A request to one of its servers (PRP-012), shaped but not yet allowed; answered with `msg`. */
    Fetch(Value, Request),
    /** Your pins (PRP-030, needs `read_pins`); answered with `msg`. */
    Pins(Value),
    /** Where you left off (needs `read_left_off`); answered with `msg`. */
    LeftOff(Value),
    /** Open your pin at this index, as your pins are now (needs `open_apps`); not answered. */
    OpenPin(Value, i64),
    /** Open where you left off (needs `open_apps`); not answered. */
    Continue(Value),
    /** Your last session, if there's one to restore (PRP-035, needs `restore_session`); answered with `msg`. */
    Session(Value),
    /** Restore your last session (needs `restore_session`); not answered. */
    RestoreSession(Value),
    /** The person's choices: theme, more contrast, text size (PRP-038, any app); answered with `msg`. */
    Preferences(Value),
    /** Change one of them (needs `change_settings`): its name and value; not answered. */
    SetPreference(Value, string, Value),
    /** One statement against the app's database (contract 6, PRP-041); answered with rows or why not. */
    Sql(Value, Query),
    /** Statements run as one transaction; answered with what changed or why not. */
    SqlBatch(Value, Query[]),
}

/** One statement an app asks its database to run (PRP-041), its shape checked. */
public struct Query {
    /** The SQL: one statement, values as `?`. */
    public sql: string,
    /** The values, in order: numbers, text, bytes, true/false or null. */
    public params: Value[],
    /** The most rows to answer with (a read). */
    public max_rows: i64,
}

/** What a contract v2 `init` or `update` returned: the new state and what it asks for. */
public struct Update {
    /** The new state. */
    public state: u8[],
    /** What it asks for, in order (at most `MAX_EFFECTS`). */
    public effects: Effect[],
    /** Which fields go in the window's address (contract 4, PRP-036). */
    public link: LinkChange,
}

/** What a contract 4 result says about the window's address (PRP-036). */
public enum LinkChange {
    /** No `link`: the address keeps the fields it had. */
    Keep,
    /** `link: null`: the address names no fields. */
    Clear,
    /** These top-level fields of the state, in this order. */
    Set(string[]),
}
