/**
 * The types of the contract's decoded form: the node tree, its meaning
 * words, and why a description was refused. Data only; reading bytes into
 * them is `contract.la`, reading props is `props.la`.
 *
 * Depends on: cbor
 * Asks (`Effect`) and a result's shape (`Update`) are `guest.effectkinds`'.
 * Used by: guest.contract, props (and, through contract's re-export, ui.render, ui.tokens, shell)
 */
import cbor { Value, DecodeError };

/** What one of Rapidkoi's own buttons means: its look comes from the theme (`themes.button`). */
enum ButtonLook {
    /** An ordinary action (no `style`, or `"normal"`). */
    Normal,
    /** The one main action in a view (`"primary"`). */
    Primary,
    /** Deletes or discards (`"danger"`). */
    Danger,
    /** Low emphasis (`"subtle"`). */
    Subtle,
}

/** One decoded node. Messages stay CBOR values the shell never looks inside. */
enum Node {
    /** A kind this shell doesn't know: shown as a placeholder. */
    Unsupported(string),
    /**
     * A box (PRP-037): its look, what it is, the message a press sends, what
     * a right-click does (PRP-070, PRP-071), and its children.
     */
    Boxed(Look, Facts, Option<Value>, Option<Context>, Self[]),
    /** A text, its look and what it is. */
    Words(string, Look, Facts),
    /** A text made of parts Rapidkoi fills in before drawing (PRP-053): never drawn as it is. */
    Parts(Part[], Look, Facts),
    /** A typing box. */
    Field(Typing, Look),
    /** A slider (PRP-075, a contract 11 addition). */
    Slider(Sliding, Look),
    /** A picture (PRP-047), and its look. */
    Pictured(Picture, Look),
    /**
     * Where Rapidkoi draws something of its own into a built-in app's
     * screen, by name (PRP-073: `widgets`, the new tab's cards).
     */
    Slot(string),
    /**
     * A box in a widget's card that opens its app at a place (PRP-074):
     * its number among the card's places, in reading order (`guest.cards`
     * numbers them), the place's fields, and the box.
     */
    Place(i64, (string, string)[], Self),
}

/**
 * What a right-click on a box does: send the app a message (`on_context`,
 * PRP-070), or open a menu Rapidkoi draws (`menu`, PRP-071). One or the
 * other: kivuli answers a right-click once.
 */
enum Context {
    Message(Value),
    Menu(Choice[]),
}

/** One entry of a box's menu (PRP-071). */
enum Choice {
    /** Its label, the message picking it sends, and whether it's disabled. */
    Item(string, Value, bool),
    Separator,
}

/** One part of a text (PRP-053): plain words, or a value only Rapidkoi knows. */
enum Part {
    /** Words as the app wrote them. */
    Plain(string),
    /** The person's name for this app: first or last. */
    Name(Which),
    /** A moment, in milliseconds since 1970-01-01 00:00 UTC, and how to show it. */
    Time(i64, Show),
}

/** Which part of the person's name. */
enum Which {
    First,
    Last,
}

/** How a moment is shown, in the person's zone (PRP-053). */
enum Show {
    /** "14:32". */
    Time,
    /** "Thu 31 Oct". */
    Date,
    /** "Thu 31 Oct, 14:32". */
    DateTime,
    /** "5 minutes ago", "yesterday", "in 3 hours". */
    Relative,
    /** "Thursday". */
    Weekday,
}

/** A picture in a screen (PRP-047): where it's from, and what Rapidkoi has of it. */
struct Picture {
    /** `asset:NAME` from the app's bundle, or an http(s) address, as the app gave it. */
    source: string,
    fit: Fitting,
    /** The colour a one-colour SVG from the bundle is drawn in. */
    colour: Option<Colour>,
    /** What it shows, for screen readers and tests. */
    label: Option<string>,
    /** The message `on_message` carries once it's shown. */
    on_load: Option<Value>,
    /** The message `on_fail` carries when it can't be. */
    on_fail: Option<Value>,
    /** What Rapidkoi has of it, filled in just before it's drawn. */
    shown: Shown,
}

/** How a picture fills its box. */
enum Fitting {
    /** All of it, inside the box: the default. */
    Contain,
    /** The whole box, cropped. */
    Cover,
}

/** What Rapidkoi has of a picture. */
enum Shown {
    /** Nothing yet: its box stays empty. */
    Waiting,
    /** Its bytes, checked. */
    Ready(u8[]),
    /** It can't be shown: Rapidkoi's broken-picture mark. */
    Broken,
}

/** A typing box (PRP-037). */
struct Typing {
    /** The text in it. */
    value: string,
    /** What it shows while empty. */
    placeholder: string,
    /** What it's for, named by the app (DECISION-056): its name, and screen readers' once kivuli can. */
    label: Option<string>,
    /** 1 for one line; 2 to 20 for a box of several lines. */
    lines: i64,
    /** The message each edit sends (`None`: disabled). */
    on_change: Option<Value>,
    /** The message Enter sends, on one line. */
    on_submit: Option<Value>,
}

/** A slider (PRP-075): range, value within it, step ≥ 1, label (its name), message (`None`: disabled). */
struct Sliding {
    min: i64,
    max: i64,
    value: i64,
    step: i64,
    label: string,
    on_change: Option<Value>,
}

/** Which way a box lays out its children. */
enum Direction {
    /** Top to bottom: the default. */
    Column,
    /** Left to right. */
    Row,
    /** On top of each other (contract 10): the first is the base, the rest drawn over it. */
    Layers,
    /** Side by side, a new line when one is full (contract 10). */
    Wrap,
    /** Side by side, as many as fit; the rest hidden from the end (contract 10). */
    Fit,
}

/** Where a layer sits on its base (contract 10): start and end follow the text's direction. */
enum Spot {
    TopStart,
    Top,
    TopEnd,
    Start,
    Center,
    End,
    BottomStart,
    Bottom,
    BottomEnd,
    /** Covering the whole base: a layer without a place. */
    Fill,
}

/** A gradient in an app's style (contract 10), drawn over its background colour. */
enum Blend {
    /** Along an angle in degrees, 0–359 (0 up, 90 right), through its stops. */
    Linear(i64, ColourStop[]),
    /** From an ellipse's centre out: x and y as fractions of the box (−1 to 2), radii across and down (above 0, at most 4). */
    Ellipse(f64, f64, f64, f64, ColourStop[]),
}

/** One colour of a gradient, at its place along it: 0 the start, 1 the end. */
struct ColourStop {
    colour: Colour,
    at: f64,
}

/** Where a node sits across its parent. */
enum Place {
    /** At the start. */
    Start,
    /** In the middle. */
    Center,
    /** At the end. */
    End,
    /** Across the whole width (in a column) or height (in a row). */
    Stretch,
}

/** A colour in an app's style: Rapidkoi's name, the app's own, or a mix of two. */
enum Colour {
    /** One of Rapidkoi's names (`accent`, `text`…): its value is never given to the app. */
    Named(string),
    /** Red, green, blue and alpha, each 0–255. */
    Raw(i64, i64, i64, i64),
    /** The first colour moved towards the second by 0 to 1. */
    Mix(Self, Self, f64),
}

/** A length in an app's style: one of Rapidkoi's names (`md`, `small`…) or pixels. */
enum Measure {
    /** A token's name. */
    Named(string),
    /** Pixels. */
    Px(i64),
}

/** A text size: one of Rapidkoi's (`title`…), points, or a multiple of the body size. */
enum TextSize {
    /** `title`, `heading`, `body` or `small`. */
    Named(string),
    /** Points. */
    Pt(i64),
    /** Times the body size. */
    Rem(f64),
}

/** A node's style, checked (PRP-037): everything optional, as the app gave it. */
struct Look {
    direction: Direction,
    gap: Option<Measure>,
    /** Vertical and horizontal. */
    padding: Option<(Measure, Measure)>,
    align: Option<Place>,
    grow: bool,
    width: Option<i64>,
    height: Option<i64>,
    min_width: Option<i64>,
    max_width: Option<i64>,
    min_height: Option<i64>,
    max_height: Option<i64>,
    background: Option<Colour>,
    /** Drawn over the background colour (contract 10); only on a box's own look. */
    gradient: Option<Blend>,
    color: Option<Colour>,
    /** Its width and colour. */
    border: Option<(i64, Colour)>,
    corner: Option<Measure>,
    /** Its width and colour. */
    outline: Option<(i64, Colour)>,
    /** `none`, `sm`, `md` or `lg`. */
    shadow: Option<string>,
    opacity: Option<f64>,
    size: Option<TextSize>,
    /** `normal`, `medium` or `bold`. */
    weight: Option<string>,
    /** `body`, `mono`, `serif` or `sans`. */
    font: Option<string>,
    italic: bool,
    /** A text kept to one line, cut with "…", instead of wrapping to its box (the owner, 2026-10-24). */
    truncate: bool,
    /** Which way the box scrolls (PRP-046): it shows what fits and scrolls the rest. */
    scroll: Option<Axis>,
    /** Where it sits on its base, in a layers box (contract 10). */
    place: Option<Spot>,
    /** In a wrap: every child as wide as the widest (contract 10). */
    equal: bool,
    /** In a wrap: at most this many on a line, 1–32 (contract 10). */
    per_line: Option<i64>,
    /** Looks for `hover`, `pressed`, `focus`, `disabled` and `checked`, none of which has its own. */
    states: (string, Self)[],
}

/** Which way a box scrolls (PRP-046). */
enum Axis {
    /** Up and down. */
    Vertical,
    /** Side to side. */
    Horizontal,
    /** Both ways. */
    Both,
}

/** What a node is (PRP-037): AccessKit's names. */
enum Role {
    Button,
    Checkbox,
    Switch,
    Tab,
    TabList,
    Heading,
    List,
    ListItem,
    Group,
    Separator,
}

/** What a node is, and its state: what keyboards and screen readers need. */
struct Facts {
    role: Option<Role>,
    /** A checkbox's or switch's. */
    checked: Option<bool>,
    /** A tab's or list item's. */
    selected: Option<bool>,
    disabled: bool,
    /** What a screen reader says, when the text isn't enough. */
    label: Option<string>,
}

/** A decoded screen: its tree, and the title its root carries (optional). */
struct Described {
    /** The root node. */
    root: Node,
    /** The screen's title, from the root's `props.title`. */
    title: Option<string>,
}

/** Why a description or result was refused. */
enum ContractError {
    /** The bytes aren't CBOR this shell accepts (or pass a decoder limit). */
    Decode(DecodeError),
    /** What was too long, and its length in bytes. */
    TooLong(string, i64),
    /** Where in the tree (`root > column > button[1]`), and what's wrong. */
    Invalid(string, string),
}

/** A contract error at `path`. */
fun invalid(path: string, problem: string): ContractError = ContractError.Invalid(path, problem);
