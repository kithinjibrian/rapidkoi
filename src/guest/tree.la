/**
 * Screens (contract 7; boxes, texts and styles since PRP-037), pure: a
 * `view` result read into boxes, texts and typing boxes, each with its
 * style (`guest.styles`) and what it is (`guest.roles`). Limited by the
 * bytes, the node count and depth, and each string. Any other kind is shown
 * as unsupported, its subtree still counted.
 *
 * Depends on: cbor, guest.nodes, guest.limits, guest.props, guest.styles, guest.roles, guest.pictures
 * Used by: guest.running
 */
import cbor { Value, Limits, decode };
import guest.notifyasks { fields_of };
import guest.nodes {
    Node,
    Context,
    Choice,
    Typing,
    Sliding,
    Described,
    ContractError,
    Axis,
    Part,
    Which,
    Show,
    invalid,
};
import guest.limits {
    MAX_VIEW,
    MAX_NODES,
    MAX_NODE_DEPTH,
    MAX_STRING,
    MAX_LABEL,
    MAX_MENU,
    MAX_PARTS,
    FIRST_MOMENT,
    LAST_MOMENT,
};
import guest.pictures { read_picture };
import guest.props { text, optional_text, maybe_text };
import guest.styles { read_style };
import guest.roles { read_facts };

/** The most lines a typing box may have. */
const MAX_LINES: i64 = 20;

/**
 * Decodes a screen and its title.
 *
 * @param bytes what the guest's `view` returned
 * @returns the tree and the root's optional `title`; `Err(TooLong)` over
 *     `MAX_VIEW`, `Err(Decode)` for bad CBOR or a decoder limit,
 *     `Err(Invalid)` for a node, style or role breaking the contract
 *
 * Example:
 *     read_tree(bytes)?.root
 */
fun read_tree(bytes: u8[]): Result<Described, ContractError> {
    if bytes.len > MAX_VIEW {
        return Err(ContractError.TooLong("the screen description", bytes.len));
    }
    // Two CBOR levels per node (its map, its children), and a style nests
    // up to six more (props, style, a state's look, a border, a mix, its
    // list). Styles add many small items, so the count is bounded by the
    // bytes; nodes are counted exactly while walking.
    let bounds = Limits {
        max_depth: 2 * MAX_NODE_DEPTH + 12,
        max_items: MAX_VIEW,
        max_bytes: MAX_VIEW,
        max_string: MAX_STRING,
    };
    let value = decode(bytes, bounds).map_err(ContractError.Decode)?;
    let count = Ref.new(0);
    let seen: Ref<string[]> = Ref.new([]);
    let root = node(value, "", 0, 1, count, seen, None)?;
    let title = match (value.get("kind"), value.get("props")) {
        (Some(Text(kind)), Some(given)) => maybe_text(given, "title", "root > {kind}")?,
        _ => None,
    };
    Ok(Described { root: root, title: title })
}

/**
 * One node and its subtree, counted in `count`; paths read `root > box >
 * text[1]`. `seen` is the picture sources so far (PRP-047); `scrolling`
 * is which ways the boxes around it already scroll.
 */
fun node(
    v: Value,
    parent: string,
    index: i64,
    depth: i64,
    count: Ref<i64>,
    seen: Ref<string[]>,
    scrolling: Option<Axis>,
): Result<Node, ContractError> {
    let path = if parent == "" { "root" } else { "{parent} > [{index}]" };
    if v.as_map().is_none() {
        return Err(invalid(path, "a node must be a map"));
    }
    let kind = match v.get("kind") {
        Some(Text(k)) => k,
        Some(_) => {
            return Err(invalid(path, "\"kind\" must be text"));
        }
        None => {
            return Err(invalid(path, "\"kind\" is missing"));
        }
    };
    let here = if parent == "" { "root > {kind}" } else { "{parent} > {kind}[{index}]" };
    count.set(count.get() + 1);
    if count.get() > MAX_NODES {
        return Err(invalid(here, "more than {MAX_NODES} nodes"));
    }
    if depth > MAX_NODE_DEPTH {
        return Err(invalid(here, "deeper than {MAX_NODE_DEPTH} nodes"));
    }
    let given = match v.get("props") {
        Some(Map(es)) => Value.Map(es),
        None => Value.Map([]),
        Some(_) => {
            return Err(invalid(here, "\"props\" must be a map"));
        }
    };
    if kind == "box" {
        // Where Rapidkoi draws its own into a built-in app (PRP-073); only
        // those may place one (`window.tabs`).
        if let Some(name) = given.get("slot") {
            return match name {
                Text("widgets") if v.get("children").is_none() => Ok(Node.Slot("widgets")),
                _ => Err(invalid(here, "slot must be \"widgets\", on a box with no children")),
            };
        }
        // A place to open in a widget's card (PRP-074): its fields, as a
        // card's own are; `guest.cards` allows it in a card only.
        let place = match given.get("open") {
            None => None,
            Some(fields) => {
                let pressed = given.get("on_press").is_some() || given.get("menu").is_some();
                if pressed || given.get("on_context").is_some() {
                    return Err(
                        invalid(here, "a box that opens a place is pressed by nothing else"),
                    );
                }
                Some(fields_of(Some(fields)).map_err(fun(e: ContractError) = match e {
                    Invalid(_, why) => invalid(here, why),
                    _ => e,
                })?)
            }
        };
        let look = read_style(given.get("style"), here)?;
        let facts = read_facts(given, here)?;
        // A scroll inside one that scrolls the same way never scrolls: say so (PRP-046).
        if let Some(a) = look.scroll {
            if overlaps(scrolling, a) {
                return Err(
                    invalid(
                        here,
                        "This app put a scrolling box inside another that scrolls the same way",
                    ),
                );
            }
        }
        let inside = match look.scroll {
            Some(a) => Some(joined(scrolling, a)),
            None => scrolling,
        };
        let made = Node.Boxed(
            look,
            facts,
            given.get("on_press"),
            read_context(given, here)?,
            children(v, here, depth, count, seen, inside)?,
        );
        return Ok(match place {
            Some(fields) => Node.Place(0, fields, made),
            None => made,
        });
    }
    if kind == "text" {
        let look = read_style(given.get("style"), here)?;
        let facts = read_facts(given, here)?;
        return match (given.get("text"), given.get("parts")) {
            (Some(_), None) => Ok(Node.Words(text(given, "text", here)?, look, facts)),
            (None, Some(ps)) => Ok(Node.Parts(read_parts(ps, here)?, look, facts)),
            (Some(_), Some(_)) => Err(invalid(here, "a text has \"text\" or \"parts\", not both")),
            (None, None) => Err(invalid(here, "a text needs \"text\" or \"parts\"")),
        };
    }
    if kind == "input" {
        let lines = match given.get("lines") {
            None => 1,
            Some(n) => match n.as_i64() {
                Some(x) if x >= 1 && x <= MAX_LINES => x,
                _ => {
                    return Err(invalid(here, "lines must be 1 to {MAX_LINES}"));
                }
            },
        };
        let label = match given.get("label") {
            None => None,
            Some(Text(s)) if s.len >= 1 && s.len <= MAX_LABEL => Some(s),
            Some(_) => {
                return Err(invalid(here, "label must be text of 1 to {MAX_LABEL} bytes"));
            }
        };
        let typing = Typing {
            value: text(given, "value", here)?,
            placeholder: optional_text(given, "placeholder", here)?,
            label: label,
            lines: lines,
            // No `on_change` means disabled, as before (DECISION-016).
            on_change: given.get("on_change"),
            on_submit: given.get("on_submit"),
        };
        return Ok(Node.Field(typing, read_style(given.get("style"), here)?));
    }
    if kind == "slider" {
        return Ok(Node.Slider(sliding(given, here)?, read_style(given.get("style"), here)?));
    }
    if kind == "image" {
        if v.get("children").is_some() {
            return Err(invalid(here, "an image has no children"));
        }
        let (p, look) = read_picture(given, here, seen)?;
        return Ok(Node.Pictured(p, look));
    }
    // Anything else isn't read, but its subtree still counts against the
    // limits, so it can't hide an oversized tree.
    tally(v, here, depth, count)?;
    Ok(Node.Unsupported(kind))
}

/**
 * What a right-click on a box does: its `on_context` message (PRP-070) or
 * its `menu` (PRP-071). Both is refused here, since kivuli would stop the
 * whole shell on a node with both.
 */
fun read_context(given: Value, here: string): Result<Option<Context>, ContractError> = match (
    given.get("on_context"),
    given.get("menu"),
) {
    (None, None) => Ok(None),
    (Some(m), None) => Ok(Some(Context.Message(m))),
    (None, Some(es)) => Ok(Some(Context.Menu(read_menu(es, here)?))),
    (Some(_), Some(_)) => Err(invalid(here, "a box has \"on_context\" or \"menu\", not both")),
};

/** A box's menu: 1 to `MAX_MENU` items and separators, each label 1 to `MAX_LABEL` bytes. */
fun read_menu(v: Value, here: string): Result<Choice[], ContractError> {
    let entries = match v {
        Array(xs) if xs.len >= 1 && xs.len <= MAX_MENU => xs,
        _ => {
            return Err(invalid(here, "\"menu\" must be an array of 1 to {MAX_MENU} entries"));
        }
    };
    let mut out: Choice[] = [];
    for e of entries {
        out.push(read_choice(e, here)?);
    }
    Ok(out)
}

/** One menu entry: a label, its on_pick and maybe disabled, or a separator. */
fun read_choice(e: Value, here: string): Result<Choice, ContractError> {
    let wrong = invalid(here, "a menu entry needs a label and on_pick, or separator set to true");
    match e {
        Map(_) => {}
        _ => {
            return Err(wrong);
        }
    }
    match (e.get("separator"), e.get("label"), e.get("on_pick"), e.get("disabled")) {
        (Some(Bool(true)), None, None, None) => Ok(Choice.Separator),
        (None, Some(Text(s)), Some(m), d) if s.len >= 1 && s.len <= MAX_LABEL => match d {
            None => Ok(Choice.Item(s, m, false)),
            Some(Bool(b)) => Ok(Choice.Item(s, m, b)),
            Some(_) => Err(wrong),
        },
        (None, Some(Text(_)), Some(_), _) => Err(
            invalid(here, "a menu item's label must be 1 to {MAX_LABEL} bytes"),
        ),
        _ => Err(wrong),
    }
}

/**
 * A text's parts (PRP-053): strings, names and moments, at most `MAX_PARTS`;
 * each moment whole milliseconds within years 1 to 9999.
 */
fun read_parts(v: Value, here: string): Result<Part[], ContractError> {
    let items = match v {
        Array(xs) if xs.len <= MAX_PARTS => xs,
        Array(_) => {
            return Err(invalid(here, "more than {MAX_PARTS} parts"));
        }
        _ => {
            return Err(invalid(here, "\"parts\" must be an array"));
        }
    };
    let mut out: Part[] = [];
    for item of items {
        out.push(match (item, item.get("name"), item.get("time")) {
            (Text(s), _, _) => Part.Plain(s),
            (_, Some(Text(n)), None) => match n {
                "first" => Part.Name(Which.First),
                "last" => Part.Name(Which.Last),
                _ => {
                    return Err(invalid(here, "a name part is \"first\" or \"last\""));
                }
            },
            (_, None, Some(ms)) => Part.Time(moment(ms, here)?, show_of(item.get("show"), here)?),
            _ => {
                return Err(invalid(here, "a part must be text, a name or a time"));
            }
        });
    }
    Ok(out)
}

/** A time part's moment: an integer within `FIRST_MOMENT` and `LAST_MOMENT`. */
fun moment(v: Value, here: string): Result<i64, ContractError> = match v {
    // Integers only: a float, even a whole one, isn't a moment.
    Unsigned(_) | Negative(_) => match v.as_i64() {
        Some(ms) if ms >= FIRST_MOMENT && ms <= LAST_MOMENT => Ok(ms),
        _ => Err(invalid(here, "a time part is whole milliseconds within years 1 to 9999")),
    },
    _ => Err(invalid(here, "a time part is whole milliseconds within years 1 to 9999")),
};

/** A time part's `show`. */
fun show_of(v: Option<Value>, here: string): Result<Show, ContractError> = match v {
    Some(Text(s)) => match s {
        "time" => Ok(Show.Time),
        "date" => Ok(Show.Date),
        "date_time" => Ok(Show.DateTime),
        "relative" => Ok(Show.Relative),
        "weekday" => Ok(Show.Weekday),
        _ => Err(invalid(here, "show must be time, date, date_time, relative or weekday")),
    },
    _ => Err(invalid(here, "show must be time, date, date_time, relative or weekday")),
};

/** A box's `children`, each at the next depth, inside what `scrolling` scrolls. */
fun children(
    v: Value,
    here: string,
    depth: i64,
    count: Ref<i64>,
    seen: Ref<string[]>,
    scrolling: Option<Axis>,
): Result<Node[], ContractError> {
    let items = match v.get("children") {
        Some(Array(xs)) => xs,
        None => [],
        Some(_) => {
            return Err(invalid(here, "\"children\" must be an array"));
        }
    };
    let mut out: Node[] = [];
    let mut i = 0;
    for item of items {
        out.push(node(item, here, i, depth + 1, count, seen, scrolling)?);
        i += 1;
    }
    Ok(out)
}

/** Whether scrolling `a` shares a way with what already scrolls around it. */
fun overlaps(around: Option<Axis>, a: Axis): bool = match (around, a) {
    (None, _) => false,
    (Some(Both), _) | (_, Both) => true,
    (Some(Vertical), Vertical) | (Some(Horizontal), Horizontal) => true,
    _ => false,
};

/** The ways scrolled once `a` is inside what already scrolls: one way, or both. */
fun joined(around: Option<Axis>, a: Axis): Axis = match around {
    None => a,
    Some(b) if b == a => a,
    _ => Axis.Both,
};

/** Counts an unread node's subtree against the limits. */
fun tally(v: Value, here: string, depth: i64, count: Ref<i64>): Result<(), ContractError> {
    let items = match v.get("children") {
        Some(Array(xs)) => xs,
        _ => [],
    };
    for item of items {
        count.set(count.get() + 1);
        if count.get() > MAX_NODES {
            return Err(invalid(here, "more than {MAX_NODES} nodes"));
        }
        if depth + 1 > MAX_NODE_DEPTH {
            return Err(invalid(here, "deeper than {MAX_NODE_DEPTH} nodes"));
        }
        tally(item, here, depth + 1, count)?;
    }
    Ok(())
}

/** The farthest a slider's ends may be from 0 (PRP-075). */
const MAX_SLIDER: i64 = 1_000_000;

/**
 * A slider's props (PRP-075): whole `min` < `max` within ±1,000,000, a
 * whole `value` held to them, a `step` of at least 1 (1 unless said), and
 * a `label` of 1 to `MAX_LABEL` bytes; anything else stops the app.
 */
fun sliding(given: Value, here: string): Result<Sliding, ContractError> {
    let bad = invalid(here, "This app drew a slider Rapidkoi can't show");
    let whole = fun(key: string): Option<i64> = given.get(key).and_then(fun(v: Value) = v.as_i64());
    let (min, max, value) = match (whole("min"), whole("max"), whole("value")) {
        (Some(a), Some(b), Some(v)) if a < b && a >= -MAX_SLIDER && b <= MAX_SLIDER => (a, b, v),
        _ => {
            return Err(bad);
        }
    };
    let step = match given.get("step") {
        None => 1,
        Some(_) => match whole("step") {
            Some(n) if n >= 1 => n,
            _ => {
                return Err(bad);
            }
        },
    };
    let label = match given.get("label") {
        Some(Text(s)) if s.len >= 1 && s.len <= MAX_LABEL => s,
        _ => {
            return Err(bad);
        }
    };
    Ok(Sliding {
        min: min,
        max: max,
        value: if value < min { min } else if value > max { max } else { value },
        step: step,
        label: label,
        on_change: given.get("on_change"),
    })
}
