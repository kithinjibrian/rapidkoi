/**
 * Answering what apps ask for (PRP-011): their public key, sign-in
 * signatures over their verified host, and requests (PRP-012, through
 * `requests`). Only signed apps get keys and signatures, by their host and
 * origin key, and only while you're signed in to them; everything else is
 * answered with nothing. The new tab's asks (PRP-030: your pins, where you
 * left off, opening them) need the permission each names, which only an
 * app built into `./main` can hold; an app asking for one it didn't
 * declare is stopped. Each answer goes back through the app's `update`,
 * which may ask again, up to `MAX_ANSWERS` in a row.
 *
 * Depends on: kivuli, people.identity, people.people, window.tabs, window.window, guest.contract, guest.home, bundles.permissions, ui.render, net.requests, window.actions
 * Used by: shell
 */
import people.identity { Master, master, public_key, sign_in };
import people.people { Grant, person, setting_of, with_setting };
import people.account { generation_for };
import window.tabs { AppPage, Tab, Screen, handle, changed };
import window.window { Model, with_tab, is_blank, with_prefs };
import window.notices { identity_trouble };
import data.preferences { prefs_value, apply };
import guest.contract { reply };
import guest.nodes { Effect };
import cbor { Value };
import std.time;
import kivuli { Cmd };
import window.actions { Msg, Approval, Answer };
import net.requests;
import data.queries;
import data.databases { Call };
import ui.render;
import guest.home { pins_of, left_off_of, pin_msg, continue_msg, session_of };
import bundles.permissions { Permission, Setting, name_of, words_of };
import people.access { key_of };
import bundles.bundle { Manifest };
import net.network { Reply };

/** The most answers in a row for one app before it's stopped: an app that keeps asking. */
const MAX_ANSWERS: i64 = 32;

/**
 * Answers every tab's waiting effects. A fetch is answered later, when its
 * task's result arrives (`requests.arrive`), unless it's refused at once.
 *
 * @returns the model with each page past its answers (the master secret
 *     made or read on first need: a failure shows as the notice, and the
 *     app gets nothing), and the requests to send
 *
 * Example:
 *     answer_all(next)
 */
fun answer_all(m: Model): (Model, Cmd<Msg>) {
    let mut at = m;
    let mut sends: Cmd<Msg>[] = [];
    let mut slots: Slot[] = [];
    for t of m.tabs {
        if t.page.asks.len > 0 {
            slots.push(Slot.InTab(t.id));
        }
    }
    // The new tab runs outside the tabs (PRP-027), and is answered too.
    if m.newtab.map(fun(p: AppPage) = p.asks.len > 0).unwrap_or(false) {
        slots.push(Slot.NewTab);
    }
    for slot of slots {
        let (next, cmds) = answer_slot(at, slot);
        at = next;
        for c of cmds {
            sends.push(c);
        }
    }
    (at, if sends.len == 0 { Cmd.none() } else { Cmd.batch(sends) })
}

/** Where a page that asks lives: a tab, or the new tab. */
enum Slot {
    InTab(i64),
    NewTab,
}

fun get(m: Model, slot: Slot): Option<AppPage> = match slot {
    InTab(id) => find(m, id),
    NewTab => m.newtab,
};

fun put(m: Model, slot: Slot, f: fun(AppPage): AppPage): Model = match slot {
    InTab(id) => with_tab(m, id, f),
    NewTab => Model { newtab: m.newtab.map(f), ..m },
};

/** The tab a page is in; the new tab is in none. */
fun tab_of(slot: Slot): Option<i64> = match slot {
    InTab(id) => Some(id),
    NewTab => None,
};

/** Whether a page's manifest declares `p`: the loader let it through only if it may hold it. */
fun holds(page: AppPage, p: Permission): bool = page.manifest.map(
    fun(m: Manifest) = m.permissions.any(fun(n: string) = n == name_of(p)),
).unwrap_or(false);

/** The permission an ask needs, if any. */
fun needed(ask: Effect): Option<Permission> = match ask {
    Pins(_) => Some(Permission.ReadPins),
    LeftOff(_) => Some(Permission.ReadLeftOff),
    OpenPin(_, _) => Some(Permission.OpenApps),
    Continue(_) => Some(Permission.OpenApps),
    Session(_) => Some(Permission.RestoreSession),
    RestoreSession(_) => Some(Permission.RestoreSession),
    SetPreference(_, _, _) => Some(Permission.ChangeSettings),
    _ => None,
};

/** A page stopped with `why`, its asks dropped. */
fun stop(page: AppPage, why: string): AppPage = AppPage {
    screen: Screen.Stopped(why, true),
    asks: [],
    ..page,
};

/** One page's effects, in order, and whatever the answers ask for after them. */
fun answer_slot(m: Model, slot: Slot): (Model, Cmd<Msg>[]) {
    let mut at = m;
    let mut sends: Cmd<Msg>[] = [];
    let mut answered = 0;
    while true {
        let p = match get(at, slot) {
            Some(p) => p,
            None => {
                return (at, sends);
            }
        };
        if p.asks.len == 0 {
            return (at, sends);
        }
        if answered >= MAX_ANSWERS {
            // It keeps asking: stop it, like any app that won't settle.
            let stopped = put(
                at,
                slot,
                fun(page: AppPage) = stop(
                    page,
                    "This app asked Rapidkoi for too many things at once",
                ),
            );
            return (stopped, sends);
        }
        let ask = p.asks[0];
        let mut grant = true;
        if let Some(wanted) = needed(ask) {
            // Reaching for what it didn't declare stops it (the owner, session 166).
            if !holds(p, wanted) {
                let why = "This app asked for {words_of(wanted)} without declaring it";
                return (put(at, slot, fun(page: AppPage) = stop(page, why)), sends);
            }
            match setting_of(at.people, key_of(p), wanted) {
                Allowed => (),
                Blocked => {
                    grant = false;
                }
                // Your answer first (PRP-031). One dialog at a time: until
                // it's answered, this page's asks wait, and any other
                // page's that need approval wait too.
                Ask => {
                    // Only the page in front asks you; one behind waits until
                    // it's shown. Never over a card you're in, the settings
                    // you may be changing: asked once it closes (the owner's
                    // call, session 173).
                    let calm = at.panel.is_none() && at.shield.is_none();
                    if at.approval.is_none() && in_front(at, slot) && calm {
                        let tab = match slot {
                            InTab(id) => Some(id),
                            NewTab => None,
                        };
                        at = Model {
                            approval: Some(Approval { tab: tab, permission: wanted, app: p.name }),
                            ..at,
                        };
                    }
                    return (at, sends);
                }
            }
        }
        let (next, cmds) = answer_head(at, slot, p, grant);
        at = next;
        for c of cmds {
            sends.push(c);
        }
        answered += 1;
    }
    (at, sends)
}

/**
 * Answers a page's first ask and moves on to the rest: `grant` false
 * answers a permission's ask as blocked (pins `[]`, nothing left off,
 * nothing opened). An answer may ask again: those come after the ones
 * still waiting.
 */
fun answer_head(m: Model, slot: Slot, p: AppPage, grant: bool): (Model, Cmd<Msg>[]) {
    let mut sends: Cmd<Msg>[] = [];
    let ask = p.asks[0];
    let rest: Effect[] = [];
    let mut later = rest;
    for i in 1..p.asks.len {
        later.push(p.asks[i]);
    }
    let (got, value, msg) = match ask {
        Fetch(msg, r, blob) => match slot {
            InTab(id) => {
                let (held, now, send) = requests.ask(m, id, msg, r, blob);
                sends.push(send);
                (held, now, msg)
            }
            // The new tab has no server of its own to reach.
            NewTab => (m, Some(reply(Reply.Failed("The new tab can't make requests"))), msg),
        },
        // Its own database (PRP-041) and blobs (PRP-054): a task, answered when it arrives.
        Sql(msg, q) => {
            let (held, now, send) = queries.ask_in(m, tab_of(slot), msg, Call.Read(q));
            sends.push(send);
            (held, now, msg)
        }
        SqlBatch(msg, steps) => {
            let (held, now, send) = queries.ask_in(m, tab_of(slot), msg, Call.Write(steps));
            sends.push(send);
            (held, now, msg)
        }
        BlobGet(msg, r) => {
            let (held, now, send) = queries.ask_in(m, tab_of(slot), msg, Call.BlobGet(r));
            sends.push(send);
            (held, now, msg)
        }
        BlobList(msg, prefix) => {
            let (held, now, send) = queries.ask_in(m, tab_of(slot), msg, Call.BlobList(prefix));
            sends.push(send);
            (held, now, msg)
        }
        Pins(msg) => (m, Some(if grant { pins_of(m) } else { Value.Array([]) }), msg),
        LeftOff(msg) => (m, Some(if grant { left_off_of(m) } else { Value.Null }), msg),
        // Opening is the window's own message, after this update: one tab
        // per app and the empty tab, as for a click (PRP-026).
        OpenPin(msg, index) => {
            if grant {
                if let Some(open) = pin_msg(m, index) {
                    sends.push(Cmd.after(0, open));
                }
            }
            (m, None, msg)
        }
        Continue(msg) => {
            if grant {
                if let Some(open) = continue_msg(m) {
                    sends.push(Cmd.after(0, open));
                }
            }
            (m, None, msg)
        }
        Session(msg) => (m, Some(if grant { session_of(m) } else { Value.Null }), msg),
        // Restoring is the window's own message, as opening is.
        RestoreSession(msg) => {
            if grant {
                sends.push(Cmd.after(0, Msg.RestoreSession));
            }
            (m, None, msg)
        }
        // Open to every app (PRP-038): three coarse values, never colours.
        Preferences(msg) => (m, Some(prefs_value(m.prefs)), msg),
        // Open to every app (PRP-053): UTC, rounded down to a second; nothing about place.
        Now(msg) => (m, Some(Value.int(time.now_ms() / 1000 * 1000)), msg),
        // Only Rapidkoi's Settings app: applied at once; a bad one stops it.
        SetPreference(msg, name, v) => {
            if !grant {
                (m, None, msg)
            } else {
                match apply(m.prefs, name, v) {
                    Ok(next) => (with_prefs(m, next), None, msg),
                    Err(why) => {
                        return (put(m, slot, fun(page: AppPage) = stop(page, why)), sends);
                    }
                }
            }
        }
        Identity(msg) => {
            let (held, v) = respond(m, p, ask);
            (held, Some(v), msg)
        }
        Sign(msg, _) => {
            let (held, v) = respond(m, p, ask);
            (held, Some(v), msg)
        }
    };
    let done = match value {
        Some(v) => put(got, slot, fun(page: AppPage) {
            let next = handle(AppPage { asks: [], ..page }, render.Msg.Answer(msg, v));
            let mut queue = later;
            for a of next.asks {
                queue.push(a);
            }
            AppPage { asks: queue, ..next }
        }),
        // Sent, or nothing to answer: a request's answer comes when its result arrives.
        None => put(got, slot, fun(page: AppPage) = AppPage { asks: later, ..page }),
    };
    (done, sends)
}

/**
 * Tells the page in front that something it may read changed while it
 * stayed there (`on_change`, PRP-031): your pins, where you left off (for
 * a permission it holds that isn't blocked), or one of its own permission
 * settings. A page that just came to the front heard `on_resume` instead.
 *
 * @param before the model before this update
 * @param after the model after it
 * @returns `after`, the page in front told when something moved
 *
 * Example:
 *     tell_changes(m, next)
 */
fun tell_changes(before: Model, after: Model): Model {
    let id = match after.current {
        Some(id) if before.current == Some(id) => id,
        _ => {
            return after;
        }
    };
    let slot = if is_blank(after, id) { Slot.NewTab } else { Slot.InTab(id) };
    let p = match get(after, slot) {
        Some(p) => p,
        None => {
            return after;
        }
    };
    let key = key_of(p);
    let reads = fun(wanted: Permission): bool = holds(p, wanted) && setting_of(
        after.people,
        key,
        wanted,
    ) != Setting.Blocked;
    let mine = fun(m: Model): Grant[] = m.people.grants.filter(fun(g: Grant) = g.app == key);
    let moved = reads(Permission.ReadPins) && pins_of(before) != pins_of(after) || reads(
        Permission.ReadLeftOff,
    ) && left_off_of(before) != left_off_of(after) || reads(
        Permission.RestoreSession,
    ) && session_of(before) != session_of(after) || mine(before) != mine(after);
    if moved { put(after, slot, changed) } else { after }
}

/**
 * Tells every running app the person's choices changed (`on_change`,
 * PRP-038): light or dark, contrast or text size. Any app may read them,
 * so every one is told, in front or not.
 *
 * Example:
 *     tell_prefs(m, next)
 */
fun tell_prefs(before: Model, after: Model): Model {
    if before.prefs == after.prefs {
        return after;
    }
    let mut at = after;
    for t of after.tabs {
        at = with_tab(at, t.id, changed);
    }
    Model { newtab: at.newtab.map(changed), ..at }
}

/** Whether a page is the one you're looking at: its tab, or the new tab on the empty tab. */
fun in_front(m: Model, slot: Slot): bool = match slot {
    InTab(id) => m.current == Some(id),
    NewTab => m.current.map(fun(id: i64) = is_blank(m, id)).unwrap_or(false),
};

/**
 * Answers a waiting approval with Don't allow once its page isn't in
 * front any more: switching tabs is a no (PRP-031).
 *
 * Example:
 *     let (m, sent) = left_behind(next);
 */
fun left_behind(m: Model): (Model, Cmd<Msg>) = match m.approval {
    Some(a) => {
        let slot = match a.tab {
            Some(id) => Slot.InTab(id),
            None => Slot.NewTab,
        };
        if in_front(m, slot) { (m, Cmd.none()) } else { approve(m, Answer.Deny) }
    }
    None => (m, Cmd.none()),
};

/**
 * Carries out your answer to the approval dialog (PRP-031): answers the
 * waiting ask (Deny as blocked), and Always allow allows it from now on.
 * The asks after it are `answer_all`'s, as usual.
 *
 * @param m the model, its `approval` waiting
 * @param a your answer
 * @returns the model with the dialog closed; what answering it sends
 *
 * Example:
 *     approve(m, Answer.Once)
 */
fun approve(m: Model, a: Answer): (Model, Cmd<Msg>) {
    let waiting = match m.approval {
        Some(w) => w,
        None => {
            return (m, Cmd.none());
        }
    };
    let slot = match waiting.tab {
        Some(id) => Slot.InTab(id),
        None => Slot.NewTab,
    };
    let cleared = Model { approval: None, ..m };
    let p = match get(cleared, slot) {
        Some(p) if p.asks.len > 0 => p,
        _ => {
            return (cleared, Cmd.none());
        }
    };
    let folks = match a {
        Always => with_setting(cleared.people, key_of(p), waiting.permission, Setting.Allowed),
        _ => cleared.people,
    };
    let (next, sends) = answer_head(Model { people: folks, ..cleared }, slot, p, a != Answer.Deny);
    (next, if sends.len == 0 { Cmd.none() } else { Cmd.batch(sends) })
}

/**
 * What to answer one effect with: the key or a signature for a signed app
 * you're signed in to; nothing otherwise.
 */
fun respond(m: Model, p: AppPage, ask: Effect): (Model, Value) {
    let t = match p.trust {
        Some(t) => t,
        None => {
            return (m, Value.Null);
        }
    };
    // Sign in off: a guest, every run (PRP-052).
    if !person(m.people, t.host, t.origin).signs_in {
        return (m, Value.Null);
    }
    let (held, secret) = secret(m);
    let mm = match secret {
        Some(mm) => mm,
        None => {
            return (held, Value.Null);
        }
    };
    // Past every key it had before it was forgotten (PRP-052).
    let g = match generation_for(m.people, mm, t.host, t.origin) {
        Ok(g) => g,
        Err(e) => {
            return (Model { notice: Some(identity_trouble(e)), ..held }, Value.Null);
        }
    };
    let made = match ask {
        Identity(_) => public_key(mm, t.host, t.origin, g),
        Sign(_, challenge) => sign_in(mm, t.host, t.origin, g, challenge),
        _ => {
            return (held, Value.Null);
        }
    };
    match made {
        Ok(bytes) => (held, Value.Bytes(bytes)),
        Err(e) => (Model { notice: Some(identity_trouble(e)), ..held }, Value.Null),
    }
}

/** The master secret: cached in the model, else read or made in the store (none without one). */
fun secret(m: Model): (Model, Option<Master>) {
    if let Some(mm) = m.master {
        return (m, Some(mm));
    }
    let s = match m.store {
        Some(s) => s,
        None => {
            return (m, None);
        }
    };
    match master(s) {
        Ok(mm) => (Model { master: Some(mm), ..m }, Some(mm)),
        Err(e) => (Model { notice: Some(identity_trouble(e)), ..m }, None),
    }
}

fun find(m: Model, id: i64): Option<AppPage> {
    for t of m.tabs {
        if t.id == id {
            return Some(t.page);
        }
    }
    None
}
