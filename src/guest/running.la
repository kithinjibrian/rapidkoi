/**
 * Running a guest (moved from `tabs.la`, PRP-011): opening it in a fresh
 * store, the init event (fresh starts) and the opened event (every open),
 * messages and Rapidkoi's answers through `handle`, reading each result
 * (its effects included), and `view`. Calls guests (bounded by fuel);
 * never draws.
 *
 * Depends on: cbor, guest.guest, guest.contract, window.tabs
 * Used by: window.tabs
 */
import guest.guest { Guest, open, reason };
import guest.contract { read_update };
import guest.nodes { ContractError, Effect, Update, LinkChange };
import guest.events { Happened, event_for };
import guest.links { with_link };
import guest.tree { read_tree };
import window.tabs { Screen, Program };

/** What one or more events left: the screen, what they asked for, and the address's change. */
struct Ran {
    /** The screen: running, or stopped with why. */
    screen: Screen,
    /** What the events asked for, in order. */
    asks: Effect[],
    /** The last change to the address's fields. */
    link: LinkChange,
}

/**
 * Opens the guest in a fresh store and brings it up: on a fresh start the
 * init event (from an empty state) with a link's fields then set in its
 * state (PRP-036; `kinds` lets an empty field take one, DECISION-056),
 * then on every open the opened event, then `view`. Returns the screen and
 * everything both events asked for.
 */
fun start(p: Program, saved: Option<u8[]>, link: (string, string)[]): Ran = match open(
    p.engine,
    p.module,
) {
    Err(e) => stopped(reason(e)),
    Ok(g) => {
        let (state, first, named) = match saved {
            Some(state) => (state, [], LinkChange.Keep),
            None => match settle(g, [], event_for(Happened.Init), "init") {
                Ok(u) => (with_link(u.state, link, u.kinds), u.effects, u.link),
                Err(why) => {
                    return stopped(why);
                }
            },
        };
        match settle(g, state, event_for(Happened.Open), "opened") {
            Err(why) => stopped(why),
            Ok(u) => {
                let mut asks = first;
                for e of u.effects {
                    asks.push(e);
                }
                // `on_open`'s own change wins; without one, `on_init`'s stands.
                let last = if u.link == LinkChange.Keep { named } else { u.link };
                shown(g, u.state, asks, last)
            }
        }
    }
};

/** A guest that stopped before it could run: why. */
fun stopped(why: string): Ran = Ran {
    screen: Screen.Stopped(why, true),
    asks: [],
    link: LinkChange.Keep,
};

/**
 * Sends an event to the guest's `handle`, then renders the new state.
 *
 * @returns the screen and what it asked for
 *
 * Example:
 *     happen(g, state, Happened.Resume)
 */
fun happen(g: Guest, state: u8[], h: Happened): Ran = match settle(
    g,
    state,
    event_for(h),
    "update",
) {
    Err(why) => stopped(why),
    Ok(u) => shown(g, u.state, u.effects, u.link),
};

/** One `handle` call, read; on any failure the guest is closed and the reason kept. */
fun settle(g: Guest, state: u8[], event: u8[], what: string): Result<Update, string> {
    let bytes = match g.handle(state, event) {
        Ok(b) => b,
        Err(e) => {
            g.close();
            return Err(reason(e));
        }
    };
    match read_update(bytes) {
        Ok(u) => Ok(u),
        Err(e) => {
            g.close();
            Err(broken("{what} result", e))
        }
    }
}

/** Renders a state; a screen that stops drops what was asked for. */
fun shown(g: Guest, state: u8[], asks: Effect[], link: LinkChange): Ran {
    let screen = show(g, state);
    match screen {
        Running(_, _, _) => Ran { screen: screen, asks: asks, link: link },
        _ => Ran { screen: screen, asks: [], link: link },
    }
}

/** Calls `view(state)` and decodes the screen. */
fun show(g: Guest, state: u8[]): Screen = match g.view(state) {
    Err(e) => halt(g, reason(e)),
    Ok(bytes) => match read_tree(bytes) {
        Err(e) => halt(g, broken("screen description", e)),
        Ok(d) => Screen.Running(g, state, d),
    },
};

/** Stops the guest: frees its store and keeps why. */
fun halt(g: Guest, why: string): Screen {
    g.close();
    Screen.Stopped(why, true)
}

fun broken(what: string, e: ContractError): string = match e {
    Invalid(path, problem) => "This app's {what} is broken ({path}: {problem})",
    TooLong(_, n) => "This app's {what} is too large ({n} bytes)",
    Decode(d) => "This app's {what} is broken (bad CBOR: {d})",
};
