/**
 * What the new tab reads (PRP-030), pure: your pins, your recent places
 * (PRP-062) and your last session, as the `pins`, `recent` and `session`
 * answers, and what `open_pin` and `open_recent` open (`left_off` and
 * `continue` answer from the newest place until the next contract), and
 * your notifications (PRP-065). Names, places (a host, or a file's name alone), icons
 * and a screen title: never a path, state, keys or trust.
 *
 * Depends on: cbor, guest.limits, net.address, window.window, window.tabs, window.actions, window.notifications
 * Used by: guest.effects, guest.noticeanswers
 */
import cbor { Value, Entry };
import guest.limits { MAX_PLACES };
import data.remembered { Face };
import net.address { is_address, parse, shown };
import window.window { Model };
import window.recent { Place };
import window.notifications { kind_name };
import ui.themes { publisher_colour };
import window.tabs { Pin, AppPage, Tab };
import window.actions { Msg };

/**
 * Returns where an app lives, as the new tab may show it: a site's host,
 * or a local app's file name without its folders.
 *
 * Example:
 *     place_of("rapidkoi://quote.dafifi.net")
 */
fun place_of(path: string): string {
    if is_address(path) {
        if let Ok(a) = parse(path) {
            return shown(a);
        }
    }
    let parts = path.split("/");
    parts[parts.len - 1]
}

/**
 * Returns the `pins` answer: up to `MAX_PLACES` maps `{name, place, icon}`,
 * in the sidebar's order.
 *
 * Example:
 *     pins_of(m)
 */
fun pins_of(m: Model): Value {
    let mut out: Value[] = [];
    for p of m.pinned {
        if out.len >= MAX_PLACES {
            break;
        }
        out.push(Value.Map(fields(p.name, p.path, None)));
    }
    Value.Array(out)
}

/**
 * Returns the `left_off` answer: your newest recent place as
 * `{name, place, icon, title?}`, or null (DECISION-044; the ask goes at the
 * next contract version).
 *
 * Example:
 *     left_off_of(m)
 */
fun left_off_of(m: Model): Value = match m.recent.places.len {
    0 => Value.Null,
    _ => Value.Map(
        fields(m.recent.places[0].name, m.recent.places[0].path, m.recent.places[0].title),
    ),
};

/**
 * Returns the `recent` answer (PRP-062): `{places: [...]}`, newest first and
 * at most `MAX_PLACES`, each app once by its newest place (the owner,
 * 2026-11-02), each `{name, place, icon, address, title?, seen, colors}`
 * (`colors.primary`, PRP-063).
 * The address is as the address box shows it: a site's link, or a file's
 * name, never its folders.
 *
 * Example:
 *     recent_of(m)
 */
fun recent_of(m: Model): Value {
    let mut out: Value[] = [];
    for p of listed(m) {
        if out.len >= MAX_PLACES {
            break;
        }
        let mut f = fields(p.name, p.path, p.title);
        f.push(entry("address", Value.Text(address_shown(p.address))));
        f.push(entry("seen", Value.int(p.seen)));
        f.push(entry("colors", Value.Map([entry("primary", Value.Text(primary_of(m, p)))])));
        out.push(Value.Map(f));
    }
    Value.Map([entry("places", Value.Array(out))])
}

/**
 * An address as the new tab may show it: a site's link keeps its fields,
 * only a file's folders are hidden, and Rapidkoi's own apps have no
 * address a person types.
 */
fun address_shown(link: string): string = if is_address(link) {
    link
} else if link.starts_with("builtin:") {
    ""
} else {
    place_of(link)
};

/**
 * Returns the `notifications` answer (PRP-065): `{unread, items: [...]}`,
 * unread first, then newest first, at most `MAX_PLACES`, each
 * `{kind, name, place, icon, text, address, sent, read}`. The app's name
 * and icon are Rapidkoi's, from the app that sent it.
 *
 * Example:
 *     notifications_of(m)
 */
fun notifications_of(m: Model): Value {
    let mut out: Value[] = [];
    for x of notifications.listed(m.notifications) {
        if out.len >= MAX_PLACES {
            break;
        }
        let name = notifications.face_for(m.notifications, x).map(fun(f: Face) = f.name).unwrap_or(
            place_of(x.path),
        );
        let mut f = [entry("kind", Value.Text(kind_name(x.kind)))];
        for e of fields(name, x.path, None) {
            f.push(e);
        }
        f.push(entry("text", Value.Text(x.text)));
        f.push(entry("address", Value.Text(address_shown(x.address))));
        f.push(entry("sent", Value.int(x.sent)));
        f.push(entry("read", Value.Bool(x.read)));
        out.push(Value.Map(f));
    }
    Value.Map([
        entry("unread", Value.int(notifications.unread(m.notifications))),
        entry("items", Value.Array(out)),
    ])
}

/**
 * Returns what `open_recent(index)` opens: that place as your places are
 * now, a fresh window at its address; nothing when there's no such place.
 *
 * Example:
 *     recent_msg(m, 0)
 */
fun recent_msg(m: Model, index: i64): Option<Msg> {
    let places = listed(m);
    if index >= 0 && index < places.len {
        Some(Msg.OpenPlace(places[index].address, places[index].origin))
    } else {
        None
    }
}

/**
 * A place's app's primary colour (PRP-063): the one it names, else the
 * palette's for it, as the dock gives it (by its first key, else its name).
 */
fun primary_of(m: Model, p: Place): string {
    for a of m.recent.apps {
        if a.path == p.path {
            if let Some(c) = a.colour {
                return c;
            }
        }
    }
    publisher_colour(m.theme, p.origin.unwrap_or(p.name.to_bytes()))
}

/** Your recent places as the new tab lists them: each app once, by its newest place. */
fun listed(m: Model): Place[] {
    let mut out: Place[] = [];
    for p of m.recent.places {
        if !out.any(fun(q: Place) = q.path == p.path && q.origin == p.origin) {
            out.push(p);
        }
    }
    out
}

/**
 * Returns what `open_pin(index)` opens: your pin at `index` as the pins
 * are now, or nothing when there's no such pin.
 *
 * Example:
 *     pin_msg(m, 0)
 */
fun pin_msg(m: Model, index: i64): Option<Msg> = if index >= 0 && index < m.pinned.len {
    Some(Msg.OpenPinned(m.pinned[index].path, m.pinned[index].origin))
} else {
    None
};

/**
 * Returns what `continue` does: opens your newest recent place
 * (DECISION-044; the ask goes at the next contract version), or nothing.
 *
 * Example:
 *     continue_msg(m)
 */
fun continue_msg(m: Model): Option<Msg> = recent_msg(m, 0);

/**
 * Returns the `session` answer (PRP-035): how many windows the last
 * session had and the apps they were of, each once as `{name, place, icon}`
 * (PRP-060: the name the session kept, else its place), or null when
 * there's none to restore.
 *
 * Example:
 *     session_of(m)
 */
fun session_of(m: Model): Value = match m.previous {
    Some(o) if o.tabs.len > 0 => {
        let mut places: string[] = [];
        let mut apps: Value[] = [];
        for t of o.tabs {
            let p = place_of(t.path);
            if !places.any(fun(a: string) = a == p) {
                places.push(p);
                let mut name = p;
                for f of o.apps {
                    if f.path == t.path {
                        name = f.name;
                    }
                }
                apps.push(Value.Map(fields(name, t.path, None)));
            }
        }
        Value.Map([entry("count", Value.int(o.tabs.len)), entry("apps", Value.Array(apps))])
    }
    _ => Value.Null,
};

/**
 * One place's fields. Its icon is named for Rapidkoi to draw (`icon:PLACE`,
 * PRP-060), never sent: the new tab shows it without ever holding it.
 */
fun fields(name: string, path: string, title: Option<string>): Entry[] {
    let place = place_of(path);
    let mut out = [
        entry("name", Value.Text(name)),
        entry("place", Value.Text(place)),
        entry("icon", Value.Text("icon:{place}")),
    ];
    if let Some(s) = title {
        out.push(entry("title", Value.Text(s)));
    }
    out
}

fun entry(k: string, v: Value): Entry = Entry { key: Value.Text(k), value: v };

fun page(m: Model, id: i64): Option<AppPage> {
    for t of m.tabs {
        if t.id == id {
            return Some(t.page);
        }
    }
    None
}
