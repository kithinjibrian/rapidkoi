/**
 * Every limit the contract puts on a guest app, in one place. A guest that
 * passes one is stopped with an error screen; Rapidkoi keeps running.
 * Values from `docs/source/meetings/2026-10-17-ui-contract.md`.
 *
 * Used by: guest.guest, guest.contract
 */

/** The one contract this Rapidkoi speaks (`rapidkoi_version()`): 9 (PRP-054; DECISION-056); older apps are rebuilt, never run. */
const CONTRACT_VERSION: i32 = 9;

/** The deepest a state may nest, as CBOR levels (PRP-036). */
const MAX_STATE_DEPTH: i64 = 64;

/** The largest module file Rapidkoi will compile, in bytes. */
const MAX_MODULE: i64 = 32 * 1024 * 1024;

/** The most a guest's linear memory may grow to, in bytes. */
const MEMORY_BYTES: i64 = 256 * 1024 * 1024;

/** The largest state a guest may hand back, in bytes. */
const MAX_STATE: i64 = 16 * 1024 * 1024;

/** The largest screen description a guest may hand back, in bytes. */
const MAX_VIEW: i64 = 4 * 1024 * 1024;

/** The largest update result: the state plus room for its map and `effects`, one blob among them (PRP-054). */
const MAX_UPDATE: i64 = MAX_STATE + MAX_BLOB + MAX_EFFECTS * (MAX_BODY_UP + 2 * MAX_URL) + 4096;

/** The most nodes in one screen description. */
const MAX_NODES: i64 = 10_000;

/** The deepest one node may sit: the root is depth 1. */
const MAX_NODE_DEPTH: i64 = 64;

/** The longest one string in a screen description, in bytes. */
const MAX_STRING: i64 = 64 * 1024;

/** The most parts in one text (PRP-053). */
const MAX_PARTS: i64 = 64;

/** The earliest moment a time part may name: 0001-01-01 00:00 UTC, in milliseconds since 1970. */
const FIRST_MOMENT: i64 = -62135596800000;

/** The latest: 9999-12-31 23:59:59.999 UTC. */
const LAST_MOMENT: i64 = 253402300799999;

/**
 * Fuel for one call into a guest: about 100 ms of work.
 *
 * Calibrated 2026-10-17 (session 6) on an Intel Core i5-4308U (2.8 GHz):
 * a busy `i32.add` loop, built with `lughac build -O 2`, ran out of 1, 2
 * and 4 billion fuel in 0.14, 0.28 and 0.57 s (`/usr/bin/time`), about
 * 7 billion fuel a second, so 100 ms is about 700 million. Fuel counts
 * instructions, not time: slower instructions (calls, memory traffic)
 * take longer per unit, so real code can run somewhat past 100 ms. It is a
 * bound on work, not a timer (epoch interruption would be, if ever needed).
 */
const FUEL_PER_CALL: u64 = 700_000_000;

/** The largest `.rkb` bundle Rapidkoi will read, in bytes. */
const MAX_BUNDLE: i64 = 32 * 1024 * 1024;

/** The largest one asset in a bundle, in bytes. */
const MAX_ASSET: i64 = 4 * 1024 * 1024;

/** The most assets in one bundle. */
const MAX_ASSETS: i64 = 256;

/** The longest app name in a manifest, in bytes. */
const MAX_NAME: i64 = 64;

/** The longest description in a manifest, in bytes. */
const MAX_DESCRIPTION: i64 = 280;

/** The longest asset name in a bundle, in bytes. */
const MAX_ASSET_NAME: i64 = 128;

/** How long fetching a bundle from a development server may take, in milliseconds. */
const FETCH_TIMEOUT_MS: i64 = 30_000;

/** The largest image any asset or picture may declare, in pixels per side (kivuli's own cap, DECISION-058). */
const MAX_IMAGE_PX: i64 = 4096;

/** The longest label a typing box or picture may have, in bytes (DECISION-056). */
const MAX_LABEL: i64 = 200;

/** The most pictures one screen may name, by distinct source (PRP-047). */
const MAX_PICTURES: i64 = 256;

/** The longest picture source, `asset:NAME` or an address, in bytes (PRP-047). */
const MAX_SOURCE: i64 = 2048;

/** The largest picture downloaded from a server, in bytes (PRP-047). */
const MAX_PICTURE: i64 = 10 * 1024 * 1024;

/** How long downloading one picture may take, in milliseconds (PRP-047). */
const PICTURE_TIMEOUT_MS: i64 = 30_000;

/** The most pictures one window downloads at once (PRP-047). */
const MAX_DOWNLOADS: i64 = 6;

/** The most decoded picture memory a window keeps, width × height × 4 bytes each (PRP-047). */
const MAX_DECODED: i64 = 256 * 1024 * 1024;

/** The most pixels a picture may declare (PRP-047): 4,096 × 4,096 until kivuli shows more (DECISION-058). */
const MAX_IMAGE_PIXELS: i64 = 4096 * 4096;

/** The largest SVG in a bundle, in bytes (PRP-047). */
const MAX_SVG: i64 = 1024 * 1024;

/** The largest icon, in pixels per side. */
const MAX_ICON_PX: i64 = 1024;

/** The largest banner, in pixels: width. */
const MAX_BANNER_WIDTH: i64 = 2048;

/** The largest banner, in pixels: height. */
const MAX_BANNER_HEIGHT: i64 = 1024;

/** The most effects one `init` or `update` may ask for (PRP-011). */
const MAX_EFFECTS: i64 = 8;

/** The longest sign-in challenge an app may ask Rapidkoi to sign, in bytes. */
const MAX_CHALLENGE: i64 = 1024;

/** The largest body an app's request may send, in bytes (PRP-012). */
const MAX_BODY_UP: i64 = 1024 * 1024;

/** The largest response body an app's request may receive, in bytes. */
const MAX_BODY_DOWN: i64 = 8 * 1024 * 1024;

/** The most requests in flight for one app. */
const MAX_IN_FLIGHT: i64 = 4;

/** How long one request may take, in milliseconds. */
const REQUEST_TIMEOUT_MS: i64 = 30_000;

/** The most servers a manifest may declare. */
const MAX_SERVERS: i64 = 32;

/** The most pins the new tab is told about (PRP-030). */
const MAX_PLACES: i64 = 64;

/** The largest icon handed to the new tab, in bytes; a bigger one is left out. */
const MAX_PLACE_ICON: i64 = 64 * 1024;

/** The most permissions a manifest may declare (PRP-030). */
const MAX_PERMISSIONS: i64 = 16;

/** The longest permission name, in bytes. */
const MAX_PERMISSION_NAME: i64 = 32;

/** The longest URL in a request, in bytes; also the longest header value. */
const MAX_URL: i64 = 8192;

/** The most headers in one request. */
const MAX_HEADERS: i64 = 64;

/** The longest SQL text a `sql` ask may send, in bytes (PRP-041). */
const MAX_SQL: i64 = 100 * 1024;

/** The most values one statement may bind. */
const MAX_SQL_PARAMS: i64 = 999;

/** The longest text or bytes value a statement may bind or store. */
const MAX_SQL_VALUE: i64 = 4 * 1024 * 1024;

/** The most rows one answer carries. */
const MAX_ROWS: i64 = 10_000;

/** The most bytes one answer's rows carry; rows past it are cut. */
const MAX_ANSWER: i64 = 4 * 1024 * 1024;

/** The most statements in one `sql_batch`. */
const MAX_STEPS: i64 = 100;

/** An app's database's largest size, in bytes. */
const DATABASE_BYTES: i64 = 100 * 1024 * 1024;

/** The largest blob, in bytes (PRP-054). */
const MAX_BLOB: i64 = 16 * 1024 * 1024;

/** All of an app's blobs together, in bytes, apart from its database. */
const BLOBS_BYTES: i64 = 1024 * 1024 * 1024;

/** The most blobs an app keeps. */
const MAX_BLOBS: i64 = 10_000;

/** The most bytes one `blob_get` answers with. */
const MAX_BLOB_PIECE: i64 = 4 * 1024 * 1024;

/** The longest blob key, in bytes. */
const MAX_BLOB_KEY: i64 = 256;

/** How long one call to an app's database may take, in milliseconds. */
const QUERY_MS: i64 = 1000;

/** The memory SQLite may use across every app's database. */
const SQLITE_HEAP: i64 = 256 * 1024 * 1024;

/** How often an app that stays open in front is checked against its site, in milliseconds (PRP-044). */
const CHECK_EVERY_MS: i64 = 15 * 60 * 1000;

/** All kept copies of signed apps together, in bytes (PRP-043): past it, the least recently opened unpinned ones go. */
const KEPT_BYTES: i64 = 500 * 1024 * 1024;
