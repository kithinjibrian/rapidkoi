/**
 * Reading one node's props: required and optional text. Each failure
 * names the node's path.
 *
 * Depends on: cbor, guest.nodes
 * Used by: guest.tree
 */
import cbor { Value };
import guest.nodes { ContractError, invalid };

/** A required text prop. */
fun text(props: Value, name: string, here: string): Result<string, ContractError> = match props.get(
    name,
) {
    Some(Text(s)) => Ok(s),
    Some(_) => Err(invalid(here, "\"{name}\" must be text")),
    None => Err(invalid(here, "\"{name}\" is missing")),
};

/** An optional text prop: `""` when left out. */
fun optional_text(
    props: Value,
    name: string,
    here: string,
): Result<string, ContractError> = match props.get(name) {
    Some(Text(s)) => Ok(s),
    Some(_) => Err(invalid(here, "\"{name}\" must be text")),
    None => Ok(""),
};

/** An optional text prop: `None` when left out. */
fun maybe_text(
    props: Value,
    name: string,
    here: string,
): Result<Option<string>, ContractError> = match props.get(name) {
    Some(Text(s)) => Ok(Some(s)),
    Some(_) => Err(invalid(here, "\"{name}\" must be text")),
    None => Ok(None),
};
