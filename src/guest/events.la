/**
 * Events (contract 9, `docs/specs/contract-9.md`), pure: what Rapidkoi
 * sends a guest's `handle`, named `on_…` on the wire.
 *
 * Depends on: cbor
 * Used by: guest.running, window.tabs
 */
import cbor { Value, Entry, encode };

/** Something that happened, for an app. */
enum Happened {
    /** A fresh start: make a first state. */
    Init,
    /** Every start, fresh or from saved state. */
    Open,
    /** Back to the front while running. */
    Resume,
    /** Something it may read changed while it's in front (PRP-031). */
    Change,
    /** Its data changed in another of its windows: these tables (PRP-041). */
    DataChanged(string[]),
    /** One of its own messages, and an input's text. */
    Message(Value, Option<string>),
    /** Rapidkoi's reply to what it asked for: bytes, null, or a request's reply. */
    Answer(Value, Value),
}

/**
 * Encodes an event as contract 7 names it (`on_…`).
 *
 * @param h what happened
 * @returns the event's bytes
 *
 * Example:
 *     event_for(Happened.Resume)
 */
fun event_for(h: Happened): u8[] = match h {
    Init => named("on_init", []),
    Open => named("on_open", []),
    Resume => named("on_resume", []),
    Change => named("on_change", []),
    DataChanged(tables) => named("on_change", [
        field("tables", Value.Array(tables.map(fun(n: string) = Value.Text(n)))),
    ]),
    Message(msg, text) => {
        let mut fields = [field("msg", msg)];
        if let Some(s) = text {
            fields.push(field("value", Value.Text(s)));
        }
        named("on_message", fields)
    }
    // A reply is its own event: a response, or why it failed, or an answer.
    Answer(msg, value) => named(
        if value.get("status").is_some() {
            "on_response"
        } else if value.get("error").is_some() {
            "on_fail"
        } else {
            "on_answer"
        },
        [field("msg", msg), field("value", value)],
    ),
};

fun field(name: string, v: Value): Entry = Entry { key: Value.Text(name), value: v };

fun named(event: string, fields: Entry[]): u8[] {
    let mut all = [field("event", Value.Text(event))];
    for f of fields {
        all.push(f);
    }
    encode(Value.Map(all))
}
