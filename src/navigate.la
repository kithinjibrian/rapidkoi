/**
 * Opening things in the window: what the address box says (a local file or
 * a local development address), a pinned app, Continue, and Reload. Each
 * returns the next model; the state itself lives in `window.la`. Reads
 * local files and fetches from localhost (CLAUDE.md rule 3).
 *
 * Depends on: std.fs, std.crypto, tabs, leftoff, window, address, verify, states, remembered, store
 * Used by: shell
 */
import std.fs;
import tabs {
    AppPage,
    open_path,
    close_page,
    resume,
    load_again,
    state_of,
    state_version_of,
    with_saved,
};
import leftoff { leave, compiled };
import verify { separate, moves };
import states { saved_state, move_state };
import std.crypto { equal };
import remembered { Recalled };
import store { Store };
import window { Model, page_of, with_tab, add_tab, app };
import address { is_address, parse };

/**
 * Opens what the address box says: a local file or development address,
 * or a notice why not.
 *
 * Example:
 *     go(m)
 */
public fun go(m: Model): Model {
    let wanted = m.draft.trim();
    if wanted == "" {
        return m;
    }
    if is_address(wanted) {
        // Local development addresses open; any other gets the reason why not yet.
        return match parse(wanted) {
            Ok(_) => open_file(m, wanted),
            Err(e) => Model { notice: Some(address.reason(e)), ..m },
        };
    }
    if fs.is_file(wanted) {
        return open_file(m, wanted);
    }
    Model { notice: Some("No app or file called “{wanted}”"), ..m }
}

/**
 * Opens a local app file: in a new tab from home, or in place of the
 * current tab's app (which becomes "where you left off").
 *
 * Example:
 *     open_file(m, "counter.wasm")
 */
public fun open_file(m: Model, path: string): Model {
    let (page, said) = resumed(m, open_path(m.engine, m.ring, path));
    let opened = match m.current {
        Some(id) if app(m, id).is_some() => {
            let left = Model { left_off: app(m, id).map(leave), ..m };
            with_tab(left, id, fun(_: AppPage) = page)
        }
        _ => add_tab(m, page),
    };
    Model { draft: "", editing: false, notice: said, ..opened }
}

/**
 * The store, after moving a state that a rotation just carried to `key`
 * (opening verified the rotation; `persist` would move it only after this
 * open read the state). Moving twice does nothing.
 */
fun arrived(s: Store, m: Model, host: string, key: u8[]): Store {
    for (h, old, new) of moves(m.ring) {
        if h == host && equal(new, key) {
            // A failed move leaves the old state in place: the app starts fresh, and nothing is lost.
            move_state(s, h, old, new).unwrap_or(());
        }
    }
    s
}

/**
 * A signed app's page, started from its saved state when there is one:
 * whatever route opened it, the same host and key pick up the same state
 * (PRP-007 amendment 2). Unsigned pages are left as they are.
 *
 * @returns the page, and a notice (a changed state shape, a broken file)
 */
fun resumed(m: Model, page: AppPage): (AppPage, Option<string>) = match (m.store, page.trust) {
    (Some(s), Some(t)) => match saved_state(arrived(s, m, t.host, t.key), t.host, t.key) {
        Read(sv) => {
            let (p, over) = with_saved(page, sv.state, sv.state_version);
            (
                p,
                if over {
                    Some("{p.name}'s saved state changed shape, so it started over")
                } else {
                    None
                },
            )
        }
        Broken(aside, _) => (
            page,
            Some("Rapidkoi couldn't read {page.name}'s saved state, so it set it aside in {aside}"),
        ),
        _ => (page, None),
    },
    _ => (page, None),
};

/**
 * Reopens the last app closed, with its saved state, in a new tab.
 *
 * Example:
 *     reopen(m)
 */
public fun reopen(m: Model): Model = match m.left_off {
    Some(l) if compiled(l) => Model { left_off: None, ..add_tab(m, resume(l)) },
    // Remembered from an earlier run: open its path again; a signed app's
    // state comes back from states/.
    Some(l) => {
        let (page, notice) = resumed(m, open_path(m.engine, m.ring, l.path));
        // Kept until it runs: a failed load leaves Continue in place.
        let left = if state_of(page).is_some() { None } else { Some(l) };
        Model { left_off: left, notice: notice, ..add_tab(m, page) }
    }
    None => m,
};

/**
 * ⟳ Reload: loads the current app again from its file or server and
 * continues with its current state when the state's shape is unchanged; a
 * changed shape starts fresh, with a notice. A stopped page starts fresh.
 *
 * Example:
 *     reload(m)
 */
public fun reload(m: Model): Model = match (m.current, page_of(m)) {
    (Some(id), App(a)) => {
        let saved = state_of(a).map(fun(st: u8[]) = (st, state_version_of(a)));
        let (loaded, over) = load_again(m.engine, m.ring, a.path, saved);
        // A changed key asks first: the open page waits, in case the
        // person keeps using it.
        let page = match loaded.screen {
            Unapproved(c, _) => AppPage { screen: tabs.Screen.Unapproved(c, [a]), ..loaded },
            _ => {
                close_page(a);
                loaded
            }
        };
        let notice: Option<string> = if over {
            Some("{page.name}'s saved state changed shape, so it started over")
        } else {
            None
        };
        Model { notice: notice, ..with_tab(m, id, fun(_: AppPage) = page) }
    }
    _ => m,
};

/**
 * "Keep using my version" on a changed key: back to the page that was
 * open, or the tab closes when there wasn't one.
 *
 * Example:
 *     keep_mine(m)
 */
public fun keep_mine(m: Model): Model = match (m.current, page_of(m)) {
    (Some(id), App(a)) => match a.screen {
        Unapproved(_, kept) if kept.len > 0 => with_tab(m, id, fun(_: AppPage) = kept[0]),
        Unapproved(_, _) => window.close(m, id),
        _ => m,
    },
    _ => m,
};

/**
 * "Open as a separate app" on a changed key: trusts the new key as a
 * second publisher for this session and opens it, marked so.
 *
 * Example:
 *     separate_app(m)
 */
public fun separate_app(m: Model): Model = match (m.current, page_of(m)) {
    (Some(id), App(a)) => match a.screen {
        Unapproved(c, _) => {
            separate(m.ring, c);
            close_page(a);
            with_tab(m, id, fun(_: AppPage) = open_path(m.engine, m.ring, a.path))
        }
        _ => m,
    },
    _ => m,
};
