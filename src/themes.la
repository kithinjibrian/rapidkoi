/**
 * Rapidkoi's themes: the colours of its own parts as kivuli typed looks.
 * The frame (the header bar and the rail) is one flat colour, with no
 * shadow, and the page sits flush inside it, curving only at its top-right
 * corner (the owner's direction, after the Opera inspiration). Apps never get colours; their content follows
 * the GTK theme. Dark is first and the default; others come later, with
 * settings.
 *
 * Depends on: kivuli, theme
 * Used by: window, shell
 */
// kivuli's Theme and theme() are imported under other names: this module has a Theme of its own.
import kivuli { Surface, Border, hex, Theme as Looks, theme as looks };
import theme { PAGE_RADIUS, EDGE_WIDTH };

/** The parts of Rapidkoi's window a theme colours. */
public enum Look {
    /** The frame: everything around the page, the rail included. */
    Frame,
    /** The page: home or an app, a rounded card inside the frame. */
    Page,
    /** A rounded card of rows in the info panel: the frame's colour on the page's. */
    Section,
    /** Over the app while the info panel is open: dims it, and a click on it closes the panel. */
    Scrim,
    /** The info panel over the app: the page's dark colour, a thin edge, every corner rounded. */
    Panel,
}

/** One theme: a name, and a colour per part. Hex values live only here. */
public struct Theme {
    /** What settings will call it. */
    public name: string,
    /** The frame (the owner's "bars": top and side, one colour). */
    public frame: string,
    /** The page card. */
    public page: string,
    /** The dim layer over the app while the panel is open: translucent (`#rrggbbaa`). */
    public scrim: string,
    /** A thin line around a part that floats over the page (the info panel). */
    public edge: string,
}

/** The dark theme, the default (the owner's colours, 2026-10-17). */
public const DARK: Theme = Theme {
    name: "dark",
    frame: "#242424",
    page: "#161616",
    scrim: "#00000060",
    edge: "#3a3a3a",
};

/**
 * Builds the kivuli theme that paints Rapidkoi's looks in `t`.
 *
 * @param t the theme
 * @returns the kivuli theme for the root's `.theme(…)`
 *
 * Example:
 *     view.theme(kivuli_theme(DARK))
 */
public fun kivuli_theme(t: Theme): Looks = looks(
    [Look.Frame, Look.Page, Look.Section, Look.Scrim, Look.Panel],
    fun(l: Look) = surface(t, l),
);

/**
 * Returns how one look appears in a theme.
 *
 * @param t the theme
 * @param l the look
 * @returns its surface; unset fields stay the GTK theme's
 *
 * Example:
 *     surface(DARK, Look.Page)
 */
public fun surface(t: Theme, l: Look): Surface = match l {
    // Flat: no theme shadow or edge line, so the header bar, rail and gaps are one surface.
    Frame => Surface { background: Some(hex(t.frame)), flat: Some(true), ..Surface.theme() },
    // Only the top-right corner curves: where the frame wraps the page.
    Page => Surface {
        background: Some(hex(t.page)),
        radius_top_right: Some(PAGE_RADIUS),
        ..Surface.theme(),
    },
    // The panel's cards: the frame's colour, rounded, on the page's.
    Section => Surface {
        background: Some(hex(t.frame)),
        radius: Some(PAGE_RADIUS),
        ..Surface.theme(),
    },
    // The panel floats over the dimmed app: the page's dark colour (its
    // cards, in the frame's, stand out on it), a thin edge to set it apart,
    // and rounded all round.
    Panel => Surface {
        background: Some(hex(t.page)),
        border: Some(Border { width: EDGE_WIDTH, color: hex(t.edge) }),
        radius: Some(PAGE_RADIUS),
        flat: Some(true),
        ..Surface.theme(),
    },
    // Flat: a plain dim layer, not a button that looks like one.
    Scrim => Surface { background: Some(hex(t.scrim)), flat: Some(true), ..Surface.theme() },
};
