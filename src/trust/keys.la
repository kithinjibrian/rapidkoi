/**
 * A publisher's secret key, on the developer's machine only: making one
 * (`keygen`), reading it back, its public fingerprint, and the rule that
 * key files live outside the project, so they're never committed or
 * published. Signing itself is std.crypto's.
 *
 * Depends on: std.crypto, std.fs, cbor
 * Used by: bundles.signing, trust.index, commands.publish
 */
import std.crypto { ed25519_keypair, ed25519_public, sha256 };
import std.fs;
import cbor { Value, Entry, Limits, decode, encode };

/** A publisher's key pair, for one host. */
struct SecretKey {
    /** The app's host the key signs for. */
    host: string,
    /** The 32-byte secret seed. Never written anywhere but its own file. */
    secret: u8[],
    /** The 32-byte public key. */
    public_key: u8[],
}

/** Why a key couldn't be made or read. */
enum KeyError {
    /** keygen never replaces a key. */
    Exists(string),
    /** A key path inside the project. */
    InsideProject(string),
    /** The file is for another host: the file, its host, the wanted host. */
    WrongHost(string, string, string),
    /** Not a Rapidkoi secret key file: the file, why. */
    Malformed(string, string),
    /** The file couldn't be read or written: the file, the system's message. */
    Io(string, string),
    /** std.crypto failed; its message. */
    Crypto(string),
}

const KIND: string = "rapidkoi secret key";

/** 0600: the owner reads and writes; nobody else does anything. */
const OWNER_ONLY: i64 = 0b110_000_000;

/**
 * Makes a key pair for `host` and writes it to `path`, readable by its
 * owner only (0600).
 *
 * @param host the app's host
 * @param path where the secret key goes: never inside `project`
 * @param project the project's folder, absolute
 * @returns the key, or why not (the file exists, the path is inside the
 *     project, writing failed)
 *
 * Example:
 *     keygen("notes.acme.com", "/home/me/.config/rapidkoi/keys/notes.key", "/work/notes")?
 */
fun keygen(host: string, path: string, project: string): Result<SecretKey, KeyError> {
    if inside(path, project) {
        return Err(KeyError.InsideProject(path));
    }
    if fs.exists(path) {
        return Err(KeyError.Exists(path));
    }
    let (secret, pk) = ed25519_keypair().map_err(fun(e) = KeyError.Crypto(e.message()))?;
    let parts = path.split("/");
    if parts.len > 1 {
        let folder = path.slice(0, path.len - parts[parts.len - 1].len - 1);
        if folder != "" {
            fs.make_dirs(folder).map_err(fun(e: string) = KeyError.Io(folder, e))?;
        }
    }
    let file = encode(
        Value.Map([
            entry("format", Value.int(1)),
            entry("kind", Value.Text(KIND)),
            entry("host", Value.Text(host)),
            entry("secret", Value.Bytes(secret)),
            entry("public", Value.Bytes(pk)),
        ]),
    );
    // Owner-only before the secret is in it, so it's never readable by
    // others; then renamed into place, so the key file is whole or absent.
    let tmp = "{path}.tmp";
    let io = fun(e: string) = KeyError.Io(path, e);
    write_bytes(tmp, []).map_err(io)?;
    fs.set_mode(tmp, OWNER_ONLY).map_err(io)?;
    write_bytes(tmp, file).map_err(io)?;
    fs.sync(tmp).map_err(io)?;
    fs.rename(tmp, path).map_err(io)?;
    Ok(SecretKey { host: host, secret: secret, public_key: pk })
}

/**
 * Reads a secret key file, checking it's for `host` and that its public
 * key belongs to its secret.
 *
 * Example:
 *     read_secret(project.key?, project.host?)?
 */
fun read_secret(path: string, host: string): Result<SecretKey, KeyError> {
    let bytes = read_bytes(path).map_err(fun(e: string) = KeyError.Io(path, e))?;
    let bad = fun(why: string) = KeyError.Malformed(path, why);
    let v = decode(bytes, Limits {
        max_depth: 2,
        max_items: 16,
        max_bytes: 4096,
        max_string: 1024,
    }).map_err(fun(_) = bad("not CBOR"))?;
    if v.get("kind").map(fun(k: Value) = k.as_text().unwrap_or("")) != Some(KIND) {
        return Err(bad("not a secret key"));
    }
    let found = v.get("host").map(fun(h: Value) = h.as_text().unwrap_or("")).unwrap_or("");
    if found != host {
        return Err(KeyError.WrongHost(path, found, host));
    }
    let secret = v.get("secret").map(fun(s: Value) = s.as_bytes().unwrap_or([])).unwrap_or([]);
    let pk = v.get("public").map(fun(s: Value) = s.as_bytes().unwrap_or([])).unwrap_or([]);
    // The stored public key must be the secret's: a mismatched file would
    // sign with one key and advertise another.
    let derived = ed25519_public(secret).map_err(fun(_) = bad("its secret isn't an Ed25519 key"))?;
    if derived != pk {
        return Err(bad("its public key isn't its secret's"));
    }
    Ok(SecretKey { host: host, secret: secret, public_key: pk })
}

/**
 * Returns a public key's fingerprint: the first 8 bytes of its SHA-256, as
 * four groups of four hex digits.
 *
 * Example:
 *     fingerprint(key.public_key)
 */
fun fingerprint(key: u8[]): string {
    let h = hex(sha256(key)).slice(0, 16);
    [h.slice(0, 4), h.slice(4, 8), h.slice(8, 12), h.slice(12, 16)].join("-")
}

/**
 * Returns bytes as lowercase hex.
 *
 * Example:
 *     hex(sha256(file))
 */
fun hex(bytes: u8[]): string {
    let digits = "0123456789abcdef";
    let mut parts: string[] = [];
    for b of bytes {
        parts.push(
            digits.slice((b >> 4) as i64, (b >> 4) as i64 + 1) + digits.slice(
                (b & 15) as i64,
                (b & 15) as i64 + 1,
            ),
        );
    }
    parts.join("")
}

/**
 * Says whether `path` is inside the folder `dir` (both absolute), after
 * resolving `.` and `..`.
 *
 * Example:
 *     inside("/work/notes/k.key", "/work/notes")
 */
fun inside(path: string, dir: string): bool {
    let p = normal(path);
    let d = normal(dir);
    p == d || p.starts_with(d + "/")
}

/**
 * Returns a plain sentence for a key error.
 *
 * Example:
 *     reason(e)
 */
fun reason(e: KeyError): string = match e {
    Exists(p) => "{p} already exists: keygen never replaces a key",
    InsideProject(p) => "{p} is inside the project: keep secret keys outside it, so they're never committed or published",
    WrongHost(p, found, wanted) => "{p} is the key for {found}, not {wanted}",
    Malformed(p, why) => "{p} isn't a Rapidkoi secret key ({why})",
    Io(p, why) => "{p}: {why}",
    Crypto(why) => "the key couldn't be made: {why}",
};

/** A path with `.` and `..` resolved. */
fun normal(path: string): string {
    let mut kept: string[] = [];
    for part of path.split("/") {
        if part == "" || part == "." {
            continue;
        }
        if part == ".." {
            kept.pop();
        } else {
            kept.push(part);
        }
    }
    "/" + kept.join("/")
}

fun entry(key: string, v: Value): Entry = Entry { key: Value.Text(key), value: v };
