/**
 * What a publisher's site says about its app: the signed index (versions,
 * which is current, which are withdrawn, and a sequence that only goes up)
 * and the public key file (the key, and the trail of rotations each signed
 * by the key before). Signed as exact bytes and checked before decoding.
 * Pure apart from std.crypto.
 *
 * Depends on: std.crypto, cbor, trust.keys, bundles.rules
 * Used by: commands.publish, trust.verify
 */
import std.crypto { ed25519_sign, ed25519_verify, equal };
import cbor { Value, Entry, Limits, decode, encode };
import trust.keys { SecretKey };
import bundles.rules { check_version };

/** One published version. */
public struct Version {
    /** MAJOR.MINOR.PATCH. */
    public version: string,
    /** The SHA-256 of its `.rkb`: its file name on the site, and its id. */
    public sha256: u8[],
    /** The `.rkb`'s size in bytes. */
    public size: i64,
    /** Why the publisher withdrew it, if they did. */
    public withdrawn: Option<string>,
}

/** A site's list of versions. */
public struct Index {
    /** The app's host. */
    public host: string,
    /** Goes up by one with every change; Rapidkoi refuses a lower one than it has seen. */
    public sequence: i64,
    /** The version people get by default. */
    public current: string,
    /** Every listed version, oldest first. */
    public versions: Version[],
}

/** One planned key change, signed by the old key. */
public struct Rotation {
    /** The key before. */
    public old: u8[],
    /** The key after. */
    public new: u8[],
    /** `old`'s signature over the change. */
    public signature: u8[],
}

/** The public key file. */
public struct KeyFile {
    /** The app's host. */
    public host: string,
    /** The current public key. */
    public key: u8[],
    /** Planned changes, oldest first. */
    public rotations: Rotation[],
}

/** Why an index or key file was refused. */
public enum IndexError {
    /** Not readable: which file, why. */
    Unreadable(string, string),
    /** The signature doesn't check with the trusted key. */
    BadSignature,
    /** For another host: found, wanted. */
    WrongHost(string, string),
    /** A version name reused for other bytes. */
    Reused(string),
    /** A version that isn't MAJOR.MINOR.PATCH. */
    BadVersion(string),
    /** A version that isn't listed. */
    NoSuchVersion(string),
    /** A key change no signed trail explains. */
    Unapproved,
}

/**
 * Signs an index with the publisher's key.
 *
 * Example:
 *     write_bytes(path, sign_index(ix, key)?)
 */
public fun sign_index(ix: Index, key: SecretKey): Result<u8[], IndexError> {
    let body = encode(
        Value.Map([
            entry("host", Value.Text(ix.host)),
            entry("sequence", Value.int(ix.sequence)),
            entry("current", Value.Text(ix.current)),
            entry("versions", Value.Array(ix.versions.map(version_value))),
        ]),
    );
    let signature = ed25519_sign(key.secret, body).map_err(
        fun(e) = IndexError.Unreadable("index", e.message()),
    )?;
    Ok(
        encode(
            Value.Map([
                entry("format", Value.int(1)),
                entry("body", Value.Bytes(body)),
                entry("signature", Value.Bytes(signature)),
            ]),
        ),
    )
}

/**
 * Reads an index, checking its signature with `key` before reading it,
 * and that it's for `host`.
 *
 * @returns the index; or why not (unreadable, a bad signature, another host)
 *
 * Example:
 *     read_index(bytes, trusted_key, "notes.acme.com")?
 */
public fun read_index(bytes: u8[], key: u8[], host: string): Result<Index, IndexError> {
    let bad = fun(why: string) = IndexError.Unreadable("index", why);
    let root = decode(bytes, Limits {
        max_depth: 3,
        max_items: 16,
        max_bytes: 1024 * 1024,
        max_string: 1024 * 1024,
    }).map_err(fun(e) = bad("{e}"))?;
    let body = blob(root, "body").ok_or(bad("no body"))?;
    let signature = blob(root, "signature").ok_or(bad("no signature"))?;
    // Checked before anything in the body is read.
    if !ed25519_verify(key, body, signature) {
        return Err(IndexError.BadSignature);
    }
    let b = decode(body, Limits {
        max_depth: 4,
        max_items: 100_000,
        max_bytes: 1024 * 1024,
        max_string: 4096,
    }).map_err(fun(e) = bad("{e}"))?;
    let found = text(b, "host").ok_or(bad("no host"))?;
    if found != host {
        return Err(IndexError.WrongHost(found, host));
    }
    let mut versions: Version[] = [];
    for v of b.get("versions").map(fun(a: Value) = a.as_array().unwrap_or([])).unwrap_or([]) {
        versions.push(Version {
            version: text(v, "version").ok_or(bad("a version without a name"))?,
            sha256: blob(v, "sha256").ok_or(bad("a version without a hash"))?,
            size: v.get("size").map(fun(n: Value) = n.as_i64().unwrap_or(-1)).unwrap_or(-1),
            withdrawn: text(v, "withdrawn"),
        });
    }
    Ok(Index {
        host: found,
        sequence: b.get("sequence").map(fun(n: Value) = n.as_i64().unwrap_or(-1)).unwrap_or(-1),
        current: text(b, "current").unwrap_or(""),
        versions: versions,
    })
}

/**
 * Adds a published version and makes it current, bumping the sequence.
 * The same version with the same bytes again changes nothing.
 *
 * @returns the new index; `Err(Reused)` for a version name already used for other bytes
 *
 * Example:
 *     add(ix, "2.4.1", sha256(file), file.len)?
 */
public fun add(ix: Index, version: string, sha: u8[], size: i64): Result<Index, IndexError> {
    if check_version(version).is_err() {
        return Err(IndexError.BadVersion(version));
    }
    for v of ix.versions {
        if v.version == version {
            return if equal(v.sha256, sha) { Ok(ix) } else { Err(IndexError.Reused(version)) };
        }
    }
    let mut versions = ix.versions;
    versions.push(Version { version: version, sha256: sha, size: size, withdrawn: None });
    Ok(Index { sequence: ix.sequence + 1, current: version, versions: versions, ..ix })
}

/**
 * Keeps the newest `keep` versions, and always the current one and any
 * withdrawn one (people who have those must still be told).
 *
 * @returns the index (its sequence unchanged: pruning isn't news) and the
 *     hashes of the builds no longer listed, to delete
 *
 * Example:
 *     let (ix, gone) = prune(ix, 3);
 */
public fun prune(ix: Index, keep: i64): (Index, u8[][]) {
    let mut kept: Version[] = [];
    let mut removed: u8[][] = [];
    let mut i = 0;
    for v of ix.versions {
        let newest = i >= ix.versions.len - keep;
        if newest || v.version == ix.current || v.withdrawn.is_some() {
            kept.push(v);
        } else {
            removed.push(v.sha256);
        }
        i += 1;
    }
    (Index { versions: kept, ..ix }, removed)
}

/**
 * Marks a version withdrawn, with the reason people will see, bumping the sequence.
 *
 * Example:
 *     withdraw(ix, "2.3.0", "Security fix in 2.3.1")?
 */
public fun withdraw(ix: Index, version: string, why: string): Result<Index, IndexError> {
    if !ix.versions.any(fun(v: Version) = v.version == version) {
        return Err(IndexError.NoSuchVersion(version));
    }
    let versions = ix.versions.map(
        fun(v: Version) = if v.version == version {
            Version { withdrawn: Some(why), ..v }
        } else {
            v
        },
    );
    Ok(Index { sequence: ix.sequence + 1, versions: versions, ..ix })
}

/**
 * Encodes the public key file.
 *
 * Example:
 *     write_bytes(path, key_file(kf))
 */
public fun key_file(kf: KeyFile): u8[] = encode(
    Value.Map([
        entry("format", Value.int(1)),
        entry("host", Value.Text(kf.host)),
        entry("key", Value.Bytes(kf.key)),
        entry(
            "rotations",
            Value.Array(
                kf.rotations.map(
                    fun(r: Rotation) = Value.Map([
                        entry("old", Value.Bytes(r.old)),
                        entry("new", Value.Bytes(r.new)),
                        entry("signature", Value.Bytes(r.signature)),
                    ]),
                ),
            ),
        ),
    ]),
);

/**
 * Reads a public key file. It isn't signed itself: HTTPS (or, in
 * development, this machine) vouches for a first fetch, and each rotation
 * carries its own signature.
 *
 * Example:
 *     read_key_file(bytes)?
 */
public fun read_key_file(bytes: u8[]): Result<KeyFile, IndexError> {
    let bad = fun(why: string) = IndexError.Unreadable("key file", why);
    let v = decode(bytes, Limits {
        max_depth: 4,
        max_items: 4096,
        max_bytes: 256 * 1024,
        max_string: 1024,
    }).map_err(fun(e) = bad("{e}"))?;
    let mut rotations: Rotation[] = [];
    for r of v.get("rotations").map(fun(a: Value) = a.as_array().unwrap_or([])).unwrap_or([]) {
        rotations.push(Rotation {
            old: blob(r, "old").ok_or(bad("a rotation without its old key"))?,
            new: blob(r, "new").ok_or(bad("a rotation without its new key"))?,
            signature: blob(r, "signature").ok_or(bad("an unsigned rotation"))?,
        });
    }
    Ok(KeyFile {
        host: text(v, "host").ok_or(bad("no host"))?,
        key: blob(v, "key").ok_or(bad("no key"))?,
        rotations: rotations,
    })
}

/**
 * Signs a planned change from `old` to the public key `new`.
 *
 * Example:
 *     rotate(old_key, new_key.public_key)?
 */
public fun rotate(old: SecretKey, new: u8[]): Result<Rotation, IndexError> {
    let signature = ed25519_sign(old.secret, change(old.host, old.public_key, new)).map_err(
        fun(e) = IndexError.Unreadable("key", e.message()),
    )?;
    Ok(Rotation { old: old.public_key, new: new, signature: signature })
}

/**
 * Follows a key file's rotations from a trusted key: each step must be
 * signed by the key before it.
 *
 * @param trusted the key Rapidkoi trusts for this host
 * @returns the file's current key when a signed trail leads to it;
 *     `Err(Unapproved)` otherwise
 *
 * Example:
 *     follow(trusted, read_key_file(bytes)?)?
 */
public fun follow(trusted: u8[], kf: KeyFile): Result<u8[], IndexError> {
    let mut at = trusted;
    // Each step moves forward along the trail; at most one pass per rotation.
    for _ of kf.rotations {
        if equal(at, kf.key) {
            break;
        }
        let mut moved = false;
        for r of kf.rotations {
            if !moved && equal(r.old, at) && ed25519_verify(
                r.old,
                change(kf.host, r.old, r.new),
                r.signature,
            ) {
                at = r.new;
                moved = true;
            }
        }
        if !moved {
            break;
        }
    }
    if equal(at, kf.key) { Ok(kf.key) } else { Err(IndexError.Unapproved) }
}

/**
 * Returns a plain sentence for an index or key file error.
 *
 * Example:
 *     reason(e)
 */
public fun reason(e: IndexError): string = match e {
    Unreadable(what, why) => "The app's {what} can't be read ({why})",
    BadSignature => "The app's index isn't signed by its publisher's key",
    WrongHost(found, wanted) => "The app's index is for {found}, not {wanted}",
    Reused(v) => "Version {v} is already published with different bytes",
    BadVersion(v) => "{v} isn't a version: use MAJOR.MINOR.PATCH, like 1.4.0",
    NoSuchVersion(v) => "There's no version {v} to withdraw",
    Unapproved => "The app's key changed without its old key's approval",
};

/** What a rotation signs: the host and both keys, as CBOR. */
fun change(host: string, old: u8[], new: u8[]): u8[] = encode(
    Value.Map([
        entry("host", Value.Text(host)),
        entry("old", Value.Bytes(old)),
        entry("new", Value.Bytes(new)),
    ]),
);

fun version_value(v: Version): Value {
    let mut fields = [
        entry("version", Value.Text(v.version)),
        entry("sha256", Value.Bytes(v.sha256)),
        entry("size", Value.int(v.size)),
    ];
    if let Some(w) = v.withdrawn {
        fields.push(entry("withdrawn", Value.Text(w)));
    }
    Value.Map(fields)
}

fun entry(key: string, v: Value): Entry = Entry { key: Value.Text(key), value: v };

fun text(v: Value, field: string): Option<string> = match v.get(field) {
    Some(Text(s)) => Some(s),
    _ => None,
};

fun blob(v: Value, field: string): Option<u8[]> = match v.get(field) {
    Some(Bytes(b)) => Some(b),
    _ => None,
};
