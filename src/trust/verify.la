/**
 * Opening a signed site: fetch its key file, its index and the current
 * build, and check each before the next, failing closed: the key (first
 * use, or a rotation trail signed by the key trusted before), the index
 * (signature, host, a sequence never lower than one seen, a current version
 * that isn't withdrawn), then the build (size, hash, signature, key, host).
 * Nothing here runs an app, and there is no way past a failed check.
 *
 * Trust is host → key and the highest sequence seen, kept in a `Keyring`
 * the window holds; `saving` keeps it on disk across restarts (PRP-007).
 *
 * Depends on: std.crypto, std.time, trust.index, bundles.signing, trust.keys, bundles.rules
 * Used by: bundles.loader, window.tabs, ui.frame, panel
 */
import std.crypto { sha256, equal };
import std.time;
import trust.index {
    Version,
    IndexError,
    read_index,
    read_key_file,
    follow,
    reason as index_reason,
};
import bundles.signing { Opened, Signed, read_any };
import trust.keys { fingerprint, hex };
import bundles.rules { BundleError, reason as bundle_reason };

/** How far Rapidkoi trusts where an app came from. */
enum Standing {
    /** Its site's key, index and build all checked out (development: this machine). */
    Verified,
    /** A signed file whose key is trusted for its host this session. */
    Trusted,
    /** A signed file whose key Rapidkoi hasn't met: it runs as a stranger. */
    NotConfirmed,
}

/** What Rapidkoi knows about a signed app's publisher, for the marker and About. */
struct Trust {
    /** The app's host. */
    host: string,
    /** The publisher's public key. */
    key: u8[],
    /** How it was trusted. */
    standing: Standing,
    /** The SHA-256 of the `.rkb` that's running. */
    build: u8[],
    /** Whether this is a second publisher for the host, opened as a separate app. */
    separate: bool,
    /** When its key was first trusted, in ms since 1970; 0 when not recorded or not trusted. */
    since: i64,
    /** The key first trusted for this app, kept through signed rotations: who the app is (PRP-011). */
    origin: u8[],
}

/** A key change no signed trail explains: what the person is asked about. */
struct Change {
    /** The host. */
    host: string,
    /** The key trusted before. */
    old: u8[],
    /** The key the site has now. */
    new: u8[],
}

/** Why a site couldn't be verified. */
enum VerifyError {
    /** No key file (a 404): an unsigned development server. */
    Unsigned,
    /** A file couldn't be fetched: which, why. */
    Fetch(string, string),
    /** The key file or index was refused. */
    Index(IndexError),
    /** The key file is for another host: found, wanted. */
    WrongHost(string, string),
    /** The key changed without approval. */
    Unapproved(Change),
    /** An older index than one already seen: got, seen. */
    Older(i64, i64),
    /** The index's current version isn't listed. */
    NoCurrent(string),
    /** The current version was withdrawn: version, the publisher's reason. */
    Withdrawn(string, string),
    /** The build's size differs from the index's. */
    Size,
    /** The build's hash differs from the index's. */
    Hash,
    /** The build itself was refused. */
    Build(BundleError),
    /** The build isn't signed, or not by the site's key. */
    BuildKey,
    /** The build names another host. */
    BuildHost(string),
}

/** One identity Rapidkoi trusts: a host, its key, and how far its index got. */
struct Identity {
    /** The host. */
    host: string,
    /** Its 32-byte public key. */
    key: u8[],
    /** The highest index sequence seen for it. */
    sequence: i64,
    /** Whether it's a second publisher for the host, opened as a separate app. */
    separate: bool,
    /** When it was first trusted, in milliseconds since 1970; 0 when not recorded (format 1). */
    since: i64,
    /** The key first trusted for this app, kept through signed rotations: who the app is (PRP-011). */
    origin: u8[],
    /** The name the person gave a separate app before opening it (PRP-049); `None` uses its manifest's. */
    name: Option<string>,
}

/** The keys trusted this session, shared by every copy (it's a box). */
struct Keyring {
    known: Ref<Identity[]>,
    /** How many times trust was recorded: a save is due when it moves. */
    count: Ref<i64>,
    /** Rotations followed (host, old key, new key), oldest first: state moves with them. */
    moved: Ref<(string, u8[], u8[])[]>,
}

/** A verified site's current build. */
struct Verified {
    /** The build's checked contents. */
    opened: Opened,
    /** Who signed it. */
    trust: Trust,
}

/** Where a site keeps Rapidkoi's files. */
const SITE: string = "/.well-known/rapidkoi";

/**
 * An empty keyring, for a new session.
 *
 * Example:
 *     let ring = keyring();
 */
fun keyring(): Keyring = keyring_of([]);

/**
 * A keyring trusting `ids`: what was saved.
 *
 * Example:
 *     keyring_of(read_trust(bytes)?)
 */
fun keyring_of(ids: Identity[]): Keyring = Keyring {
    known: Ref.new(ids),
    count: Ref.new(0),
    moved: Ref.new([]),
};

/**
 * Returns the identities a keyring trusts, to save.
 *
 * Example:
 *     trust_file(identities(ring))
 */
fun identities(ring: Keyring): Identity[] = ring.known.get();

/**
 * Returns the rotations this keyring followed (host, old key, new key),
 * oldest first: compare lengths to find the new ones.
 *
 * Example:
 *     moves(ring)
 */
fun moves(ring: Keyring): (string, u8[], u8[])[] = ring.moved.get();

/**
 * Returns how many times trust was recorded in this keyring: compare two
 * readings to know whether there's anything new to save.
 *
 * Example:
 *     if changes(ring) != before { save(…) }
 */
fun changes(ring: Keyring): i64 = ring.count.get();

/** What a check found to trust: recorded with `record` when it's used. */
struct Record {
    /** The identity it was checked as (the one it replaces); none on first use. */
    from: Option<Identity>,
    /** The identity to trust now: its key and the sequence reached. */
    now: Identity,
}

/**
 * Verifies a site and returns its current build, checked, recording trust
 * once everything passed: `check_site` then `record`.
 *
 * @param ring this session's keyring
 * @param host the address's host, `localhost:8000` in development
 * @param get fetches a path on the site, as (status, body)
 * @returns the build and its trust; or the first check that failed
 *
 * Example:
 *     verify_site(ring, "localhost:8000", fetcher)?
 */
fun verify_site(
    ring: Keyring,
    host: string,
    get: fun(string): Result<(i64, u8[]), string>,
): Result<Verified, VerifyError> {
    let (v, r) = check_site(known_for(ring, host), host, get)?;
    record(ring, r);
    Ok(v)
}

/**
 * Returns the identities trusted for a host: a snapshot, plain data, to
 * check a site against away from the keyring (in a background task).
 *
 * Example:
 *     known_for(ring, "localhost:8000")
 */
fun known_for(ring: Keyring, host: string): Identity[] = ring.known.get().filter(
    fun(k: Identity) = k.host == host,
);

/**
 * Records what a check found: a first use, a higher sequence or a
 * rotation (moving the state with it). Nothing new records nothing.
 *
 * Example:
 *     record(ring, r)
 */
fun record(ring: Keyring, r: Record) = remember(ring, r.from, r.now);

/**
 * Verifies a site against a snapshot of the identities trusted for its
 * host, recording nothing: the same checks, in the same order, as
 * `verify_site`. Safe to run in a background task.
 *
 * @param known_all the identities trusted for `host` (`known_for`; others are ignored)
 * @returns the build and its trust, and what to record; or the first check that failed
 *
 * Example:
 *     check_site(known_for(ring, host), host, fetcher)?
 */
fun check_site(
    known_all: Identity[],
    host: string,
    get: fun(string): Result<(i64, u8[]), string>,
): Result<(Verified, Record), VerifyError> = check_site_at(known_all, host, get, None);

/**
 * Verifies a site as `check_site` does, at the version a link names
 * (PRP-036): that build while the index still lists it, refused if it was
 * withdrawn; the current one when it's no longer listed.
 *
 * @param wanted the link's version, if it names one
 * @returns the build and its trust, and what to record; or the first check that failed
 *
 * Example:
 *     check_site_at(known_for(ring, host), host, fetcher, Some("1.4.0"))?
 */
fun check_site_at(
    known_all: Identity[],
    host: string,
    get: fun(string): Result<(i64, u8[]), string>,
    wanted: Option<string>,
): Result<(Verified, Record), VerifyError> {
    // 1. The key.
    let fetched = get("{SITE}/key");
    let kf_bytes = match fetched {
        Ok((404, _)) => {
            return Err(VerifyError.Unsigned);
        }
        _ => body("key file", fetched)?,
    };
    let kf = read_key_file(kf_bytes).map_err(VerifyError.Index)?;
    if kf.host != host {
        return Err(VerifyError.WrongHost(kf.host, host));
    }
    let known = known_all.filter(fun(k: Identity) = k.host == host);
    // The identity this site is checked as: the known key it matches or a
    // signed trail leads from; none on first use.
    let from = match first(known, fun(k: Identity) = equal(k.key, kf.key)) {
        Some(k) => Some(k),
        None => first(known, fun(k: Identity) = follow(k.key, kf).is_ok()),
    };
    if known.len > 0 && from.is_none() {
        return Err(VerifyError.Unapproved(Change { host: host, old: known[0].key, new: kf.key }));
    }
    let key = kf.key;
    let seen = from.map(fun(k: Identity) = k.sequence).unwrap_or(0);
    let separate = from.map(fun(k: Identity) = k.separate).unwrap_or(false);
    // 2. The index, signed by that key.
    let ix = read_index(body("index", get("{SITE}/index"))?, key, host).map_err(VerifyError.Index)?;
    if ix.sequence < seen {
        return Err(VerifyError.Older(ix.sequence, seen));
    }
    let listed = wanted.and_then(
        fun(w: string) = first(ix.versions, fun(v: Version) = v.version == w),
    );
    let v = match listed {
        Some(v) => v,
        None => first(ix.versions, fun(v: Version) = v.version == ix.current).ok_or(
            VerifyError.NoCurrent(ix.current),
        )?,
    };
    if let Some(why) = v.withdrawn {
        return Err(VerifyError.Withdrawn(v.version, why));
    }
    // 3. The build that index names.
    let bytes = body("build", get("{SITE}/builds/{hex(v.sha256)}.rkb"))?;
    if bytes.len != v.size {
        return Err(VerifyError.Size);
    }
    if !equal(sha256(bytes), v.sha256) {
        return Err(VerifyError.Hash);
    }
    let opened = read_any(bytes).map_err(VerifyError.Build)?;
    let s = opened.signed.ok_or(VerifyError.BuildKey)?;
    if !equal(s.key, key) {
        return Err(VerifyError.BuildKey);
    }
    if s.host != host {
        return Err(VerifyError.BuildHost(s.host));
    }
    // Everything passed: what to remember is the key and how far the sequence got.
    let r = Record {
        from: from,
        // A rotation or a higher sequence keeps the first use's date.
        now: Identity {
            host: host,
            key: key,
            sequence: ix.sequence,
            separate: separate,
            since: from.map(fun(k: Identity) = k.since).unwrap_or(time.now_ms()),
            // A rotation keeps who the app is, and its name; a first use starts it here.
            origin: from.map(fun(k: Identity) = k.origin).unwrap_or(key),
            // The person's name for it, else its own, for "Which app?" (PRP-049).
            name: match from.and_then(fun(k: Identity) = k.name) {
                Some(n) => Some(n),
                None => named(opened.bundle.manifest.name),
            },
        },
    };
    Ok(
        (
            Verified {
                opened: opened,
                trust: Trust {
                    host: host,
                    key: key,
                    standing: Standing.Verified,
                    build: s.hash,
                    separate: separate,
                    since: r.now.since,
                    origin: r.now.origin,
                },
            },
            r,
        ),
    )
}

/**
 * Trusts a site's new key as a separate app ("Open as a separate app"),
 * under the name the person gave it (PRP-049): the old key stays trusted
 * too, as another app.
 *
 * Example:
 *     separate(ring, change, "Bob's Notes")
 */
fun separate(ring: Keyring, c: Change, name: string) {
    ring.known.update(fun(all: Identity[]) {
        let mut next = all;
        next.push(Identity {
            host: c.host,
            key: c.new,
            sequence: 0,
            separate: true,
            since: time.now_ms(),
            origin: c.new,
            name: Some(name),
        });
        next
    });
    ring.count.update(fun(n: i64) = n + 1);
}

/**
 * Says how far a signed file is trusted: `Trusted` when its key is trusted
 * for its host this session, `NotConfirmed` otherwise. It never adds trust.
 *
 * Example:
 *     standing_of(ring, opened.signed?)
 */
fun standing_of(ring: Keyring, s: Signed): Trust {
    let found = first(ring.known.get(), fun(k: Identity) = k.host == s.host && equal(k.key, s.key));
    Trust {
        host: s.host,
        key: s.key,
        standing: if found.is_some() { Standing.Trusted } else { Standing.NotConfirmed },
        build: s.hash,
        separate: found.map(fun(k: Identity) = k.separate).unwrap_or(false),
        since: found.map(fun(k: Identity) = k.since).unwrap_or(0),
        // A key Rapidkoi hasn't met is its own app: never a trusted publisher's.
        origin: found.map(fun(k: Identity) = k.origin).unwrap_or(s.key),
    }
}

/**
 * Returns a plain sentence for a verify error.
 *
 * Example:
 *     reason(e)
 */
fun reason(e: VerifyError): string = match e {
    Unsigned => "The site has no key: it isn't signed",
    Fetch(what, why) => "The app's {what} couldn't be fetched ({why})",
    Index(i) => index_reason(i),
    WrongHost(found, wanted) => "The app's key file is for {found}, not {wanted}",
    Unapproved(c) => "{c.host} is now signed by a different key",
    Older(got, seen) => "The site sent an older index than one already seen (sequence {got}, after {seen})",
    NoCurrent(v) => "The app's index names {v} as current but doesn't list it",
    Withdrawn(v, why) => "Version {v} was withdrawn by its publisher: {why}",
    Size => "The app's build isn't the size its index says",
    Hash => "The app's build doesn't match its index's hash",
    Build(b) => bundle_reason(b),
    BuildKey => "The app's build isn't signed by its site's key",
    BuildHost(h) => "The app's build is for {h}, not this site",
};

/** An app's own name, kept with its identity when it's one a person could have given (PRP-049). */
fun named(name: string): Option<string> = if name != "" && name.char_count() <= 64 {
    Some(name)
} else {
    None
};

/** Records an identity, in place of the one it was checked as (after a rotation, its old key). */
fun remember(ring: Keyring, from: Option<Identity>, now: Identity) {
    // Nothing new (the same key at the same sequence): nothing to save.
    if let Some(f) = from {
        if f.host == now.host && equal(
            f.key,
            now.key,
        ) && f.sequence == now.sequence && f.separate == now.separate && f.name == now.name {
            return;
        }
    }
    ring.count.update(fun(n: i64) = n + 1);
    if let Some(f) = from {
        if !equal(f.key, now.key) {
            ring.moved.update(fun(all: (string, u8[], u8[])[]) {
                let mut next = all;
                next.push((now.host, f.key, now.key));
                next
            });
        }
    }
    ring.known.update(fun(all: Identity[]) {
        let mut next: Identity[] = [];
        for k of all {
            let replaced = match from {
                Some(f) => k.host == f.host && equal(k.key, f.key) && k.separate == f.separate,
                None => false,
            };
            if !replaced {
                next.push(k);
            }
        }
        next.push(now);
        next
    });
}

/** A 200 response's body, or why not. */
fun body(what: string, r: Result<(i64, u8[]), string>): Result<u8[], VerifyError> = match r {
    Ok((200, b)) => Ok(b),
    Ok((status, _)) => Err(VerifyError.Fetch(what, "the server answered {status}")),
    Err(why) => Err(VerifyError.Fetch(what, why)),
};

fun first<T>(xs: T[], f: fun(T): bool): Option<T> {
    for x of xs {
        if f(x) {
            return Some(x);
        }
    }
    None
}
