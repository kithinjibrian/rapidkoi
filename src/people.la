/**
 * The people file (PRP-011): how you sign in to each signed app (how many
 * times you started over, whether it signs you in automatically, whether
 * you signed out) and the name apps may show with `{FIRST_NAME}` and
 * `{LAST_NAME}`: one for every app, and optionally one per app. Format 2
 * (PRP-012) adds each app's switched-off servers and the servers you've
 * been shown. Read as hostile input; saved by `saving` as it changes.
 *
 * Depends on: cbor, std.crypto, remembered, rules, network, limits
 * Used by: effects, account, saving, render
 */
import cbor { Value, Entry, Limits, decode, encode };
import std.crypto { equal };
import remembered { Unreadable };
import rules { check_host };
import network { check_server };
import limits { MAX_SERVERS };

/** The longest name part, in characters. */
public const MAX_NAME: i64 = 64;

/** The most apps the file holds. */
public const MAX_PEOPLE: i64 = 10_000;

/** The file's cap in bytes. */
public const MAX_PEOPLE_FILE: i64 = 4 * 1024 * 1024;

/** You, to one app. */
public struct Person {
    /** The app's host. */
    public host: string,
    /** The key first trusted for the app (its identity, kept through rotations). */
    public origin: u8[],
    /** How many times you started over with it: a new key each time. */
    public generation: i64,
    /** Whether it signs you in when it asks (on by default). */
    public auto: bool,
    /** Whether you signed out of it. */
    public signed_out: bool,
    /** Your first name in this app only; "" uses the one for every app. */
    public first: string,
    /** Your last name in this app only; "" uses the one for every app. */
    public last: string,
    /** The servers you switched off for it, its own host included (PRP-012). */
    public off: string[],
    /** The servers it declared when you last saw its Access page, or first opened it. */
    public seen: string[],
}

/** Everything in the people file. */
public struct People {
    /** Your first name for every app ("" for none). */
    public first: string,
    /** Your last name for every app ("" for none). */
    public last: string,
    /** The apps you've signed in to or changed settings for. */
    public apps: Person[],
}

/**
 * Nobody yet: no name, no apps.
 *
 * Example:
 *     nobody()
 */
public fun nobody(): People = People { first: "", last: "", apps: [] };

/**
 * Returns you to one app: its saved settings, or the defaults (generation
 * 0, signed in automatically, no name of its own).
 *
 * Example:
 *     person(people, host, origin)
 */
public fun person(p: People, host: string, origin: u8[]): Person {
    for x of p.apps {
        if x.host == host && equal(x.origin, origin) {
            return x;
        }
    }
    Person {
        host: host,
        origin: origin,
        generation: 0,
        auto: true,
        signed_out: false,
        first: "",
        last: "",
        off: [],
        seen: [],
    }
}

/**
 * Says whether an app has settings saved: false until its first open,
 * when what it declares is seen without a notice.
 *
 * Example:
 *     known(people, host, origin)
 */
public fun known(p: People, host: string, origin: u8[]): bool = p.apps.any(
    fun(x: Person) = x.host == host && equal(x.origin, origin),
);

/**
 * Saves one app's settings in place of its old ones.
 *
 * Example:
 *     with_person(people, Person { auto: false, ..person(people, host, origin) })
 */
public fun with_person(p: People, x: Person): People {
    let mut apps = forget_person(p, x.host, x.origin).apps;
    apps.push(x);
    People { apps: apps, ..p }
}

/**
 * Removes one app's settings (Forget this app).
 *
 * Example:
 *     forget_person(people, host, origin)
 */
public fun forget_person(p: People, host: string, origin: u8[]): People = People {
    apps: p.apps.filter(fun(x: Person) = !(x.host == host && equal(x.origin, origin))),
    ..p,
};

/**
 * Returns the name an app may show, first and last: its own where set,
 * else the one for every app; "" where neither is.
 *
 * Example:
 *     name_in(people, host, origin)
 */
public fun name_in(p: People, host: string, origin: u8[]): (string, string) {
    let x = person(p, host, origin);
    (if x.first != "" { x.first } else { p.first }, if x.last != "" { x.last } else { p.last })
}

/**
 * Encodes the people file.
 *
 * Example:
 *     save(s, "people", people_file(people))?
 */
public fun people_file(p: People): u8[] = encode(
    Value.Map([
        entry("format", Value.int(2)),
        entry("kind", Value.Text("rapidkoi people")),
        entry("first", Value.Text(p.first)),
        entry("last", Value.Text(p.last)),
        entry(
            "apps",
            Value.Array(
                p.apps.map(
                    fun(x: Person) = Value.Map([
                        entry("host", Value.Text(x.host)),
                        entry("origin", Value.Bytes(x.origin)),
                        entry("generation", Value.int(x.generation)),
                        entry("auto", Value.Bool(x.auto)),
                        entry("signed_out", Value.Bool(x.signed_out)),
                        entry("first", Value.Text(x.first)),
                        entry("last", Value.Text(x.last)),
                        entry("off", names(x.off)),
                        entry("seen", names(x.seen)),
                    ]),
                ),
            ),
        ),
    ]),
);

/**
 * Reads the people file: every host a host name, every origin 32 bytes,
 * every name at most `MAX_NAME` characters.
 *
 * Example:
 *     read_people(bytes)?
 */
public fun read_people(bytes: u8[]): Result<People, Unreadable> {
    let bad = fun(why: string) = Unreadable.Broken(why);
    let v = decode(bytes, Limits {
        max_depth: 5,
        max_items: 16 * MAX_PEOPLE + 64,
        max_bytes: MAX_PEOPLE_FILE,
        max_string: 4096,
    }).map_err(fun(e) = bad("not CBOR ({e})"))?;
    if v.as_map().is_none() || text(v, "kind") != Some("rapidkoi people") {
        return Err(bad("it isn't Rapidkoi's people file"));
    }
    let format = whole(v, "format");
    if format > 2 {
        return Err(Unreadable.Newer(format));
    }
    if format < 1 {
        return Err(bad("it isn't Rapidkoi's people file"));
    }
    let first = name(v, "first")?;
    let last = name(v, "last")?;
    let items = match v.get("apps") {
        Some(Array(xs)) => xs,
        _ => {
            return Err(bad("its apps aren't a list"));
        }
    };
    if items.len > MAX_PEOPLE {
        return Err(bad("it has more than 10,000 apps"));
    }
    let mut apps: Person[] = [];
    for x of items {
        let host = text(x, "host").unwrap_or("");
        if check_host(host).is_err() {
            return Err(bad("an app's host isn't a host name"));
        }
        let origin = match x.get("origin") {
            Some(Bytes(b)) if b.len == 32 => b,
            _ => {
                return Err(bad("an app's origin key isn't 32 bytes"));
            }
        };
        let generation = whole(x, "generation");
        if generation < 0 {
            return Err(bad("an app's generation isn't a whole number"));
        }
        apps.push(Person {
            host: host,
            origin: origin,
            generation: generation,
            auto: flag(x, "auto").ok_or(bad("an app's auto isn't true or false"))?,
            signed_out: flag(x, "signed_out").ok_or(
                bad("an app's signed_out isn't true or false"),
            )?,
            first: name(x, "first")?,
            last: name(x, "last")?,
            off: servers(x, "off", format)?,
            seen: servers(x, "seen", format)?,
        });
    }
    Ok(People { first: first, last: last, apps: apps })
}

/**
 * A list of server names (format 2; none in format 1): at most one more
 * than a manifest may declare, since the own host can be switched off too.
 */
fun servers(v: Value, field: string, format: i64): Result<string[], Unreadable> {
    if format < 2 {
        return Ok([]);
    }
    let bad = Unreadable.Broken("an app's servers aren't server names");
    let items = match v.get(field) {
        Some(Array(xs)) if xs.len <= MAX_SERVERS + 1 => xs,
        _ => {
            return Err(bad);
        }
    };
    let mut out: string[] = [];
    for item of items {
        match item {
            Text(s) if check_server(s).is_ok() => out.push(s),
            _ => {
                return Err(bad);
            }
        }
    }
    Ok(out)
}

fun names(xs: string[]): Value = Value.Array(xs.map(fun(x: string) = Value.Text(x)));

/** A name part: text of at most `MAX_NAME` characters. */
fun name(v: Value, field: string): Result<string, Unreadable> {
    let s = text(v, field).ok_or(Unreadable.Broken("a name isn't text"))?;
    let mut count = 0;
    for _ of s.chars() {
        count += 1;
    }
    if count > MAX_NAME {
        return Err(Unreadable.Broken("a name is longer than 64 characters"));
    }
    Ok(s)
}

fun flag(v: Value, field: string): Option<bool> = match v.get(field) {
    Some(Bool(b)) => Some(b),
    _ => None,
};

fun whole(v: Value, field: string): i64 = v.get(field).map(
    fun(n: Value) = n.as_i64().unwrap_or(-1),
).unwrap_or(-1);

fun text(v: Value, field: string): Option<string> = match v.get(field) {
    Some(Text(s)) => Some(s),
    _ => None,
};

fun entry(key: string, v: Value): Entry = Entry { key: Value.Text(key), value: v };
