/**
 * The shell's kivuli app: one guest, its state and its decoded screen, or
 * the error screen. `update` calls the guest (fuel bounds every call:
 * CLAUDE.md architecture rule 3); `view` only renders what's stored.
 *
 * Depends on: kivuli, wasmtime, guest, contract, render, theme
 * Used by: main
 */
import kivuli { View };
import cbor { Value };
import wasmtime { Engine, Module };
import guest { Guest, compile, open, reason };
import contract { Node, ContractError, read_tree, read_update, envelope };
import render { Msg, screen, stopped };
import theme { SPACE_LG, WINDOW_WIDTH, WINDOW_HEIGHT };

/** What the window shows. */
public enum Screen {
    /** The guest, its state, and its decoded screen. */
    Running(Guest, u8[], Node),
    /** Why the app isn't running, and whether Restart can help. */
    Stopped(string, bool),
}

/** The compiled app, kept so Restart can start it again. */
public struct Program {
    engine: Engine,
    module: Module,
}

/** The shell's model. */
public struct Model {
    /** The window title. */
    public title: string,
    /** The app, when one loaded. */
    program: Option<Program>,
    /** What's on screen. */
    public screen: Screen,
}

/**
 * Builds the first model from the command line: `./main path/to/app.wasm`.
 *
 * @param argv the program's arguments, `argv[0]` its path
 * @returns a running app, or the error screen saying why not (no Restart)
 *
 * Example:
 *     sandbox("app.rapidkoi.shell", boot(args()), update, view)
 */
public fun boot(argv: string[]): Model {
    if argv.len < 2 {
        return failed("Rapidkoi", "Open an app: ./main path/to/app.wasm");
    }
    let path = argv[1];
    let parts = path.split("/");
    let title = "Rapidkoi — {parts[parts.len - 1]}";
    let bytes = match read_bytes(path) {
        Ok(b) => b,
        Err(e) => {
            return failed(title, "Couldn't read {path}: {e}");
        }
    };
    let engine = Engine.new();
    match compile(engine, bytes) {
        Ok(module) => launch(title, engine, module),
        Err(e) => failed(title, reason(e)),
    }
}

/**
 * Starts a compiled app.
 *
 * @param title the window title
 * @param engine the engine `module` was compiled with
 * @param module the app
 * @returns the model: running, or stopped with Restart offered
 *
 * Example:
 *     launch("Rapidkoi — counter.wasm", engine, module)
 */
public fun launch(title: string, engine: Engine, module: Module): Model {
    let program = Program { engine: engine, module: module };
    Model { title: title, program: Some(program), screen: start(program) }
}

/**
 * Handles one message: an event goes to the guest, Restart starts afresh.
 *
 * @param m the model
 * @param msg what the window sent
 * @returns the next model; any guest or contract failure stops the app
 *
 * Example:
 *     update(m, Msg.Restart)
 */
public fun update(m: Model, msg: Msg): Model = match (m.screen, msg) {
    (Running(g, state, _), Event(value, text)) => Model {
        screen: step(g, state, value, text),
        ..m,
    },
    // An event can only come from the guest's screen; once stopped, ignore it.
    (Stopped(_, _), Event(_, _)) => m,
    (_, Restart) => {
        if let Running(g, _, _) = m.screen {
            g.close();
        }
        match m.program {
            Some(p) => Model { screen: start(p), ..m },
            None => m,
        }
    }
};

/**
 * Renders the model: the guest's screen or the error screen, in the window.
 *
 * @param m the model
 * @returns the window's view; never calls the guest
 *
 * Example:
 *     view(m)
 */
public fun view(m: Model): View<Msg> {
    let content = match m.screen {
        Running(_, _, tree) => screen(tree),
        Stopped(why, can_restart) => stopped(why, can_restart),
    };
    content.padding(SPACE_LG).window(m.title, WINDOW_WIDTH, WINDOW_HEIGHT)
}

fun failed(title: string, why: string): Model = Model {
    title: title,
    program: None,
    screen: Screen.Stopped(why, false),
};

/** Opens the guest in a fresh store, then `init` and `view`. */
fun start(p: Program): Screen = match open(p.engine, p.module) {
    Err(e) => Screen.Stopped(reason(e), true),
    Ok(g) => match g.init() {
        Err(e) => halt(g, reason(e)),
        Ok(state) => show(g, state),
    },
};

/** Sends one event to the guest's `update`, then renders the new state. */
fun step(g: Guest, state: u8[], msg: Value, text: Option<string>): Screen = match g.update(
    state,
    envelope(msg, text),
) {
    Err(e) => halt(g, reason(e)),
    Ok(bytes) => match read_update(bytes) {
        Err(e) => halt(g, broken("update result", e)),
        Ok(next) => show(g, next),
    },
};

/** Calls `view(state)` and decodes the screen. */
fun show(g: Guest, state: u8[]): Screen = match g.view(state) {
    Err(e) => halt(g, reason(e)),
    Ok(bytes) => match read_tree(bytes) {
        Err(e) => halt(g, broken("screen description", e)),
        Ok(tree) => Screen.Running(g, state, tree),
    },
};

/** Stops the guest: frees its store and keeps why. */
fun halt(g: Guest, why: string): Screen {
    g.close();
    Screen.Stopped(why, true)
}

fun broken(what: string, e: ContractError): string = match e {
    Invalid(path, problem) => "This app's {what} is broken ({path}: {problem})",
    TooLong(_, n) => "This app's {what} is too large ({n} bytes)",
    Decode(d) => "This app's {what} is broken (bad CBOR: {d})",
};
