/**
 * Loading an app: from a local file the person chose (a `.rkb` bundle,
 * signed or not, or a bare `.wasm`) or a local development address. A
 * signed site is verified first (`verify`), and a failed check never
 * loads. A signed file says how far its key is trusted. Never runs it.
 * Its stages are the app pipeline's first three (PRP-069, `boot.appboot`):
 * `checked_file`, `checked_bytes` and `checked_fetched` (Source and
 * Checked), then `compiled_with` (Compiled); `load`, `from_bytes` and
 * `from_fetched` are them chained, compiling plainly (tests).
 *
 * Depends on: wasmtime, std.http, guest.guest, bundles.bundle, bundles.signing, trust.verify, trust.publishers, net.fetching, net.address, guest.limits
 * Used by: boot.appboot, window.tabs, net.loads
 */
import trust.publishers { known_of };
import wasmtime { Engine, Module };
import guest.guest { GuestError, compile, reason, OLDER };
import bundles.bundle { Manifest, asset };
import bundles.rules { reason as bundle_reason };
import bundles.signing { Opened, read_any };
import trust.verify {
    Trust,
    Change,
    Keyring,
    VerifyError,
    known_for,
    record,
    standing_of,
    reason as verify_reason,
};
import net.fetching { Fetched, fetch_app };
import net.dialing { Network };
import net.address { Address, is_address, parse, url, shown };
import guest.limits { MAX_BUNDLE, FETCH_TIMEOUT_MS, CONTRACT_VERSION };
import bundles.permissions { Tier, PermissionError, parse as parse_permissions, tier_of, words_of };
import std.http { Limits };

/** An app ready to start: what to call it, its manifest if it has one, and its compiled module. */
struct Loaded {
    /** The manifest's name, or the file's name without `.wasm`. */
    name: string,
    /** The bundle's manifest; `None` for a bare `.wasm`. */
    manifest: Option<Manifest>,
    /** The icon's PNG bytes, checked by the bundle rules; `None` without one. */
    icon: Option<u8[]>,
    /** The compiled module. */
    module: Module,
    /** Its bundle's pictures by name, checked by the bundle rules (PRP-047); none for a bare `.wasm`. */
    assets: (string, u8[])[],
    /** Who signed it and how far that's trusted; `None` when unsigned. */
    trust: Option<Trust>,
}

/**
 * Where an app's bytes came from (PRP-030): only bytes compiled into
 * `./main` may hold a built-in permission. Never read from the manifest,
 * which can't vouch for itself.
 */
enum Origin {
    /** Compiled into `./main` (`window/newtab.la`). */
    BuiltIn,
    /** Any file or address. */
    External,
}

/** Why an app wasn't loaded. */
enum Refusal {
    /** It couldn't be loaded: what to call it, why. */
    Failed(string, string),
    /** A signed site failed a check: its host, why. No way past it. */
    Unverified(string, string),
    /** A signed site's key changed without approval: the person decides. */
    Unapproved(string, Change),
}

/**
 * Loads the app in a local file: checked (`checked_file`), then compiled.
 *
 * @param engine the program's engine
 * @param ring this session's trusted keys
 * @param path a `.rkb` bundle, a `.wasm` module, or a local development address
 * @returns the app; or why not (unreadable, not a bundle, a contract this
 *     Rapidkoi doesn't speak, not a module, a failed check, a changed key)
 *
 * Example:
 *     load(engine, ring, "counter.rkb")
 */
fun load(engine: Engine, ring: Keyring, path: string): Result<Loaded, Refusal> = compiled_with(
    checked_file(ring, path)?,
    plain(engine),
);

/**
 * The Source and Checked stages for a local file (PRP-069): its bytes read
 * and every rule checked, nothing compiled. A bare `.wasm` has no manifest
 * to check; a local development address is fetched and waited for (tests,
 * and `load_again`'s files).
 *
 * @returns what's checked; or why not, as `load`
 *
 * Example:
 *     checked_file(ring, "counter.rkb")?
 */
fun checked_file(ring: Keyring, path: string): Result<Checked, Refusal> {
    if is_address(path) {
        let a = parse(path).map_err(fun(e) = Refusal.Failed(path, address.reason(e)))?;
        let f = fetch_app(
            a,
            known_for(ring, shown(a)),
            Network { ca_file: None, hosts: [] },
            FETCH_TIMEOUT_MS,
        );
        return checked_fetched(ring, f);
    }
    let file = name_of(path);
    let bytes = read_bytes(path).map_err(
        fun(e: string) = Refusal.Failed(file, "Couldn't read {path}: {e}"),
    )?;
    if !path.ends_with(".rkb") {
        return Ok(Checked {
            name: file,
            manifest: None,
            icon: None,
            module: bytes,
            assets: [],
            trust: None,
        });
    }
    checked_bytes(ring, file, bytes, Origin.External)
}

/**
 * Returns a plain sentence for a refusal.
 *
 * Example:
 *     why(r)
 */
fun why(r: Refusal): string = match r {
    Failed(_, w) => w,
    Unverified(_, w) => "This app couldn't be verified, so Rapidkoi didn't run it: {w}",
    Unapproved(_, c) => verify_reason(VerifyError.Unapproved(c)),
};

/**
 * Fetches a bundle from a local development server: at most `MAX_BUNDLE`
 * bytes, within `FETCH_TIMEOUT_MS`. Waits on the window's thread (CLAUDE.md
 * rule 3; DECISION-021 for loading in the background).
 *
 * @returns the bundle's bytes, unchecked; or why not (unreachable, timed
 *     out, too large, a status other than 200)
 *
 * Example:
 *     fetch(parse("rapidkoi://localhost:8000")?)
 */
fun fetch(a: Address): Result<u8[], string> {
    let bounds = Limits { body: MAX_BUNDLE, timeout_ms: FETCH_TIMEOUT_MS, ..http.limits() };
    let r = http.request_with("GET", url(a), #{}, [], bounds).map_err(
        fun(e: string) = "Couldn't reach rapidkoi://{shown(a)}: {e}",
    )?;
    if r.status != 200 {
        return Err("The development server answered {r.status}");
    }
    Ok(r.body)
}

/**
 * Turns what a background load fetched into an app: checked
 * (`checked_fetched`), then compiled, only after every check passed. Call
 * `current` first: a result checked against a snapshot that's since
 * changed must load again instead.
 *
 * @returns the app; or why not (as `load`)
 *
 * Example:
 *     from_fetched(engine, ring, fetched)
 */
fun from_fetched(
    engine: Engine,
    ring: Keyring,
    f: Fetched,
): Result<Loaded, Refusal> = compiled_with(checked_fetched(ring, f)?, plain(engine));

/**
 * The Checked stage for what a site's background load fetched (PRP-069):
 * records the trust a signed site's check found, then checks its bundle.
 *
 * Example:
 *     checked_fetched(ring, fetched)?
 */
fun checked_fetched(ring: Keyring, f: Fetched): Result<Checked, Refusal> = match f {
    Signed(v, r, _, _) => {
        record(ring, r);
        vetted(v.opened, Some(v.trust), Origin.External)
    }
    Unsigned(name, bytes) => checked_bytes(ring, name, bytes, Origin.External),
    Refused(r) => Err(r),
};

/**
 * Says whether a fetched result can be used as it is: a signed site's was
 * checked against a snapshot of its app's trust, which must still be the
 * keyring's. Otherwise (another tab recorded trust meanwhile) it loads again.
 *
 * Example:
 *     if current(ring, fetched) { from_fetched(…) } else { … }
 */
fun current(ring: Keyring, f: Fetched): bool = match f {
    // Each app is checked against its own keys (PRP-049): only theirs count.
    Signed(v, _, known, _) => {
        let t = v.trust;
        known_of(known_for(ring, t.host), t.host, t.origin) == known_of(known, t.host, t.origin)
    }
    _ => true,
};

/**
 * Opens a bundle already in memory, as `load` opens a `.rkb` file: every
 * rule checked, a signed one verified against `ring`.
 *
 * @param engine the engine to compile its module with
 * @param ring the keys trusted, for a signed bundle
 * @param file what to call it in a refusal
 * @param bytes the bundle's bytes
 * @param origin where they came from: `BuiltIn` only for bytes compiled into `./main`
 * @returns the app; or why not
 *
 * Example:
 *     from_bytes(engine, keyring(), "newtab.rkb", BUNDLE, Origin.BuiltIn)
 */
fun from_bytes(
    engine: Engine,
    ring: Keyring,
    file: string,
    bytes: u8[],
    origin: Origin,
): Result<Loaded, Refusal> = compiled_with(
    checked_bytes(ring, file, bytes, origin)?,
    plain(engine),
);

/**
 * The Checked stage for a bundle's bytes (either format, PRP-069): read,
 * a signed one's key's standing found, every rule checked.
 *
 * Example:
 *     checked_bytes(ring, "settings.rkb", BUNDLE, Origin.BuiltIn)?
 */
fun checked_bytes(
    ring: Keyring,
    file: string,
    bytes: u8[],
    origin: Origin,
): Result<Checked, Refusal> {
    let o = read_any(bytes).map_err(fun(e) = Refusal.Failed(file, bundle_reason(e)))?;
    let trust = o.signed.map(fun(s) = standing_of(ring, s));
    vetted(o, trust, origin)
}

/**
 * Whether an app's manifest speaks the contract this Rapidkoi runs: an
 * older or newer one is refused when it loads.
 *
 * Example:
 *     runs_here(bundle.manifest)
 */
fun runs_here(m: Manifest): bool = m.contract == CONTRACT_VERSION as i64;

/** An app checked and ready to compile (PRP-069): what `Loaded` holds, its module still bytes. */
struct Checked {
    name: string,
    manifest: Option<Manifest>,
    icon: Option<u8[]>,
    /** The module's bytes, compiled by the Compiled stage. */
    module: u8[],
    assets: (string, u8[])[],
    trust: Option<Trust>,
}

/**
 * A bundle's rules checked, before anything is compiled: a refused app's
 * module is never touched. Its contract, Rapidkoi's own controls (a site
 * choosing them could hide the shield, PRP-031), and built-in permissions
 * only from `./main`.
 */
fun vetted(o: Opened, trust: Option<Trust>, origin: Origin): Result<Checked, Refusal> {
    let b = o.bundle;
    let m = b.manifest;
    let newer = Refusal.Failed(m.name, "This app needs a newer version of Rapidkoi");
    if m.contract < CONTRACT_VERSION as i64 {
        return Err(Refusal.Failed(m.name, OLDER));
    }
    if m.contract > CONTRACT_VERSION as i64 {
        return Err(newer);
    }
    if m.controls.is_some() && origin == Origin.External {
        return Err(Refusal.Failed(m.name, "This app asks to change Rapidkoi's own controls"));
    }
    let held = parse_permissions(m.permissions).map_err(fun(_: PermissionError) = newer)?;
    for p of held {
        if tier_of(p) == Tier.BuiltIn && origin == Origin.External {
            return Err(
                Refusal.Failed(
                    m.name,
                    "This app asks for something only Rapidkoi's own apps can have: {words_of(p)}",
                ),
            );
        }
    }
    let icon = match m.icon {
        Some(name) => asset(b, name),
        None => None,
    };
    Ok(Checked {
        name: m.name,
        manifest: Some(m),
        icon: icon,
        module: b.module,
        assets: b.assets,
        trust: trust,
    })
}

/**
 * The Compiled stage (PRP-069): what's checked, its module made by `make`
 * (through the modules kept for the run, or plainly).
 *
 * Example:
 *     compiled_with(checked_file(ring, path)?, plain(engine))
 */
fun compiled_with(
    c: Checked,
    make: fun(u8[]): Result<Module, GuestError>,
): Result<Loaded, Refusal> {
    let module = make(c.module).map_err(fun(e) = Refusal.Failed(c.name, reason(e)))?;
    Ok(Loaded {
        name: c.name,
        manifest: c.manifest,
        icon: c.icon,
        module: module,
        assets: c.assets,
        trust: c.trust,
    })
}

/** Compiling with nothing kept: tests, and the commands that load an app once. */
fun plain(engine: Engine): fun(u8[]): Result<Module, GuestError> = fun(bytes: u8[]) = compile(
    engine,
    bytes,
);

/**
 * Returns a file path's last part, without `.wasm`.
 *
 * Example:
 *     name_of("apps/counter.wasm")
 */
fun name_of(path: string): string {
    let parts = path.split("/");
    let file = parts[parts.len - 1];
    if file.ends_with(".wasm") && file.len > 5 { file.slice(0, file.len - 5) } else { file }
}
