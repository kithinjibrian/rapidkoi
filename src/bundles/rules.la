/**
 * The rules every bundle keeps (format 1): names, versions, asset names and
 * types, references, sizes and counts. Pure; used by `bundle.read` and
 * `bundle.write` alike, so a bundle the packer writes is always one Rapidkoi
 * reads.
 *
 * Depends on: guest.limits, imagesize
 * Used by: bundles.bundle
 */
import imagesize { Format, size_of, format_of };
import guest.limits {
    MAX_MODULE,
    MAX_ASSET,
    MAX_ASSETS,
    MAX_NAME,
    MAX_DESCRIPTION,
    MAX_ASSET_NAME,
    MAX_IMAGE_PX,
    MAX_IMAGE_PIXELS,
    MAX_SVG,
};

/** Why a bundle was refused. */
enum BundleError {
    /** The bytes aren't CBOR this reader accepts, with the decoder's reason. */
    Decode(string),
    /** Not a map at its top level. */
    NotAMap,
    /** What was too large, and its size in bytes. */
    TooLarge(string, i64),
    /** A format this Rapidkoi can't read. */
    Format(i64),
    /** A required field is missing. */
    Missing(string),
    /** A field, and what's wrong with it. */
    Wrong(string, string),
    /** An asset name breaking the naming rules. */
    BadName(string),
    /** An asset that isn't a PNG, JPEG or SVG picture (PRP-047). */
    NotPicture(string),
    /** An asset whose value isn't bytes. */
    AssetNotBytes(string),
    /** An image larger than its role allows: what, its width and height, the most allowed. */
    ImageTooLarge(string, i64, i64, i64, i64),
    /** Format 2: the signature doesn't match the manifest's bytes. */
    BadSignature,
    /** Format 2: a part doesn't match its signed hash: which. */
    HashMismatch(string),
    /** Format 2: an asset the signed manifest doesn't list. */
    UnsignedAsset(string),
    /** Format 2: an asset the signed manifest lists but the bundle lacks. */
    AbsentAsset(string),
    /** Format 2: the manifest's host isn't a host. */
    BadHost(string),
    /** A field naming an asset the bundle doesn't have: the field, the name. */
    MissingAsset(string, string),
    /** More assets than allowed. */
    TooManyAssets(i64),
    /** A field that must be empty in format 1. */
    NotEmpty(string),
}

/**
 * Returns a plain sentence for a bundle error.
 *
 * @param e the error
 * @returns what's wrong, naming the field
 *
 * Example:
 *     reason(BundleError.Missing("name"))
 */
fun reason(e: BundleError): string = match e {
    Decode(d) => "This file isn't a Rapidkoi bundle ({d})",
    NotAMap => "This file isn't a Rapidkoi bundle (it isn't a map)",
    TooLarge(what, n) => if what == "bundle" {
        "This bundle is too large ({n} bytes)"
    } else {
        "This bundle's {what} is too large ({n} bytes)"
    },
    Format(n) => "This bundle needs a newer version of Rapidkoi (format {n})",
    Missing(field) => "This bundle is missing \"{field}\"",
    Wrong(field, problem) => "This bundle's \"{field}\" {problem}",
    BadName(name) => "This bundle has an asset with a bad name: \"{name}\"",
    NotPicture(name) => "This bundle's asset \"{name}\" isn't a PNG, JPEG or SVG picture",
    AssetNotBytes(name) => "This bundle's asset \"{name}\" must be bytes",
    BadSignature => "This bundle's signature doesn't match its contents",
    HashMismatch(what) => "This bundle's {what} doesn't match its signed hash",
    UnsignedAsset(name) => "This bundle has an asset its signature doesn't cover: \"{name}\"",
    AbsentAsset(name) => "This bundle is missing a signed asset: \"{name}\"",
    BadHost(h) => "This bundle's host isn't a host name: \"{h}\"",
    ImageTooLarge(what, w, h, mw, mh) => "This bundle's {what} image is too large ({w} × {h} px; at most {mw} × {mh})",
    MissingAsset(field, name) => "This bundle's \"{field}\" names an asset it doesn't have: \"{name}\"",
    TooManyAssets(n) => "This bundle has too many assets ({n}; at most {MAX_ASSETS})",
    NotEmpty(field) => "This bundle asks for \"{field}\", which this version of Rapidkoi can't grant yet",
};

/**
 * Checks an app name: 1 to `MAX_NAME` bytes, no control characters.
 *
 * Example:
 *     check_name("Counter")?
 */
fun check_name(name: string): Result<(), BundleError> {
    if name.len < 1 || name.len > MAX_NAME {
        return Err(BundleError.Wrong("name", "must be 1 to {MAX_NAME} bytes"));
    }
    plain_text("name", name)
}

/**
 * Checks a description: up to `MAX_DESCRIPTION` bytes, no control characters.
 *
 * Example:
 *     check_description("Counts")?
 */
fun check_description(text: string): Result<(), BundleError> {
    if text.len > MAX_DESCRIPTION {
        return Err(BundleError.Wrong("description", "must be at most {MAX_DESCRIPTION} bytes"));
    }
    plain_text("description", text)
}

/**
 * Checks a version is plain semver, MAJOR.MINOR.PATCH: digits only, no
 * leading zeros, no pre-release or build parts.
 *
 * Example:
 *     check_version("1.4.0")?
 */
fun check_version(v: string): Result<(), BundleError> {
    let wrong = BundleError.Wrong("version", "must be MAJOR.MINOR.PATCH, like 1.4.0");
    let parts = v.split(".");
    if parts.len != 3 {
        return Err(wrong);
    }
    for p of parts {
        // 1–9 digits: no leading zeros (semver), and small enough for any reader.
        if p.len == 0 || p.len > 9 || p.len > 1 && p[0] == 48 {
            return Err(wrong);
        }
        for b of p {
            if b < 48 || b > 57 {
                return Err(wrong);
            }
        }
    }
    Ok(())
}

/**
 * Checks an asset name: 1 to `MAX_ASSET_NAME` bytes of `a–z 0–9 . _ - /`,
 * not starting or ending with `/`, with no `..` and no `//`. Names are keys,
 * never file paths; the rules keep them unambiguous anyway.
 *
 * Example:
 *     check_asset_name("banner/home.png")?
 */
fun check_asset_name(name: string): Result<(), BundleError> {
    let bad = BundleError.BadName(name);
    if name.len < 1 || name.len > MAX_ASSET_NAME || name.starts_with("/") || name.ends_with(
        "/",
    ) || name.contains("..") || name.contains("//") {
        return Err(bad);
    }
    for b of name {
        let lower = b >= 97 && b <= 122;
        let digit = b >= 48 && b <= 57;
        // . _ - /
        if !(lower || digit || b == 46 || b == 95 || b == 45 || b == 47) {
            return Err(bad);
        }
    }
    Ok(())
}

/**
 * Checks one asset: its name, its size, and that it's a picture Rapidkoi
 * shows (PRP-047): a PNG or JPEG whose header declares at most
 * `MAX_IMAGE_PX` a side and `MAX_IMAGE_PIXELS`, or an SVG of UTF-8 text
 * of at most `MAX_SVG`. Rapidkoi reads only the header; GTK decodes the rest.
 *
 * Example:
 *     check_asset("icon.png", bytes)?
 */
fun check_asset(name: string, bytes: u8[]): Result<(), BundleError> {
    check_asset_name(name)?;
    if bytes.len > MAX_ASSET {
        return Err(BundleError.TooLarge("asset \"{name}\"", bytes.len));
    }
    let not_picture = BundleError.NotPicture(name);
    match size_of(bytes) {
        Ok(s) if s.format == Format.Png || s.format == Format.Jpeg => {
            if s.width > MAX_IMAGE_PX || s.height > MAX_IMAGE_PX || s.pixels() > MAX_IMAGE_PIXELS {
                return Err(
                    BundleError.ImageTooLarge(
                        "asset \"{name}\"",
                        s.width,
                        s.height,
                        MAX_IMAGE_PX,
                        MAX_IMAGE_PX,
                    ),
                );
            }
            Ok(())
        }
        // An SVG is drawn at its box's size, so its own size, if any, doesn't matter.
        _ if is_svg(bytes) => {
            if bytes.len > MAX_SVG {
                return Err(BundleError.TooLarge("asset \"{name}\"", bytes.len));
            }
            // Recolouring reads it as text.
            string_from_utf8(bytes).map(fun(_s: string) = ()).map_err(fun(_e: string) = not_picture)
        }
        _ => Err(not_picture),
    }
}

/** Whether the bytes are an SVG, sized or not. */
fun is_svg(bytes: u8[]): bool = format_of(bytes) == Some(Format.Svg);

/**
 * Checks an image used in a role (the icon, a banner) is no larger than the
 * role allows, so a tiny file can't claim a huge picture.
 *
 * @param field the manifest field naming it (`icon`, `banners`)
 * @param bytes the asset, already checked by `check_asset`
 *
 * Example:
 *     check_role("icon", bytes, 1024, 1024)?
 */
fun check_role(field: string, bytes: u8[], max_w: i64, max_h: i64): Result<(), BundleError> {
    match size_of(bytes) {
        Ok(s) if s.format != Format.Svg && (s.width > max_w || s.height > max_h) => Err(
            BundleError.ImageTooLarge("\"{field}\"", s.width, s.height, max_w, max_h),
        ),
        _ => Ok(()),
    }
}

/**
 * Checks a host name: 1 to 253 bytes of `a–z 0–9 . -`, with an optional
 * `:port` (development hosts are `localhost:8000`).
 *
 * Example:
 *     check_host("notes.acme.com")?
 */
fun check_host(host: string): Result<(), BundleError> {
    let bad = BundleError.BadHost(host);
    if host.len < 1 || host.len > 253 || host.starts_with(".") || host.starts_with("-") {
        return Err(bad);
    }
    for b of host {
        let ok = b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 46 || b == 45 || b == 58;
        if !ok {
            return Err(bad);
        }
    }
    Ok(())
}

/**
 * Checks the counts and sizes of a whole bundle's parts.
 *
 * Example:
 *     check_sizes(module.len, assets.len)?
 */
fun check_sizes(module: i64, assets: i64): Result<(), BundleError> {
    if module > MAX_MODULE {
        return Err(BundleError.TooLarge("module", module));
    }
    if assets > MAX_ASSETS {
        return Err(BundleError.TooManyAssets(assets));
    }
    Ok(())
}

/** No control characters (below space, and DEL). */
fun plain_text(field: string, text: string): Result<(), BundleError> {
    for b of text {
        if b < 32 || b == 127 {
            return Err(BundleError.Wrong(field, "can't hold control characters"));
        }
    }
    Ok(())
}
