/**
 * `rapidkoi.toml`: how a developer describes their app to `pack`,
 * `keygen` and `publish`. Read with std.toml under tight limits; unknown
 * tables and keys are refused, so a typo never passes silently. Paths are
 * made absolute from the toml's folder; `~/` expands from `$HOME`.
 *
 * Depends on: std.toml, std.env
 * Used by: commands.pack, commands.publish
 */
import std.toml { Value, Limits, parse_with, as_text, as_i64, as_table, as_array };
import std.env;

/** What a project describes. Paths are absolute. */
public struct Project {
    /** The folder holding the toml. */
    public dir: string,
    /** [app] name. */
    public name: string,
    /** [app] version. */
    public version: string,
    /** [app] description, if any. */
    public description: Option<string>,
    /** [app] host: set, the app is signed and published. */
    public host: Option<string>,
    /** [app] state_version, default 1. */
    public state_version: i64,
    /** [app] module: the .wasm. */
    public module: string,
    /** [app] icon, if any. */
    public icon: Option<string>,
    /** [banners]: page → file. */
    public banners: (string, string)[],
    /** [assets]: name → file. */
    public assets: (string, string)[],
    /** [publish] key: the secret key file. */
    public key: Option<string>,
    /** [publish] site, default `site`. */
    public site: string,
    /** [publish] keep, default 3: versions kept on the site. */
    public keep: i64,
    /** [network] servers: what the app may reach besides its host (PRP-012). */
    public servers: string[],
}

/** Why a project couldn't be read. */
public enum ProjectError {
    /** The file couldn't be read. */
    Unreadable(string),
    /** The TOML itself is wrong; std.toml's message. */
    Toml(string),
    /** A required field, by table and name. */
    Missing(string, string),
    /** A field of the wrong kind: table, name, what it must be. */
    Wrong(string, string, string),
    /** A table this file doesn't have. */
    UnknownTable(string),
    /** A key a table doesn't have: table ("" at the top), name. */
    UnknownKey(string, string),
    /** `~/` with no `$HOME`. */
    NoHome(string, string),
}

/**
 * Reads `rapidkoi.toml` from a folder.
 *
 * @param dir the project's folder, absolute
 * @returns the project, or why not
 *
 * Example:
 *     read_project(env.current_dir()?)?
 */
public fun read_project(dir: string): Result<Project, ProjectError> {
    let text = read_file("{dir}/rapidkoi.toml").map_err(
        fun(e: string) = ProjectError.Unreadable(e),
    )?;
    parse_project(text, dir, env.get("HOME"))
}

/**
 * Parses a project's toml text.
 *
 * @param text the file's contents
 * @param dir its folder, absolute: relative paths start there
 * @param home `$HOME`, for `~/`
 * @returns the project, or why not
 *
 * Example:
 *     parse_project(text, "/work/notes", env.get("HOME"))
 */
public fun parse_project(
    text: string,
    dir: string,
    home: Option<string>,
): Result<Project, ProjectError> {
    // A project file is small; generous room, nothing more.
    let bounds = Limits { bytes: 64 * 1024, depth: 8, values: 10_000 };
    let doc = parse_with(text, bounds).map_err(fun(e) = ProjectError.Toml(e.message()))?;
    for (k, v) of doc {
        let known = k == "app" || k == "banners" || k == "assets" || k == "publish" || k == "network";
        if !known {
            return Err(match as_table(v) {
                Some(_) => ProjectError.UnknownTable(k),
                None => ProjectError.UnknownKey("", k),
            });
        }
    }
    let app = table(doc, "app")?;
    only(app, "app", [
        "name",
        "version",
        "description",
        "host",
        "state_version",
        "module",
        "icon",
    ])?;
    let publish = table(doc, "publish")?;
    only(publish, "publish", ["key", "site", "keep"])?;
    let keep = whole(publish, "publish", "keep")?.unwrap_or(3);
    if keep < 1 {
        return Err(ProjectError.Wrong("publish", "keep", "at least 1"));
    }
    let network = table(doc, "network")?;
    only(network, "network", ["servers"])?;
    let key = match words(publish, "publish", "key")? {
        Some(k) => Some(expand(k, home, "publish", "key")?),
        None => None,
    };
    Ok(Project {
        dir: dir,
        name: required(app, "app", "name")?,
        version: required(app, "app", "version")?,
        description: words(app, "app", "description")?,
        host: words(app, "app", "host")?,
        state_version: whole(app, "app", "state_version")?.unwrap_or(1),
        module: at(dir, required(app, "app", "module")?),
        icon: words(app, "app", "icon")?.map(fun(p: string) = at(dir, p)),
        banners: files(table(doc, "banners")?, "banners", dir)?,
        assets: files(table(doc, "assets")?, "assets", dir)?,
        key: key,
        site: at(dir, words(publish, "publish", "site")?.unwrap_or("site")),
        keep: keep,
        servers: names(network, "network", "servers")?,
    })
}

/**
 * Returns a plain sentence for a project error, starting `rapidkoi.toml: `.
 *
 * Example:
 *     reason(e)
 */
public fun reason(e: ProjectError): string = "rapidkoi.toml: " + match e {
    Unreadable(why) => "can't read it: {why}",
    Toml(message) => message,
    Missing(t, k) => "[{t}] needs {k}",
    Wrong(t, k, what) => if what == "at least 1" {
        "[{t}] {k} must be at least 1"
    } else {
        "[{t}] {k} must be {what}"
    },
    UnknownTable(t) => "unknown table [{t}]",
    UnknownKey(t, k) => if t == "" {
        "unknown key {k} (did you mean [app] {k}?)"
    } else {
        "unknown key [{t}] {k}"
    },
    NoHome(t, k) => "[{t}] {k} starts with ~/ but $HOME isn't set",
};

/** A table, or an empty one when it's absent. */
fun table(
    doc: Map<string, Value>,
    name: string,
): Result<Map<string, Value>, ProjectError> = match doc.get(name) {
    Some(v) => as_table(v).ok_or(ProjectError.Wrong(name, name, "a table")),
    None => Ok(#{}),
};

/** Refuses keys a table doesn't have. */
fun only(t: Map<string, Value>, name: string, allowed: string[]): Result<(), ProjectError> {
    for k of t.keys() {
        if !allowed.any(fun(a: string) = a == k) {
            return Err(ProjectError.UnknownKey(name, k));
        }
    }
    Ok(())
}

fun words(
    t: Map<string, Value>,
    name: string,
    key: string,
): Result<Option<string>, ProjectError> = match t.get(key) {
    Some(v) => match as_text(v) {
        Some(s) => Ok(Some(s)),
        None => Err(ProjectError.Wrong(name, key, "text")),
    },
    None => Ok(None),
};

fun required(
    t: Map<string, Value>,
    name: string,
    key: string,
): Result<string, ProjectError> = match words(t, name, key)? {
    Some(s) => Ok(s),
    None => Err(ProjectError.Missing(name, key)),
};

fun whole(
    t: Map<string, Value>,
    name: string,
    key: string,
): Result<Option<i64>, ProjectError> = match t.get(key) {
    Some(v) => match as_i64(v) {
        Some(n) => Ok(Some(n)),
        None => Err(ProjectError.Wrong(name, key, "a whole number")),
    },
    None => Ok(None),
};

/** A list of text, or none when absent; the names themselves are checked when packed. */
fun names(t: Map<string, Value>, name: string, key: string): Result<string[], ProjectError> {
    let wrong = ProjectError.Wrong(name, key, "a list of server names");
    let items = match t.get(key) {
        Some(v) => as_array(v).ok_or(wrong)?,
        None => [],
    };
    let mut out: string[] = [];
    for v of items {
        out.push(as_text(v).ok_or(wrong)?);
    }
    Ok(out)
}

/** `name = "path"` pairs, paths made absolute, in the file's order. */
fun files(
    t: Map<string, Value>,
    name: string,
    dir: string,
): Result<(string, string)[], ProjectError> {
    let mut out: (string, string)[] = [];
    for (k, v) of t {
        match as_text(v) {
            Some(p) => out.push((k, at(dir, p))),
            None => {
                return Err(ProjectError.Wrong(name, k, "a file path"));
            }
        }
    }
    Ok(out)
}

/** A path from the project's folder; absolute paths stay as they are. */
fun at(dir: string, p: string): string = if p.starts_with("/") { p } else { "{dir}/{p}" };

/** `~/…` from `$HOME`. */
fun expand(p: string, home: Option<string>, t: string, k: string): Result<string, ProjectError> {
    if !p.starts_with("~/") {
        return Ok(p);
    }
    match home {
        Some(h) => Ok(h + p.slice(1, p.len)),
        None => Err(ProjectError.NoHome(t, k)),
    }
}
