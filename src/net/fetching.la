/**
 * What a background load does (PRP-008): fetch an address's key file,
 * index and build, and check them against a snapshot of the identities
 * trusted for its host, recording nothing. Or, for a plain-HTTP
 * development server with no key, fetch its bundle. Remote and HTTPS
 * sites must be signed; redirects are refused, never followed; every
 * certificate is checked as std checks it (PRP-009). Runs in a kivuli
 * task, so it holds only plain data (the address, the snapshot, the
 * network) and returns plain data: the window records trust and compiles
 * when the result arrives (`loader.from_fetched`). A signed load also
 * hands back the site's files it checked, for keeping (PRP-043).
 *
 * Depends on: std.http, net.dialing, net.network, trust.verify, bundles.loader, net.address, guest.limits
 * Used by: bundles.loader, window.navigate
 */
import std.http { Limits };
import std.time;
import trust.verify {
    Verified,
    Record,
    Identity,
    VerifyError,
    SITE,
    check_site_at,
    reason as verify_reason,
};
import bundles.loader { Refusal };
import net.address { Address, url, site_url, shown };
import guest.limits { MAX_BUNDLE };

import net.dialing { Network, Dialed, dial };
import net.network { reason as network_reason };

/** What a background load came back with. */
enum Fetched {
    /** A signed site, checked: the build, what to record, the snapshot it was checked against, and where it came from. */
    Signed(Verified, Record, Identity[], Source),
    /** A bundle from a server with no key (or an `http://` address): what to call it, its bytes, unchecked. */
    Unsigned(string, u8[]),
    /** It couldn't be fetched or verified. */
    Refused(Refusal),
}

/** Where a signed load's build came from, and the site's files it checked (PRP-043). */
struct Source {
    /** The site's key file, as checked; empty when read from the kept copy. */
    key: u8[],
    /** The site's index, as checked; empty when read from the kept copy. */
    index: u8[],
    /** The build, as checked; empty when read from the kept copy. */
    build: u8[],
    /** How many bytes the app takes kept: its build, key and index. */
    size: i64,
    /** Read from the kept copy rather than fetched. */
    kept: bool,
    /** The site couldn't be reached, so the kept copy opened in place of what was asked. */
    offline: bool,
    /** When the site was last reached and checked, in milliseconds since 1970: now, when fetched. */
    checked: i64,
}

/**
 * Fetches and checks the app at an address. Safe to run in a task.
 *
 * @param a the address
 * @param known a snapshot of the identities trusted for its host (`verify.known_for`)
 * @param net the system's roots (and, in tests only, an extra CA)
 * @param timeout_ms how long each request may take
 * @returns the checked build and what to record; a plain-HTTP development
 *     server's bundle; or why not (unreachable, timed out, a certificate,
 *     a redirect, no key over HTTPS, a failed check, a changed key)
 *
 * Example:
 *     Cmd.task(fun(): Fetched = fetch_app(a, known, Network { ca_file: None, hosts: [] }, FETCH_TIMEOUT_MS), done)
 */
fun fetch_app(a: Address, known: Identity[], net: Network, timeout_ms: i64): Fetched {
    let host = shown(a);
    let fail = fun(why: string) = Fetched.Refused(Refusal.Failed(host, why));
    // An http:// address naming no file is a site's own (a link, PRP-036).
    if !a.http || a.route == "/" {
        // A site with a key is verified; without one, only a plain-HTTP
        // development server on this machine may serve an unsigned bundle.
        // A link's version opens while the site lists it (PRP-036).
        let (fetched, source) = check_signed(a, known, net, timeout_ms, a.version);
        match fetched {
            Ok((v, r)) => {
                return Fetched.Signed(v, r, known, source);
            }
            Err(Unsigned) if a.secure => {
                return fail("{host} has no Rapidkoi key, so it can't be verified");
            }
            Err(Unsigned) => {}
            Err(Unapproved(c)) => {
                return Fetched.Refused(Refusal.Unapproved(host, c));
            }
            // A status on the index or build: which file, as before.
            Err(Fetch(_, why)) if !why.starts_with("the server answered") => {
                return fail(failure(host, why, timeout_ms));
            }
            Err(e) => {
                return Fetched.Refused(Refusal.Unverified(host, verify_reason(e)));
            }
        }
    }
    match get(a, url(a), net, timeout_ms) {
        Ok((200, body)) => Fetched.Unsigned(host, body),
        Ok((status, _)) => fail("The development server answered {status}"),
        Err(why) => fail(failure(host, why, timeout_ms)),
    }
}

/**
 * Checks a signed site at an address, as `fetch_app` does, keeping the
 * files it fetched. Safe to run in a task.
 *
 * @param wanted a link's version, if it names one
 * @returns the check's outcome, and the site's files as fetched (whatever of them was)
 *
 * Example:
 *     let (checked, source) = check_signed(a, known, net, FETCH_TIMEOUT_MS, None);
 */
fun check_signed(
    a: Address,
    known: Identity[],
    net: Network,
    timeout_ms: i64,
    wanted: Option<string>,
): (Result<(Verified, Record), VerifyError>, Source) {
    let got: Ref<(string, u8[])[]> = Ref.new([]);
    let checked = check_site_at(
        known,
        shown(a),
        fun(p: string) {
            let r = get(a, site_url(a, p), net, timeout_ms);
            if let Ok((200, body)) = r {
                got.update(fun(all: (string, u8[])[]) {
                    let mut next = all;
                    next.push((p, body));
                    next
                });
            }
            r
        },
        wanted,
    );
    let file = fun(f: fun(string): bool) = got.get().iter().find(
        fun(x: (string, u8[])) = f(x.0),
    ).map(fun(x: (string, u8[])) = x.1).unwrap_or([]);
    let key = file(fun(p: string) = p == "{SITE}/key");
    let index = file(fun(p: string) = p == "{SITE}/index");
    let build = file(fun(p: string) = p.starts_with("{SITE}/builds/"));
    (
        checked,
        Source {
            key: key,
            index: index,
            build: build,
            size: key.len + index.len + build.len,
            kept: false,
            offline: false,
            checked: time.now_ms(),
        },
    )
}

/**
 * One GET, as (status, body): at most `MAX_BUNDLE` bytes, within
 * `timeout_ms`. A redirect is an error here, so nothing ever follows one.
 * A name pointing to this computer or the local network is refused before
 * anything is sent (PRP-013), as "refused: " and the sentence.
 */
fun get(a: Address, target: string, net: Network, timeout_ms: i64): Result<(i64, u8[]), string> {
    let bounds = Limits { body: MAX_BUNDLE, timeout_ms: timeout_ms, ..http.limits() };
    let r = match dial(a, "GET", target, #{}, [], bounds, net) {
        Ok(r) => r,
        Err(Refused(e)) => {
            return Err("refused: {network_reason(e, "")}");
        }
        Err(Failed(why)) => {
            return Err(why);
        }
    };
    if r.status >= 300 && r.status < 400 {
        return Err("redirect {r.status}");
    }
    Ok((r.status, r.body))
}

/** A plain sentence for a network failure (or `get`'s redirect or refusal). */
fun failure(host: string, why: string, timeout_ms: i64): string = if why.starts_with("refused: ") {
    why.slice(9, why.len)
} else if why == "timed out" {
    late(host, timeout_ms)
} else if why.starts_with("redirect ") {
    "{host} answered with a redirect ({why.slice(9, why.len)}); Rapidkoi doesn't follow redirects"
} else if why.contains("certificate verify failed") {
    "{host}'s certificate couldn't be verified: {why}"
} else {
    "Couldn't reach rapidkoi://{host}: {why}"
};

/** "HOST didn't answer in N seconds". */
fun late(host: string, timeout_ms: i64): string {
    let n = timeout_ms / 1000;
    "{host} didn't answer in {n} {if n == 1 { "second" } else { "seconds" }}"
}
