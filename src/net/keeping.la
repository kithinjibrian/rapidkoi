/**
 * Keeping signed apps (PRP-043), the tasks' side: opening an app from its
 * kept copy when there is one, else from its site (keeping what it
 * fetched), falling back to the copy when the site can't be reached; and
 * the check that follows an open from the copy. Every copy is checked as
 * a site is (`verify.check_site_at` over `kept.files`). Touches the disk
 * and the network: run it in a task.
 *
 * Depends on: std.time, std.crypto, net.fetching, net.dialing, net.address, data.kept, data.store, trust.verify, trust.index, bundles.loader, guest.limits
 * Used by: net.loads, window.actions
 */
import std.time;
import std.crypto { equal };
import net.fetching { Fetched, Source, fetch_app, check_signed };
import net.dialing { Network };
import net.address { Address, shown };
import data.kept {
    Kept,
    Meta,
    kept_for,
    has,
    files,
    keep,
    read_meta,
    write_meta,
    size_of,
    remove,
    evict,
    adopt,
    old_for,
};
import trust.publishers { known_of };
import data.store { Store };
import trust.verify { Verified, Record, Identity, check_site_at };
import trust.index { Version, read_index, read_key_file };
import bundles.loader { Refusal, runs_here };
import guest.limits { KEPT_BYTES };

/** Where a load keeps what it opens. */
struct Keeping {
    /** The data folder. */
    store: Store,
    /** The copies of pinned apps: never evicted. */
    held: Kept[],
    /** Whether to open from the kept copy before asking the site: not for ⟳, which goes to the site first. */
    cache_first: bool,
    /**
     * Which app at the address this load opens, by its first key
     * (PRP-049); `None` when none is known there yet.
     */
    origin: Option<u8[]>,
}

/** What the check after an open from the kept copy found. */
enum Refreshed {
    /**
     * The site was reached and its current build checked: the trust to
     * record, the snapshot it was checked against, the version of a newer
     * build now kept (PRP-044), and why the running version was withdrawn, if it was.
     */
    Checked(Record, Identity[], Option<string>, Option<string>),
    /** The site lists no version that may run, so the copy is gone; why the running version was withdrawn, if it was. */
    Gone(Option<string>),
    /** The site couldn't be reached: offline, most likely. */
    Unreachable,
    /** The site failed a check (an older index, a bad file): the copy is gone, and the next open asks the site. */
    Refused,
    /**
     * The site is signed by this key now, with no signed trail from the
     * app's (PRP-049): the copy stays as the person's version.
     */
    Moved(u8[]),
}

/**
 * Opens a signed app for a load: from its kept copy first (unless
 * `cache_first` is off), else from its site, keeping what it fetched when
 * it's the site's current version; when the site can't be reached, from
 * the kept copy after all, whatever version was asked for. Each app opens
 * from its own copy and is checked only against its own keys (PRP-049): a
 * site now signed by another key with no trail opens the app's copy as the
 * person's version, marked moved on. Without `keeping`, exactly `fetch_app`.
 *
 * @param known the identities trusted for the address's host (`verify.known_for`)
 * @returns what `fetch_app` returns; a signed result's `Source` says where it came from
 *
 * Example:
 *     open_app(a, known, net, FETCH_TIMEOUT_MS, Some(Keeping { store: s, held: [], cache_first: true, origin: None }))
 */
fun open_app(
    a: Address,
    known: Identity[],
    net: Network,
    timeout_ms: i64,
    keeping: Option<Keeping>,
): Fetched {
    let kp = match keeping {
        Some(k) => k,
        None => {
            return fetch_app(a, known, net, timeout_ms);
        }
    };
    let host = shown(a);
    let first = match kp.origin {
        Some(o) => Some(o),
        None => signer_of_old(kp.store, host),
    };
    let origin = match first {
        Some(o) => o,
        // No app known here yet: whatever the site serves, kept as its own app.
        None => {
            let f = fetch_app(a, known, net, timeout_ms);
            if let Signed(v, _, _, src) = f {
                if current_of(src, host) == Some(v.opened.bundle.manifest.version) {
                    kept_fetched(kp, kept_for(kp.store, host, v.trust.origin), src);
                }
            }
            return f;
        }
    };
    let mine = known_of(known, host, origin);
    // Its first key is always one of its own, trusted yet or not.
    let mut signers = mine.map(fun(i: Identity) = i.key);
    signers.push(origin);
    adopt(kp.store, host, origin, signers);
    let k = kept_for(kp.store, host, origin);
    // A copy whose site moved on is the only version there is: it opens even on ⟳.
    let moved = meta_of(k).moved;
    if (kp.cache_first || moved.is_some()) && has(k) {
        match from_kept(k, mine, host, a.version, false) {
            // A copy built for another contract can't run: the site may have a rebuilt one.
            Some(Signed(v, _, _, _)) if !runs_here(v.opened.bundle.manifest) => {
                remove(k).unwrap_or(());
            }
            Some(f) => {
                return f;
            }
            None => {}
        }
    }
    let f = fetch_app(a, mine, net, timeout_ms);
    match f {
        Signed(v, _, _, src) => {
            // A link's older version runs, but only the current one is kept.
            if current_of(src, host) == Some(v.opened.bundle.manifest.version) {
                kept_fetched(kp, k, src);
            }
            f
        }
        // The site couldn't be reached: the kept copy, whatever was asked.
        Refused(Failed(_, _)) if has(k) => from_kept(k, mine, host, None, true).unwrap_or(f),
        // Another publisher's site now: the person's version, kept (DECISION-064).
        Refused(Unapproved(_, c)) if has(k) => {
            write_meta(k, Meta { moved: Some(c.new), ..meta_of(k) }).unwrap_or(());
            from_kept(k, mine, host, None, false).unwrap_or(f)
        }
        _ => f,
    }
}

/**
 * Checks the site of an app opened from its kept copy: keeps a newer
 * current build for the next open (silently: a routine update changes
 * nothing for the person), notes when the site was reached, and finds
 * whether the running version was withdrawn.
 *
 * @param known the identities trusted for this app (`apps.known_of`)
 * @param running the running build's SHA-256
 * @param version the running build's version
 * @param origin the app's first key: whose copy it is
 * @returns what it found; the copy is updated or removed to match
 *
 * Example:
 *     refresh(a, known, net, FETCH_TIMEOUT_MS, s, pinned, t.build, "1.0.0")
 */
fun refresh(
    a: Address,
    known: Identity[],
    net: Network,
    timeout_ms: i64,
    s: Store,
    held: Kept[],
    running: u8[],
    version: string,
    origin: u8[],
): Refreshed {
    let host = shown(a);
    let k = kept_for(s, host, origin);
    let (checked, src) = check_signed(Address { version: None, ..a }, known, net, timeout_ms, None);
    let withdrawn = withdrawn_in(src, host, version);
    match checked {
        Ok((v, r)) => {
            let newer = !equal(v.trust.build, running);
            let meta = meta_of(k);
            if newer {
                keep(k, src.key, src.index, src.build).unwrap_or(());
                evict(s, held, KEPT_BYTES).unwrap_or(0);
            }
            // A failed write only means the next open checks again. The
            // site is the app's again, if it had moved on (DECISION-064).
            write_meta(k, Meta { checked: src.checked, moved: None, ..meta }).unwrap_or(());
            let fresher = if newer { Some(v.opened.bundle.manifest.version) } else { None };
            Refreshed.Checked(r, known, fresher, withdrawn)
        }
        // Not reached (offline, a lookup, a timeout): nothing changes.
        Err(Fetch(_, why)) if !why.starts_with("the server answered") => Refreshed.Unreachable,
        Err(Withdrawn(_, _)) | Err(NoCurrent(_)) => {
            remove(k).unwrap_or(());
            Refreshed.Gone(withdrawn)
        }
        // Another publisher's key, no trail: the copy stays, as the person's version.
        Err(Unapproved(c)) => {
            write_meta(k, Meta { moved: Some(c.new), ..meta_of(k) }).unwrap_or(());
            Refreshed.Moved(c.new)
        }
        Err(_) => {
            remove(k).unwrap_or(());
            Refreshed.Refused
        }
    }
}

/** The kept copy, checked as a site is, as a load's result: when it passes. Marks it opened. */
fun from_kept(
    k: Kept,
    known: Identity[],
    host: string,
    wanted: Option<string>,
    offline: bool,
): Option<Fetched> {
    let (v, r) = check_site_at(known, host, files(k), wanted).ok()?;
    let meta = meta_of(k);
    // Opened now, for eviction.
    write_meta(k, Meta { opened: time.now_ms(), ..meta }).unwrap_or(());
    Some(
        Fetched.Signed(v, r, known, Source {
            key: [],
            index: [],
            build: [],
            size: size_of(k),
            kept: true,
            offline: offline,
            checked: meta.checked,
            moved: meta.moved,
        }),
    )
}

/** Keeps a fetched site's files, opened and checked now, then evicts past the limit. */
fun kept_fetched(kp: Keeping, k: Kept, src: Source) {
    // Keeping is a bonus: a failure leaves the app opening from its site, as before.
    if keep(k, src.key, src.index, src.build).is_ok() {
        write_meta(k, Meta { checked: src.checked, opened: time.now_ms(), moved: None }).unwrap_or(
            (),
        );
        evict(kp.store, kp.held, KEPT_BYTES).unwrap_or(0);
    }
}

/**
 * The key that signed a host's copy kept before PRP-049, when nothing is
 * trusted there yet: that copy is its own app, first met now.
 */
fun signer_of_old(s: Store, host: string): Option<u8[]> {
    let old = old_for(s, host);
    if !has(old) {
        return None;
    }
    let kf = read_key_file(read_bytes("{old.dir}/key").ok()?).ok()?;
    Some(kf.key)
}

/** A kept copy's meta, or a blank one. */
fun meta_of(k: Kept): Meta = read_meta(k).unwrap_or(Meta { checked: 0, opened: 0, moved: None });

/** The current version a fetched index names, read with its own key file. */
fun current_of(src: Source, host: string): Option<string> {
    let kf = read_key_file(src.key).ok()?;
    Some(read_index(src.index, kf.key, host).ok()?.current)
}

/** Why a fetched index says `version` was withdrawn, if it does. */
fun withdrawn_in(src: Source, host: string, version: string): Option<string> {
    let kf = read_key_file(src.key).ok()?;
    let ix = read_index(src.index, kf.key, host).ok()?;
    ix.versions.iter().find(fun(x: Version) = x.version == version)?.withdrawn
}
