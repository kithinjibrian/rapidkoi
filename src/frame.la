/**
 * Rapidkoi's frame, pure: the bar (back, home, forward, the address box,
 * info, share) for the window's header bar, and the tab rail down the right. Only Rapidkoi
 * draws these; an app's view lives between them and can't reach them.
 *
 * Depends on: kivuli, actions, tabs, verify, keys, theme
 * Used by: panel, shell
 */
import kivuli {
    View,
    Image,
    Align,
    ButtonStyle,
    MenuEntry,
    button,
    item,
    menu_separator,
    column,
    input,
    row,
    separator,
    spacer,
    text,
};
import actions { Msg, TabAction };
import address { parse };
import tabs { Page, Tab, AppPage, is_loading };
import verify { Change, Standing };
import keys { fingerprint };
import theme { SPACE_SM, TEXT_TITLE, RAIL_WIDTH, TAB_SIZE, TAB_ICON };

/** The bar's parts in the window's header bar: start, title (it fills the row), end. */
public struct Bar {
    /** Back, home, forward. */
    public start: View<Msg>[],
    /** The address box, or an app page's address. */
    public title: View<Msg>,
    /** App info (app pages only), share. */
    public end: View<Msg>[],
}

/**
 * Builds the bar, for the window's header bar: GTK draws the window
 * controls beside it, in one row.
 *
 * @param page what the window shows
 * @param draft the address box's text
 * @param editing whether an app page's address is being edited
 * @param pinned whether the current app is pinned (☆ or ★)
 * @returns its parts; back, forward and share are disabled until links (DECISION-018)
 *
 * Example:
 *     let b = bar(Page.Home, "", false, false);
 *     view.header(b.start, b.title, b.end)
 */
public fun bar(page: Page, draft: string, editing: bool, pinned: bool): Bar {
    let back = icon_button("go-previous-symbolic", "Back (comes with links)", None);
    let forward = icon_button("go-next-symbolic", "Forward (comes with links)", None);
    let share = icon_button("emblem-shared-symbolic", "Share (comes with links)", None);
    let box = input(draft, Msg.Draft).placeholder("Search or type a path").name(
        "address",
    ).on_submit(Msg.Go).autofocus();
    match page {
        Home => Bar {
            // On home, ⌂ moves to the search box; it carries Ctrl+K.
            start: [back, icon_button("go-home-symbolic", "Search (Ctrl+K)", Some(Msg.FocusSearch)).shortcut("Ctrl+K"), forward],
            title: box.expand(),
            end: [share],
        },
        App(p) => {
            // Drawn by Rapidkoi only: an app can never show this marker.
            let place = if editing {
                box.expand()
            } else {
                button(marker(p, file_of(p.path)), Msg.EditAddress).button_style(
                    ButtonStyle.Subtle,
                ).tooltip("Search or type a path (Ctrl+K)").shortcut("Ctrl+K").expand()
            };
            let star = if pinned {
                icon_button("starred-symbolic", "Unpin", Some(Msg.TogglePin))
            } else {
                icon_button("non-starred-symbolic", "Pin", Some(Msg.TogglePin))
            };
            Bar {
                start: [
                    back,
                    icon_button("go-home-symbolic", "Home", Some(Msg.Home)),
                    forward,
                    icon_button("view-refresh-symbolic", "Reload", Some(Msg.Reload)),
                ],
                title: row([place, star]).spacing(SPACE_SM).expand(),
                end: [
                    icon_button("dialog-information-symbolic", "App info", Some(Msg.TogglePanel)),
                    share,
                ],
            }
        }
    }
}

/**
 * Builds the tab rail on the right. Home isn't a tab: + and ⌂ show it.
 *
 * @param open the open tabs, in order
 * @param current the current tab's id; `None` on home
 * @returns the rail: one button per app, +, then settings and more (disabled)
 *
 * Example:
 *     rail(m.tabs, m.current, pinned_paths)
 */
public fun rail(open: Tab[], current: Option<i64>, pinned: string[]): View<Msg> {
    let mut items = open.map(
        fun(t: Tab) = tab_button(t, current, pinned.any(fun(p: string) = p == t.page.path)),
    );
    items.push(icon_button("list-add-symbolic", "New tab", Some(Msg.NewTab)));
    items.push(separator().width(RAIL_WIDTH));
    items.push(spacer());
    items.push(icon_button("emblem-system-symbolic", "Settings (coming soon)", None));
    items.push(icon_button("view-more-symbolic", "More (coming soon)", None));
    // Each item at its own size on the rail's center line, not stretched
    // across it: a stretched button's icon would sit at its left.
    let centered = items.map(fun(v: View<Msg>) = v.align(Align.Center));
    column(centered).spacing(SPACE_SM).padding(SPACE_SM).width(RAIL_WIDTH)
}

/**
 * Returns what a tab is called: "name · title", or the name alone.
 *
 * @param p the app page
 * @returns its label
 *
 * Example:
 *     label(page)
 */
public fun label(p: AppPage): string = match p.title {
    Some(t) => "{p.name} · {t}",
    None => p.name,
};

/**
 * Returns a name's first character, upper-cased: the stand-in for app art
 * until PRP-003 (DECISION-018).
 *
 * @param name the app's name
 * @returns one character, or "?" for an empty name
 *
 * Example:
 *     initial("counter")
 */
public fun initial(name: string): string {
    for c of name.chars() {
        return "{c.to_upper()}";
    }
    "?"
}

/** An icon-only button with a tooltip; `None` means disabled. */
fun icon_button(icon: string, tip: string, msg: Option<Msg>): View<Msg> = match msg {
    Some(m) => button("", m).icon(icon).tooltip(tip).button_style(ButtonStyle.Subtle),
    // kivuli: `.disabled(true)` removes the message, so any one will do.
    None => button("", Msg.Home).disabled(true).icon(icon).tooltip(tip).button_style(
        ButtonStyle.Subtle,
    ),
};

fun tab_button(t: Tab, current: Option<i64>, pinned: bool): View<Msg> {
    let look = if current == Some(t.id) { ButtonStyle.Primary } else { ButtonStyle.Subtle };
    let face = match icon_of(t.page.path, t.page.icon) {
        Some(img) => button("", Msg.Select(t.id)).image(img).size(TAB_ICON),
        None => button(initial(t.page.title.unwrap_or(t.page.name)), Msg.Select(t.id)),
    };
    face.tooltip(label(t.page)).button_style(look).width(TAB_SIZE).height(TAB_SIZE).menu(
        tab_menu(t, pinned),
    )
}

/**
 * A tab's right-click menu: what the bar and panel do, for that tab (it's
 * selected first). Reload waits while the tab loads; Forget asks in the panel.
 */
fun tab_menu(t: Tab, pinned: bool): MenuEntry<Msg>[] = [
    if is_loading(t.page) {
        item("Reload", Msg.OnTab(t.id, TabAction.Reload)).disabled(true)
    } else {
        item("Reload", Msg.OnTab(t.id, TabAction.Reload))
    },
    item(if pinned { "Unpin" } else { "Pin to home" }, Msg.OnTab(t.id, TabAction.TogglePin)),
    item("About this app", Msg.OnTab(t.id, TabAction.About)),
    menu_separator(),
    item("Close tab", Msg.OnTab(t.id, TabAction.Close)),
    item("Forget this app…", Msg.OnTab(t.id, TabAction.Forget)),
];

/**
 * Returns how Rapidkoi names where an app came from: `✓ localhost:8000 ·
 * verified (development)` from a signed site, `✓ host` for a signed file
 * whose key is trusted, `⚠ host · not confirmed` for one whose isn't,
 * `🛠 localhost:8000 · development` from an unsigned development server,
 * `📦 file · local bundle` for a `.rkb`, `📄 file · local file` for a bare
 * module, and `localhost:8000 · loading…` while it loads. Drawn only by
 * Rapidkoi, never by an app.
 *
 * Example:
 *     marker(page, "counter.rkb")
 */
public fun marker(p: AppPage, shown: string): string = match p.trust {
    // Nothing claims ✓ or ⚠ before every check has passed.
    None if is_loading(p) => "{p.name} · loading…",
    Some(t) => {
        let separate = if t.separate { " · new publisher" } else { "" };
        match t.standing {
            // "(development)" only for this machine: a remote host is the real thing.
            Verified => if remote(p.path) {
                "✓ {t.host} · verified{separate}"
            } else {
                "✓ {t.host} · verified (development){separate}"
            },
            Trusted => "✓ {t.host}{separate}",
            NotConfirmed => "⚠ {t.host} · not confirmed",
        }
    }
    None => match parse(p.path) {
        Ok(a) => "🛠 {address.shown(a)} · development",
        Err(_) => match p.manifest {
            Some(_) => "📦 {shown} · local bundle",
            None => "📄 {shown} · local file",
        },
    },
};

/** Whether a page came from another machine's address. */
fun remote(path: string): bool = parse(path).map(fun(a) = a.remote).unwrap_or(false);

/**
 * The page asking about a key that changed without its old key's approval.
 * There's no "run anyway": keep the version that was open, or open the new
 * publisher as a separate app.
 *
 * @param c the change
 * @param open whether a page was open before (otherwise keeping closes the tab)
 *
 * Example:
 *     unapproved(change, true)
 */
public fun unapproved(c: Change, open: bool): View<Msg> = column([
    text("{c.host} is now signed by a different key").size(TEXT_TITLE).bold().align(Align.Start),
    text("This can mean the site changed owners.").dim().align(Align.Start),
    text("Before: key {fingerprint(c.old)} · Now: key {fingerprint(c.new)}").dim().align(
        Align.Start,
    ),
    row([
        button(
            if open { "Keep using my version" } else { "Don't open it" },
            Msg.KeepMine,
        ).button_style(ButtonStyle.Primary),
        button("Open as a separate app", Msg.SeparateApp),
    ]).spacing(SPACE_SM),
]).spacing(SPACE_SM);

/**
 * Returns an app's icon as a kivuli image, keyed by its file and role, so
 * kivuli decodes it once, not on every render.
 *
 * @param path the app's file
 * @param icon its icon's PNG bytes, if any
 * @returns the keyed image, or `None`
 *
 * Example:
 *     icon_of(page.path, page.icon)
 */
public fun icon_of(path: string, icon: Option<u8[]>): Option<Image> = icon.map(
    fun(b: u8[]) = Image.Bytes("{path}#icon", b),
);

fun file_of(path: string): string {
    let parts = path.split("/");
    parts[parts.len - 1]
}
