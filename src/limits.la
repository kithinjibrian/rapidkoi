/**
 * Every limit contract v1 puts on a guest app, in one place. A guest that
 * passes one is stopped with an error screen; Rapidkoi keeps running.
 * Values from `docs/source/meetings/2026-10-17-ui-contract.md`.
 *
 * Used by: guest, contract
 */

/** The contract version this shell speaks (`rapidkoi_version()`). */
public const CONTRACT_VERSION: i32 = 1;

/** The largest module file Rapidkoi will compile, in bytes. */
public const MAX_MODULE: i64 = 32 * 1024 * 1024;

/** The most a guest's linear memory may grow to, in bytes. */
public const MEMORY_BYTES: i64 = 256 * 1024 * 1024;

/** The largest state a guest may hand back, in bytes. */
public const MAX_STATE: i64 = 16 * 1024 * 1024;

/** The largest screen description a guest may hand back, in bytes. */
public const MAX_VIEW: i64 = 4 * 1024 * 1024;

/** The largest update result: the state plus room for its map and `effects`. */
public const MAX_UPDATE: i64 = MAX_STATE + 4096;

/** The most nodes in one screen description. */
public const MAX_NODES: i64 = 10_000;

/** The deepest one node may sit: the root is depth 1. */
public const MAX_NODE_DEPTH: i64 = 64;

/** The longest one string in a screen description, in bytes. */
public const MAX_STRING: i64 = 64 * 1024;

/**
 * Fuel for one call into a guest: about 100 ms of work on the development
 * machine. Calibrated in session 6; see the measurement in CONTEXT.md.
 */
public const FUEL_PER_CALL: u64 = 100_000_000;
