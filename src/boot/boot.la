/**
 * Rapidkoi's start (PRP-068, DECISION-096), as its stages in order, so no
 * app runs before what it reads:
 *
 *   1. setup         the wasmtime engine, SQLite's shared memory cap, the clock
 *   2. folder        the data folder (`shell.boot`; none: nothing saved, a notice)
 *   3. restore       what the folder holds, part by part (`data.restoring`)
 *   4. session       the session that ended becomes "previous", for Restore
 *   5. builtins      the new tab, its module through the modules kept for the run
 *   6. first_window  the blank tab, the focus in the address bar; or, given a
 *                    file or address, its tab
 *   7. settled       the passes every update runs (`boot.settle`)
 *
 * Then Rapidkoi runs: its subscriptions, and `Launched` for what the
 * command line or the desktop names. Settings and All apps compile into
 * the same modules the first time they open.
 *
 * Depends on: kivuli, std.time, sqlite, wasmtime, guest.limits, guest.modules, data.restoring, data.sessions, data.saving, data.store, window.window, window.newtab, window.navigate, window.actions, boot.settle
 * Used by: shell
 */
import kivuli { Cmd };
import std.time;
import sqlite;
import wasmtime { Engine };
import guest.limits { SQLITE_HEAP };
import data.restoring { restore };
import data.sessions { begin_session };
import data.saving { mark };
import data.store { Store };
import window.window { Model, with_pages, new_blank };
import window.newtab;
import window.navigate;
import window.actions { Msg };
import boot.settle { settled };

/**
 * Builds the first window on a data folder (or none, saving nothing), the
 * new tab running `bundle`: stages 1 and 3 to 7. Tests start here with a
 * folder of their own.
 *
 * Example:
 *     start_with(["./main"], Some(store_at("test/tmp/s")), newtab.BUNDLE)
 */
fun start_with(argv: string[], s: Option<Store>, bundle: u8[]): (Model, Cmd<Msg>) {
    let set = setup();
    let remembered = match s {
        Some(st) => session(restore(set, st), st),
        None => set,
    };
    let ready = builtins(remembered, bundle);
    let (before, after, cmd) = first_window(ready, argv);
    settled(before, after, cmd, mark(before))
}

/**
 * Stage 1: the engine every app compiles with, SQLite's one memory cap for
 * every app's database (PRP-041), and the clock, so a place recorded before
 * the first tick has its time.
 *
 * Example:
 *     setup()
 */
fun setup(): Model {
    sqlite.heap_limit(SQLITE_HEAP);
    Model { now: time.now_ms(), ..with_pages(Engine.new(), []) }
}

/**
 * Stage 4: the session that just ended becomes the previous one, for the
 * new tab's Restore (PRP-035; the owner's model, session 186).
 *
 * Example:
 *     session(restore(m, s), s)
 */
fun session(m: Model, s: Store): Model = begin_session(m, s);

/**
 * Stage 5: the new tab's app, once for the window, now that what it reads
 * is there; without it the empty tab is just empty (PRP-027). Its module is
 * kept for the run. Nothing reopens on its own: the last session waits
 * for Restore.
 *
 * Example:
 *     builtins(m, newtab.BUNDLE)
 */
fun builtins(m: Model, bundle: u8[]): Model {
    let held = Ref.new(m.modules);
    let page = newtab.open_kept(held, m.engine, m.now, bundle).ok();
    Model { newtab: page, modules: held.get(), ..m }
}

/**
 * Stage 6: the window. With nothing named, the blank tab, the focus in the
 * address bar (the owner, sessions 182–183), what restoring said still
 * showing; given a file or address (tests, `start_with`), its tab.
 *
 * @returns the window before and after, and what the stage sends, for Settle
 *
 * Example:
 *     first_window(m, ["./main"])
 */
fun first_window(m: Model, argv: string[]): (Model, Model, Cmd<Msg>) {
    if argv.len < 2 {
        let blank = Model { notice: m.notice, ..new_blank(m) };
        // Settled from the blank tab itself: nothing resumes, nothing is told.
        return (blank, blank, Cmd.focus("address"));
    }
    let (placed, cmd) = navigate.open_file(m, argv[1]);
    (m, placed, cmd)
}
