/**
 * Rapidkoi's window as a kivuli app: `boot` from the command line, `update`
 * for every message, and `view` composing the bar (in the header bar), home
 * or the current app (with the info panel beside it), and the rail, in the
 * current theme, maximized. The state and what
 * changes it live in `window.la`; `view` never calls a guest.
 *
 * Depends on: kivuli, wasmtime, actions, tabs, window, render, frame, home, panel, theme, themes
 * Used by: main
 */
import kivuli { View, Cmd, column, row, scroll, text };
import wasmtime { Engine };
import actions { Msg, PanelPage };
import tabs { AppPage, open_path, handle };
public import window { Model, with_pages, title_of };
import navigate;
import render { screen, stopped };
import frame { bar, rail };
import home;
import panel;
import theme { SPACE_SM, SPACE_MD, SPACE_LG, WINDOW_WIDTH, WINDOW_HEIGHT };
import themes { Look, kivuli_theme };

/**
 * Builds the first window from the command line: `./main` shows home,
 * `./main path/to/app.wasm` opens that app in a tab.
 *
 * @param argv the program's arguments, `argv[0]` its path
 * @returns the first model, and a command focusing the box on home
 *
 * Example:
 *     App { init: boot(args()), … }
 */
public fun boot(argv: string[]): (Model, Cmd<Msg>) {
    let engine = Engine.new();
    if argv.len < 2 {
        return (with_pages(engine, []), Cmd.focus("address"));
    }
    (with_pages(engine, [open_path(engine, argv[1])]), Cmd.none())
}

/**
 * Handles one message from the window.
 *
 * @param m the model
 * @param msg what was pressed or typed
 * @returns the next model, and a command (focusing the box, or none)
 *
 * Example:
 *     update(m, Msg.NewTab)
 */
public fun update(m: Model, msg: Msg): (Model, Cmd<Msg>) = match msg {
    Tab(id, inner) => (window.with_tab(m, id, fun(a: AppPage) = handle(a, inner)), Cmd.none()),
    Select(id) => (window.show_tab(m, id), Cmd.none()),
    // Home isn't a tab: + and ⌂ both show it, keeping every app open.
    NewTab | Home => (window.go_home(m), Cmd.focus("address")),
    CloseTab(id) => (window.close(m, id), Cmd.none()),
    Draft(text) => (Model { draft: text, notice: None, ..m }, Cmd.none()),
    Go => (navigate.go(m), Cmd.none()),
    EditAddress => match window.page_of(m) {
        App(a) => (Model { editing: true, draft: a.path, ..m }, Cmd.focus("address")),
        Home => (m, Cmd.focus("address")),
    },
    OpenPinned(path) => (navigate.open_file(window.go_home(m), path), Cmd.none()),
    Continue => (navigate.reopen(m), Cmd.none()),
    TogglePanel => (
        Model {
            panel: if m.panel.is_some() { None } else { Some(PanelPage.Main) },
            confirm: None,
            ..m,
        },
        Cmd.none(),
    ),
    TogglePin => (window.toggle_pin(m), Cmd.none()),
    PanelGo(page) => (Model { panel: Some(page), confirm: None, ..m }, Cmd.none()),
    PanelBack => (Model { panel: Some(PanelPage.Main), confirm: None, ..m }, Cmd.none()),
    Ask(c) => (Model { confirm: Some(c), ..m }, Cmd.none()),
    Cancel => (Model { confirm: None, ..m }, Cmd.none()),
    StartOver => match m.current {
        Some(id) => (
            Model {
                confirm: None,
                ..window.with_tab(m, id, fun(a: AppPage) = handle(a, render.Msg.Restart)),
            },
            Cmd.none(),
        ),
        None => (m, Cmd.none()),
    },
    Forget => (window.forget(m), Cmd.none()),
    FocusSearch => (m, Cmd.focus("address")),
    Reload => (navigate.reload(m), Cmd.none()),
};

/**
 * Draws the window: the bar, home or the current app (with the panel
 * beside it when open), and the rail. Never calls a guest.
 *
 * @param m the model
 * @returns the window's view
 *
 * Example:
 *     view(m)
 */
public fun view(m: Model): View<Msg> {
    let page = window.page_of(m);
    // On an app page m.current is Some: page_of found its tab.
    let id = m.current.unwrap_or(-1);
    let middle = match page {
        Home => card(home.view(m.draft, m.pinned, window.card(m), m.tabs)),
        App(a) if m.panel.is_some() => row([
            card(app_view(id, a)).expand(),
            // The panel on the page's colour, a strip of frame between it and the
            // app, so its section cards (the frame's colour) stand out.
            scroll(panel.view(a, m.panel.unwrap_or(PanelPage.Main), m.confirm)).style([Look.Page]).padding(SPACE_SM),
        ]),
        App(a) => card(app_view(id, a)),
    };
    let mut parts: View<Msg>[] = [];
    if let Some(n) = m.notice {
        parts.push(text(n).dim().padding(SPACE_MD));
    }
    parts.push(row([middle.expand(), rail(m.tabs, m.current)]).expand());
    let pinned = match page {
        App(a) => window.is_pinned(m, a.path),
        Home => false,
    };
    let b = bar(page, m.draft, m.editing, pinned);
    column(parts).style([Look.Frame]).window(
        title_of(m),
        WINDOW_WIDTH,
        WINDOW_HEIGHT,
    ).maximized().theme(kivuli_theme(m.theme)).header(b.start, b.title, b.end).header_style([
        Look.Frame,
    ])
}

/**
 * The page, flush with the frame: it meets the header bar above and the rail
 * on its right, and the window's edges on the left and bottom.
 */
fun card(v: View<Msg>): View<Msg> = scroll(v.padding(SPACE_LG)).style([Look.Page]);

/** A tab's app, its messages tagged with the tab, so they reach only it. */
fun app_view(id: i64, a: AppPage): View<Msg> {
    let shown = match a.screen {
        Running(_, _, d) => screen(d.root),
        Stopped(why, can_restart) => stopped(why, can_restart),
    };
    shown.map(fun(inner: render.Msg) = Msg.Tab(id, inner))
}
