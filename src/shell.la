/**
 * Rapidkoi's window as a kivuli app: `boot` from the command line, `update`
 * for every message, and `view`, the bare frame from `layout.la` (PRP-014).
 * The state and what changes it live in `window.la`; `view` never calls a
 * guest.
 *
 * Depends on: kivuli, wasmtime, window.actions, window.tabs, window.window, data.saving, data.store, net.loads, guest.effects, net.requests, people.access, people.account, ui.render, ui.layout
 * Used by: main
 */
import kivuli { View, Cmd, Sub };
import wasmtime { Engine };
import window.actions { Msg, PanelPage, Confirm, TabAction, PinAction };
import window.tabs { AppPage, Tab, Pin, handle, is_loading };
import net.loads;
import guest.effects { answer_all };
import net.requests;
import people.account { on_account, forget_account };
import people.access { on_access, looked, news };
public import window.window { Model, with_pages, title_of };
import window.navigate;
import data.saving { session_store, restore, persist, mark, forgotten };
import data.store { Store };
import ui.render;
import ui.layout;

/**
 * Builds the first window from the command line, remembering what this
 * person's data folder holds: `./main` shows home, `./main path/to/app.wasm`
 * opens that app in a tab.
 *
 * @param argv the program's arguments, `argv[0]` its path
 * @returns the first model, and a command focusing the box on home
 *
 * Example:
 *     App { init: boot(args()), … }
 */
public fun boot(argv: string[]): (Model, Cmd<Msg>) = match session_store() {
    Ok(s) => start(argv, Some(s)),
    Err(e) => {
        let (m, cmd) = start(argv, None);
        (Model { notice: Some(store.reason(e)), ..m }, cmd)
    }
};

/**
 * Builds the first window on a data folder (or none, saving nothing).
 * Tests start here with a folder of their own, never the person's.
 *
 * Example:
 *     start(["./main"], Some(store_at("test/tmp/s")))
 */
public fun start(argv: string[], s: Option<Store>): (Model, Cmd<Msg>) {
    let empty = with_pages(Engine.new(), []);
    let remembered = match s {
        Some(st) => restore(empty, st),
        None => empty,
    };
    if argv.len < 2 {
        return (remembered, Cmd.focus("address"));
    }
    let at = mark(remembered);
    let (placed, cmd) = navigate.open_file(remembered, argv[1]);
    let (answered, sends) = answer_all(placed);
    let opened = persist(remembered, news(answered), at);
    // Opening clears the notice line; what restoring said still shows.
    let notice = match (remembered.notice, opened.notice) {
        (Some(a), Some(b)) => Some("{a} · {b}"),
        (Some(a), None) => Some(a),
        (None, b) => b,
    };
    (Model { notice: notice, ..opened }, both(cmd, sends))
}

/**
 * What the window listens to: the loading tick (120 ms) while some tab is
 * loading in the background, and nothing otherwise.
 *
 * Example:
 *     App { subscriptions: subscriptions, … }
 */
public fun subscriptions(m: Model): Sub<Msg> = if m.tabs.any(fun(t: Tab) = is_loading(t.page)) {
    Sub.every(120, Msg.Tick)
} else {
    Sub.none()
};

/**
 * Handles one message from the window, then saves whatever it changed
 * that Rapidkoi remembers (PRP-007).
 *
 * Example:
 *     update(m, Msg.NewTab)
 */
public fun update(m: Model, msg: Msg): (Model, Cmd<Msg>) {
    // The keyring is shared by every copy of the model: mark it first.
    let at = mark(m);
    let (next, cmd) = handle_msg(m, msg);
    // What a v2 app asked for is answered before anything is drawn or saved.
    let (answered, sends) = answer_all(next);
    // What each app declares, and "New" cleared once its Access page is left.
    (persist(m, news(looked(m, answered)), at), both(cmd, sends))
}

/** Two commands as one; either alone when the other does nothing, so a lone task stays a task. */
fun both(a: Cmd<Msg>, b: Cmd<Msg>): Cmd<Msg> = match (a, b) {
    (_, Nothing) => a,
    (Nothing, _) => b,
    _ => Cmd.batch([a, b]),
};

/**
 * Handles one message from the window.
 *
 * @param m the model
 * @param msg what was pressed or typed
 * @returns the next model, and a command (focusing the box, or none)
 *
 * Example:
 *     handle_msg(m, Msg.NewTab)
 */
fun handle_msg(m: Model, msg: Msg): (Model, Cmd<Msg>) = match msg {
    Tab(id, inner) => (window.with_tab(m, id, fun(a: AppPage) = handle(a, inner)), Cmd.none()),
    // Choosing a tab, from the address box's suggestions too, closes them.
    Select(id) => (window.show_tab(Model { draft: "", ..m }, id), Cmd.none()),
    // Home isn't a tab: + and ⌂ both show it, keeping every app open.
    NewTab | Home => (window.go_home(m), Cmd.focus("address")),
    CloseTab(id) => (window.close(m, id), Cmd.none()),
    Draft(text) => (Model { draft: text, notice: None, ..m }, Cmd.none()),
    Go => navigate.go(m),
    Dismiss => (Model { draft: "", editing: false, notice: None, ..m }, Cmd.none()),
    EditAddress => match window.page_of(m) {
        App(a) => (Model { editing: true, draft: a.path, ..m }, Cmd.focus("address")),
        Home => (m, Cmd.focus("address")),
    },
    OpenPinned(path) => navigate.open_file(window.go_home(m), path),
    Continue => navigate.reopen(Model { draft: "", editing: false, ..m }),
    TogglePanel => (
        Model {
            panel: if m.panel.is_some() { None } else { Some(PanelPage.Main) },
            confirm: None,
            ..m,
        },
        Cmd.none(),
    ),
    TogglePin => (window.toggle_pin(m), Cmd.none()),
    PanelGo(page) => (Model { panel: Some(page), confirm: None, ..m }, Cmd.none()),
    PanelBack => (Model { panel: Some(PanelPage.Main), confirm: None, ..m }, Cmd.none()),
    Ask(c) => (Model { confirm: Some(c), ..m }, Cmd.none()),
    Cancel => (Model { confirm: None, ..m }, Cmd.none()),
    StartOver => match m.current {
        Some(id) => (
            Model {
                confirm: None,
                ..window.with_tab(m, id, fun(a: AppPage) = handle(a, render.Msg.Restart)),
            },
            Cmd.none(),
        ),
        None => (m, Cmd.none()),
    },
    Forget => (forget_account(m, forgotten(m, window.forget(m))), Cmd.none()),
    FocusSearch => (m, Cmd.focus("address")),
    Reload => navigate.reload(m),
    KeepMine => (navigate.keep_mine(m), Cmd.none()),
    SeparateApp => navigate.separate_app(m),
    Fetched(id, number, f) => loads.arrive(m, id, number, f),
    Responded(id, load, msg, got) => (requests.arrive(m, id, load, msg, got), Cmd.none()),
    ToggleServer(server) => (on_access(m, server), Cmd.none()),
    Tick(now) => (Model { now: now, ..m }, Cmd.none()),
    OnTab(id, action) => on_tab(m, id, action),
    OnPin(path, action) => on_pin(m, path, action),
    SetName(_, _, _) | ToggleAutoSignIn | SignOut | SignIn | StartOverIdentity => (
        on_account(m, msg),
        Cmd.none(),
    ),
};

/**
 * A tab's menu item: select that tab, then do what the bar or panel would.
 * A tab that's gone does nothing. Forget opens the panel at its question.
 */
fun on_tab(m: Model, id: i64, action: TabAction): (Model, Cmd<Msg>) {
    if !m.tabs.any(fun(t: Tab) = t.id == id) {
        return (m, Cmd.none());
    }
    let at = window.show_tab(m, id);
    match action {
        Reload => navigate.reload(at),
        TogglePin => (window.toggle_pin(at), Cmd.none()),
        About => (Model { panel: Some(PanelPage.About), confirm: None, ..at }, Cmd.none()),
        Close => (window.close(at, id), Cmd.none()),
        Forget => (
            Model { panel: Some(PanelPage.Main), confirm: Some(Confirm.Forget), ..at },
            Cmd.none(),
        ),
    }
}

/** A home tile's menu item, for the app at `path`. Forget opens it, then the panel at its question. */
fun on_pin(m: Model, path: string, action: PinAction): (Model, Cmd<Msg>) = match action {
    Open => navigate.open_file(window.go_home(m), path),
    Unpin => (Model { pinned: m.pinned.filter(fun(p: Pin) = p.path != path), ..m }, Cmd.none()),
    Forget => {
        let (opened, cmd) = navigate.open_file(window.go_home(m), path);
        (Model { panel: Some(PanelPage.Main), confirm: Some(Confirm.Forget), ..opened }, cmd)
    }
};

/**
 * Draws the window: the bare frame (PRP-014). Never calls a guest.
 *
 * @param m the model
 * @returns the window's view
 *
 * Example:
 *     view(m)
 */
public fun view(m: Model): View<Msg> = layout.view(m);
