/**
 * Rapidkoi's window as a kivuli app: `boot` from the command line (its
 * stages are `boot.boot`'s, PRP-068), `update` for every message (ending in
 * `boot.settle`), and `view`, the bare frame from `layout.la` (PRP-014).
 * The state and what changes it live in `window.la`; `view` never calls a
 * guest.
 *
 * Depends on: kivuli, boot.boot, boot.settle, window.actions, window.tabs, window.window, data.saving, data.store, net.loads, guest.effects, net.requests, people.access, people.account, ui.render, ui.layout
 * Used by: main
 */
import kivuli { View, Cmd, Sub, FileFilter };
import std.time;
import window.actions { Msg, PanelPage, ShieldPage, Confirm, TabAction, PinAction };
import window.tabs { AppPage, Tab, Pin, handle, is_loading };
import net.loads;
import net.checks;
import window.choosing;
import window.notices { for_rapidkoi, told, dismiss, with_more, nothing_saved, data_not_removed };
import guest.effects { approve };
import net.requests;
import net.downloads;
import data.queries;
import data.databases;
import guest.storing;
import data.kept;
import guest.limits { CHECK_EVERY_MS };
import people.account { on_account, forget_account };
import people.access { on_access, set_permission };
import people.people { with_looks };
import window.window { Model };
import window.navigate;
import window.ownapps;
import window.pins;
import window.zones;
import window.instances { close_instance, close_app, start_rename, confirm_rename };
import window.newtab;
import data.saving { session_store, mark, forgotten };
import boot.settle { settled, both };
import boot.boot as stages;
import data.sessions { restored };
import data.store { Store };
import ui.render;
import ui.layout;
import ui.frame { address_of };
import net.address { is_address };

/**
 * Builds the first window from the command line, remembering what this
 * person's data folder holds: `./main` shows home, `./main path/to/app.wasm`
 * opens that app in a tab.
 *
 * @param argv the program's arguments, `argv[0]` its path
 * @returns the first model, and a command focusing the box on home
 *
 * Example:
 *     App { init: boot(args()), … }
 */
fun boot(argv: string[]): (Model, Cmd<Msg>) = match session_store() {
    Ok(s) => start(argv, Some(s)),
    Err(e) => {
        let (m, cmd) = start(argv, None);
        (for_rapidkoi(m, nothing_saved(store.reason(e))), cmd)
    }
};

/** Builds the first window with the new tab built into ./main (`start_with`). */
fun start(argv: string[], s: Option<Store>): (Model, Cmd<Msg>) = start_with(argv, s, newtab.BUNDLE);

/**
 * Builds the first window on a data folder (or none, saving nothing), the
 * new tab running `bundle`: Rapidkoi's start, stage by stage (`boot.boot`,
 * PRP-068). Tests start here with a folder of their own.
 *
 * Example:
 *     start_with(["./main"], Some(store_at("test/tmp/s")), newtab.BUNDLE)
 */
fun start_with(
    argv: string[],
    s: Option<Store>,
    bundle: u8[],
): (Model, Cmd<Msg>) = stages.start_with(argv, s, bundle);

/** A minute, in milliseconds: the time tick (PRP-053). */
const MINUTE_MS: i64 = 60_000;

/**
 * What the window listens to: the loading tick (120 ms) while some tab is
 * loading in the background, a minute's tick while the screen in front
 * shows a time, and, while a kept app is in front, a check
 * against its site every `CHECK_EVERY_MS` and when the window comes back to
 * the front (PRP-044).
 *
 * Example:
 *     App { subscriptions: subscriptions, … }
 */
fun subscriptions(m: Model): Sub<Msg> {
    let mut subs: Sub<Msg>[] = [];
    if m.tabs.any(fun(t: Tab) = is_loading(t.page)) {
        subs.push(Sub.every(120, Msg.Tick));
    }
    let in_front = match window.page_of(m) {
        App(p) => p.cached.is_some(),
        Home => false,
    };
    // A minute's tick while the screen in front shows a time: "5 minutes ago" moves on (PRP-053).
    if zones.shows_time(m) {
        subs.push(Sub.every(MINUTE_MS, Msg.Tick));
    }
    if in_front {
        subs.push(Sub.every(CHECK_EVERY_MS, Msg.CheckForUpdates));
        // And when the window comes back to the front (PRP-044, DECISION-054).
        subs.push(Sub.window_active(fun(on: bool) = Msg.WindowActive(on)));
    }
    match subs.len {
        0 => Sub.none(),
        1 => subs[0],
        _ => Sub.batch(subs),
    }
}

/**
 * Handles one message from the window, then saves whatever it changed
 * that Rapidkoi remembers (PRP-007).
 *
 * Example:
 *     update(m, Msg.NewTab)
 */
fun update(m: Model, msg: Msg): (Model, Cmd<Msg>) {
    // The keyring is shared by every copy of the model: mark it first.
    let at = mark(m);
    let (handled, cmd) = handle_msg(m, msg);
    // The shield's card belongs to one page: leaving it (another tab, home,
    // another app in this tab) closes it (PRP-021).
    // Site settings too (PRP-022).
    // A card the message itself opened (About or Forget from another tab's
    // menu) stays: only what was open on the old page closes.
    let next = if shown(handled) != shown(m) {
        Model {
            shield: if handled.shield == m.shield { None } else { handled.shield },
            panel: if handled.panel == m.panel { None } else { handled.panel },
            ..handled,
        }
    } else {
        handled
    };
    // An approval waits on its own tab now, not a no when it goes to the back
    // (PRP-057). Leaving All apps closes it (PRP-067). The rest is Settle's,
    // as after Rapidkoi starts (PRP-068).
    settled(m, ownapps.left_all_apps(m, next), cmd, at)
}

/** The page the window shows: its tab and its app's path; `None` on home. */
fun shown(m: Model): Option<(i64, string)> = match (m.current, window.page_of(m)) {
    (Some(id), App(a)) => Some((id, a.path)),
    _ => None,
};

/** What share copies: an app's link at an address, else its file's path. */
fun shared(p: AppPage): string = if is_address(p.path) { address_of(p) } else { p.path };

/**
 * Handles one message from the window.
 *
 * @param m the model
 * @param msg what was pressed or typed
 * @returns the next model, and a command (focusing the box, or none)
 *
 * Example:
 *     handle_msg(m, Msg.NewTab)
 */
fun handle_msg(m: Model, msg: Msg): (Model, Cmd<Msg>) = match msg {
    Tab(id, inner) => (window.with_tab(m, id, fun(a: AppPage) = handle(a, inner)), Cmd.none()),
    // Choosing a tab, from the address box's suggestions too, closes them.
    Select(id) => (window.show_tab(Model { draft: "", ..m }, id), Cmd.none()),
    // Home isn't a tab: + and ⌂ both show it, keeping every app open.
    // + adds an empty tab; Home shows one, the current if it's empty (PRP-024).
    NewTab => (window.new_blank(m), Cmd.focus("address")),
    Home => (window.go_home(m), Cmd.focus("address")),
    // One of several instances closes to another of the same app (PRP-033).
    CloseTab(id) => (close_instance(m, id), Cmd.none()),
    CloseApp(id) => (close_app(m, id), Cmd.none()),
    // The new tab's own clicks (session 185): what it asks for is answered
    // after, as for any app.
    FromNewTab(inner) => (
        Model { newtab: m.newtab.map(fun(p: AppPage) = handle(p, inner)), ..m },
        Cmd.none(),
    ),
    // The new tab's Restore (PRP-035): the last session's windows, added.
    // Stacked under what's open, the current winning where they overlap;
    // then it's part of the current session (the owner, session 186).
    RestoreSession => match m.previous {
        Some(o) => navigate.reopen_all(restored(Model { previous: None, ..m }), o),
        None => (m, Cmd.none()),
    },
    NewInstance => navigate.new_instance(m),
    RenameInstance(id) => (start_rename(m, id), Cmd.none()),
    InstanceName(typed) => (
        Model { renaming: m.renaming.map(fun(r: (i64, string)) = (r.0, typed)), ..m },
        Cmd.none(),
    ),
    ConfirmRename => (confirm_rename(m), Cmd.none()),
    // Typing in the field starts editing: on an app, what's typed replaces
    // its address in the box until Enter or Dismiss (PRP-025).
    Draft(text) => (Model { draft: text, editing: true, ..m }, Cmd.none()),
    Go => navigate.go(m),
    Dismiss => (Model { draft: "", editing: false, ..m }, Cmd.none()),
    // One card at a time: opening the shield's closes site settings (PRP-022).
    Shield(page) => (
        Model { shield: page, panel: if page.is_some() { None } else { m.panel }, ..m },
        Cmd.none(),
    ),
    EditAddress => match window.page_of(m) {
        App(a) => (Model { editing: true, draft: a.path, ..m }, Cmd.focus("address")),
        Home => (m, Cmd.focus("address")),
    },
    OpenPinned(path, origin) => navigate.open_pin(m, path, origin),
    OpenPlace(to, origin) => navigate.open_place(m, to, origin),
    Approve(a) => approve(m, a),
    SetPermission(name, s) => (set_permission(m, name, s), Cmd.none()),
    TogglePanel => (
        Model {
            panel: if m.panel.is_some() { None } else { Some(PanelPage.Main) },
            // One card at a time: site settings close the shield's (PRP-022).
            // A question stays: it's over the app's area, not in the card (PRP-057).
            shield: None,
            ..m,
        },
        // Opening it: its app's data's size, read in a task (PRP-041).
        if m.panel.is_none() { sizing(m) } else { Cmd.none() },
    ),
    // Closing only, never a toggle: a popover may say it closed more than
    // once, and a toggle reopened it over everything (session 171).
    ClosePanel => (Model { panel: None, ..m }, Cmd.none()),
    TogglePin => (pins.toggle_pin(m), Cmd.none()),
    Menu(open) => (Model { menu: open, ..m }, Cmd.none()),
    Bell(action) => navigate.on_bell(m, action),
    OpenSettings => (ownapps.open_settings(Model { menu: false, ..m }), Cmd.none()),
    OpenAllApps => (ownapps.open_all_apps(m), Cmd.none()),
    // The owner's words (PRP-058); the chosen file opens as a typed path does.
    OpenApp => (
        Model { menu: false, ..m },
        Cmd.open_file(
            "Open an app",
            [FileFilter { name: "Rapidkoi apps", patterns: ["*.rkb", "*.wasm"] }],
            fun(c: Option<string>) = Msg.AppChosen(c),
        ),
    ),
    AppChosen(Some(path)) => navigate.open_file(m, path),
    AppChosen(None) => (m, Cmd.none()),
    About(open) => (Model { about: open, menu: false, ..m }, Cmd.none()),
    Quit => (m, Cmd.quit()),
    OwnLooks(key, c, t) => (Model { people: with_looks(m.people, key, c, t), ..m }, Cmd.none()),
    ShowInRecent(key, on) => (pins.shown_in_recent(m, key, on), Cmd.none()),
    PanelGo(page) => (Model { panel: Some(page), ..m }, Cmd.none()),
    PanelBack => (Model { panel: Some(PanelPage.Main), ..m }, Cmd.none()),
    Ask(c) => (Model { confirm: Some(c), ..m }, Cmd.none()),
    Cancel => (Model { confirm: None, renaming: None, ..m }, Cmd.none()),
    Forget => {
        // The app the question asked about, wherever you are now (PRP-057).
        let m = match m.confirm {
            Some(Forget(tab)) if m.tabs.any(fun(t: Tab) = t.id == tab) => window.show_tab(m, tab),
            Some(Forget(_)) => {
                return (Model { confirm: None, ..m }, Cmd.none());
            }
            None => m,
        };
        // Its database and its kept copy go with it (PRP-041, PRP-043); a failure is the notice.
        // Its next key is kept past it in forget_account (PRP-052), which never depends on these.
        let said = match (m.current, window.page_of(m)) {
            (Some(id), App(a)) => {
                let copy = copy_removed(m, id);
                let db = data_cleared(m, id);
                (if db.is_some() { db } else { copy }).map(
                    fun(why: string) = data_not_removed(a.name, why),
                )
            }
            _ => None,
        };
        let gone = forget_account(m, forgotten(m, pins.forget(m)));
        // Its tab is gone: Rapidkoi says it (PRP-051).
        (Model { notice: with_more(gone.notice, said), ..gone }, Cmd.none())
    }
    FocusSearch => (m, Cmd.focus("address")),
    Reload => navigate.reload(m),
    KeepMine => (navigate.keep_mine(m), Cmd.none()),
    SeparateApp => (choosing.start_naming(m), Cmd.none()),
    SeparateMoved => choosing.separate_moved(m),
    NameSeparate(typed) => (choosing.name_typed(m, typed), Cmd.none()),
    ConfirmSeparate => choosing.confirm_naming(m),
    CancelSeparate => (choosing.cancel_naming(m), Cmd.none()),
    Choose(origin) => choosing.choose(m, origin),
    Chip(open) => (Model { chip: open, ..m }, Cmd.none()),
    DismissNotice => (dismiss(m), Cmd.none()),
    SetDefault(origin, on) => (choosing.set_default_here(m, origin, on), Cmd.none()),
    Rename(origin) => (choosing.start_rename(m, origin), Cmd.none()),
    Fetched(id, number, f) => loads.arrive(m, id, number, f),
    Refreshed(id, build, r) => (checks.refreshed(m, id, build, r), Cmd.none()),
    CheckForUpdates(_) => (m, checks.check_current(m)),
    Launched(items) => navigate.open_launched(m, items),
    Share => (m, match window.page_of(m) {
        App(p) => Cmd.copy_text(shared(p)),
        Home => Cmd.none(),
    }),
    WindowActive(on) => (m, if on { checks.check_current(m) } else { Cmd.none() }),
    Responded(id, load, msg, got) => (requests.arrive(m, id, load, msg, got), Cmd.none()),
    Pictured(id, load, source, got) => (downloads.arrive(m, id, load, source, got), Cmd.none()),
    Overflowed(id, across, down) => (Model { overflow: (id, across, down), ..m }, Cmd.none()),
    Queried(id, load, msg, got) => (queries.arrive(m, id, load, msg, got), Cmd.none()),
    Wrote(path, id, load, msg, got) => queries.wrote(m, path, id, load, msg, got),
    FileChosen(c) => storing.chosen(m, c),
    FileDone(id, load, msg, got) => (storing.done(m, id, load, msg, got), Cmd.none()),
    DataSized(id, n) => (
        window.with_tab(m, id, fun(a: AppPage) = AppPage { data_size: Some(n), ..a }),
        Cmd.none(),
    ),
    ToggleServer(server) => (on_access(m, server), Cmd.none()),
    // A new minute looks the zone up again; the app isn't called (PRP-053).
    Tick(now) => (
        if now / MINUTE_MS != m.now / MINUTE_MS {
            zones.refresh(m, now)
        } else {
            Model { now: now, ..m }
        },
        Cmd.none(),
    ),
    OnTab(id, action) => on_tab(m, id, action),
    OnPin(path, origin, action) => navigate.on_pin(m, path, origin, action),
    SetName(_, _, _) | SetSignIn(_) => (on_account(m, msg), Cmd.none()),
};

/**
 * A tab's menu item: select that tab, then do what the bar or panel would.
 * A tab that's gone does nothing. Forget opens the panel at its question.
 */
fun on_tab(m: Model, id: i64, action: TabAction): (Model, Cmd<Msg>) {
    if !m.tabs.any(fun(t: Tab) = t.id == id) {
        return (m, Cmd.none());
    }
    let at = window.show_tab(m, id);
    match action {
        Reload => navigate.reload(at),
        TogglePin => (pins.toggle_pin(at), Cmd.none()),
        // About this app is the shield's card now (PRP-022).
        About => (Model { shield: Some(ShieldPage.Main), panel: None, ..at }, Cmd.none()),
        Close => (window.close(at, id), Cmd.none()),
        Forget => (
            Model { panel: Some(PanelPage.Main), confirm: Some(Confirm.Forget(id)), ..at },
            Cmd.none(),
        ),
    }
}

/**
 * Draws the window: the bare frame (PRP-014). Never calls a guest.
 *
 * @param m the model
 * @returns the window's view
 *
 * Example:
 *     view(m)
 */
fun view(m: Model): View<Msg> = layout.view(m);

/**
 * Removes tab `id`'s app's kept copy (PRP-043), when it's a signed app: a
 * folder in Rapidkoi's own data folder, removed as Forget asks. Returns
 * why, when it couldn't.
 */
fun copy_removed(m: Model, id: i64): Option<string> = match (
    m.store,
    m.tabs.iter().find(fun(t: Tab) = t.id == id).and_then(fun(t: Tab) = t.page.trust),
) {
    (Some(s), Some(tr)) => match kept.remove(kept.kept_for(s, tr.host, tr.origin)) {
        Ok(()) => None,
        Err(e) => Some(kept.reason(e)),
    },
    _ => None,
};

/**
 * Removes tab `id`'s app's database (PRP-041): a file in Rapidkoi's own
 * data folder, as saving's are. Returns why, when it couldn't.
 */
fun data_cleared(m: Model, id: i64): Option<string> = match (
    m.store,
    m.tabs.iter().find(fun(t: Tab) = t.id == id),
) {
    (Some(s), Some(t)) => match databases.path_for(s, t.page) {
        Some(path) => match databases.clear(path) {
            Ok(()) => None,
            Err(why) => Some(why),
        },
        None => None,
    },
    _ => None,
};

/** A task reading the current app's database's size for its ⚙ card; nothing when it keeps none. */
fun sizing(m: Model): Cmd<Msg> = match (m.store, m.current) {
    (Some(s), Some(id)) => match m.tabs.iter().find(fun(t: Tab) = t.id == id).and_then(
        fun(t: Tab) = databases.path_for(s, t.page),
    ) {
        Some(path) => Cmd.task(
            fun(): i64 = databases.size_of(path),
            fun(n: i64) = Msg.DataSized(id, n),
        ),
        None => Cmd.none(),
    },
    _ => Cmd.none(),
};
