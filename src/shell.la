/**
 * Rapidkoi's window as a kivuli app: `boot` from the command line, `update`
 * for every message, and `view` composing the bar, home or the current
 * app (with the info panel beside it), and the rail. The state and what
 * changes it live in `window.la`; `view` never calls a guest.
 *
 * Depends on: kivuli, wasmtime, actions, tabs, window, render, frame, home, panel, theme
 * Used by: main
 */
import kivuli { View, Cmd, column, row, scroll, text };
import wasmtime { Engine };
import actions { Msg };
import tabs { AppPage, Pin, open_path, handle };
public import window { Model, with_pages, title_of };
import render { screen, stopped };
import frame { bar, rail };
import home;
import panel;
import theme { SPACE_MD, SPACE_LG, WINDOW_WIDTH, WINDOW_HEIGHT };

/**
 * Builds the first window from the command line: `./main` shows home,
 * `./main path/to/app.wasm` opens that app in a tab.
 *
 * @param argv the program's arguments, `argv[0]` its path
 * @returns the first model, and a command focusing the box on home
 *
 * Example:
 *     App { init: boot(args()), … }
 */
public fun boot(argv: string[]): (Model, Cmd<Msg>) {
    let engine = Engine.new();
    if argv.len < 2 {
        return (with_pages(engine, []), Cmd.focus("address"));
    }
    (with_pages(engine, [open_path(engine, argv[1])]), Cmd.none())
}

/**
 * Handles one message from the window.
 *
 * @param m the model
 * @param msg what was pressed or typed
 * @returns the next model, and a command (focusing the box, or none)
 *
 * Example:
 *     update(m, Msg.NewTab)
 */
public fun update(m: Model, msg: Msg): (Model, Cmd<Msg>) = match msg {
    Tab(id, inner) => (window.with_tab(m, id, fun(a: AppPage) = handle(a, inner)), Cmd.none()),
    Select(id) => (window.show_tab(m, id), Cmd.none()),
    // Home isn't a tab: + and ⌂ both show it, keeping every app open.
    NewTab | Home => (window.go_home(m), Cmd.focus("address")),
    CloseTab(id) => (window.close(m, id), Cmd.none()),
    Draft(text) => (Model { draft: text, notice: None, ..m }, Cmd.none()),
    Go => (window.go(m), Cmd.none()),
    EditAddress => match window.page_of(m) {
        App(a) => (Model { editing: true, draft: a.path, ..m }, Cmd.focus("address")),
        Home => (m, Cmd.focus("address")),
    },
    OpenPinned(path) => (window.open_file(window.go_home(m), path), Cmd.none()),
    Continue => (window.reopen(m), Cmd.none()),
    TogglePanel => (Model { showing_panel: !m.showing_panel, ..m }, Cmd.none()),
    Pin => (window.pin(m), Cmd.none()),
    Unpin(path) => (
        Model { pinned: m.pinned.filter(fun(p: Pin) = p.path != path), ..m },
        Cmd.none(),
    ),
    FocusSearch => (m, Cmd.focus("address")),
};

/**
 * Draws the window: the bar, home or the current app (with the panel
 * beside it when open), and the rail. Never calls a guest.
 *
 * @param m the model
 * @returns the window's view
 *
 * Example:
 *     view(m)
 */
public fun view(m: Model): View<Msg> {
    let page = window.page_of(m);
    // On an app page m.current is Some: page_of found its tab.
    let id = m.current.unwrap_or(-1);
    let middle = match page {
        Home => scroll(home.view(m.draft, m.pinned, window.card(m), m.tabs).padding(SPACE_LG)),
        App(a) if m.showing_panel => row([
            scroll(app_view(id, a).padding(SPACE_LG)).expand(),
            panel.view(id, a, window.is_pinned(m, a.path)),
        ]).spacing(SPACE_MD),
        App(a) => scroll(app_view(id, a).padding(SPACE_LG)),
    };
    let mut parts = [bar(page, m.draft, m.editing).padding(SPACE_MD)];
    if let Some(n) = m.notice {
        parts.push(text(n).dim().padding(SPACE_MD));
    }
    parts.push(row([middle.expand(), rail(m.tabs, m.current)]).expand());
    // kivuli can't maximize yet (DECISION-020): the default size stands in.
    column(parts).window(title_of(m), WINDOW_WIDTH, WINDOW_HEIGHT)
}

/** A tab's app, its messages tagged with the tab, so they reach only it. */
fun app_view(id: i64, a: AppPage): View<Msg> {
    let shown = match a.screen {
        Running(_, _, d) => screen(d.root),
        Stopped(why, can_restart) => stopped(why, can_restart),
    };
    shown.map(fun(inner: render.Msg) = Msg.Tab(id, inner))
}
