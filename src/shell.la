/**
 * Rapidkoi's window as a kivuli app: `boot` from the command line, `update`
 * for every message, and `view`, the bare frame from `layout.la` (PRP-014).
 * The state and what changes it live in `window.la`; `view` never calls a
 * guest.
 *
 * Depends on: kivuli, wasmtime, window.actions, window.tabs, window.window, data.saving, data.store, net.loads, guest.effects, net.requests, people.access, people.account, ui.render, ui.layout
 * Used by: main
 */
import kivuli { View, Cmd, Sub };
import wasmtime { Engine };
import window.actions { Msg, PanelPage, ShieldPage, Confirm, TabAction, PinAction };
import window.tabs { AppPage, Tab, Pin, handle, is_loading, to_front };
import net.loads;
import guest.effects { answer_all, approve, left_behind, tell_changes };
import net.requests;
import people.account { on_account, forget_account };
import people.access { on_access, looked, news, set_permission };
public import window.window { Model, with_pages, title_of };
import window.navigate;
import window.instances { close_instance, close_app, start_rename, confirm_rename, touched };
import window.newtab;
import data.saving { session_store, restore, restore_open, persist, mark, forgotten };
import data.store { Store };
import ui.render;
import ui.layout;

/**
 * Builds the first window from the command line, remembering what this
 * person's data folder holds: `./main` shows home, `./main path/to/app.wasm`
 * opens that app in a tab.
 *
 * @param argv the program's arguments, `argv[0]` its path
 * @returns the first model, and a command focusing the box on home
 *
 * Example:
 *     App { init: boot(args()), … }
 */
public fun boot(argv: string[]): (Model, Cmd<Msg>) = match session_store() {
    Ok(s) => start(argv, Some(s)),
    Err(e) => {
        let (m, cmd) = start(argv, None);
        (Model { notice: Some(store.reason(e)), ..m }, cmd)
    }
};

/**
 * Builds the first window on a data folder (or none, saving nothing).
 * Tests start here with a folder of their own, never the person's.
 *
 * The launch order (session 170): no app runs until the window it reads
 * from is complete.
 * 1. Restore what the data folder holds: trust, pins, where you left off,
 *    people and permission settings.
 * 2. Build the window: the empty tab, or the app's tab.
 * 3. Start the apps: the new tab, then the one named on the command line.
 * 4. Answer what they asked for when they opened.
 *
 * Example:
 *     start(["./main"], Some(store_at("test/tmp/s")))
 */
public fun start(argv: string[], s: Option<Store>): (Model, Cmd<Msg>) {
    let engine = Engine.new();
    // 1. Restore.
    let empty = with_pages(engine, []);
    let (restored, open) = match s {
        Some(st) => restore_open(restore(empty, st), st),
        None => (empty, None),
    };
    // 2 and 3. The new tab's app, once for the window, now that what it
    // reads is there; without it the empty tab is just empty (PRP-027).
    let ready = Model { newtab: newtab.open(engine).ok(), ..restored };
    // 2 and 3. What was open when Rapidkoi closed, reopened in its tabs
    // before anything else is opened (PRP-034).
    let (remembered, reloads) = match open {
        Some(o) if o.tabs.len > 0 => navigate.reopen_all(ready, o),
        _ => (ready, Cmd.none()),
    };
    if argv.len < 2 {
        // Launch lands on the new tab, reopened apps waiting in the dock
        // (the owner, session 182); new_blank makes the one that was in
        // front the one to go back to. It clears the notice line; what
        // restoring said still shows.
        let window_ = Model { notice: remembered.notice, ..window.new_blank(remembered) };
        // 4. What the apps asked for when they opened: the new tab's your
        // pins and where you left off, so the first screen shows them.
        let (answered, sends) = answer_all(window_);
        let focus: Cmd<Msg> = Cmd.focus("address");
        return (answered, both(both(focus, reloads), sends));
    }
    let at = mark(remembered);
    // 2 and 3: the app's tab, and the app in it.
    let (placed, cmd) = navigate.open_file(remembered, argv[1]);
    // 4. What both asked for.
    let (answered, sends) = answer_all(placed);
    let opened = persist(remembered, news(answered), at);
    // Opening clears the notice line; what restoring said still shows.
    let notice = match (remembered.notice, opened.notice) {
        (Some(a), Some(b)) => Some("{a} · {b}"),
        (Some(a), None) => Some(a),
        (None, b) => b,
    };
    (Model { notice: notice, ..opened }, both(both(reloads, cmd), sends))
}

/**
 * What the window listens to: the loading tick (120 ms) while some tab is
 * loading in the background, and nothing otherwise.
 *
 * Example:
 *     App { subscriptions: subscriptions, … }
 */
public fun subscriptions(m: Model): Sub<Msg> = if m.tabs.any(fun(t: Tab) = is_loading(t.page)) {
    Sub.every(120, Msg.Tick)
} else {
    Sub.none()
};

/**
 * Handles one message from the window, then saves whatever it changed
 * that Rapidkoi remembers (PRP-007).
 *
 * Example:
 *     update(m, Msg.NewTab)
 */
public fun update(m: Model, msg: Msg): (Model, Cmd<Msg>) {
    // The keyring is shared by every copy of the model: mark it first.
    let at = mark(m);
    let (handled, cmd) = handle_msg(m, msg);
    // The shield's card belongs to one page: leaving it (another tab, home,
    // another app in this tab) closes it (PRP-021).
    // Site settings too (PRP-022).
    // A card the message itself opened (About or Forget from another tab's
    // menu) stays: only what was open on the old page closes.
    let next = if shown(handled) != shown(m) {
        Model {
            shield: if handled.shield == m.shield { None } else { handled.shield },
            panel: if handled.panel == m.panel { None } else { handled.panel },
            ..handled,
        }
    } else {
        handled
    };
    // An approval whose page went to the back is a no (PRP-031).
    let (decided, denied) = left_behind(next);
    // What a v2 app asked for is answered before anything is drawn or saved:
    // what on_resume and on_change asked for too.
    // The instance now in front is the one its app reopens to (PRP-033).
    let (answered, sends) = answer_all(tell_changes(m, resumed(m, touched(m, decided))));
    // What each app declares, and "New" cleared once its Access page is left.
    (
        persist(m, news(looked(m, answered)), at),
        both(both(both(cmd, denied), sends), into_view(m, answered)),
    )
}

/**
 * Scrolls the sidebar to the current tab when it changed (PRP-028): a
 * tab selected, made or closed to a neighbour may be out of sight. The
 * focus stays where it is.
 */
fun into_view(before: Model, after: Model): Cmd<Msg> = match after.current {
    Some(id) => if before.current != Some(id) { Cmd.scroll_to("tab-{id}") } else { Cmd.none() },
    None => Cmd.none(),
};

/**
 * Tells the page now at the front that it's back (`on_resume`, PRP-030),
 * when the current tab changed to one that was already there: an app tab
 * that existed before this update, or the empty tab, whose page is the new
 * tab's. A page just opened heard `on_open` instead.
 */
fun resumed(before: Model, after: Model): Model = match after.current {
    Some(id) if before.current != Some(id) => if window.is_blank(after, id) {
        Model { newtab: after.newtab.map(to_front), ..after }
    } else if before.tabs.any(fun(t: Tab) = t.id == id) {
        window.with_tab(after, id, to_front)
    } else {
        after
    },
    _ => after,
};

/** The page the window shows: its tab and its app's path; `None` on home. */
fun shown(m: Model): Option<(i64, string)> = match (m.current, window.page_of(m)) {
    (Some(id), App(a)) => Some((id, a.path)),
    _ => None,
};

/** Two commands as one; either alone when the other does nothing, so a lone task stays a task. */
fun both(a: Cmd<Msg>, b: Cmd<Msg>): Cmd<Msg> = match (a, b) {
    (_, Nothing) => a,
    (Nothing, _) => b,
    _ => Cmd.batch([a, b]),
};

/**
 * Handles one message from the window.
 *
 * @param m the model
 * @param msg what was pressed or typed
 * @returns the next model, and a command (focusing the box, or none)
 *
 * Example:
 *     handle_msg(m, Msg.NewTab)
 */
fun handle_msg(m: Model, msg: Msg): (Model, Cmd<Msg>) = match msg {
    Tab(id, inner) => (window.with_tab(m, id, fun(a: AppPage) = handle(a, inner)), Cmd.none()),
    // Choosing a tab, from the address box's suggestions too, closes them.
    Select(id) => (window.show_tab(Model { draft: "", ..m }, id), Cmd.none()),
    // Home isn't a tab: + and ⌂ both show it, keeping every app open.
    // + adds an empty tab; Home shows one, the current if it's empty (PRP-024).
    NewTab => (window.new_blank(m), Cmd.focus("address")),
    Home => (window.go_home(m), Cmd.focus("address")),
    // One of several instances closes to another of the same app (PRP-033).
    CloseTab(id) => (close_instance(m, id), Cmd.none()),
    CloseApp(id) => (close_app(m, id), Cmd.none()),
    NewInstance => navigate.new_instance(m),
    RenameInstance(id) => (start_rename(m, id), Cmd.none()),
    InstanceName(typed) => (
        Model { renaming: m.renaming.map(fun(r: (i64, string)) = (r.0, typed)), ..m },
        Cmd.none(),
    ),
    ConfirmRename => (confirm_rename(m), Cmd.none()),
    // Typing in the field starts editing: on an app, what's typed replaces
    // its address in the box until Enter or Dismiss (PRP-025).
    Draft(text) => (Model { draft: text, editing: true, notice: None, ..m }, Cmd.none()),
    Go => navigate.go(m),
    Dismiss => (Model { draft: "", editing: false, notice: None, ..m }, Cmd.none()),
    // One card at a time: opening the shield's closes site settings (PRP-022).
    Shield(page) => (
        Model { shield: page, panel: if page.is_some() { None } else { m.panel }, ..m },
        Cmd.none(),
    ),
    EditAddress => match window.page_of(m) {
        App(a) => (Model { editing: true, draft: a.path, ..m }, Cmd.focus("address")),
        Home => (m, Cmd.focus("address")),
    },
    OpenPinned(path) => navigate.open_pin(m, path),
    Continue => navigate.reopen(Model { draft: "", editing: false, ..m }),
    Approve(a) => approve(m, a),
    SetPermission(name, s) => (set_permission(m, name, s), Cmd.none()),
    TogglePanel => (
        Model {
            panel: if m.panel.is_some() { None } else { Some(PanelPage.Main) },
            // One card at a time: site settings close the shield's (PRP-022).
            shield: None,
            confirm: None,
            ..m,
        },
        Cmd.none(),
    ),
    // Closing only, never a toggle: a popover may say it closed more than
    // once, and a toggle reopened it over everything (session 171).
    ClosePanel => (Model { panel: None, confirm: None, ..m }, Cmd.none()),
    TogglePin => (window.toggle_pin(m), Cmd.none()),
    PanelGo(page) => (Model { panel: Some(page), confirm: None, ..m }, Cmd.none()),
    PanelBack => (Model { panel: Some(PanelPage.Main), confirm: None, ..m }, Cmd.none()),
    Ask(c) => (Model { confirm: Some(c), ..m }, Cmd.none()),
    Cancel => (Model { confirm: None, renaming: None, ..m }, Cmd.none()),
    StartOver => match m.current {
        Some(id) => (
            Model {
                confirm: None,
                ..window.with_tab(m, id, fun(a: AppPage) = handle(a, render.Msg.Restart)),
            },
            Cmd.none(),
        ),
        None => (m, Cmd.none()),
    },
    Forget => (forget_account(m, forgotten(m, window.forget(m))), Cmd.none()),
    FocusSearch => (m, Cmd.focus("address")),
    Reload => navigate.reload(m),
    KeepMine => (navigate.keep_mine(m), Cmd.none()),
    SeparateApp => navigate.separate_app(m),
    Fetched(id, number, f) => loads.arrive(m, id, number, f),
    Responded(id, load, msg, got) => (requests.arrive(m, id, load, msg, got), Cmd.none()),
    ToggleServer(server) => (on_access(m, server), Cmd.none()),
    Tick(now) => (Model { now: now, ..m }, Cmd.none()),
    OnTab(id, action) => on_tab(m, id, action),
    OnPin(path, action) => on_pin(m, path, action),
    SetName(_, _, _) | ToggleAutoSignIn | SignOut | SignIn | StartOverIdentity => (
        on_account(m, msg),
        Cmd.none(),
    ),
};

/**
 * A tab's menu item: select that tab, then do what the bar or panel would.
 * A tab that's gone does nothing. Forget opens the panel at its question.
 */
fun on_tab(m: Model, id: i64, action: TabAction): (Model, Cmd<Msg>) {
    if !m.tabs.any(fun(t: Tab) = t.id == id) {
        return (m, Cmd.none());
    }
    let at = window.show_tab(m, id);
    match action {
        Reload => navigate.reload(at),
        TogglePin => (window.toggle_pin(at), Cmd.none()),
        // About this app is the shield's card now (PRP-022).
        About => (
            Model { shield: Some(ShieldPage.Main), panel: None, confirm: None, ..at },
            Cmd.none(),
        ),
        Close => (window.close(at, id), Cmd.none()),
        Forget => (
            Model { panel: Some(PanelPage.Main), confirm: Some(Confirm.Forget), ..at },
            Cmd.none(),
        ),
    }
}

/** A home tile's menu item, for the app at `path`. Forget opens it, then the panel at its question. */
fun on_pin(m: Model, path: string, action: PinAction): (Model, Cmd<Msg>) = match action {
    Open => navigate.open_pin(m, path),
    Unpin => (Model { pinned: m.pinned.filter(fun(p: Pin) = p.path != path), ..m }, Cmd.none()),
    Forget => {
        let (opened, cmd) = navigate.open_pin(m, path);
        (Model { panel: Some(PanelPage.Main), confirm: Some(Confirm.Forget), ..opened }, cmd)
    }
};

/**
 * Draws the window: the bare frame (PRP-014). Never calls a guest.
 *
 * @param m the model
 * @returns the window's view
 *
 * Example:
 *     view(m)
 */
public fun view(m: Model): View<Msg> = layout.view(m);
