/**
 * Who you are to each app (PRP-011): one master secret on this computer
 * (16 bytes since PRP-076, so it can be 12 backup words: `people.words`),
 * and each app's Ed25519 key derived from it with HKDF-SHA256 and the
 * app's identity (its host, the key first trusted for it, and how many
 * times you started over). Apps get only the public key; a sign-in
 * signature covers the verified host, so another host can't use it.
 * Nothing per-app secret is stored: seeds are worked out when needed.
 *
 * Depends on: std.crypto, cbor, data.store, trust.keys, people.words
 * Used by: guest.effects, people.account, data.saving
 */
import std.crypto { random_bytes, hkdf_sha256, ed25519_public, ed25519_sign };
import cbor { Value, Entry, Limits, decode, encode };
import data.store { Store, StoreError, load, save, remove, reason as store_reason };
import trust.keys { hex };
import people.words { words_of };

/** This computer's master secret: never shown, never sent. */
struct Master {
    secret: u8[],
}

/** Why an identity couldn't be made or used. */
enum IdentityError {
    /** The data folder failed. */
    Store(StoreError),
    /** std.crypto failed: its message. */
    Crypto(string),
    /** The identity file is damaged or from a newer Rapidkoi: why. Left as it is. */
    Broken(string),
}

/** The identity file: its secret never replaced without the person's say (PRP-076). */
const FILE: string = "identity";

/** Where a format-1 identity (a 32-byte secret, before backup words) is kept, never deleted. */
const OLD_FILE: string = "identity-v1";

/** The secret's size: 12 backup words' worth (DECISION-101). */
const SECRET_BYTES: i64 = 16;

/** What the person did about backing up: kept beside the secret. */
struct Backup {
    /** The words were written down (checked), or typed in to restore: never shown again. */
    backed_up: bool,
    /** The reminder was shown and closed. */
    reminded: bool,
}

/** What every derivation starts with: changing it would change everyone's keys. */
const LABEL: string = "rapidkoi identity v1";

/**
 * Returns this computer's master secret, making it (16 random bytes,
 * owner-only, written safely, not yet backed up) the first time.
 *
 * @returns it; or why not. A broken or newer file is refused and left
 *     alone: replacing it would make you a stranger to every app.
 *
 * Example:
 *     master(store)?
 */
fun master(s: Store): Result<Master, IdentityError> {
    match load(s, FILE, 4096).map_err(IdentityError.Store)? {
        Some(bytes) => read(bytes),
        None => {
            let secret = random_bytes(SECRET_BYTES).map_err(
                fun(e) = IdentityError.Crypto(e.message()),
            )?;
            write(s, secret, Backup { backed_up: false, reminded: false })?;
            Ok(Master { secret: secret })
        }
    }
}

/**
 * Returns this computer's master secret if one was made before, without
 * making one (at start-up, so the Account page can name you).
 *
 * @returns it; `None` before any app has asked; or why not (as `master`)
 *
 * Example:
 *     existing(store)?
 */
fun existing(s: Store): Result<Option<Master>, IdentityError> = match load(s, FILE, 4096).map_err(
    IdentityError.Store,
)? {
    Some(bytes) => Ok(Some(read(bytes)?)),
    None => Ok(None),
};

/**
 * Keeps a format-1 identity (a 32-byte secret, which can't be backup
 * words) as `identity-v1`, never deleted, so the next `master` makes a
 * new one (PRP-076, DECISION-101). Anything else is left as it is.
 *
 * @returns whether one was kept aside (the window says so, once)
 *
 * Example:
 *     retire_old(store)?
 */
fun retire_old(s: Store): Result<bool, IdentityError> {
    let bytes = match load(s, FILE, 4096).map_err(IdentityError.Store)? {
        Some(b) => b,
        None => {
            return Ok(false);
        }
    };
    let format = match decode(bytes, LIMITS) {
        Ok(v) => v.get("format").and_then(fun(n: Value) = n.as_i64()),
        Err(_) => None,
    };
    if format != Some(1) {
        return Ok(false);
    }
    // Saved whole first, then removed: never a moment with neither.
    save(s, OLD_FILE, bytes).map_err(IdentityError.Store)?;
    remove(s, FILE).map_err(IdentityError.Store)?;
    Ok(true)
}

/**
 * Returns what the person did about backing up; `None` before there's an
 * identity.
 *
 * Example:
 *     backup_of(store)?
 */
fun backup_of(s: Store): Result<Option<Backup>, IdentityError> = match load(s, FILE, 4096).map_err(
    IdentityError.Store,
)? {
    Some(bytes) => Ok(Some(file_of(bytes)?.1)),
    None => Ok(None),
};

/**
 * Whether there's someone here who hasn't written their words down: an
 * identity file saying not backed up. Unreadable is false, so no error
 * shows as a dot (PRP-077).
 *
 * Example:
 *     unbacked(store)
 */
fun unbacked(s: Store): bool = match backup_of(s) {
    Ok(Some(b)) => !b.backed_up,
    _ => false,
};

/**
 * Records what the person did about backing up, the secret unchanged.
 *
 * Example:
 *     note_backup(store, Backup { backed_up: true, reminded: true })?
 */
fun note_backup(s: Store, b: Backup): Result<(), IdentityError> {
    let m = master(s)?;
    write(s, m.secret, b)
}

/**
 * Makes `secret` (from typed backup words) who you are on this computer,
 * backed up, over any identity it had: only once the person said so
 * (`window.backup`).
 *
 * Example:
 *     adopt(store, secret)?
 */
fun adopt(s: Store, secret: u8[]): Result<Master, IdentityError> {
    if secret.len != SECRET_BYTES {
        return Err(IdentityError.Broken("its master secret isn't {SECRET_BYTES} bytes"));
    }
    write(s, secret, Backup { backed_up: true, reminded: true })?;
    Ok(Master { secret: secret })
}

/**
 * Returns the 12 backup words this master secret is.
 *
 * Example:
 *     words_for(m)
 */
fun words_for(m: Master): string[] = words_of(m.secret);

/**
 * Returns your public key for one app.
 *
 * @param host the app's verified host
 * @param origin the key first trusted for it (kept through rotations)
 * @param generation how many times you started over with it
 *
 * Example:
 *     public_key(m, "notes.acme.com", origin, 0)?
 */
fun public_key(
    m: Master,
    host: string,
    origin: u8[],
    generation: i64,
): Result<u8[], IdentityError> {
    ed25519_public(seed(m, host, origin, generation)?).map_err(
        fun(e) = IdentityError.Crypto(e.message()),
    )
}

/**
 * Signs an app's sign-in challenge with your key for it, over the
 * verified host and the challenge (`sign_in_message`).
 *
 * Example:
 *     sign_in(m, host, origin, 0, challenge)?
 */
fun sign_in(
    m: Master,
    host: string,
    origin: u8[],
    generation: i64,
    challenge: u8[],
): Result<u8[], IdentityError> = ed25519_sign(
    seed(m, host, origin, generation)?,
    sign_in_message(host, challenge),
).map_err(fun(e) = IdentityError.Crypto(e.message()));

/**
 * Returns exactly what a sign-in signs: the CBOR map `{kind: "rapidkoi
 * sign-in", host, challenge}`. An app's server rebuilds it to check.
 *
 * Example:
 *     ed25519_verify(public_key, sign_in_message(host, challenge), signature)
 */
fun sign_in_message(host: string, challenge: u8[]): u8[] = encode(
    Value.Map([
        entry("kind", Value.Text("rapidkoi sign-in")),
        entry("host", Value.Text(host)),
        entry("challenge", Value.Bytes(challenge)),
    ]),
);

/**
 * Returns how a key is named on screen: "User " and the key's first four
 * hex digits. The key is public, so the app can show the same label
 * without a hash library; it's a nickname, never proof of anything.
 *
 * Example:
 *     user_label(public_key)
 */
fun user_label(key: u8[]): string = "User {hex(key).slice(0, 4)}";

/**
 * Returns a plain sentence for an identity error.
 *
 * Example:
 *     reason(e)
 */
fun reason(e: IdentityError): string = match e {
    Store(s) => "Rapidkoi couldn't keep your identity: {store_reason(s)}",
    Crypto(why) => "Rapidkoi couldn't work out your key: {why}",
    Broken(why) => "Rapidkoi couldn't read your identity ({why}); it left the file as it was",
};

/** One app's 32-byte Ed25519 seed: HKDF over the master and the app's identity. */
fun seed(m: Master, host: string, origin: u8[], generation: i64): Result<u8[], IdentityError> {
    let info = encode(
        Value.Array([
            Value.Text(LABEL),
            Value.Text(host),
            Value.Bytes(origin),
            Value.int(generation),
        ]),
    );
    hkdf_sha256(m.secret, [], info, 32).map_err(fun(e) = IdentityError.Crypto(e.message()))
}

/** The identity file's master secret, checked. */
fun read(bytes: u8[]): Result<Master, IdentityError> = file_of(bytes).map(
    fun(f: (Master, Backup)) = f.0,
);

/** How much of an identity file is read. */
const LIMITS: Limits = Limits { max_depth: 2, max_items: 16, max_bytes: 4096, max_string: 1024 };

/** The identity file, format 2: its secret and what was done about backing it up. */
fun file_of(bytes: u8[]): Result<(Master, Backup), IdentityError> {
    let v = decode(bytes, LIMITS).map_err(fun(_) = IdentityError.Broken("not CBOR"))?;
    let format = v.get("format").map(fun(n: Value) = n.as_i64().unwrap_or(-1)).unwrap_or(-1);
    if format > 2 {
        return Err(IdentityError.Broken("it was written by a newer Rapidkoi"));
    }
    // Format 1 is set aside at start (`retire_old`); met here, it's left alone.
    if format != 2 || v.get("kind").map(fun(k: Value) = k.as_text().unwrap_or("")) != Some(
        "rapidkoi identity",
    ) {
        return Err(IdentityError.Broken("it isn't Rapidkoi's identity file"));
    }
    let secret = match v.get("master") {
        Some(Bytes(b)) if b.len == SECRET_BYTES => b,
        _ => {
            return Err(IdentityError.Broken("its master secret isn't {SECRET_BYTES} bytes"));
        }
    };
    let flag = fun(name: string): bool = match v.get(name) {
        Some(Bool(b)) => b,
        _ => false,
    };
    Ok(
        (
            Master { secret: secret },
            Backup { backed_up: flag("backed_up"), reminded: flag("reminded") },
        ),
    )
}

/** Writes the identity file, format 2. */
fun write(s: Store, secret: u8[], b: Backup): Result<(), IdentityError> = save(
    s,
    FILE,
    encode(
        Value.Map([
            entry("format", Value.int(2)),
            entry("kind", Value.Text("rapidkoi identity")),
            entry("master", Value.Bytes(secret)),
            entry("backed_up", Value.Bool(b.backed_up)),
            entry("reminded", Value.Bool(b.reminded)),
        ]),
    ),
).map_err(IdentityError.Store);

fun entry(key: string, v: Value): Entry = Entry { key: Value.Text(key), value: v };
