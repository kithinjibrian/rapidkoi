/**
 * You to each app (PRP-011): whether each signed app may know who you are
 * (Sign in), the generation its key is made with, the name apps may show
 * with `{FIRST_NAME}` and `{LAST_NAME}` (one for every app, and optionally
 * one per app), each app's servers (PRP-012), permissions (PRP-031) and
 * looks (PRP-038), and the apps you forgot (PRP-052). Pure; the file
 * itself is `people_codec`.
 *
 * Depends on: std.crypto, bundles.permissions, people.forgotten
 * Used by: people.people_codec, guest.effects, people.account, data.saving, ui.render
 */
import std.crypto { equal };
import bundles.permissions { Permission, Setting, name_of, default_of };
import people.forgotten { Forgotten };

/** The longest name part, in characters. */
const MAX_NAME: i64 = 64;

/** The most apps the file holds. */
const MAX_PEOPLE: i64 = 10_000;

/** You, to one app. */
struct Person {
    /** The app's host. */
    host: string,
    /** The key first trusted for the app (its identity, kept through rotations). */
    origin: u8[],
    /** Its key's own generation: 0, unless kept from before format 5's Forget. */
    generation: i64,
    /** Sign in: whether it gets your key and signatures when it asks (on by default). */
    signs_in: bool,
    /** Your first name in this app only; "" uses the one for every app. */
    first: string,
    /** Your last name in this app only; "" uses the one for every app. */
    last: string,
    /** The servers you switched off for it, its own host included (PRP-012). */
    off: string[],
    /** The servers it declared that you've been told about (the notice, or its first open). */
    seen: string[],
    /** Those told about since you last looked at its Access page: marked new there. */
    fresh: string[],
}

/** Everything in the people file. */
struct People {
    /** Your first name for every app ("" for none). */
    first: string,
    /** Your last name for every app ("" for none). */
    last: string,
    /** The apps you've signed in to or changed settings for. */
    apps: Person[],
    /** The permission settings you changed from their defaults (PRP-031). */
    grants: Grant[],
    /** The apps you switched to your colours or text size (PRP-038). */
    looks: OwnLooks[],
    /** The apps you forgot: where each one's next key starts (PRP-052). */
    forgotten: Forgotten[],
}

/** The person's switch for one app's looks (PRP-038). */
struct OwnLooks {
    /** The app's key, as for permissions. */
    app: string,
    /** Use my colours. */
    colours: bool,
    /** Use my text size. */
    text_size: bool,
}

/** One permission setting you chose for one app. */
struct Grant {
    /** The app: `builtin:<file>` for one built into `./main`. */
    app: string,
    /** The permission's name (`read_pins`). */
    permission: string,
    /** What you chose. */
    setting: Setting,
}

/**
 * Nobody yet: no name, no apps.
 *
 * Example:
 *     nobody()
 */
fun nobody(): People = People {
    first: "",
    last: "",
    apps: [],
    grants: [],
    looks: [],
    forgotten: [],
};

/**
 * Returns you to one app: its saved settings, or the defaults (generation
 * 0, signed in, no name of its own).
 *
 * Example:
 *     person(people, host, origin)
 */
fun person(p: People, host: string, origin: u8[]): Person {
    for x of p.apps {
        if x.host == host && equal(x.origin, origin) {
            return x;
        }
    }
    Person {
        host: host,
        origin: origin,
        generation: 0,
        signs_in: true,
        first: "",
        last: "",
        off: [],
        seen: [],
        fresh: [],
    }
}

/**
 * Says whether an app has settings saved: false until its first open,
 * when what it declares is seen without a notice.
 *
 * Example:
 *     known(people, host, origin)
 */
fun known(p: People, host: string, origin: u8[]): bool = p.apps.any(
    fun(x: Person) = x.host == host && equal(x.origin, origin),
);

/**
 * Saves one app's settings in place of its old ones.
 *
 * Example:
 *     with_person(people, Person { signs_in: false, ..person(people, host, origin) })
 */
fun with_person(p: People, x: Person): People {
    let mut apps = forget_person(p, x.host, x.origin).apps;
    apps.push(x);
    People { apps: apps, ..p }
}

/**
 * Removes one app's settings; Forget also keeps its generation (`account.forget_app`).
 *
 * Example:
 *     forget_person(people, host, origin)
 */
fun forget_person(p: People, host: string, origin: u8[]): People = People {
    apps: p.apps.filter(fun(x: Person) = !(x.host == host && equal(x.origin, origin))),
    ..p,
};

/**
 * Returns the name an app may show, first and last: its own where set,
 * else the one for every app; "" where neither is.
 *
 * Example:
 *     name_in(people, host, origin)
 */
fun name_in(p: People, host: string, origin: u8[]): (string, string) {
    let x = person(p, host, origin);
    (if x.first != "" { x.first } else { p.first }, if x.last != "" { x.last } else { p.last })
}

/**
 * Returns the setting you chose for an app's permission, or its default.
 *
 * @param p everything in the people file
 * @param app the app's key: `builtin:<file>` for a built-in app
 * @param permission the permission
 * @returns the setting
 *
 * Example:
 *     setting_of(people, "builtin:newtab", Permission.ReadPins)
 */
fun setting_of(p: People, app: string, permission: Permission): Setting {
    for g of p.grants {
        if g.app == app && g.permission == name_of(permission) {
            return g.setting;
        }
    }
    default_of(permission)
}

/**
 * Sets an app's permission; a setting back at its default isn't kept.
 *
 * Example:
 *     with_setting(people, "builtin:newtab", Permission.ReadPins, Setting.Blocked)
 */
fun with_setting(p: People, app: string, permission: Permission, s: Setting): People {
    let name = name_of(permission);
    let mut kept = p.grants.filter(fun(g: Grant) = !(g.app == app && g.permission == name));
    if s != default_of(permission) {
        kept.push(Grant { app: app, permission: name, setting: s });
    }
    People { grants: kept, ..p }
}

/**
 * Returns an app's look switches: Use my colours, Use my text size.
 *
 * Example:
 *     looks_of(people, "notes.acme.com")
 */
fun looks_of(p: People, app: string): (bool, bool) {
    for l of p.looks {
        if l.app == app {
            return (l.colours, l.text_size);
        }
    }
    (false, false)
}

/**
 * Sets an app's look switches; both off isn't kept.
 *
 * Example:
 *     with_looks(people, "notes.acme.com", true, false)
 */
fun with_looks(p: People, app: string, colours: bool, text_size: bool): People {
    let mut kept = p.looks.filter(fun(l: OwnLooks) = l.app != app);
    if colours || text_size {
        kept.push(OwnLooks { app: app, colours: colours, text_size: text_size });
    }
    People { looks: kept, ..p }
}
