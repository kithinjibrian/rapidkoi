/**
 * Rapidkoi's entry: `./main path/to/app.wasm` opens one app under UI
 * contract v1. Wiring only; everything worth testing lives in `shell`.
 *
 * Depends on: kivuli, shell
 */
import kivuli { sandbox };
import shell { boot, update, view };

fun main(): i32 = sandbox("app.rapidkoi.shell", boot(args()), update, view);
