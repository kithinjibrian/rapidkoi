/**
 * Rapidkoi's entry: `./main` opens home, `./main path/to/app.wasm` opens
 * that app. Wiring only; everything worth testing lives in `shell`.
 *
 * Depends on: kivuli, shell
 */
import kivuli { App, Sub, application };
import shell { Model, boot, update, view };
import actions { Msg };

fun main(): i32 = application(App {
    id: "app.rapidkoi.shell",
    init: boot(args()),
    update: update,
    view: view,
    subscriptions: fun(_: Model) = Sub.none(),
});
