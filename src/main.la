/**
 * Rapidkoi's entry: `./main` opens home; `./main path/to/app.rkb` (or a
 * `.wasm`, or `rapidkoi://localhost:PORT`) opens that app, and so does a
 * second `./main …` while one runs, in the running window; `./main pack …`
 * packs a bundle, `./main keygen` and `./main publish` sign and publish
 * one to a site folder, and `./main serve …` serves a bundle or a site for
 * development, all without a window. Wiring only; the work lives in
 * `shell`, `pack`, `publish` and `serve`.
 *
 * Depends on: kivuli, shell, window.actions, commands.pack, commands.publish, commands.serve
 */
import kivuli { App, application };
import shell { boot, update, view, subscriptions };
import window.window { Model };
import window.actions { Msg };
import commands.pack;
import commands.serve;
import commands.publish;

fun main(): i32 {
    let argv = args();
    if argv.len >= 2 && argv[1] == "pack" {
        return pack.run(argv);
    }
    if argv.len >= 2 && (argv[1] == "keygen" || argv[1] == "publish") {
        return publish.run(argv);
    }
    if argv.len >= 2 && argv[1] == "serve" {
        return serve.run(argv);
    }
    // What the command line names arrives as `Launched`, through GIO, as a
    // later launch's does (kivuli 0.61): opened once, by the same path.
    application(App {
        id: "app.rapidkoi.shell",
        init: boot([argv[0]]),
        update: update,
        view: view,
        subscriptions: subscriptions,
        on_open: Some(Msg.Launched),
    })
}
