/**
 * Rapidkoi's entry: `./main` opens home; `./main path/to/app.rkb` (or a
 * `.wasm`, or `rapidkoi://localhost:PORT`) opens that app; `./main pack …`
 * packs a bundle and `./main serve …` serves one for development, both
 * without a window. Wiring only; the work lives in `shell`, `pack` and
 * `serve`.
 *
 * Depends on: kivuli, shell, actions, pack, serve
 */
import kivuli { App, Sub, application };
import shell { Model, boot, update, view };
import actions { Msg };
import pack;
import serve;

fun main(): i32 {
    let argv = args();
    if argv.len >= 2 && argv[1] == "pack" {
        return pack.run(argv);
    }
    if argv.len >= 2 && argv[1] == "serve" {
        return serve.run(argv);
    }
    application(App {
        id: "app.rapidkoi.shell",
        init: boot(argv),
        update: update,
        view: view,
        subscriptions: fun(_: Model) = Sub.none(),
    })
}
