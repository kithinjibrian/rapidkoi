/**
 * The `keygen` and `publish` commands, and `pack` from `rapidkoi.toml`.
 * Publishing writes a static site: `.well-known/rapidkoi/` holds the public
 * key file, the signed index, and each kept version as
 * `builds/<sha256 hex>.rkb`; `index.html` is the landing page (PRP-036). It builds only on an index that verifies with
 * the project's key, writes nothing outside the site folder, and never
 * writes or prints the secret key.
 *
 * Depends on: std.fs, std.env, std.crypto, bundles.project, trust.keys, bundles.signing, trust.index, bundles.bundle
 * Used by: main, commands.pack
 */
import std.fs;
import std.env;
import std.crypto { sha256 };
import bundles.project { Project, read_project, reason as project_reason };
import trust.keys {
    SecretKey,
    KeyError,
    keygen,
    read_secret,
    fingerprint,
    hex,
    inside,
    reason as key_reason,
};
import bundles.signing { write_signed };
import trust.index {
    Index,
    KeyFile,
    sign_index,
    read_index,
    add,
    prune,
    withdraw,
    key_file,
    read_key_file,
    reason as index_reason,
};
import guest.limits { CONTRACT_VERSION };
import bundles.bundle { Bundle, Manifest, write, reason as bundle_reason };
import commands.landing { landing_page };

/** Where a site keeps Rapidkoi's files, under its root. */
public const WELL_KNOWN: string = ".well-known/rapidkoi";

/**
 * Runs `keygen` or `publish` from the program's arguments, in the current
 * folder's project: prints a summary, or `rapidkoi <command>: <what>` on stderr.
 *
 * @returns the exit code: 0 on success, 1 on any error
 *
 * Example:
 *     if argv[1] == "publish" { return publish.run(argv); }
 */
public fun run(argv: string[]): i32 {
    let command = argv[1];
    let result: Result<string, string> = match env.current_dir() {
        Err(e) => Err("can't find the current folder: {e}"),
        Ok(dir) => if command == "keygen" {
            make_key(dir)
        } else {
            let mut rest: string[] = [];
            for i in 2..argv.len {
                rest.push(argv[i]);
            }
            publish_args(dir, rest)
        },
    };
    match result {
        Ok(summary) => {
            println(summary);
            0
        }
        Err(e) => {
            eprintln("rapidkoi {command}: {e}");
            1
        }
    }
}

/**
 * Makes the project's secret key at `[publish].key`.
 *
 * @param dir the project's folder, absolute
 * @returns what was written, with the key's fingerprint
 *
 * Example:
 *     make_key("/work/notes")?
 */
public fun make_key(dir: string): Result<string, string> {
    let p = read_project(dir).map_err(project_reason)?;
    let (host, path) = signer(p)?;
    let k = keygen(host, path, p.dir).map_err(key_reason)?;
    Ok(
        "wrote {path} (readable by you only) · fingerprint {fingerprint(k.public_key)}\nKeep it secret: never commit or share it",
    )
}

/**
 * Publishes the project's current version, or withdraws one with
 * `--withdraw VERSION --reason TEXT`.
 *
 * Example:
 *     publish_args("/work/notes", ["--withdraw", "1.0.0", "--reason", "Security fix in 1.0.1"])?
 */
public fun publish_args(dir: string, args: string[]): Result<string, string> {
    if args.len == 0 {
        return publish_site(dir);
    }
    if args.len == 4 && args[0] == "--withdraw" && args[2] == "--reason" {
        return withdraw_version(dir, args[1], args[3]);
    }
    Err("use: rapidkoi publish, or rapidkoi publish --withdraw VERSION --reason TEXT")
}

/**
 * Packs, signs and publishes the project's version to its site folder:
 * adds it to the index (verified first), makes it current, prunes to
 * `keep`, and deletes the pruned builds.
 *
 * @param dir the project's folder, absolute
 * @returns a summary; or why not (the project, the key, a tampered or
 *     foreign index, a version reused with other bytes, writing)
 *
 * Example:
 *     publish_site("/work/notes")?
 */
public fun publish_site(dir: string): Result<string, string> {
    let p = read_project(dir).map_err(project_reason)?;
    let key = secret(p)?;
    let bytes = write_signed(bundle_of(p)?, key).map_err(bundle_reason)?;
    let sha = sha256(bytes);
    let before = existing(p, key)?;
    let after = add(before, p.version, sha, bytes.len).map_err(index_reason)?;
    if after.sequence == before.sequence {
        return Ok("{p.name} {p.version} is already published with these bytes: nothing changed");
    }
    let (kept, gone) = prune(after, p.keep);
    let root = "{p.site}/{WELL_KNOWN}";
    fs.make_dirs("{root}/builds").map_err(fun(e: string) = "can't make {root}/builds: {e}")?;
    // The build first, then the index naming it: a reader never sees an
    // index listing a build that isn't there yet.
    put("{root}/builds/{hex(sha)}.rkb", bytes)?;
    put("{root}/index", sign_index(kept, key).map_err(index_reason)?)?;
    put("{root}/key", key_file(KeyFile { host: key.host, key: key.public_key, rotations: [] }))?;
    // What a browser shows at the app's address and at every link (PRP-036).
    let page = landing_page(
        p.name,
        p.description,
        "{key.host} · key {fingerprint(key.public_key)}",
        key.host,
    );
    write_file("{p.site}/index.html", page).map_err(
        fun(e: string) = "can't write {p.site}/index.html: {e}",
    )?;
    for h of gone {
        let file = "{root}/builds/{hex(h)}.rkb";
        if fs.exists(file) {
            fs.remove_file(file).map_err(fun(e: string) = "can't remove {file}: {e}")?;
        }
    }
    let versions = if kept.versions.len == 1 { "version" } else { "versions" };
    let removed = if gone.len == 0 {
        ""
    } else if gone.len == 1 {
        ", 1 old build removed"
    } else {
        ", {gone.len} old builds removed"
    };
    Ok(
        "published {p.name} {p.version} to {p.site} · build {hex(sha).slice(0, 16)} · sequence {kept.sequence} · {kept.versions.len} {versions} kept{removed}",
    )
}

/**
 * Marks a published version withdrawn, with the reason people will see,
 * and re-signs the index.
 *
 * Example:
 *     withdraw_version("/work/notes", "1.0.0", "Security fix in 1.0.1")?
 */
public fun withdraw_version(dir: string, version: string, why: string): Result<string, string> {
    let p = read_project(dir).map_err(project_reason)?;
    let key = secret(p)?;
    let ix = withdraw(existing(p, key)?, version, why).map_err(index_reason)?;
    put("{p.site}/{WELL_KNOWN}/index", sign_index(ix, key).map_err(index_reason)?)?;
    Ok("withdrew {p.name} {version} · sequence {ix.sequence}")
}

/**
 * Packs the project into one `.rkb` in its folder, `name-version.rkb`:
 * signed (format 2) when it has a host and a key, otherwise format 1.
 *
 * @param dir the project's folder, absolute
 * @param force whether to replace an existing file
 *
 * Example:
 *     pack_project("/work/notes", false)?
 */
public fun pack_project(dir: string, force: bool): Result<string, string> {
    let p = read_project(dir).map_err(project_reason)?;
    let out = "{p.dir}/{p.name.split(" ").join("-")}-{p.version}.rkb";
    if fs.exists(out) && !force {
        return Err("{out} exists; add --force to replace it");
    }
    let b = bundle_of(p)?;
    let (bytes, kind) = match (p.host, p.key) {
        (Some(_), Some(_)) => (write_signed(b, secret(p)?).map_err(bundle_reason)?, "signed"),
        _ => (write(b).map_err(bundle_reason)?, "unsigned"),
    };
    put(out, bytes)?;
    Ok("packed {out}: {p.name} {p.version}, {kind}, {bytes.len / 1024} KB")
}

/**
 * Reads a project's files into a bundle: the module, the icon, banners
 * and assets, named as `pack` names them.
 *
 * Example:
 *     bundle_of(read_project(dir)?)?
 */
public fun bundle_of(p: Project): Result<Bundle, string> {
    let mut assets: (string, u8[])[] = [];
    let mut icon: Option<string> = None;
    if let Some(file) = p.icon {
        assets.push(("icon.png", load(file)?));
        icon = Some("icon.png");
    }
    let mut banners: (string, string)[] = [];
    for b of p.banners {
        let name = "banner/{b.0}.png";
        assets.push((name, load(b.1)?));
        banners.push((b.0, name));
    }
    for a of p.assets {
        assets.push((a.0, load(a.1)?));
    }
    Ok(Bundle {
        manifest: Manifest {
            contract: CONTRACT_VERSION as i64,
            name: p.name,
            version: p.version,
            description: p.description,
            state_version: p.state_version,
            icon: icon,
            banners: banners,
            servers: p.servers,
            permissions: [],
            controls: None,
        },
        module: load(p.module)?,
        assets: assets,
    })
}

/** The project's host and key path, both required to sign. */
fun signer(p: Project): Result<(string, string), string> {
    let host = p.host.ok_or("rapidkoi.toml: [app] needs host to sign")?;
    let path = p.key.ok_or("rapidkoi.toml: [publish] needs key to sign")?;
    if inside(path, p.dir) {
        return Err(key_reason(KeyError.InsideProject(path)));
    }
    Ok((host, path))
}

fun secret(p: Project): Result<SecretKey, string> {
    let (host, path) = signer(p)?;
    if !fs.exists(path) {
        return Err("there's no key at {path}: run rapidkoi keygen first");
    }
    read_secret(path, host).map_err(key_reason)
}

/**
 * The site's index so far, verified with the project's key; an empty one
 * for a new site. A site already holding another key is refused: building
 * on it would look, to everyone, like an unapproved key change.
 */
fun existing(p: Project, key: SecretKey): Result<Index, string> {
    let root = "{p.site}/{WELL_KNOWN}";
    if fs.exists("{root}/key") {
        let kf = read_key_file(
            read_bytes("{root}/key").map_err(fun(e: string) = "can't read {root}/key: {e}")?,
        ).map_err(index_reason)?;
        if kf.key != key.public_key || kf.host != key.host {
            return Err(
                "{root}/key is another key's (key {fingerprint(kf.key)}, host {kf.host}): publishing with this one would look like an unapproved key change",
            );
        }
    }
    if !fs.exists("{root}/index") {
        return Ok(Index { host: key.host, sequence: 0, current: "", versions: [] });
    }
    let bytes = read_bytes("{root}/index").map_err(
        fun(e: string) = "can't read {root}/index: {e}",
    )?;
    read_index(bytes, key.public_key, key.host).map_err(
        fun(e) = "{root}/index: {index_reason(e)}; it wasn't changed",
    )
}

fun load(file: string): Result<u8[], string> = read_bytes(file).map_err(
    fun(e: string) = "can't read {file}: {e}",
);

fun put(file: string, bytes: u8[]): Result<i64, string> = write_bytes(file, bytes).map_err(
    fun(e: string) = "can't write {file}: {e}",
);
