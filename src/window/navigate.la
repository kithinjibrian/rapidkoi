/**
 * Opening things in the window: what the address box says (a local file or
 * a local development address), a pinned app, Continue, and Reload. Each
 * returns the next model and, for an address, the background load's task
 * (`loads.la`); the state itself lives in `window.la`. Reads local files
 * (CLAUDE.md rule 3).
 *
 * Depends on: std.fs, kivuli, window.tabs, window.window, net.address, trust.verify, net.loads, window.upgrades, window.actions
 * Used by: shell
 */
import std.fs;
import window.tabs {
    AppPage,
    Tab,
    Pin,
    open_path,
    close_page,
    state_of,
    state_version_of,
    failed_page,
};
import window.restarts { load_again };
import window.recent { remember };
import window.upgrades { upgrading, landed };
import window.notices {
    here,
    told,
    tab_loaded,
    for_rapidkoi,
    bad_address,
    no_such,
    started_over,
    settings_failed,
    all_apps_failed,
};
import window.choosing { asks_which };
import window.instances { next_instance, next_instance_of, another };
import data.remembered { Open };
import trust.verify { Identity, known_for };
import std.crypto { equal };
import net.loads { begin, begin_app, begin_link, begin_restoring, resumed, begin_place };
import window.apps { tab_of };
import window.pins { pins_app };
import kivuli { Cmd };
import window.actions { Msg, PanelPage, Confirm, PinAction, BellAction };
import window.notifications { open_at, dismiss };
import window.window {
    Model,
    page_of,
    with_tab,
    add_tab,
    app,
    slot,
    open_tab_of,
    show_tab,
    go_home,
    same_app,
};
import net.address { is_address, parse, without_link };
import window.settings_app;
import window.allapps;
import bundles.loader { why };

/**
 * Opens what the address box says: a local file or development address,
 * or a notice why not.
 *
 * Example:
 *     go(m)
 */
fun go(m: Model): (Model, Cmd<Msg>) {
    let wanted = m.draft.trim();
    if wanted == "" {
        return (m, Cmd.none());
    }
    if is_address(wanted) {
        // Local development addresses open; any other gets the reason why not yet.
        return match parse(wanted) {
            Ok(_) => open_file(m, wanted),
            Err(e) => (here(m, bad_address(address.reason(e))), Cmd.none()),
        };
    }
    // An app already open is shown even if its file has gone since (PRP-026).
    if fs.is_file(wanted) || open_tab_of(m, wanted).is_some() {
        return open_file(m, wanted);
    }
    (here(m, no_such(wanted)), Cmd.none())
}

/**
 * Opens a local app file or address: in a new tab from home, or in place
 * of the current tab's app (its place kept in Recent, PRP-062). A file
 * opens at once; an address loads in the background (PRP-008). A link
 * (PRP-036) opens at its version; one with fields always in a new window.
 *
 * @returns the model, and the load's task for an address
 *
 * Example:
 *     open_file(m, "counter.wasm")
 */
fun open_file(m: Model, text: string): (Model, Cmd<Msg>) {
    // Settings by its path (PRP-064): from a pin, a recent card or the address box, as ☰ opens it.
    if text == settings_app.SETTINGS_KEY {
        return (open_settings(Model { draft: "", editing: false, ..m }), Cmd.none());
    }
    // A link (PRP-036) is its app's address with a version and fields.
    let (path, version, fields) = match parse(text) {
        Ok(a) if is_address(text) => (without_link(text), a.version, a.fields),
        _ => (text, None, []),
    };
    // A link's fields always open a new window, beside what's open.
    if fields.len > 0 {
        let placed = add_tab(m, AppPage {
            instance: next_instance(m, path),
            ..failed_page(path, ""),
        });
        let tidy = Model { draft: "", editing: false, ..placed };
        return begin_link(tidy, placed.current.unwrap_or(-1), path, version, fields);
    }
    // Several apps at this address: the default, or which one (PRP-049, PRP-050).
    if let Some(asking) = asks_which(Model { draft: "", editing: false, ..m }, path) {
        return asking;
    }
    // One tab per app (PRP-026): an app already open is shown, not started twice.
    if let Some(id) = open_tab_of(m, path) {
        return (show_tab(Model { draft: "", editing: false, ..m }, id), Cmd.none());
    }
    let placed = match m.current {
        // The app in this tab gives way to the new one, which starts as its
        // first instance: the old one's name and key don't carry over.
        Some(id) if app(m, id).is_some() => (
            {
                // Its place is kept (PRP-062); its window's state goes with it (session 189).
                let mut kept = m;
                if let Some(a) = app(m, id) {
                    kept = Model { recent: remember(m.recent, m.people, a, m.now), ..m };
                    close_page(a);
                }
                with_tab(kept, id, fun(_: AppPage) = failed_page(path, ""))
            },
            id,
        ),
        // A new tab, or the current empty tab, filled in place (PRP-024).
        _ => (add_tab(m, failed_page(path, "")), slot(m)),
    };
    let (base, id) = placed;
    let tidy = Model { draft: "", editing: false, ..base };
    if is_address(path) && parse(path).is_ok() {
        return begin_link(tidy, id, path, version, []);
    }
    // A new window starts fresh: state lives with its window, and only
    // Restore brings a saved one back (session 189). Its old notice goes.
    let page = open_path(m.engine, m.ring, path);
    (with_tab(tab_loaded(tidy, id), id, fun(_: AppPage) = page), Cmd.none())
}

/**
 * Opens what a launch named, each as `open_file` would (kivuli 0.61's
 * `on_open`, DECISION-014): the first launch's command line, or a later
 * one's, handed over to this window.
 *
 * Example:
 *     open_launched(m, ["/home/a/counter.rkb"])
 */
fun open_launched(m: Model, items: string[]): (Model, Cmd<Msg>) {
    let mut at = m;
    let mut cmds: Cmd<Msg>[] = [];
    for item of items {
        let (next, cmd) = open_file(at, from_outside(item));
        at = next;
        cmds.push(cmd);
    }
    (at, Cmd.batch(cmds))
}

/**
 * An item as GIO hands it over, as it would be typed: an address's bare
 * host loses the `/` GIO adds; a path after it, or a file's path, stays.
 *
 * Example:
 *     from_outside("rapidkoi://notes.dafifi.net/") == "rapidkoi://notes.dafifi.net"
 */
fun from_outside(item: string): string {
    let scheme = item.split("://");
    if scheme.len == 2 && item.ends_with("/") && !scheme[1].slice(0, scheme[1].len - 1).contains(
        "/",
    ) {
        return item.slice(0, item.len - 1);
    }
    item
}

/**
 * Opens another instance of the current app (PRP-033): the strip's +. It
 * starts fresh from the app's compiled program, in a new tab, under the
 * next number.
 * Nothing on an empty tab, or for an app that isn't running yet.
 *
 * Example:
 *     new_instance(m)
 */
fun new_instance(m: Model): (Model, Cmd<Msg>) {
    let p = match page_of(m) {
        App(a) => a,
        Home => {
            return (m, Cmd.none());
        }
    };
    match another(p, next_instance_of(m, p)) {
        // Fresh, as every new window is (session 189).
        Some(fresh) => (add_tab(m, fresh), Cmd.none()),
        None => (m, Cmd.none()),
    }
}

/**
 * Reopens a saved session (PRP-034, PRP-035), each window in its own tab
 * in the order saved, except apps open now, whose current windows win: a file opened again, an address loading in the
 * background, each as the same instance under the same name, a signed one
 * from its saved state. The one that was in front is current. One that
 * can't come back shows why in its tab.
 *
 * @param m the window, its data folder restored and no tabs yet
 * @param o what was open
 * @returns the window with its tabs, and the background loads
 *
 * Example:
 *     reopen_all(m, open)
 */
fun reopen_all(m: Model, o: Open): (Model, Cmd<Msg>) {
    let mut at = m;
    let mut tasks: Cmd<Msg>[] = [];
    let mut ids: i64[] = [];
    // The current session wins per app (the owner, session 187): an app
    // open now keeps only its current windows; one that isn't comes back
    // with all of its own.
    for t of o.tabs {
        // The same app (PRP-049): its address, and its first key when saved with one.
        let current = m.tabs.filter(fun(x: Tab) = same_app(x.page.path, t.path) && match (
            t.origin,
            x.page.trust,
        ) {
            (Some(o), Some(tr)) => equal(o, tr.origin),
            _ => true,
        });
        if current.len > 0 {
            ids.push(current[0].id);
            continue;
        }
        let named = fun(p: AppPage) = AppPage {
            instance: t.instance,
            label: t.label,
            seen: t.seen,
            link: t.link,
            ..p,
        };
        if t.path == settings_app.SETTINGS_KEY {
            // Rapidkoi's own Settings comes back built in, never from a file (PRP-038).
            let held = Ref.new(at.modules);
            if let Ok(page) = settings_app.open_kept(held, at.engine, at.now) {
                at = add_tab(Model { modules: held.get(), ..at }, named(page));
            }
        } else if is_address(t.path) && parse(t.path).is_ok() {
            // Its tab first, under its name; begin keeps the instance (loads).
            let placed = add_tab(at, named(failed_page(t.path, "")));
            let id = placed.current.unwrap_or(-1);
            let (loading, task) = begin_restoring(placed, id, t.path, t.origin);
            at = loading;
            tasks.push(task);
        } else {
            let (page, said) = resumed(at, named(open_path(at.engine, at.ring, t.path)), t.link);
            let placed = add_tab(at, page);
            // About that window's app: on its tab (PRP-051).
            at = told(placed, placed.current.unwrap_or(-1), said);
        }
        ids.push(at.current.unwrap_or(-1));
    }
    let front = match o.current {
        Some(i) if i < ids.len => Some(ids[i]),
        _ => at.current,
    };
    (Model { current: front, ..at }, if tasks.len == 0 { Cmd.none() } else { Cmd.batch(tasks) })
}

/**
 * Opens a pinned app: its tab when it's open (PRP-026), else in the empty
 * tab (a new one when there's none).
 *
 * Example:
 *     open_pin(m, "counter.wasm")
 */
fun open_pin(m: Model, path: string, origin: Option<u8[]>): (Model, Cmd<Msg>) = match tab_of(
    m,
    path,
    origin,
) {
    // A pin from before PRP-049 names no app: at an address with several, which.
    Some(_) if origin.is_none() && asks_which(m, path).is_some() => asks_which(
        Model { draft: "", editing: false, ..go_home(m) },
        path,
    ).unwrap_or((m, Cmd.none())),
    Some(id) => (show_tab(Model { draft: "", editing: false, ..m }, id), Cmd.none()),
    // A pin names its app (PRP-049): that one, never another at its address.
    None => match origin {
        Some(o) if is_address(path) && parse(path).is_ok() => {
            let home = Model { draft: "", editing: false, ..go_home(m) };
            let id = slot(home);
            begin_app(add_tab(home, failed_page(path, "")), id, path, o)
        }
        _ => open_file(go_home(m), path),
    },
};

/**
 * ⟳ Reload: loads the current app again from its file or server and
 * continues with its current state when the state's shape is unchanged; a
 * changed shape starts fresh, with a notice. A stopped page starts fresh.
 *
 * Example:
 *     reload(m)
 */
fun reload(m: Model): (Model, Cmd<Msg>) = match (m.current, page_of(m)) {
    // One upgrade or reload of an app at a time (PRP-048).
    (Some(_), App(a)) if upgrading(m, a.path) => (m, Cmd.none()),
    (Some(id), App(a)) if a.path == settings_app.SETTINGS_KEY => {
        // Built in: started again as it is, its settings read afresh; its
        // module from the modules kept for the run (PRP-068).
        let held = Ref.new(m.modules);
        match settings_app.open_kept(held, m.engine, m.now) {
            Ok(page) => {
                let same = AppPage { instance: a.instance, label: a.label, seen: a.seen, ..page };
                let (moved, notice) = landed(
                    Model { modules: held.get(), ..m },
                    id,
                    [a],
                    same,
                    None,
                );
                (told(moved, id, notice), Cmd.none())
            }
            Err(_) => (m, Cmd.none()),
        }
    },
    (Some(id), App(a)) => {
        let saved = state_of(a).map(fun(st: u8[]) = (st, state_version_of(a)));
        if is_address(a.path) && parse(a.path).is_ok() {
            // In the background: the running page stays until the new one
            // is ready (or a changed key is answered); a loading one is
            // simply started again, its result now stale.
            return match a.screen {
                Loading(p) => begin(m, id, a.path, false, p.saved, p.kept),
                _ => begin(m, id, a.path, false, saved, [a]),
            };
        }
        let (loaded, over) = load_again(m.engine, m.ring, a.path, saved, a.link);
        // A changed key asks first: the open page waits, in case the
        // person keeps using it.
        let page = match loaded.screen {
            Unapproved(c, _) => AppPage { screen: tabs.Screen.Unapproved(c, [a]), ..loaded },
            _ => loaded,
        };
        let notice = if over { Some(started_over(page.name)) } else { None };
        // Reloaded, it's still the same instance; every window of the app
        // moves with it, or none (PRP-048).
        let same = AppPage { instance: a.instance, label: a.label, seen: a.seen, ..page };
        let (moved, said) = landed(m, id, [a], same, notice);
        (told(moved, id, said), Cmd.none())
    }
    _ => (m, Cmd.none()),
};

/**
 * "Open my version" on a changed key: back to the person's version, or
 * the tab closes when there's none.
 *
 * Example:
 *     keep_mine(m)
 */
fun keep_mine(m: Model): Model = match (m.current, page_of(m)) {
    (Some(id), App(a)) => match a.screen {
        Unapproved(_, kept) if kept.len > 0 => with_tab(m, id, fun(_: AppPage) = kept[0]),
        Unapproved(_, _) => window.close(m, id),
        _ => m,
    },
    _ => m,
};

/**
 * Opens Rapidkoi's Settings app (PRP-038): its tab when it's open, else a
 * new one. If it can't start, why is the notice.
 *
 * Example:
 *     open_settings(m)
 */
fun open_settings(m: Model): Model {
    if let Some(id) = open_tab_of(m, settings_app.SETTINGS_KEY) {
        return show_tab(m, id);
    }
    // Compiled once for the run (PRP-068).
    let held = Ref.new(m.modules);
    match settings_app.open_kept(held, m.engine, m.now) {
        Ok(page) => add_tab(Model { modules: held.get(), ..m }, page),
        Err(r) => for_rapidkoi(m, settings_failed(why(r))),
    }
}

/**
 * Opens All apps (PRP-067): its tab when it's open, else a new one. If it
 * can't start, why is the notice.
 *
 * Example:
 *     open_all_apps(m)
 */
fun open_all_apps(m: Model): Model {
    if let Some(id) = open_tab_of(m, allapps.ALL_APPS_KEY) {
        return show_tab(m, id);
    }
    // Compiled once for the run (PRP-068).
    let held = Ref.new(m.modules);
    match allapps.open_kept(held, m.engine, m.now) {
        Ok(page) => add_tab(Model { modules: held.get(), ..m }, page),
        Err(r) => for_rapidkoi(m, all_apps_failed(why(r))),
    }
}

/** A home tile's menu item, for the app at `path`. Forget opens it, then the panel at its question; Permissions, the panel on its permissions (PRP-067). */
fun on_pin(
    m: Model,
    path: string,
    origin: Option<u8[]>,
    action: PinAction,
): (Model, Cmd<Msg>) = match action {
    Open => open_pin(m, path, origin),
    Unpin => (
        Model { pinned: m.pinned.filter(fun(p: Pin) = !pins_app(p, path, origin)), ..m },
        Cmd.none(),
    ),
    Forget => {
        let (opened, cmd) = open_pin(m, path, origin);
        let tab = opened.current.unwrap_or(-1);
        (Model { panel: Some(PanelPage.Main), confirm: Some(Confirm.Forget(tab)), ..opened }, cmd)
    }
    Permissions => {
        let (opened, cmd) = open_pin(m, path, origin);
        (Model { panel: Some(PanelPage.Permissions), ..opened }, cmd)
    }
};

/**
 * Opens a recent place (PRP-062): a fresh window at its address. Without
 * fields it opens as a pin does (its app's open tab, or that exact app
 * again); a link's fields open a new window for that exact app, at them.
 *
 * Example:
 *     open_place(m, "rapidkoi://notes.dafifi.net/@0.9.0?note=3", origin)
 */
fun open_place(m: Model, to: string, origin: Option<u8[]>): (Model, Cmd<Msg>) = match (
    parse(to),
    origin,
) {
    (Ok(a), Some(o)) if is_address(to) && a.fields.len > 0 => {
        let path = without_link(to);
        let home = Model { draft: "", editing: false, ..go_home(m) };
        let placed = add_tab(home, AppPage {
            instance: next_instance(home, path),
            ..failed_page(path, ""),
        });
        begin_place(placed, placed.current.unwrap_or(-1), path, a.version, a.fields, o)
    },
    (Ok(_), Some(_)) if is_address(to) => open_pin(m, without_link(to), origin),
    _ => open_file(Model { draft: "", editing: false, ..go_home(m) }, to),
};

/**
 * The bell's card (PRP-066): opening it closes ☰'s; a row opens its
 * notification's place, marks it read and closes the card; × removes it.
 * An index past the end changes nothing.
 *
 * Example:
 *     on_bell(m, BellAction.Open(0))
 */
fun on_bell(m: Model, action: BellAction): (Model, Cmd<Msg>) = match action {
    Show(open) => (Model { bell: open, menu: if open { false } else { m.menu }, ..m }, Cmd.none()),
    Open(index) => match open_at(m.notifications, index) {
        (marked, Some(x)) => open_place(
            Model { notifications: marked, bell: false, ..m },
            x.address,
            x.origin,
        ),
        (_, None) => (m, Cmd.none()),
    },
    Dismiss(index) => (Model { notifications: dismiss(m.notifications, index), ..m }, Cmd.none()),
};
