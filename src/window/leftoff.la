/**
 * "Where you left off": what leaving an app page keeps (its name, title,
 * state, and its compiled app while this session lasts), a snapshot of an
 * open page, one read back from disk, and which signed app it is. Moved
 * unchanged from `tabs.la` (PRP-008 step 0).
 *
 * Depends on: bundles.bundle, trust.verify, window.tabs
 * Used by: window.tabs, window.window, window.navigate, data.saving, data.remembered
 */
import bundles.bundle { Manifest };
import trust.verify { Trust };
import window.tabs { AppPage, Program, close_page, state_of, state_version_of };

/** The app page the person last left, for "Where you left off". */
struct LeftOff {
    /** The app's name. */
    name: string,
    /** Its file. */
    path: string,
    /** Its last screen title, if any. */
    title: Option<string>,
    /** Its state when left; `None` when it had stopped. */
    state: Option<u8[]>,
    /** The version of that state's shape (1 for a bare `.wasm`). */
    state_version: i64,
    manifest: Option<Manifest>,
    /** Its icon, if it had one. */
    icon: Option<u8[]>,
    trust: Option<Trust>,
    /** Which signed app it is, when read back from disk (no `trust` then). */
    signer: Option<(string, u8[])>,
    program: Option<Program>,
    /** Which instance of its app it was (PRP-033): "" for the first. */
    instance: string,
    /** The name the person gave that instance, if any. */
    label: Option<string>,
}

/**
 * Closes a page and remembers it for "Where you left off".
 *
 * @param p the page
 * @returns what Continue needs: its name, title, state and compiled module
 *
 * Example:
 *     let left = leave(page);
 */
fun leave(p: AppPage): LeftOff {
    let left = LeftOff {
        name: p.name,
        path: p.path,
        title: p.title,
        state: state_of(p),
        state_version: state_version_of(p),
        manifest: p.manifest,
        icon: p.icon,
        trust: p.trust,
        signer: None,
        program: p.program,
        instance: p.instance,
        label: p.label,
    };
    close_page(p);
    left
}

/**
 * What leaving a page would remember, without closing it: what's saved as
 * "where you left off" while the app is still open (PRP-007 amendment 1).
 *
 * Example:
 *     snapshot(page)
 */
fun snapshot(p: AppPage): LeftOff = LeftOff {
    name: p.name,
    path: p.path,
    title: p.title,
    state: state_of(p),
    state_version: state_version_of(p),
    manifest: p.manifest,
    icon: p.icon,
    trust: p.trust,
    signer: None,
    program: None,
    instance: p.instance,
    label: p.label,
};

/**
 * Says whether a left-off still holds its compiled app (left this
 * session), so `resume` can start it; one read from disk must be loaded
 * again.
 *
 * Example:
 *     if compiled(l) { resume(l) } else { … }
 */
fun compiled(l: LeftOff): bool = l.program.is_some();

/**
 * A "where you left off" read back from disk: no compiled program and no
 * state, so Continue opens its path again, and a signed app's state comes
 * back from `states/` (PRP-007 amendment 2).
 *
 * Example:
 *     recalled("Counter", "rapidkoi://localhost:8000", Some("Count: 3"), None, Some((host, key)))
 */
fun recalled(
    name: string,
    path: string,
    title: Option<string>,
    icon: Option<u8[]>,
    signer: Option<(string, u8[])>,
): LeftOff = LeftOff {
    name: name,
    path: path,
    title: title,
    state: None,
    state_version: 1,
    manifest: None,
    icon: icon,
    trust: None,
    signer: signer,
    program: None,
    instance: "",
    label: None,
};

/**
 * The same left-off, as one instance of its app (PRP-033): what the
 * left-off file read back.
 *
 * Example:
 *     as_instance(recalled(…), "2", Some("Work"))
 */
fun as_instance(l: LeftOff, instance: string, label: Option<string>): LeftOff = LeftOff {
    instance: instance,
    label: label,
    ..l,
};

/**
 * Returns which signed app a left-off is (its host and key), or `None`
 * for an unsigned one: signed apps keep their state across restarts.
 *
 * Example:
 *     signer_of(left)
 */
fun signer_of(l: LeftOff): Option<(string, u8[])> = match l.trust {
    Some(t) => Some((t.host, t.key)),
    None => l.signer,
};
