/**
 * Pins and Forget (moved unchanged from `window.la`, PRP-035, for its
 * size): pinning and unpinning the current app, whether an app is pinned,
 * and forgetting the current app. Each acts on one app: at an address
 * with several, the one with that first key (PRP-049).
 *
 * Depends on: std.crypto, window.window, window.tabs, window.leftoff
 * Used by: shell, ui.addressbox
 */
import std.crypto { equal };
import window.window { Model, page_of, close };
import window.tabs { Pin, AppPage };
import window.leftoff { LeftOff, signer_of };

/**
 * Forgets the current app: closes its tab without making it "where you left
 * off", unpins it, drops a "where you left off" from the same place, and
 * closes the panel. `saving` then saves both; the app's trusted key stays,
 * so a swapped key still asks first (PRP-007).
 *
 * Example:
 *     forget(m)
 */
fun forget(m: Model): Model = match (m.current, page_of(m)) {
    (Some(id), App(a)) => {
        let closed = close(m, id);
        // close() made this app "where you left off"; forgetting keeps the
        // one from before, unless that was this app too.
        let left = match m.left_off {
            Some(l) if left_is(l, a) => None,
            _ => m.left_off,
        };
        Model {
            pinned: closed.pinned.filter(fun(p: Pin) = !pins_app(p, a.path, origin_of(a))),
            left_off: left,
            panel: None,
            confirm: None,
            ..closed,
        }
    }
    _ => m,
};

/**
 * Pins the current app, or unpins it if it's pinned (☆ in the bar).
 *
 * Example:
 *     toggle_pin(m)
 */
fun toggle_pin(m: Model): Model = match page_of(m) {
    App(a) if is_pinned(m, a.path, origin_of(a)) => Model {
        pinned: m.pinned.filter(fun(p: Pin) = !pins_app(p, a.path, origin_of(a))),
        ..m,
    },
    _ => pin(m),
};

/**
 * Pins the current app, unless it's pinned already.
 *
 * Example:
 *     pin(m)
 */
fun pin(m: Model): Model = match page_of(m) {
    App(a) if !is_pinned(m, a.path, origin_of(a)) => {
        let mut more = m.pinned;
        more.push(Pin { name: a.name, path: a.path, icon: a.icon, origin: origin_of(a) });
        Model { pinned: more, ..m }
    }
    _ => m,
};

/**
 * Says whether the app at `path` with first key `origin` is pinned.
 *
 * Example:
 *     is_pinned(m, "counter.wasm", None)
 */
fun is_pinned(m: Model, path: string, origin: Option<u8[]>): bool = m.pinned.any(
    fun(p: Pin) = pins_app(p, path, origin),
);

/**
 * Whether pin `p` is the app at `path` with first key `origin`: a pin
 * made before PRP-049, which names no key, is any app at its address.
 *
 * Example:
 *     pins_app(pin, "rapidkoi://notes.dafifi.net", Some(origin))
 */
fun pins_app(p: Pin, path: string, origin: Option<u8[]>): bool = p.path == path && match (
    p.origin,
    origin,
) {
    (Some(a), Some(b)) => equal(a, b),
    _ => true,
};

/** A page's app's first key, when it's signed (PRP-049). */
fun origin_of(a: AppPage): Option<u8[]> = a.trust.map(fun(t) = t.origin);

/** Whether "where you left off" is app `a`: its address, and its key when it was signed. */
fun left_is(l: LeftOff, a: AppPage): bool = l.path == a.path && match (signer_of(l), a.trust) {
    (Some((_, k)), Some(t)) => equal(k, t.key) || equal(k, t.origin),
    _ => true,
};
