/**
 * Rapidkoi's Settings (PRP-038): a built-in app, a bundle built into
 * `./main` from `assets/apps/settings.rkb` (`scripts/settings.sh` packs it),
 * as the new tab is. It alone may hold `change_settings`. Unsigned: it's
 * trusted because it's part of Rapidkoi. Still a guest, under every limit.
 *
 * Depends on: wasmtime, bundles.loader, trust.verify, window.tabs
 * Used by: window.navigate
 */
import wasmtime { Engine };
import bundles.loader { Origin, Refusal, from_bytes };
import trust.verify { keyring };
import window.tabs { AppPage, Pin, from_loaded };
import bundles.bundle { read, asset };

/** Settings' path and settings key: no host or file, so a name of its own. */
const SETTINGS_KEY: string = "builtin:settings";

/** The Settings app's bundle, as built into the program. */
const BUNDLE: u8[] = include_bytes("../../assets/apps/settings.rkb");

/**
 * Starts the Settings app.
 *
 * @param engine the engine to compile it with
 * @returns its page, running; or why it couldn't start
 *
 * Example:
 *     settings_app.open(engine)
 */
fun open(engine: Engine): Result<AppPage, Refusal> {
    // Built in: the only bytes that may hold built-in permissions (PRP-030).
    let l = from_bytes(engine, keyring(), "settings.rkb", BUNDLE, Origin.BuiltIn)?;
    Ok(from_loaded(engine, l, SETTINGS_KEY, []))
}

/**
 * Settings as a pin (PRP-064): what a first run's pins start with, its
 * icon from its bundle, opened by its path as ☰ opens it.
 *
 * Example:
 *     settings_app.pin()
 */
fun pin(): Pin {
    let icon = match read(BUNDLE) {
        Ok(b) => b.manifest.icon.and_then(fun(i: string) = asset(b, i)),
        Err(_) => None,
    };
    Pin { name: "Settings", path: SETTINGS_KEY, icon: icon, origin: None }
}
