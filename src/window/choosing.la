/**
 * Two apps at one address (PRP-049, DECISION-064): naming a separate app
 * before it opens, and "Which app?" when an address has several. A
 * separate app is another publisher's key at the same host, trusted as
 * its own app under the person's name; it opens in its own tab, and the
 * person's version stays. Never touches the disk; loads are tasks.
 *
 * Depends on: kivuli, std.crypto, window.window, window.tabs, window.apps, window.actions, trust.verify, trust.publishers, net.loads, net.address
 * Used by: window.navigate, shell, ui.asking
 */
import kivuli { Cmd };
import std.crypto { equal };
import window.window { Model, Naming, app, add_tab, close, show_tab, with_tab, page_of };
import window.leftoff { leave };
import window.tabs { AppPage, Tab, Page, Pin, open_path, close_page, failed_page };
import window.actions { Msg };
import trust.verify { Change, Identity, known_for, separate };
import trust.publishers { apps_at, default_at, set_default, renamed };
import net.loads { begin_app };
import net.address { is_address, parse, shown };

/** The longest name a separate app is given, as an instance's (PRP-033). */
const MAX_NAME: i64 = 64;

/**
 * "Open as a separate app" on the question about a changed key: asks for
 * the new app's name first.
 *
 * Example:
 *     start_naming(m)
 */
fun start_naming(m: Model): Model = match (m.current, page_of(m)) {
    (Some(id), App(a)) => match a.screen {
        Unapproved(c, _) => Model { naming: Some(Naming.Separate(id, c, "")), ..m },
        _ => m,
    },
    _ => m,
};

/**
 * "Open as a separate app" on the shield of an app whose site moved on
 * (PRP-049): the new publisher's app, named first, then in place; or its
 * tab, when it's already an app here.
 *
 * Example:
 *     separate_moved(m)
 */
fun separate_moved(m: Model): (Model, Cmd<Msg>) {
    let (a, t, new) = match page_of(m) {
        App(a) => match (a.trust, a.cached.and_then(fun(c) = c.moved)) {
            (Some(t), Some(new)) => (a, t, new),
            _ => {
                return (m, Cmd.none());
            }
        },
        Home => {
            return (m, Cmd.none());
        }
    };
    let known = apps_at(known_for(m.ring, t.host), t.host);
    if let Some(i) = known.iter().find(fun(i: Identity) = equal(i.key, new)) {
        let placed = add_tab(Model { shield: None, ..m }, failed_page(a.path, ""));
        return opened(placed, placed.current.unwrap_or(-1), a.path, i.origin);
    }
    // Named first, from your version's tab: the new app's tab opens only
    // with it (the owner, 2026-10-30).
    let c = Change { host: t.host, old: t.key, new: new };
    // The shield's card closes: the dialog takes over (the owner, 2026-10-30).
    match m.current {
        Some(id) => (
            Model { naming: Some(Naming.Separate(id, c, "")), shield: None, ..m },
            Cmd.none(),
        ),
        None => (m, Cmd.none()),
    }
}

/**
 * The name typed in the naming dialog.
 *
 * Example:
 *     name_typed(m, "Bob's Notes")
 */
fun name_typed(m: Model, typed: string): Model = match m.naming {
    Some(Separate(id, c, _)) => Model { naming: Some(Naming.Separate(id, c, typed)), ..m },
    Some(Renaming(host, origin, _)) => Model {
        naming: Some(Naming.Renaming(host, origin, typed)),
        ..m,
    },
    None => m,
};

/**
 * Rename on a row of the chip's list (PRP-050): the naming dialog, holding
 * the app's name.
 *
 * Example:
 *     start_rename(m, origin)
 */
fun start_rename(m: Model, origin: u8[]): Model {
    let host = match here(m) {
        Some(h) => h,
        None => {
            return m;
        }
    };
    let name = apps_at(known_for(m.ring, host), host).iter().find(
        fun(i: Identity) = equal(i.origin, origin),
    ).and_then(fun(i: Identity) = i.name).unwrap_or("");
    Model { naming: Some(Naming.Renaming(host, origin, name)), chip: false, ..m }
}

/**
 * Default on a row of the chip's list or "Which app?" (PRP-050): ticks or
 * unticks that app as the address's default.
 *
 * Example:
 *     set_default_here(m, origin, true)
 */
fun set_default_here(m: Model, origin: u8[], on: bool): Model {
    let host = match (here(m), m.choosing) {
        (Some(h), _) => h,
        (None, Some((_, path))) => match parse(path) {
            Ok(a) => shown(a),
            Err(_) => {
                return m;
            }
        },
        _ => {
            return m;
        }
    };
    set_default(m.ring, host, origin, on);
    m
}

/** The host of the signed app in front, if one is. */
fun here(m: Model): Option<string> = match page_of(m) {
    App(a) => a.trust.map(fun(t) = t.host),
    Home => None,
};

/**
 * Says why the name typed can't be used, or nothing when it can: empty,
 * longer than 64 characters, or another app's at this address.
 *
 * Example:
 *     naming_problem(m)
 */
fun naming_problem(m: Model): Option<string> {
    // A rename may keep the app's own name.
    let (host, itself, typed) = match m.naming {
        Some(Separate(_, c, typed)) => (c.host, None, typed),
        Some(Renaming(host, origin, typed)) => (host, Some(origin), typed),
        None => {
            return None;
        }
    };
    let name = typed.trim();
    if name == "" {
        return Some("Give it a name");
    }
    if name.char_count() > MAX_NAME {
        return Some("At most 64 characters");
    }
    let taken = apps_at(known_for(m.ring, host), host).any(
        fun(i: Identity) = i.name == Some(name) && !itself.map(
            fun(o: u8[]) = equal(o, i.origin),
        ).unwrap_or(false),
    );
    if taken {
        return Some("Another app here is called that");
    }
    None
}

/**
 * Opens the separate app under the name typed, if it can be used: its key
 * trusted as its own app, loaded from its site in place, in the tab it
 * was asked from. The person's version, when one was open, becomes where
 * they left off.
 *
 * Example:
 *     confirm_naming(m)
 */
fun confirm_naming(m: Model): (Model, Cmd<Msg>) {
    let (id, c, typed) = match m.naming {
        Some(Separate(id, c, typed)) if naming_problem(m).is_none() => (id, c, typed),
        Some(Renaming(host, origin, typed)) if naming_problem(m).is_none() => {
            return (renamed_here(m, host, origin, typed.trim()), Cmd.none());
        }
        _ => {
            return (m, Cmd.none());
        }
    };
    separate(m.ring, c, typed.trim());
    let base = Model { naming: None, ..m };
    let a = match app(base, id) {
        Some(a) => a,
        None => {
            return (base, Cmd.none());
        }
    };
    // In place (the owner, 2026-10-30): the new app takes this tab. Your
    // version, if it was open, closes as any app does: where you left
    // off, its window's state with it, for Continue.
    let yours = match a.screen {
        Unapproved(_, kept) if kept.len > 0 => Some(kept[0]),
        Unapproved(_, _) => None,
        _ => Some(a),
    };
    let left = match yours {
        Some(y) => Some(leave(y)),
        None => base.left_off,
    };
    close_page(a);
    opened(Model { left_off: left, ..base }, id, a.path, c.new)
}

/**
 * Cancel on the name: the window as it was (the question, if it asked).
 *
 * Example:
 *     cancel_naming(m)
 */
fun cancel_naming(m: Model): Model = Model { naming: None, ..m };

/**
 * "Which app?" for an address with several apps (PRP-049): its tab and
 * the question, in place of opening one; or its default, opened (PRP-050).
 * `None` when the address has one app or none, so it opens as before.
 *
 * Example:
 *     asks_which(m, "rapidkoi://notes.dafifi.net")
 */
fun asks_which(m: Model, path: string): Option<(Model, Cmd<Msg>)> {
    if !is_address(path) {
        return None;
    }
    let host = shown(parse(path).ok()?);
    let all = known_for(m.ring, host);
    if apps_at(all, host).len < 2 {
        return None;
    }
    let placed = add_tab(m, failed_page(path, ""));
    let id = placed.current.unwrap_or(-1);
    // The default, when one is ticked (PRP-050): no question.
    if let Some(origin) = default_at(all, host) {
        return Some(opened(placed, id, path, origin));
    }
    Some((Model { choosing: Some((id, path)), ..placed }, Cmd.none()))
}

/**
 * The apps "Which app?" lists for its address: one per first key, with
 * the name each is shown by (its own or the person's, else the host).
 *
 * Example:
 *     choices(m)
 */
fun choices(m: Model): (string, Identity)[] = match m.choosing {
    Some((_, path)) => match parse(path) {
        Ok(a) => apps_at(known_for(m.ring, shown(a)), shown(a)).map(
            fun(i: Identity) = (i.name.unwrap_or(i.host), i),
        ),
        Err(_) => [],
    },
    None => [],
};

/**
 * Opens the app picked from "Which app?" or the chip's list: its tab when
 * it's open, else in the asking tab or a new one.
 *
 * Example:
 *     choose(m, origin)
 */
fun choose(m: Model, origin: u8[]): (Model, Cmd<Msg>) = match m.choosing {
    Some((id, path)) => opened(Model { choosing: None, ..m }, id, path, origin),
    // From the chip's list (PRP-050): that app's tab, or a new one for it.
    None => match page_of(m) {
        App(a) => {
            let placed = add_tab(Model { chip: false, ..m }, failed_page(a.path, ""));
            opened(placed, placed.current.unwrap_or(-1), a.path, origin)
        }
        Home => (m, Cmd.none()),
    },
};

/** App `origin` at `path` in tab `id`: its own tab instead, when one is open. */
fun opened(m: Model, id: i64, path: string, origin: u8[]): (Model, Cmd<Msg>) {
    let open = m.tabs.iter().find(
        fun(t: Tab) = t.id != id && t.page.path == path && t.page.trust.map(
            fun(tr) = equal(tr.origin, origin),
        ).unwrap_or(false),
    );
    if let Some(t) = open {
        return (show_tab(close(m, id), t.id), Cmd.none());
    }
    if is_address(path) && parse(path).is_ok() {
        return begin_app(m, id, path, origin);
    }
    // A signed file: its key is trusted now, so it opens as that app.
    (with_tab(m, id, fun(_: AppPage) = open_path(m.engine, m.ring, path)), Cmd.none())
}

/**
 * App `origin` at `host` renamed (PRP-050): its identity, and its open
 * windows and pins, so the new name shows everywhere at once.
 */
fun renamed_here(m: Model, host: string, origin: u8[], name: string): Model {
    renamed(m.ring, host, origin, name);
    let theirs = fun(p: AppPage) = p.trust.map(
        fun(t) = t.host == host && equal(t.origin, origin),
    ).unwrap_or(false);
    Model {
        naming: None,
        tabs: m.tabs.map(
            fun(t: Tab) = if theirs(t.page) {
                Tab { page: AppPage { name: name, ..t.page }, ..t }
            } else {
                t
            },
        ),
        pinned: m.pinned.map(
            fun(p: Pin) = if p.origin.map(fun(o: u8[]) = equal(o, origin)).unwrap_or(false) {
                Pin { name: name, ..p }
            } else {
                p
            },
        ),
        ..m,
    }
}
