/**
 * Starting an app page again (moved from `tabs.la`, PRP-036): reopening a
 * window that was left, with its saved state; starting a page again from a
 * saved state; and ⟳ Reload's load from where it came from.
 *
 * Depends on: wasmtime, bundles.loader, trust.verify, guest.running, window.tabs
 * Used by: window.navigate, net.loads
 */
import wasmtime { Engine };
import boot.appboot { Source, loaded };
import guest.modules { Modules };
import trust.verify { Keyring };
import guest.running { start };
import window.tabs {
    AppPage,
    Screen,
    Program,
    ran,
    close_page,
    state_version_of,
    refused,
    failed,
    open_program,
    from_loaded,
};

/**
 * Starts a page again from a saved state, when the state's version is the
 * page's: how a signed app picks up where it was after a restart.
 *
 * @returns the page, and whether the saved state had to be dropped
 *     because its shape changed (the page is left as it was then)
 *
 * Example:
 *     with_saved(page, saved.state, saved.state_version)
 */
fun with_saved(p: AppPage, state: u8[], version: i64): (AppPage, bool) = match p.program {
    Some(prog) if state_version_of(p) == version => {
        close_page(p);
        // The window keeps the fields its address named.
        (ran(p, start(prog, Some(state), [])), false)
    }
    Some(_) => (p, true),
    None => (p, false),
};

/**
 * Loads an app again from where it came from (its file, or its development
 * server) and starts it with `saved` state when the new build's state
 * version matches; otherwise fresh. ⟳ Reload uses it.
 *
 * @param held the modules kept for the run: through the pipeline (PRP-069),
 *     an unchanged file compiles nothing
 * @param engine the program's engine
 * @param now when, for the modules kept
 * @param ring this session's trusted keys
 * @param path the page's file or address
 * @param saved the running page's state and state version, if it had one
 * @param link the fields the running page's address named, kept with its state
 * @returns the page, and whether a saved state had to be dropped because
 *     its shape changed (`migrate` comes with PRP-006)
 *
 * Example:
 *     load_again(held, engine, now, ring, page.path, Some((state, 1)), page.link)
 */
fun load_again(
    held: Ref<Modules>,
    engine: Engine,
    now: i64,
    ring: Keyring,
    path: string,
    saved: Option<(u8[], i64)>,
    link: string[],
): (AppPage, bool) = match loaded(held, engine, now, ring, Source.File(path)) {
    Err(r) => (refused(r, path), false),
    Ok(l) => {
        // Its manifest before its first screen, as `tabs.from_loaded` gives it (PRP-073).
        let fresh = from_loaded(engine, l, path, []);
        let now = state_version_of(fresh);
        match saved {
            Some((state, version)) if version == now => {
                close_page(fresh);
                let program = Program { engine: engine, module: l.module, assets: l.assets };
                // Continued with its state, the window keeps its address's fields.
                (
                    ran(
                        AppPage { program: Some(program), link: link, ..fresh },
                        start(program, Some(state), []),
                    ),
                    false,
                )
            }
            Some(_) => (fresh, true),
            None => (fresh, false),
        }
    }
};
