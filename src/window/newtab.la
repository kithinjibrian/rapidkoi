/**
 * Rapidkoi's new tab (PRP-027): the app every empty tab runs, a bundle
 * built into ./main from `assets/apps/newtab.rkb` (`scripts/newtab.sh`
 * packs it). Unsigned: it's trusted because it's part of Rapidkoi. Still a
 * guest, under every limit.
 *
 * Depends on: wasmtime, bundles.loader, trust.verify, window.tabs
 * Used by: shell
 */
import wasmtime { Engine };
import bundles.loader { Refusal };
import guest.modules { Modules, no_modules };
import boot.appboot { Source, loaded, started };
import trust.verify { keyring };
import window.tabs { AppPage };

/** The new tab's path and settings key: no host or file, so a name of its own (PRP-031). */
const NEWTAB_KEY: string = "builtin:newtab";

/** The new-tab app's bundle, as built into the program. */
const BUNDLE: u8[] = include_bytes("../../assets/apps/newtab.rkb");

/**
 * Starts the new-tab app.
 *
 * @param engine the engine to compile it with
 * @returns its page, running; or why it couldn't start
 *
 * Example:
 *     newtab.open(engine)
 */
fun open(engine: Engine): Result<AppPage, Refusal> = open_bundle(engine, BUNDLE);

/**
 * Starts a new-tab app from `bundle`: `BUNDLE` in Rapidkoi, a stand-in in tests.
 * Only bytes compiled into the program reach it, so they may hold built-in
 * permissions; nothing a guest sends or a file holds is ever passed here.
 *
 * Example:
 *     newtab.open_bundle(engine, BUNDLE)
 */
fun open_bundle(engine: Engine, bundle: u8[]): Result<AppPage, Refusal> = open_kept(
    Ref.new(no_modules()),
    engine,
    0,
    bundle,
);

/**
 * Starts a new-tab app from `bundle` as `open_bundle` does, its module
 * compiled through the modules kept for the run (PRP-068).
 *
 * @param held the modules kept; what's compiled is kept there
 *
 * Example:
 *     newtab.open_kept(held, engine, now, BUNDLE)
 */
fun open_kept(
    held: Ref<Modules>,
    engine: Engine,
    now: i64,
    bundle: u8[],
): Result<AppPage, Refusal> {
    // An empty keyring: the bundle is unsigned, so nothing is looked up.
    // Built in: the only bytes that may hold built-in permissions (PRP-030).
    let l = loaded(held, engine, now, keyring(), Source.BuiltIn("newtab.rkb", bundle))?;
    // Its path is its key for your permission settings (`access.key_of`).
    Ok(started(engine, l, NEWTAB_KEY, []))
}
