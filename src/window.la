/**
 * The window's state and the changes that open nothing: tabs (apps only;
 * home isn't a tab), the current one or home, the address box's text,
 * pins, "where you left off" and the theme. Opening files and addresses is
 * `navigate.la`. Never draws.
 *
 * Depends on: wasmtime, actions, tabs, home, frame, themes
 * Used by: navigate, shell
 */
import wasmtime { Engine };
import actions { Msg };
import tabs { Page, Tab, Pin, LeftOff, AppPage, leave };
import home { Card };
import frame { icon_of };
import themes { Theme, DARK };

/** The window's state. */
public struct Model {
    engine: Engine,
    /** The open apps, in rail order. */
    public tabs: Tab[],
    /** The current tab's id; `None` while home shows. */
    public current: Option<i64>,
    next: i64,
    /** The address box's text. */
    public draft: string,
    /** Whether an app page's address is being edited. */
    public editing: bool,
    /** Whether the info panel is open. */
    public showing_panel: bool,
    /** Pinned apps, in this session (PRP-003 keeps them). */
    public pinned: Pin[],
    /** The last app tab visited before home, if it's still open. */
    public last: Option<i64>,
    /** The last app closed, with its state, in this session. */
    public left_off: Option<LeftOff>,
    /** A short message under the bar (an address that can't be opened yet). */
    public notice: Option<string>,
    /** Rapidkoi's own colours. */
    public theme: Theme,
}

/**
 * Builds a window with one tab per page, the first current; none shows home.
 *
 * @param engine the engine the pages' apps were compiled with
 * @param pages the apps to open
 * @returns the model, in the dark theme
 *
 * Example:
 *     with_pages(engine, [])
 */
public fun with_pages(engine: Engine, pages: AppPage[]): Model {
    let mut made: Tab[] = [];
    for p of pages {
        made.push(Tab { id: made.len, page: p });
    }
    Model {
        engine: engine,
        tabs: made,
        current: if made.len > 0 { Some(0) } else { None },
        next: made.len,
        draft: "",
        editing: false,
        showing_panel: false,
        pinned: [],
        last: None,
        left_off: None,
        notice: None,
        theme: DARK,
    }
}

/**
 * Returns what the window shows: home, or the current tab's app.
 *
 * Example:
 *     page_of(m)
 */
public fun page_of(m: Model): Page = match m.current {
    Some(id) => match app(m, id) {
        Some(a) => Page.App(a),
        None => Page.Home,
    },
    None => Page.Home,
};

/**
 * Returns the window's title: "Rapidkoi" on home, "Rapidkoi — {title or name}" on an app.
 *
 * Example:
 *     title_of(m)
 */
public fun title_of(m: Model): string = match page_of(m) {
    Home => "Rapidkoi",
    App(a) => "Rapidkoi — {a.title.unwrap_or(a.name)}",
};

/**
 * Returns "Where you left off": the last app visited if its tab is open,
 * else the last app closed.
 *
 * Example:
 *     card(m)
 */
public fun card(m: Model): Option<Card> {
    if let Some(id) = m.last {
        if let Some(a) = app(m, id) {
            return Some(Card {
                name: a.name,
                title: a.title,
                msg: Msg.Select(id),
                icon: icon_of(a.path, a.icon),
            });
        }
    }
    m.left_off.map(
        fun(l: LeftOff) = Card {
            name: l.name,
            title: l.title,
            msg: Msg.Continue,
            icon: icon_of(l.path, l.icon),
        },
    )
}

/**
 * Shows home; the app stays open in its tab and becomes "where you left off".
 *
 * Example:
 *     go_home(m)
 */
public fun go_home(m: Model): Model = Model {
    current: None,
    last: if m.current.is_some() { m.current } else { m.last },
    draft: "",
    editing: false,
    showing_panel: false,
    notice: None,
    ..m,
};

/**
 * Shows a tab, if it's open.
 *
 * Example:
 *     show_tab(m, 2)
 */
public fun show_tab(m: Model, id: i64): Model = if app(m, id).is_some() {
    Model { current: Some(id), editing: false, notice: None, ..m }
} else {
    m
};

/**
 * Changes one tab's app.
 *
 * Example:
 *     with_tab(m, id, fun(a) = handle(a, msg))
 */
public fun with_tab(m: Model, id: i64, f: fun(AppPage): AppPage): Model = Model {
    tabs: m.tabs.map(fun(t: Tab) = if t.id == id { Tab { page: f(t.page), ..t } } else { t }),
    ..m,
};

/**
 * Closes a tab; its app becomes "where you left off". The tab to its right
 * (or left) becomes current; with none left, home shows.
 *
 * Example:
 *     close(m, 2)
 */
public fun close(m: Model, id: i64): Model {
    let mut at = -1;
    let mut left = m.left_off;
    let mut kept: Tab[] = [];
    for t of m.tabs {
        if t.id == id {
            at = kept.len;
            left = Some(leave(t.page));
        } else {
            kept.push(t);
        }
    }
    if at < 0 {
        return m;
    }
    let current: Option<i64> = if m.current != Some(id) {
        m.current
    } else if kept.len == 0 {
        None
    } else {
        Some(kept[if at < kept.len { at } else { kept.len - 1 }].id)
    };
    Model { tabs: kept, current: current, left_off: left, showing_panel: false, ..m }
}

/**
 * Pins the current app, unless it's pinned already.
 *
 * Example:
 *     pin(m)
 */
public fun pin(m: Model): Model = match page_of(m) {
    App(a) if !is_pinned(m, a.path) => {
        let mut more = m.pinned;
        more.push(Pin { name: a.name, path: a.path, icon: a.icon });
        Model { pinned: more, ..m }
    }
    _ => m,
};

/**
 * Says whether the app at `path` is pinned.
 *
 * Example:
 *     is_pinned(m, "counter.wasm")
 */
public fun is_pinned(m: Model, path: string): bool = m.pinned.any(fun(p: Pin) = p.path == path);

fun add_tab(m: Model, page: AppPage): Model {
    let mut more = m.tabs;
    more.push(Tab { id: m.next, page: page });
    Model { tabs: more, current: Some(m.next), next: m.next + 1, ..m }
}

fun app(m: Model, id: i64): Option<AppPage> {
    for t of m.tabs {
        if t.id == id {
            return Some(t.page);
        }
    }
    None
}
