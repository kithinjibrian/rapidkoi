/**
 * The app info panel, pure: what an app is, what it may do, and the
 * actions on its tab. Shown beside the app until kivuli has an overlay
 * (DECISION-018).
 *
 * Depends on: kivuli, render, actions, tabs, frame, theme
 * Used by: shell
 */
import kivuli { View, ButtonStyle, button, column, row, text };
import render;
import actions { Msg };
import tabs { AppPage };
import frame { icon_button, marker };
import bundle { Manifest };
import address { parse };
import theme { SPACE_SM, SPACE_MD, TEXT_TITLE, PANEL_WIDTH };

/**
 * Builds the info panel for an app page.
 *
 * @param id the page's tab
 * @param p the page
 * @param pinned whether the app is pinned
 * @returns the panel: name, title, version and description (bundles), where it came from, contract and state version, permissions, Restart, Pin/Unpin, Close tab
 *
 * Example:
 *     panel.view(tab.id, page, false)
 */
public fun view(id: i64, p: AppPage, pinned: bool): View<Msg> {
    let mut parts = [
        row([
            text(p.name).size(TEXT_TITLE).bold().expand(),
            icon_button("window-close-symbolic", "Close the panel", Some(Msg.TogglePanel)),
        ]),
    ];
    if let Some(t) = p.title {
        parts.push(text(t));
    }
    if let Some(m) = p.manifest {
        parts.push(text("Version {m.version}").dim());
        if let Some(d) = m.description {
            parts.push(text(d).wrap());
        }
    }
    parts.push(text(marker(p, p.path)).dim().wrap());
    let state = p.manifest.map(fun(m: Manifest) = m.state_version).unwrap_or(1);
    parts.push(text("Contract v1 · state v{state}").dim());
    parts.push(text("Permissions: none. This app can't reach anything outside itself.").wrap());
    if let Ok(a) = parse(p.path) {
        parts.push(
            text("Served from rapidkoi://{address.shown(a)} (development, unsigned)").dim().wrap(),
        );
        parts.push(
            button("Reload", Msg.Reload).tooltip("Fetch the server's bundle again and start fresh"),
        );
    }
    parts.push(button("Restart", Msg.Tab(id, render.Msg.Restart)));
    parts.push(if pinned { button("Unpin", Msg.Unpin(p.path)) } else { button("Pin", Msg.Pin) });
    parts.push(button("Close tab", Msg.CloseTab(id)).button_style(ButtonStyle.Danger));
    column(parts).spacing(SPACE_SM).padding(SPACE_MD).width(PANEL_WIDTH)
}
