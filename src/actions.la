/**
 * What Rapidkoi's window can send its `update`: the frame's buttons, the
 * address box, home, the info panel and its pages, and each tab's own
 * screen.
 *
 * Depends on: render, fetching
 * Used by: frame, home, panel, shell
 */
import render;
import fetching { Fetched };

/** A message to the shell. */
public enum Msg {
    /** A message from a tab's own screen (a guest event, or Restart), by tab id. */
    Tab(i64, render.Msg),
    /** Show this tab. */
    Select(i64),
    /** Open a new tab on home. */
    NewTab,
    /** Close this tab. */
    CloseTab(i64),
    /** Go home in the current tab. */
    Home,
    /** The address box's new text. */
    Draft(string),
    /** Open what the address box says. */
    Go,
    /** Turn the address shown on an app page back into the box. */
    EditAddress,
    /** Open a pinned app, by path, in the current tab. */
    OpenPinned(string),
    /** Reopen where the person left off. */
    Continue,
    /** Show or hide the app info panel. */
    TogglePanel,
    /** Pin the current app, or unpin it if it's pinned (☆ in the bar). */
    TogglePin,
    /** Move the keyboard to the address box (Ctrl+K). */
    FocusSearch,
    /** Load the current app again from its file or server, keeping its state when it can (⟳). */
    Reload,
    /** Open one of the info panel's pages. */
    PanelGo(PanelPage),
    /** Go back to the info panel's main page. */
    PanelBack,
    /** Ask before a destructive action. */
    Ask(Confirm),
    /** Don't do the action that was asked about. */
    Cancel,
    /** Clear the current app's state and start it fresh (confirmed). */
    StartOver,
    /** Forget the current app: its tab, pin and saved state (confirmed). */
    Forget,
    /** On a changed key: keep the page that was open (or close the tab). */
    KeepMine,
    /** On a changed key: trust the new key as a separate app, this session. */
    SeparateApp,
    /** A background load's result, for this tab and load number (PRP-008). */
    Fetched(i64, i64, Fetched),
    /** The loading tick: the time, while some tab is loading. */
    Tick(i64),
}

/** The info panel's pages. */
public enum PanelPage {
    /** The header, description, settings, storage and Forget. */
    Main,
    /** How the app knows you (sign-in comes later: DECISION-022). */
    Account,
    /** Whether it may send notifications. */
    Notifications,
    /** What it can reach: devices, files, servers. */
    Access,
    /** What it saved: where you left off, and Start over. */
    State,
    /** Its files and database. */
    Data,
    /** Who published it, where it came from, its version and build. */
    About,
}

/** A destructive action waiting for "yes". */
public enum Confirm {
    /** Clear the app's state. */
    StartOver,
    /** Forget the app entirely. */
    Forget,
}
