/**
 * The window's frame, pure (PRP-014): the header bar across the top, the
 * sidebar down the right and the content area filling the rest. Only the
 * frame: what goes in each area comes with later redesign PRPs
 * (DECISION-027). Never calls a guest.
 *
 * Depends on: kivuli, actions, window, theme, themes
 * Used by: shell
 */
import kivuli { View, column, row };
import actions { Msg };
import window { Model, title_of };
import theme { FRAME_THICKNESS, WINDOW_WIDTH, WINDOW_HEIGHT };
import themes { Look, kivuli_theme };

/**
 * Draws the bare frame: an empty header bar (GTK's window controls only), an
 * empty sidebar on the right and an empty content area.
 *
 * @param m the model: its theme and the window's title
 * @returns the window's view
 *
 * Example:
 *     layout.view(m)
 */
public fun view(m: Model): View<Msg> {
    let none: View<Msg>[] = [];
    // The content area meets the window's left and bottom edges; Look.Page
    // rounds only its top-right corner, where the frame wraps it.
    let content = column(none).expand().style([Look.Page]);
    // Empty and as wide as the header bar is tall, so the frame is an even L.
    // The root's Look.Frame paints it, as one surface with the header bar.
    let sidebar = column(none).width(FRAME_THICKNESS);
    // An empty title view: without one GTK would show the window's title in
    // the bar. The title stays set for the taskbar.
    column([row([content, sidebar]).expand()]).style([Look.Frame]).window(
        title_of(m),
        WINDOW_WIDTH,
        WINDOW_HEIGHT,
    ).maximized().theme(kivuli_theme(m.theme)).header(
        none,
        column(none).expand(),
        none,
    ).header_style([Look.Frame])
}
