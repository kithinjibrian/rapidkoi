/**
 * The rules every bundle keeps (format 1): names, versions, asset names and
 * types, references, sizes and counts. Pure; used by `bundle.read` and
 * `bundle.write` alike, so a bundle the packer writes is always one Rapidkoi
 * reads.
 *
 * Depends on: limits
 * Used by: bundle
 */
import limits { MAX_MODULE, MAX_ASSET, MAX_ASSETS, MAX_NAME, MAX_DESCRIPTION, MAX_ASSET_NAME };

/** Why a bundle was refused. */
public enum BundleError {
    /** The bytes aren't CBOR this reader accepts, with the decoder's reason. */
    Decode(string),
    /** Not a map at its top level. */
    NotAMap,
    /** What was too large, and its size in bytes. */
    TooLarge(string, i64),
    /** A format this Rapidkoi can't read. */
    Format(i64),
    /** A required field is missing. */
    Missing(string),
    /** A field, and what's wrong with it. */
    Wrong(string, string),
    /** An asset name breaking the naming rules. */
    BadName(string),
    /** An asset that isn't a PNG image. */
    NotPng(string),
    /** An asset whose value isn't bytes. */
    AssetNotBytes(string),
    /** A field naming an asset the bundle doesn't have: the field, the name. */
    MissingAsset(string, string),
    /** More assets than allowed. */
    TooManyAssets(i64),
    /** A field that must be empty in format 1. */
    NotEmpty(string),
}

/**
 * Returns a plain sentence for a bundle error.
 *
 * @param e the error
 * @returns what's wrong, naming the field
 *
 * Example:
 *     reason(BundleError.Missing("name"))
 */
public fun reason(e: BundleError): string = match e {
    Decode(d) => "This file isn't a Rapidkoi bundle ({d})",
    NotAMap => "This file isn't a Rapidkoi bundle (it isn't a map)",
    TooLarge(what, n) => if what == "bundle" {
        "This bundle is too large ({n} bytes)"
    } else {
        "This bundle's {what} is too large ({n} bytes)"
    },
    Format(n) => "This bundle needs a newer version of Rapidkoi (format {n})",
    Missing(field) => "This bundle is missing \"{field}\"",
    Wrong(field, problem) => "This bundle's \"{field}\" {problem}",
    BadName(name) => "This bundle has an asset with a bad name: \"{name}\"",
    NotPng(name) => "This bundle's asset \"{name}\" isn't a PNG image",
    AssetNotBytes(name) => "This bundle's asset \"{name}\" must be bytes",
    MissingAsset(field, name) => "This bundle's \"{field}\" names an asset it doesn't have: \"{name}\"",
    TooManyAssets(n) => "This bundle has too many assets ({n}; at most {MAX_ASSETS})",
    NotEmpty(field) => "This bundle asks for \"{field}\", which this version of Rapidkoi can't grant yet",
};

/**
 * Checks an app name: 1 to `MAX_NAME` bytes, no control characters.
 *
 * Example:
 *     check_name("Counter")?
 */
public fun check_name(name: string): Result<(), BundleError> {
    if name.len < 1 || name.len > MAX_NAME {
        return Err(BundleError.Wrong("name", "must be 1 to {MAX_NAME} bytes"));
    }
    plain_text("name", name)
}

/**
 * Checks a description: up to `MAX_DESCRIPTION` bytes, no control characters.
 *
 * Example:
 *     check_description("Counts")?
 */
public fun check_description(text: string): Result<(), BundleError> {
    if text.len > MAX_DESCRIPTION {
        return Err(BundleError.Wrong("description", "must be at most {MAX_DESCRIPTION} bytes"));
    }
    plain_text("description", text)
}

/**
 * Checks a version is plain semver, MAJOR.MINOR.PATCH: digits only, no
 * leading zeros, no pre-release or build parts.
 *
 * Example:
 *     check_version("1.4.0")?
 */
public fun check_version(v: string): Result<(), BundleError> {
    let wrong = BundleError.Wrong("version", "must be MAJOR.MINOR.PATCH, like 1.4.0");
    let parts = v.split(".");
    if parts.len != 3 {
        return Err(wrong);
    }
    for p of parts {
        // 1–9 digits: no leading zeros (semver), and small enough for any reader.
        if p.len == 0 || p.len > 9 || p.len > 1 && p[0] == 48 {
            return Err(wrong);
        }
        for b of p {
            if b < 48 || b > 57 {
                return Err(wrong);
            }
        }
    }
    Ok(())
}

/**
 * Checks an asset name: 1 to `MAX_ASSET_NAME` bytes of `a–z 0–9 . _ - /`,
 * not starting or ending with `/`, with no `..` and no `//`. Names are keys,
 * never file paths; the rules keep them unambiguous anyway.
 *
 * Example:
 *     check_asset_name("banner/home.png")?
 */
public fun check_asset_name(name: string): Result<(), BundleError> {
    let bad = BundleError.BadName(name);
    if name.len < 1 || name.len > MAX_ASSET_NAME || name.starts_with("/") || name.ends_with(
        "/",
    ) || name.contains("..") || name.contains("//") {
        return Err(bad);
    }
    for b of name {
        let lower = b >= 97 && b <= 122;
        let digit = b >= 48 && b <= 57;
        // . _ - /
        if !(lower || digit || b == 46 || b == 95 || b == 45 || b == 47) {
            return Err(bad);
        }
    }
    Ok(())
}

/**
 * Checks one asset: its name, its size, and that it starts with PNG's
 * 8-byte signature. Rapidkoi decodes nothing itself.
 *
 * Example:
 *     check_asset("icon.png", bytes)?
 */
public fun check_asset(name: string, bytes: u8[]): Result<(), BundleError> {
    check_asset_name(name)?;
    if bytes.len > MAX_ASSET {
        return Err(BundleError.TooLarge("asset \"{name}\"", bytes.len));
    }
    let signature: u8[] = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a];
    if bytes.len < 8 {
        return Err(BundleError.NotPng(name));
    }
    for i in 0..8 {
        if bytes[i] != signature[i] {
            return Err(BundleError.NotPng(name));
        }
    }
    Ok(())
}

/**
 * Checks the counts and sizes of a whole bundle's parts.
 *
 * Example:
 *     check_sizes(module.len, assets.len)?
 */
public fun check_sizes(module: i64, assets: i64): Result<(), BundleError> {
    if module > MAX_MODULE {
        return Err(BundleError.TooLarge("module", module));
    }
    if assets > MAX_ASSETS {
        return Err(BundleError.TooManyAssets(assets));
    }
    Ok(())
}

/** No control characters (below space, and DEL). */
fun plain_text(field: string, text: string): Result<(), BundleError> {
    for b of text {
        if b < 32 || b == 127 {
            return Err(BundleError.Wrong(field, "can't hold control characters"));
        }
    }
    Ok(())
}
