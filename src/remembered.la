/**
 * The three files Rapidkoi remembers across restarts, as CBOR maps that
 * start with their format and kind: `trust` (identities: host, key,
 * sequence, separate), `pins` (name, path, icon) and `left-off` (the app
 * used last; a signed app's state is in `states/`). Reading treats every file as hostile: CBOR
 * limits, then every field checked. `recall` adds the store: a missing file
 * is Fresh, a broken one is set aside, a newer one is left alone.
 *
 * Depends on: cbor, store, verify, tabs, rules, limits
 * Used by: saving
 */
import cbor { Value, Entry, Limits, decode, encode };
import store { Store, StoreError, load, set_aside, reason as store_reason };
import verify { Identity };
import tabs { Pin, LeftOff, recalled, signer_of };
import rules { check_host, check_asset, check_role };
import limits { MAX_ICON_PX };

/** The format these files are written in. */
public const FORMAT: i64 = 1;

/** The most identities the trust file holds. */
public const MAX_IDENTITIES: i64 = 10_000;

/** The most pins the pins file holds. */
public const MAX_PINS: i64 = 256;

/** The trust file's cap in bytes. */
public const MAX_TRUST_FILE: i64 = 1024 * 1024;

/** The pins file's cap in bytes (icons are kept with their pins). */
public const MAX_PINS_FILE: i64 = 32 * 1024 * 1024;

/** The left-off file's cap in bytes: a name, a path and an icon. */
public const MAX_LEFT_FILE: i64 = 8 * 1024 * 1024;

/** Why a file's bytes can't be used. */
public enum Unreadable {
    /** Damaged or not Rapidkoi's: why, naming the field. */
    Broken(string),
    /** Written by a newer Rapidkoi: its format number. */
    Newer(i64),
}

/** What reading one remembered file came to. */
public enum Recalled<T> {
    /** No file: a first run. */
    Fresh,
    /** Read. */
    Read(T),
    /** Broken, and set aside: where it went, why. */
    Broken(string, string),
    /** A newer Rapidkoi's: left as it is. */
    Newer(i64),
    /** It couldn't even be read or set aside: why. */
    Failed(string),
}

/**
 * Reads one remembered file from the store.
 *
 * @param name `trust`, `pins` or `left-off`
 * @param max its cap in bytes; a larger file is broken
 * @param read its format's reader
 *
 * Example:
 *     recall(s, "trust", MAX_TRUST_FILE, read_trust)
 */
public fun recall<T>(
    s: Store,
    name: string,
    max: i64,
    read: fun(u8[]): Result<T, Unreadable>,
): Recalled<T> {
    let bytes = match load(s, name, max) {
        Ok(None) => {
            return Recalled.Fresh;
        }
        Ok(Some(b)) => b,
        Err(TooLarge(n, size)) => {
            return aside(s, name, store_reason(StoreError.TooLarge(n, size)));
        }
        Err(e) => {
            return Recalled.Failed(store_reason(e));
        }
    };
    match read(bytes) {
        Ok(v) => Recalled.Read(v),
        Err(Newer(n)) => Recalled.Newer(n),
        Err(Broken(why)) => aside(s, name, why),
    }
}

/**
 * Encodes the trust file.
 *
 * Example:
 *     save(s, "trust", trust_file(identities(ring)))?
 */
public fun trust_file(ids: Identity[]): u8[] = file(
    "trust",
    "entries",
    Value.Array(
        ids.map(
            fun(i: Identity) = Value.Map([
                entry("host", Value.Text(i.host)),
                entry("key", Value.Bytes(i.key)),
                entry("sequence", Value.int(i.sequence)),
                entry("separate", Value.Bool(i.separate)),
            ]),
        ),
    ),
);

/**
 * Reads the trust file: every host a host name, every key 32 bytes.
 *
 * Example:
 *     read_trust(bytes)?
 */
public fun read_trust(bytes: u8[]): Result<Identity[], Unreadable> {
    let items = list(bytes, "trust", "entries", 4, 16 * MAX_IDENTITIES, 1024 * 1024)?;
    if items.len > MAX_IDENTITIES {
        return Err(Unreadable.Broken("it has more than 10,000 entries"));
    }
    let mut ids: Identity[] = [];
    for v of items {
        if v.as_map().is_none() {
            return Err(Unreadable.Broken("an entry isn't a map"));
        }
        let host = text(v, "host").ok_or(Unreadable.Broken("an entry has no host"))?;
        if check_host(host).is_err() {
            return Err(Unreadable.Broken("an entry's host isn't a host name"));
        }
        let key = blob(v, "key").unwrap_or([]);
        if key.len != 32 {
            return Err(Unreadable.Broken("an entry's key isn't 32 bytes"));
        }
        let sequence = v.get("sequence").map(fun(n: Value) = n.as_i64().unwrap_or(-1)).unwrap_or(
            -1,
        );
        if sequence < 0 {
            return Err(Unreadable.Broken("an entry's sequence isn't a whole number"));
        }
        let separate = match v.get("separate") {
            Some(Bool(b)) => b,
            _ => {
                return Err(Unreadable.Broken("an entry's separate isn't true or false"));
            }
        };
        ids.push(Identity { host: host, key: key, sequence: sequence, separate: separate });
    }
    Ok(ids)
}

/**
 * Encodes the pins file.
 *
 * Example:
 *     save(s, "pins", pins_file(m.pinned))?
 */
public fun pins_file(pins: Pin[]): u8[] = file("pins", "pins", Value.Array(pins.map(fun(p: Pin) {
    let mut fields = [entry("name", Value.Text(p.name)), entry("path", Value.Text(p.path))];
    if let Some(icon) = p.icon {
        fields.push(entry("icon", Value.Bytes(icon)));
    }
    Value.Map(fields)
})));

/**
 * Reads the pins file. An icon that fails the bundle's icon rules is
 * dropped, keeping the pin.
 *
 * Example:
 *     read_pins(bytes)?
 */
public fun read_pins(bytes: u8[]): Result<Pin[], Unreadable> {
    let items = list(bytes, "pins", "pins", 4, 16 * MAX_PINS, MAX_PINS_FILE)?;
    if items.len > MAX_PINS {
        return Err(Unreadable.Broken("it has more than 256 pins"));
    }
    let mut pins: Pin[] = [];
    for v of items {
        let name = text(v, "name").ok_or(Unreadable.Broken("a pin has no name"))?;
        let path = text(v, "path").ok_or(Unreadable.Broken("a pin has no path"))?;
        pins.push(Pin { name: name, path: path, icon: icon(blob(v, "icon")) });
    }
    Ok(pins)
}

/**
 * Encodes the left-off file: which app was used last, and (for a signed
 * one) its host and key. Its state lives in `states/`.
 *
 * Example:
 *     save(s, "left-off", left_file(l))?
 */
public fun left_file(l: LeftOff): u8[] {
    let mut fields = [entry("name", Value.Text(l.name)), entry("path", Value.Text(l.path))];
    if let Some(t) = l.title {
        fields.push(entry("title", Value.Text(t)));
    }
    if let Some(i) = l.icon {
        fields.push(entry("icon", Value.Bytes(i)));
    }
    if let Some((host, key)) = signer_of(l) {
        fields.push(entry("host", Value.Text(host)));
        fields.push(entry("key", Value.Bytes(key)));
    }
    file("left-off", "app", Value.Map(fields))
}

/**
 * Reads the left-off file: an app to reopen by its path.
 *
 * Example:
 *     read_left(bytes)?
 */
public fun read_left(bytes: u8[]): Result<LeftOff, Unreadable> {
    let v = root(bytes, "left-off", 4, 64, MAX_LEFT_FILE)?.get("app").ok_or(
        Unreadable.Broken("there's no app"),
    )?;
    let name = text(v, "name").ok_or(Unreadable.Broken("the app has no name"))?;
    let path = text(v, "path").ok_or(Unreadable.Broken("the app has no path"))?;
    let signer = match text(v, "host") {
        None => None,
        Some(host) => {
            if check_host(host).is_err() {
                return Err(Unreadable.Broken("the app's host isn't a host name"));
            }
            let key = blob(v, "key").unwrap_or([]);
            if key.len != 32 {
                return Err(Unreadable.Broken("the app's key isn't 32 bytes"));
            }
            Some((host, key))
        }
    };
    Ok(recalled(name, path, text(v, "title"), icon(blob(v, "icon")), signer))
}

/** A broken file set aside: Broken with where it went, or Failed when it couldn't be moved. */
fun aside<T>(s: Store, name: string, why: string): Recalled<T> = match set_aside(s, name) {
    Ok(path) => Recalled.Broken(path, why),
    Err(e) => Recalled.Failed(store_reason(e)),
};

/** A file's map: `{format, kind: "rapidkoi KIND", FIELD: value}`. */
fun file(kind: string, field: string, value: Value): u8[] = encode(
    Value.Map([
        entry("format", Value.int(FORMAT)),
        entry("kind", Value.Text("rapidkoi {kind}")),
        entry(field, value),
    ]),
);

/** The decoded map, after its format and kind are checked. */
fun root(bytes: u8[], kind: string, depth: i64, items: i64, size: i64): Result<Value, Unreadable> {
    let bounds = Limits { max_depth: depth, max_items: items, max_bytes: size, max_string: size };
    let v = decode(bytes, bounds).map_err(fun(e) = Unreadable.Broken("not CBOR ({e})"))?;
    if v.as_map().is_none() {
        return Err(Unreadable.Broken("not CBOR (not a map)"));
    }
    let format = v.get("format").map(fun(n: Value) = n.as_i64().unwrap_or(-1)).unwrap_or(-1);
    if format > FORMAT {
        return Err(Unreadable.Newer(format));
    }
    if format != FORMAT || text(v, "kind") != Some("rapidkoi {kind}") {
        return Err(Unreadable.Broken("it isn't Rapidkoi's {kind} file"));
    }
    Ok(v)
}

/** The array at `field` in a checked file. */
fun list(
    bytes: u8[],
    kind: string,
    field: string,
    depth: i64,
    items: i64,
    size: i64,
): Result<Value[], Unreadable> {
    match root(bytes, kind, depth, items, size)?.get(field) {
        Some(Array(xs)) => Ok(xs),
        _ => Err(Unreadable.Broken("its {field} isn't a list")),
    }
}

/** An icon that passes the bundle's icon rules, or none. */
fun icon(bytes: Option<u8[]>): Option<u8[]> = match bytes {
    Some(b) if check_asset("icon.png", b).is_ok() && check_role(
        "icon",
        b,
        MAX_ICON_PX,
        MAX_ICON_PX,
    ).is_ok() => Some(b),
    _ => None,
};

fun entry(key: string, v: Value): Entry = Entry { key: Value.Text(key), value: v };

fun text(v: Value, field: string): Option<string> = match v.get(field) {
    Some(Text(s)) => Some(s),
    _ => None,
};

fun blob(v: Value, field: string): Option<u8[]> = match v.get(field) {
    Some(Bytes(b)) => Some(b),
    _ => None,
};
