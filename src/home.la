/**
 * Home, pure: what a new tab shows. The logo, "Where you left off", and the
 * Pinned tiles, or, while the person types, the tiles that match. Search is
 * in-session only until PRP-003 (DECISION-018).
 *
 * Depends on: kivuli, actions, tabs, frame, theme
 * Used by: shell
 */
import kivuli { View, Image, ButtonStyle, button, column, row, spacer, text };
import actions { Msg };
import tabs { Tab, Pin };
import frame { initial, icon_of };
import theme {
    SPACE_XS,
    SPACE_MD,
    SPACE_LG,
    TEXT_TITLE,
    TEXT_HEADING,
    TILE_SIZE,
    TILE_ICON,
    TILES_PER_ROW,
    BANNER_HEIGHT,
};

/** "Where you left off": the app and its last screen, and what Continue sends. */
public struct Card {
    /** The app's name. */
    public name: string,
    /** Its last screen's title, if any. */
    public title: Option<string>,
    /** `Select(id)` for an open tab, `Continue` for a closed app. */
    public msg: Msg,
    /** The app's icon, keyed, if it has one. */
    public icon: Option<Image>,
}

/**
 * Builds home.
 *
 * @param draft the search box's text: empty shows home, anything else filters it
 * @param pinned the pinned apps
 * @param card "Where you left off", if there is one
 * @param open the open tabs (search finds their apps too)
 * @returns the home view
 *
 * Example:
 *     home.view("", m.pinned, None, m.tabs)
 */
public fun view(draft: string, pinned: Pin[], card: Option<Card>, open: Tab[]): View<Msg> {
    let logo: View<Msg> = row([
        text("◯").size(TEXT_TITLE),
        text("Rapidkoi").size(TEXT_TITLE).bold(),
    ]).spacing(SPACE_MD);
    let query = draft.trim();
    let mut parts = [logo];
    if query == "" {
        if let Some(c) = card {
            parts.push(left_off(c));
        }
        if pinned.len > 0 {
            parts.push(text("Pinned").size(TEXT_HEADING).bold());
            parts.push(
                grid(
                    pinned.map(
                        fun(p: Pin) = tile(p.name, Msg.OpenPinned(p.path), icon_of(p.path, p.icon)),
                    ),
                ),
            );
        }
        if card.is_none() && pinned.len == 0 {
            parts.push(
                text("Open an app: type the path of a .wasm file above, then press Enter.").dim(),
            );
        }
    } else {
        let found = results(query, pinned, card, open);
        if found.len == 0 {
            parts.push(text("Nothing matches “{query}”").dim());
        } else {
            parts.push(grid(found));
        }
    }
    column(parts).spacing(SPACE_LG)
}

/**
 * Says whether a search matches a name or title, ignoring case.
 *
 * @param query what the person typed
 * @param name an app's name
 * @param title its screen title, if any
 * @returns true when either contains the query
 *
 * Example:
 *     matches("COUNT", "counter", None)
 */
public fun matches(query: string, name: string, title: Option<string>): bool {
    let q = lower(query);
    lower(name).contains(q) || lower(title.unwrap_or("")).contains(q)
}

/** The tiles matching `query`: open apps, pinned apps, and a closed "where you left off". */
fun results(query: string, pinned: Pin[], card: Option<Card>, open: Tab[]): View<Msg>[] {
    let mut found: View<Msg>[] = [];
    for t of open {
        if matches(query, t.page.name, t.page.title) {
            found.push(tile(t.page.name, Msg.Select(t.id), icon_of(t.page.path, t.page.icon)));
        }
    }
    for p of pinned {
        if matches(query, p.name, None) {
            found.push(tile(p.name, Msg.OpenPinned(p.path), icon_of(p.path, p.icon)));
        }
    }
    // An open tab is already among the tabs above; only a closed app adds a tile.
    if let Some(c) = card {
        if c.msg == Msg.Continue && matches(query, c.name, c.title) {
            found.push(tile(c.name, Msg.Continue, c.icon));
        }
    }
    found
}

/** "Where you left off": the app and its last screen, and Continue. No picture until PRP-003. */
fun left_off(c: Card): View<Msg> {
    let place = match c.title {
        Some(t) => "{c.name} · {t}",
        None => c.name,
    };
    column([
        text("Where you left off").size(TEXT_HEADING).bold(),
        spacer(),
        row([text(place).expand(), button("Continue", c.msg).button_style(ButtonStyle.Primary)]),
    ]).padding(SPACE_LG).height(BANNER_HEIGHT)
}

/** One big tile: the app's icon (or its initial without one), and its name below. */
fun tile(name: string, msg: Msg, icon: Option<Image>): View<Msg> {
    let face = match icon {
        Some(img) => button("", msg).image(img).size(TILE_ICON),
        None => button(initial(name), msg),
    };
    column([face.width(TILE_SIZE).height(TILE_SIZE).tooltip("Open {name}"), text(name)]).spacing(
        SPACE_XS,
    )
}

/** Rows of `TILES_PER_ROW` tiles: a wrapping grid until kivuli has one (DECISION-018). */
fun grid(tiles: View<Msg>[]): View<Msg> {
    let mut rows: View<Msg>[] = [];
    let mut current: View<Msg>[] = [];
    for t of tiles {
        current.push(t);
        if current.len == TILES_PER_ROW {
            rows.push(row(current).spacing(SPACE_MD));
            current = [];
        }
    }
    if current.len > 0 {
        rows.push(row(current).spacing(SPACE_MD));
    }
    column(rows).spacing(SPACE_MD)
}

/** ASCII and Latin-1 lower case (what `char.to_lower` covers). */
fun lower(s: string): string {
    let mut out = "";
    for c of s.chars() {
        out = out + "{c.to_lower()}";
    }
    out
}
