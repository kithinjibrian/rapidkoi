/**
 * Pages and tabs: what one tab holds, and the life of an app page. Starting
 * a guest from a file or a module, sending it events, Restart, and leaving
 * a page with its state so Continue can resume it. Calls guests (bounded by
 * fuel); never draws.
 *
 * Depends on: cbor, wasmtime, guest, bundle, loader, verify, contract, render
 * Used by: actions, frame, home, panel, shell
 */
import cbor { Value };
import wasmtime { Engine, Module };
import guest { Guest, open, reason };
import bundle { Manifest };
import loader { Refusal, load, why };
import verify { Trust, Change, Keyring };
import contract { Described, ContractError, read_tree, read_update, envelope };
import render { Msg };

/** What an app page shows. */
public enum Screen {
    /** The guest, its state, and its decoded screen. */
    Running(Guest, u8[], Described),
    /** Why the app isn't running, and whether Restart can help. */
    Stopped(string, bool),
    /** A signed site failed a check, so it never ran: why. Only ⟳ tries again. */
    Refused(string),
    /**
     * A signed site's key changed without approval: the change, and the
     * page that was open before (when reloading), kept until the person decides.
     */
    Unapproved(Change, AppPage[]),
}

/** A compiled app, kept so Restart and Continue can start it again. */
public struct Program {
    engine: Engine,
    module: Module,
}

/** One app in a tab. */
public struct AppPage {
    /** The manifest's name, or the file's name without `.wasm`: what Rapidkoi calls the app. */
    public name: string,
    /** The bundle's manifest; `None` for a bare `.wasm`. */
    public manifest: Option<Manifest>,
    /** The app's icon as PNG bytes, from its bundle. */
    public icon: Option<u8[]>,
    /** The file it came from, as the person gave it. */
    public path: string,
    /** The current screen's title, if the app gives one. */
    public title: Option<string>,
    /** Who signed it and how far that's trusted; `None` when unsigned. */
    public trust: Option<Trust>,
    program: Option<Program>,
    /** What's on screen. */
    public screen: Screen,
}

/** What the window shows: home, or the current tab's app. */
public enum Page {
    /** Home: no tab is current. */
    Home,
    /** An app. */
    App(AppPage),
}

/** One tab: always an app (home isn't a tab). Ids are never reused, so a message for a closed tab finds nothing. */
public struct Tab {
    /** The tab's id. */
    public id: i64,
    /** Its app. */
    public page: AppPage,
}

/** A pinned app on home. */
public struct Pin {
    /** The app's name. */
    public name: string,
    /** Its file. */
    public path: string,
    /** Its icon, if it has one. */
    public icon: Option<u8[]>,
}

/** The app page the person last left, for "Where you left off". */
public struct LeftOff {
    /** The app's name. */
    public name: string,
    /** Its file. */
    public path: string,
    /** Its last screen title, if any. */
    public title: Option<string>,
    /** Its state when left; `None` when it had stopped. */
    public state: Option<u8[]>,
    /** The version of that state's shape (1 for a bare `.wasm`). */
    public state_version: i64,
    manifest: Option<Manifest>,
    /** Its icon, if it had one. */
    public icon: Option<u8[]>,
    trust: Option<Trust>,
    program: Option<Program>,
}

/**
 * Opens the app in a local file the person chose: a `.rkb` bundle or a `.wasm`.
 *
 * @param engine the program's engine
 * @param ring this session's trusted keys
 * @param path the file or address
 * @returns the page: running, or stopped with the reason (no Restart when
 *     the file couldn't be read or compiled), refused, or asking about a
 *     changed key
 *
 * Example:
 *     open_path(engine, ring, "counter.wasm")
 */
public fun open_path(engine: Engine, ring: Keyring, path: string): AppPage = match load(
    engine,
    ring,
    path,
) {
    Ok(l) => AppPage {
        manifest: l.manifest,
        icon: l.icon,
        trust: l.trust,
        ..open_module(l.name, path, engine, l.module),
    },
    Err(r) => refused(r, path),
};

/**
 * Starts a compiled app as a page.
 *
 * @param name what to call it
 * @param path where it came from
 * @param engine the engine `module` was compiled with
 * @param module the app
 * @returns the page, running or stopped (with Restart)
 *
 * Example:
 *     open_module("counter", "counter.wasm", engine, module)
 */
public fun open_module(name: string, path: string, engine: Engine, module: Module): AppPage {
    let program = Program { engine: engine, module: module };
    titled(AppPage {
        name: name,
        manifest: None,
        icon: None,
        path: path,
        title: None,
        trust: None,
        program: Some(program),
        screen: start(program, None),
    })
}

/**
 * Handles a message from the page's own screen.
 *
 * @param p the page
 * @param msg an event for the guest, or Restart
 * @returns the next page; any guest or contract failure stops it
 *
 * Example:
 *     handle(page, Msg.Restart)
 */
public fun handle(p: AppPage, msg: Msg): AppPage = match (p.screen, msg) {
    (Running(g, state, _), Event(value, text)) => titled(AppPage {
        screen: step(g, state, value, text),
        ..p,
    }),
    // Events only come from a running screen; otherwise, ignore them.
    (_, Event(_, _)) => p,
    (_, Restart) => {
        close_page(p);
        match p.program {
            Some(prog) => titled(AppPage { screen: start(prog, None), ..p }),
            None => p,
        }
    }
};

/**
 * Frees a page's guest. Closing twice does nothing.
 *
 * Example:
 *     close_page(page)
 */
public fun close_page(p: AppPage) {
    match p.screen {
        Running(g, _, _) => g.close(),
        Unapproved(_, kept) => {
            for k of kept {
                close_page(k);
            }
        }
        _ => {}
    }
}

/**
 * Closes a page and remembers it for "Where you left off".
 *
 * @param p the page
 * @returns what Continue needs: its name, title, state and compiled module
 *
 * Example:
 *     let left = leave(page);
 */
public fun leave(p: AppPage): LeftOff {
    let left = LeftOff {
        name: p.name,
        path: p.path,
        title: p.title,
        state: state_of(p),
        state_version: state_version_of(p),
        manifest: p.manifest,
        icon: p.icon,
        trust: p.trust,
        program: p.program,
    };
    close_page(p);
    left
}

/**
 * Reopens a page that was left, in a fresh store, with its saved state:
 * `view(state)` without calling `init`. A page left stopped starts afresh.
 *
 * @param l what `leave` kept
 * @returns the page, running or stopped
 *
 * Example:
 *     resume(left)
 */
public fun resume(l: LeftOff): AppPage = match l.program {
    Some(prog) => titled(AppPage {
        name: l.name,
        manifest: l.manifest,
        icon: l.icon,
        path: l.path,
        title: l.title,
        trust: l.trust,
        program: Some(prog),
        screen: start(prog, l.state),
    }),
    None => failed(l.name, l.path, "This app couldn't be reopened"),
};

/**
 * Says whether a left-off still holds its compiled app (left this
 * session), so `resume` can start it; one read from disk must be loaded
 * again.
 *
 * Example:
 *     if compiled(l) { resume(l) } else { … }
 */
public fun compiled(l: LeftOff): bool = l.program.is_some();

/**
 * A "where you left off" read back from disk: no compiled program, so
 * Continue loads it again from its path.
 *
 * Example:
 *     recalled("Counter", "counter.rkb", Some("Count: 3"), Some(state), 1, None)
 */
public fun recalled(
    name: string,
    path: string,
    title: Option<string>,
    state: Option<u8[]>,
    state_version: i64,
    icon: Option<u8[]>,
): LeftOff = LeftOff {
    name: name,
    path: path,
    title: title,
    state: state,
    state_version: state_version,
    manifest: None,
    icon: icon,
    trust: None,
    program: None,
};

/**
 * Loads an app again from where it came from (its file, or its development
 * server) and starts it with `saved` state when the new build's state
 * version matches; otherwise fresh. ⟳ Reload uses it.
 *
 * @param engine the program's engine
 * @param ring this session's trusted keys
 * @param path the page's file or address
 * @param saved the running page's state and state version, if it had one
 * @returns the page, and whether a saved state had to be dropped because
 *     its shape changed (`migrate` comes with PRP-006)
 *
 * Example:
 *     load_again(engine, ring, page.path, Some((state, 1)))
 */
public fun load_again(
    engine: Engine,
    ring: Keyring,
    path: string,
    saved: Option<(u8[], i64)>,
): (AppPage, bool) = match load(engine, ring, path) {
    Err(r) => (refused(r, path), false),
    Ok(l) => {
        let fresh = AppPage {
            manifest: l.manifest,
            icon: l.icon,
            trust: l.trust,
            ..open_module(l.name, path, engine, l.module),
        };
        let now = state_version_of(fresh);
        match saved {
            Some((state, version)) if version == now => {
                close_page(fresh);
                let program = Program { engine: engine, module: l.module };
                (
                    titled(AppPage {
                        program: Some(program),
                        screen: start(program, Some(state)),
                        ..fresh,
                    }),
                    false,
                )
            }
            Some(_) => (fresh, true),
            None => (fresh, false),
        }
    }
};

/**
 * Returns the version of a page's state shape: its manifest's, or 1 for a
 * bare module.
 *
 * Example:
 *     state_version_of(page)
 */
public fun state_version_of(p: AppPage): i64 = p.manifest.map(
    fun(m: Manifest) = m.state_version,
).unwrap_or(1);

/**
 * Returns a page's current state.
 *
 * @returns the state bytes; `None` when the page has stopped
 *
 * Example:
 *     state_of(page)
 */
public fun state_of(p: AppPage): Option<u8[]> = match p.screen {
    Running(_, state, _) => Some(state),
    _ => None,
};

fun failed(name: string, path: string, why: string): AppPage = AppPage {
    name: name,
    manifest: None,
    icon: None,
    path: path,
    title: None,
    trust: None,
    program: None,
    screen: Screen.Stopped(why, false),
};

/** A page for an app that wasn't loaded: stopped, refused, or asking about its key. */
fun refused(r: Refusal, path: string): AppPage = match r {
    Failed(name, w) => failed(name, path, w),
    Unverified(host, _) => AppPage { screen: Screen.Refused(why(r)), ..failed(host, path, "") },
    Unapproved(host, c) => AppPage { screen: Screen.Unapproved(c, []), ..failed(host, path, "") },
};

/** Copies the running screen's title onto the page; a stopped page keeps its last one. */
fun titled(p: AppPage): AppPage = match p.screen {
    Running(_, _, d) => AppPage { title: d.title, ..p },
    _ => p,
};

/** Opens the guest in a fresh store, then `init` (unless resuming `saved`) and `view`. */
fun start(p: Program, saved: Option<u8[]>): Screen = match open(p.engine, p.module) {
    Err(e) => Screen.Stopped(reason(e), true),
    Ok(g) => match saved {
        Some(state) => show(g, state),
        None => match g.init() {
            Err(e) => halt(g, reason(e)),
            Ok(state) => show(g, state),
        },
    },
};

/** Sends one event to the guest's `update`, then renders the new state. */
fun step(g: Guest, state: u8[], msg: Value, text: Option<string>): Screen = match g.update(
    state,
    envelope(msg, text),
) {
    Err(e) => halt(g, reason(e)),
    Ok(bytes) => match read_update(bytes) {
        Err(e) => halt(g, broken("update result", e)),
        Ok(next) => show(g, next),
    },
};

/** Calls `view(state)` and decodes the screen. */
fun show(g: Guest, state: u8[]): Screen = match g.view(state) {
    Err(e) => halt(g, reason(e)),
    Ok(bytes) => match read_tree(bytes) {
        Err(e) => halt(g, broken("screen description", e)),
        Ok(d) => Screen.Running(g, state, d),
    },
};

/** Stops the guest: frees its store and keeps why. */
fun halt(g: Guest, why: string): Screen {
    g.close();
    Screen.Stopped(why, true)
}

fun broken(what: string, e: ContractError): string = match e {
    Invalid(path, problem) => "This app's {what} is broken ({path}: {problem})",
    TooLong(_, n) => "This app's {what} is too large ({n} bytes)",
    Decode(d) => "This app's {what} is broken (bad CBOR: {d})",
};
