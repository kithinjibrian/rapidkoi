/**
 * The sidebar, pure (PRP-023): Rapidkoi's apps down the window's right.
 * Pinned apps first (open or not), a line, the other open apps, scrolling
 * when they don't fit; + fixed at the bottom.
 * The current app's icon is ringed in the accent and has a × (Ctrl+W); any
 * app's icon is washed faintly on hover; each has a right-click menu. A ×
 * on any hovered app waits for kivuli's group hover (DECISION-036).
 *
 * Depends on: kivuli, kivuli.ui, window.actions, window.tabs, window.window, ui.frame, ui.tokens, ui.themes
 * Used by: ui.layout
 */
import kivuli {
    View,
    Align,
    Image,
    MenuEntry,
    column,
    icon,
    image,
    item,
    menu_separator,
    overlay,
    scroll,
    text,
};
import kivuli.ui { Button, button_with as ui_button_with, separator };
import window.actions { Msg, TabAction, PinAction };
import window.tabs { Tab, Pin, AppPage };
import window.window { Model, order as tab_order };
import ui.frame { label, initial, icon_of };
import ui.tokens { SPACE_XS, HEADER_ICON, TAB_CLOSE, TAB_CLOSE_ICON, gap, square };
import ui.themes { Theme, heading };
import ui.frame_looks { app_button, app_current, tab_close };

/**
 * Builds the sidebar's apps and +, top to bottom.
 *
 * @param m the model: its tabs, the current one, its pins
 * @returns the sidebar's column
 *
 * Example:
 *     sidebar.view(m)
 */
public fun view(m: Model): View<Msg> {
    let t = m.theme;
    let mut pinned: View<Msg>[] = [];
    for p of m.pinned {
        match tab_of(m, p.path) {
            // Pinned and open: one button, its tab.
            Some(tab) => pinned.push(open_app(m, tab, true)),
            None => pinned.push(closed_pin(t, p)),
        }
    }
    // The rest, app and empty tabs, in the order they were made (PRP-024).
    let mut rest: View<Msg>[] = [];
    for id of order(m) {
        match tab_by_id(m, id) {
            Some(tab) => if !m.pinned.any(fun(p: Pin) = p.path == tab.page.path) {
                rest.push(open_app(m, tab, false));
            },
            None => rest.push(empty_tab(m, id)),
        }
    }
    let mut all = pinned;
    if pinned.len > 0 && rest.len > 0 {
        all.push(separator());
    }
    for v of rest {
        all.push(v);
    }
    let plus = ui_button_with([icon("list-add-symbolic").size(HEADER_ICON)], Msg.NewTab).style(
        app_button(t),
    ).tooltip("Add a tab").shortcut("Ctrl+T").align(Align.Center);
    // The apps scroll when there are more than fit; + stays at the strip's
    // bottom. Chrome's way (+ right after the last app until they overflow)
    // and scrolling an app into view wait for kivuli (DECISION-037).
    column([scroll(column(all).style([gap(SPACE_XS)])).expand(), plus]).style([gap(SPACE_XS)])
}

/**
 * Returns every tab's id, app and empty, in the order they were made: the
 * sidebar's order for the tabs that aren't pinned.
 *
 * Example:
 *     sidebar.order(m)
 */
public fun order(m: Model): i64[] = tab_order(m);

/** The app tab with this id, if it's one. */
fun tab_by_id(m: Model, id: i64): Option<Tab> {
    for tab of m.tabs {
        if tab.id == id {
            return Some(tab);
        }
    }
    None
}

/** An empty tab: the new-tab placeholder, ringed with its × when current, a menu with Close. */
fun empty_tab(m: Model, id: i64): View<Msg> {
    let t = m.theme;
    let current = m.current == Some(id);
    let mut look = app_button(t);
    if current {
        for x of app_current(t) {
            look.push(x);
        }
    }
    let button = ui_button_with([icon("tab-new-symbolic").size(HEADER_ICON)], Msg.Select(id)).style(
        look,
    ).tooltip("New tab").menu([item("Close", Msg.CloseTab(id))]);
    if !current {
        return button.align(Align.Center);
    }
    overlay(button, [close_button(t, id, "New tab")]).align(Align.Center)
}

/** The open tab showing `path`, if one does. */
fun tab_of(m: Model, path: string): Option<Tab> {
    for tab of m.tabs {
        if tab.page.path == path {
            return Some(tab);
        }
    }
    None
}

/** An open app: its icon, the ring and × when it's current, and its menu. */
fun open_app(m: Model, tab: Tab, pinned: bool): View<Msg> {
    let t = m.theme;
    let current = m.current == Some(tab.id);
    let mut look = app_button(t);
    if current {
        for x of app_current(t) {
            look.push(x);
        }
    }
    let button = ui_button_with(
        [face(t, tab.page.name, tab.page.path, tab.page.icon)],
        Msg.Select(tab.id),
    ).style(look).tooltip(label(tab.page)).menu([
        item("Close", Msg.OnTab(tab.id, TabAction.Close)),
        item(if pinned { "Unpin" } else { "Pin" }, Msg.OnTab(tab.id, TabAction.TogglePin)),
        menu_separator(),
        item("Forget this app…", Msg.OnTab(tab.id, TabAction.Forget)),
    ]);
    if !current {
        return button.align(Align.Center);
    }
    // The current app's ×; every app's, on hover, waits for kivuli's group
    // hover (DECISION-036).
    overlay(button, [close_button(t, tab.id, tab.page.name)]).align(Align.Center)
}

/** The current tab's × at its icon's top-right corner, and Ctrl+W. */
fun close_button(t: Theme, id: i64, name: string): View<Msg> = ui_button_with(
    [icon("window-close-symbolic").size(TAB_CLOSE_ICON)],
    Msg.CloseTab(id),
).style(tab_close(t)).tooltip("Close {name}").shortcut("Ctrl+W").place(Align.End, Align.Start);

/** A pinned app that isn't open: its icon, opening it, and its menu. */
fun closed_pin(t: Theme, p: Pin): View<Msg> = ui_button_with(
    [face(t, p.name, p.path, p.icon)],
    Msg.OpenPinned(p.path),
).style(app_button(t)).tooltip("Open {p.name}").menu([
    item("Open", Msg.OnPin(p.path, PinAction.Open)),
    item("Unpin", Msg.OnPin(p.path, PinAction.Unpin)),
    menu_separator(),
    item("Forget this app…", Msg.OnPin(p.path, PinAction.Forget)),
]).align(Align.Center);

/** An app's icon, or its initial without one. */
fun face(t: Theme, name: string, path: string, bytes: Option<u8[]>): View<Msg> = match icon_of(
    path,
    bytes,
) {
    Some(img) => image(img).style([square(HEADER_ICON)]).align(Align.Center),
    None => text(initial(name)).style(heading(t)).align(Align.Center),
};
