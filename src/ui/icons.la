/**
 * Returns an SVG with its white fill (`#ffffff`, as Iconsax ships it) in
 * `colour` instead; nothing else changes.
 *
 * Example:
 *     recolour(svg(Icon.Home), "#e8e8e8")
 */
// Lugha's strings have no replace: splitting at each white and joining
// with the new colour is the same.
public fun recolour(svg: string, colour: string): string = svg.split("#ffffff").join(colour);

/**
 * Returns an icon drawn in `colour`, as a picture kivuli shows. Keyed by the
 * icon and the colour, so kivuli reads each pair once.
 *
 * @param i the icon
 * @param colour a theme colour, `#rrggbb`
 * @returns the SVG as image bytes
 *
 * Example:
 *     image(icon(Icon.Home, t.text))
 */
public fun icon(i: Icon, colour: string): Image = Image.Bytes(
    "icon:{file(i)}:{colour}",
    recolour(svg(i), colour).to_bytes(),
);
