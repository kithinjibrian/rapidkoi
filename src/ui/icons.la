/**
 * Rapidkoi's own icons (PRP-019): the Iconsax SVGs in `assets/icons/`,
 * compiled in as text (Lugha can't embed a file, and the binary may run
 * anywhere), each drawn in a theme colour. A test keeps every one equal to
 * its file. Apps never reach these.
 *
 * Depends on: kivuli
 * Used by: ui.header, ui.addressbox
 */
import kivuli { Image };

/** An icon of Rapidkoi's, named for what it's for. */
public enum Icon {
    /** `arrow-left4.svg`. */
    Back,
    /** `arrow-right4.svg`. */
    Forward,
    /** `home.svg`. */
    Home,
    /** `menu.svg`. */
    Menu,
    /** `profile-circle.svg`. */
    Account,
    /** `rotate-right.svg`. */
    Reload,
    /** `settings.svg`. */
    Settings,
    /** `shield-tick.svg`. */
    Shield,
    /** `star.svg`. */
    Star,
}

/** Every icon, for tests and for listing. */
public const ALL: Icon[] = [
    Icon.Back,
    Icon.Forward,
    Icon.Home,
    Icon.Menu,
    Icon.Account,
    Icon.Reload,
    Icon.Settings,
    Icon.Shield,
    Icon.Star,
];

/**
 * Returns the file in `assets/icons/` an icon came from.
 *
 * Example:
 *     file(Icon.Home)
 */
public fun file(i: Icon): string = match i {
    Back => "arrow-left4.svg",
    Forward => "arrow-right4.svg",
    Home => "home.svg",
    Menu => "menu.svg",
    Account => "profile-circle.svg",
    Reload => "rotate-right.svg",
    Settings => "settings.svg",
    Shield => "shield-tick.svg",
    Star => "star.svg",
};

/**
 * Returns an icon's SVG, exactly as its file holds it: white (`#ffffff`).
 *
 * Example:
 *     svg(Icon.Home)
 */
