/**
 * Site settings, pure (PRP-022): the card behind ⚙. The app (icon, name,
 * version, description), then sections: Account (Public key, the Sign in
 * switch, Name; signed apps only, PRP-052), App settings (Servers, and
 * Permissions for an app declaring any, PRP-031), App data (its size); and
 * Forget this app at the bottom, which asks first in a dialog over the
 * window. A built-in app's `controls` choose which rows show. Only
 * Rapidkoi draws these; the logic is PRP-011's, PRP-012's and PRP-052's.
 *
 * Depends on: kivuli, kivuli.ui, window.actions, window.tabs, window.window, people.account, people.access, people.identity, trust.keys, guest.nodes, ui.cards, ui.grants, ui.tokens, ui.themes
 * Used by: ui.addressbox, ui.layout
 */
import kivuli { View, Align, Dialog, column, row, spacer, text };
import kivuli.ui {
    button as ui_button,
    switch,
    separator,
    dialog as ui_dialog,
    dialog_header,
    dialog_footer,
    input as ui_input,
};
import ui.asking;
import window.actions { Msg, PanelPage, Confirm, NameScope, NamePart, Answer };
import window.tabs { AppPage, state_of };
import window.window { Model, page_of };
import people.account { Account, account_of, generation_for };
import people.access { Access, access_of, key_of };
import people.people { Person, looks_of, name_in };
import people.identity { public_key };
import trust.keys { fingerprint };
import guest.nodes { ButtonLook };
import ui.cards { sized, choice, detail, sentence, line, identity as app_head };
import ui.tokens { SPACE_XS, SPACE_SM, SPACE_MD, gap, padding_xy };
import ui.themes { body, dim, title, group, button as button_look };
import ui.schemes { Theme };
import ui.grants;
import ui.strip;

/**
 * Builds site settings' card on a page, for an app page.
 *
 * @param m the model (the person's account and settings, the theme)
 * @param p the app page
 * @param page which page of the card
 * @returns the card's content, for the popover
 *
 * Example:
 *     settings.card(m, page, PanelPage.Main)
 */
fun card(m: Model, p: AppPage, page: PanelPage): View<Msg> {
    let t = m.theme;
    let you = account_of(m, p);
    let reach = access_of(m, p);
    let shown = match page {
        Main => front(m, p, you, reach),
        Key => detail(t, "Public key", Msg.PanelBack, key_page(m, t, p, you)),
        Name => detail(t, "Name", Msg.PanelBack, name_page(you)),
        Access => detail(t, "Servers", Msg.PanelBack, servers_page(t, reach)),
        Permissions => detail(t, "Permissions", Msg.PanelBack, grants.page(m, t, p)),
    };
    sized(shown)
}

/**
 * Returns the dialog asking before a destructive action, while one is asked
 * about: for the root's `.dialog(…)`. ✕, Escape and a click outside cancel.
 *
 * Example:
 *     page.dialog(settings.dialog(m))
 */
fun dialog(m: Model): Option<Dialog<Msg>> {
    // Renaming an instance (PRP-033): closing it is Cancel.
    if m.renaming.is_some() {
        return Some(ui_dialog(Msg.Cancel, [dialog_view(m)]));
    }
    // Naming a separate app (PRP-049): closing it is Cancel.
    if m.naming.is_some() {
        return Some(ui_dialog(Msg.CancelSeparate, [asking.naming_view(m)]));
    }
    // An app waiting for your approval first (PRP-031): closing it is Don't allow.
    if m.approval.is_some() {
        return Some(ui_dialog(Msg.Approve(Answer.Deny), [dialog_view(m)]));
    }
    // About Rapidkoi (PRP-038): closing it is all it does.
    if m.about {
        return Some(ui_dialog(Msg.About(false), [dialog_view(m)]));
    }
    match m.confirm {
        Some(_) => Some(ui_dialog(Msg.Cancel, [dialog_view(m)])),
        None => None,
    }
}

/** What Rapidkoi is, in its version: About's dialog. */
const RAPIDKOI_VERSION: string = "0.1.0";

/**
 * Returns what the dialog shows while an action is asked about: its question
 * and its two buttons, Cancel and the action. Empty when nothing is asked.
 *
 * Example:
 *     dialog_view(m)
 */
fun dialog_view(m: Model): View<Msg> {
    if m.renaming.is_some() {
        return strip.rename_view(m);
    }
    if let Some(q) = grants.question(m) {
        return q;
    }
    if m.about {
        let t = m.theme;
        return column([
            text("Rapidkoi").style(title(t)).align(Align.Start),
            text(RAPIDKOI_VERSION).style(dim(t)).align(Align.Start),
        ]).style([gap(SPACE_SM)]);
    }
    let t = m.theme;
    let name = match page_of(m) {
        App(p) => p.name,
        Home => "this app",
    };
    let (title, says, label, msg) = match m.confirm {
        // The owner's words (PRP-052).
        Some(Forget) => (
            "Forget {name}?",
            "Its windows, pin, data and settings here will be removed. Next time you open it, it won't know you.",
            "Forget",
            Msg.Forget,
        ),
        None => {
            let none: View<Msg>[] = [];
            return column(none);
        }
    };
    column([
        dialog_header(title, says),
        dialog_footer([
            ui_button("Cancel", Msg.Cancel).style(button_look(t, ButtonLook.Normal)),
            ui_button(label, msg).style(button_look(t, ButtonLook.Danger)),
        ]),
    ])
}

/** The card's main page: the app, its sections, and Forget; a built-in app's `controls` choose. */
fun front(m: Model, p: AppPage, you: Account, reach: Access): View<Msg> {
    let t = m.theme;
    let shows = fun(row: string): bool = grants.shows_row(p, row);
    let mut parts: View<Msg>[] = [app_head(t, p, p.manifest.map(fun(x) = x.version))];
    if let Some(d) = p.manifest.and_then(fun(x) = x.description) {
        parts.push(sentence(t, d));
    }
    parts.push(separator());
    // An unsigned app can't have an account: no section rather than a dead one.
    if let Some(x) = you.person {
        let mut rows: View<Msg>[] = [];
        if shows("account.public_key") {
            rows.push(
                choice(
                    t,
                    "Public key",
                    Some(
                        if x.signs_in {
                            you.label.unwrap_or("Not signed in yet")
                        } else {
                            "Not shared"
                        },
                    ),
                    Msg.PanelGo(PanelPage.Key),
                ),
            );
        }
        if shows("account.identity") {
            rows.push(switch_row(t, "Sign in", "sign_in", x.signs_in, Msg.SetSignIn));
            rows.push(choice(t, "Name", Some(name_shown(m, you)), Msg.PanelGo(PanelPage.Name)));
        }
        if rows.len > 0 {
            parts.push(section(t, "Account", rows));
        }
    }
    let mut app_rows: View<Msg>[] = [];
    if shows("app_settings.servers") {
        app_rows.push(
            choice(t, "Servers", Some(servers_summary(reach)), Msg.PanelGo(PanelPage.Access)),
        );
    }
    // Only an app that declares permissions has a Permissions row (PRP-031).
    if let Some(said) = grants.summary(m, p) {
        if shows("app_settings.permissions") {
            app_rows.push(choice(t, "Permissions", Some(said), Msg.PanelGo(PanelPage.Permissions)));
        }
    }
    // The person's last word over the app's looks (PRP-038).
    if shows("app_settings.looks") {
        let key = key_of(p);
        let (colours, text_size) = looks_of(m.people, key);
        app_rows.push(
            switch_row(
                t,
                "Use my colours",
                "use_my_colours",
                colours,
                fun(on: bool) = Msg.OwnLooks(key, on, text_size),
            ),
        );
        app_rows.push(
            switch_row(
                t,
                "Use my text size",
                "use_my_text_size",
                text_size,
                fun(on: bool) = Msg.OwnLooks(key, colours, on),
            ),
        );
    }
    if app_rows.len > 0 {
        parts.push(section(t, "App settings", app_rows));
    }
    if shows("app_data.state") {
        parts.push(section(t, "App data", [fact_row(t, "Data", kept(p))]));
    }
    if shows("forget") {
        parts.push(
            ui_button("Forget this app…", Msg.Ask(Confirm.Forget)).style(
                button_look(t, ButtonLook.Danger),
            ),
        );
    }
    column(parts).style([gap(SPACE_SM)])
}

/** A row with a switch at its end, found by `name`. */
fun switch_row(
    t: Theme,
    label: string,
    name: string,
    on: bool,
    toggle: fun(bool): Msg,
): View<Msg> = row([
    text(label).style(body(t)).align(Align.Center),
    spacer(),
    switch(on, toggle).name(name).align(Align.Center),
]).style([gap(SPACE_SM), padding_xy(SPACE_SM, SPACE_MD)]);

/** A section: a dim heading over its rows in one rounded group. */
fun section(t: Theme, title: string, rows: View<Msg>[]): View<Msg> = column([
    text(title).style(dim(t)),
    column(rows).style(group(t)),
]).style([gap(SPACE_XS)]);

/** Public key: who you are to the app, read-only. */
fun key_page(m: Model, t: Theme, p: AppPage, you: Account): View<Msg>[] {
    let mut parts: View<Msg>[] = [];
    // Sign in off: the app gets no key, so none is shown (PRP-052).
    if you.person.map(fun(x: Person) = !x.signs_in).unwrap_or(false) {
        return [line(t, "You are", "Not shared")];
    }
    match you.label {
        Some(l) => parts.push(line(t, "You are", l)),
        None => parts.push(line(t, "You are", "Not signed in yet: {p.name} hasn't asked")),
    }
    // The key itself needs the master secret, already read once the app asked.
    let key = match (p.trust, m.master) {
        (Some(tr), Some(secret)) => generation_for(m.people, secret, tr.host, tr.origin).and_then(
            fun(g: i64) = public_key(secret, tr.host, tr.origin, g),
        ).ok(),
        _ => None,
    };
    if let Some(k) = key {
        parts.push(line(t, "Key", fingerprint(k)));
    }
    parts
}

/** Name: your name in this app only; the one for every app is Rapidkoi's (PRP-052). */
fun name_page(you: Account): View<Msg>[] = match you.person {
    Some(x) => [
        ui_input(
            x.first,
            fun(s: string) = Msg.SetName(NameScope.ThisApp, NamePart.First, s),
        ).placeholder("First name"),
        ui_input(
            x.last,
            fun(s: string) = Msg.SetName(NameScope.ThisApp, NamePart.Last, s),
        ).placeholder("Last name"),
    ],
    // The row isn't offered for an unsigned app.
    None => [],
};

/** The name this app sees: its own, else the one for every app, else "Not set"; cut to fit the row. */
fun name_shown(m: Model, you: Account): string {
    let (first, last) = match you.person {
        Some(x) => name_in(m.people, x.host, x.origin),
        None => ("", ""),
    };
    let both = "{first} {last}".trim();
    if both == "" {
        return "Not set";
    }
    // Each part may be 64 characters: past NAME_FITS the row would push the card wider.
    let mut out = "";
    let mut count = 0;
    for c of both.chars() {
        if count < NAME_FITS {
            out = out + "{c}";
        }
        count += 1;
    }
    if count > NAME_FITS { "{out}…" } else { out }
}

/** The most characters of a name the Name row shows before "…". */
const NAME_FITS: i64 = 24;

/** A row stating a fact, as the switch rows are laid out. */
fun fact_row(t: Theme, label: string, value: string): View<Msg> = row([
    text(label).style(body(t)).align(Align.Center),
    spacer(),
    text(value).style(dim(t)).align(Align.Center),
]).style([gap(SPACE_SM), padding_xy(SPACE_SM, SPACE_MD)]);

/** Servers: its own first, then the declared ones; switches on a signed app. */
fun servers_page(t: Theme, a: Access): View<Msg>[] {
    let all = listed(a);
    if all.len == 0 {
        return [text("None").style(dim(t))];
    }
    let mut parts: View<Msg>[] = [];
    for s of all {
        let mut words: View<Msg>[] = [text(s).style(body(t))];
        if a.own == Some(s) {
            words.push(text("Its own server").style(dim(t)));
        }
        if a.fresh.any(fun(f: string) = f == s) {
            words.push(text("New").style(dim(t)));
        }
        let mut line_parts: View<Msg>[] = [column(words).align(Align.Center), spacer()];
        if a.switches {
            let on = !a.off.any(fun(o: string) = o == s);
            line_parts.push(
                switch(on, fun(_: bool) = Msg.ToggleServer(s)).name(s).align(Align.Center),
            );
        }
        parts.push(row(line_parts));
    }
    if !a.switches {
        // A fact, not an explanation: why there are no switches.
        parts.push(text("Unsigned: this computer only").style(dim(t)));
    }
    parts
}

/** Its own server first, then the declared ones. */
fun listed(a: Access): string[] {
    let mut all: string[] = [];
    if let Some(o) = a.own {
        all.push(o);
    }
    for s of a.servers {
        if a.own != Some(s) {
            all.push(s);
        }
    }
    all
}

/** "None", "1 server", "3 servers, 1 off". */
fun servers_summary(a: Access): string {
    let all = listed(a);
    if all.len == 0 {
        return "None";
    }
    let noun = if all.len == 1 { "server" } else { "servers" };
    let off = all.filter(fun(s: string) = a.off.any(fun(o: string) = o == s)).len;
    if off == 0 { "{all.len} {noun}" } else { "{all.len} {noun}, {off} off" }
}

/** What the app keeps here, in words: its state and its database, once its size is known. */
fun kept(p: AppPage): string = size(saved(p) + p.data_size.unwrap_or(0));

/** How many bytes the app saved: its state, 0 for none or an empty one (`{}`, one CBOR byte). */
fun saved(p: AppPage): i64 = match state_of(p) {
    Some(bytes) if bytes != [0xa0] => bytes.len,
    _ => 0,
};

/** A size in plain words: "Nothing saved", "900 B", "12 KB", "3.4 MB" (the old panel's). */
fun size(n: i64): string {
    if n <= 0 {
        return "Nothing saved";
    }
    if n < 1024 {
        return "{n} B";
    }
    if n < 1024 * 1024 {
        return "{n / 1024} KB";
    }
    // One decimal for megabytes, rounded to the nearest tenth: 3.4 MB.
    let tenths = (n * 10 + 512 * 1024) / (1024 * 1024);
    "{tenths / 10}.{tenths % 10} MB"
}
