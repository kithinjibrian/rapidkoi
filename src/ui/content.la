/**
 * The content area's page, pure: the current app, as it stands (running,
 * loading, stopped, refused, or Rapidkoi's question about a changed key).
 * Never calls a guest.
 *
 * Depends on: kivuli, ui.widgets, window.actions, window.tabs, window.window, guest.nodes, guest.pictures, guest.placeholders, people.people, ui.render, ui.frame
 * Used by: ui.layout
 */
import kivuli { View, Styling, Font, Size, column, lazy };
import std.crypto { sha256 };
import trust.keys { hex };
import ui.schemes { Theme };
import window.actions { Msg };
import window.tabs { AppPage };
import window.downloaded { Kept };
import guest.nodes { Node, Picture, Shown };
import guest.pictures { asset_of, icon_of };
import ui.appicons { icon_for };
import guest.placeholders { fill };
import window.zones { moments };
import people.people { name_in, looks_of, setting_of };
import bundles.permissions { Permission, Setting };
import people.access { key_of };
import ui.paint { Own };
import window.window { Model };
import ui.render { screen_as, screen_with, stopped, refused, loading };
import ui.widgets;
import ui.frame { unapproved };
import ui.asking { which_view };

/**
 * Draws a tab's app, its messages tagged with the tab, so they reach only it.
 *
 * @param id the tab's id
 * @param a its app page
 * @param m the model: the time (for loading), the person's name (for placeholders) and the theme
 * @returns the page's view
 *
 * Example:
 *     app_view(id, a, m)
 */
fun app_view(id: i64, a: AppPage, m: Model): View<Msg> {
    // An address with several apps asks which first (PRP-049).
    if m.choosing.map(fun(c: (i64, string)) = c.0 == id).unwrap_or(false) {
        return which_view(m);
    }
    let now = m.now;
    let shown = match a.screen {
        // Its parts are filled while drawing: the app can show your name
        // and times in your zone, never know them (PRP-011, PRP-053).
        Running(_, state, d) => {
            let (first, last) = match a.trust {
                Some(t) => name_in(m.people, t.host, t.origin),
                None => (m.people.first, m.people.last),
            };
            let own = own_of(a, m);
            // Rebuilt and compared only when what it shows changed: a
            // popover, a notice or the dock leave it be (kivuli's `lazy`).
            lazy(
                screen_key(id, state, m.theme, own, first, last, a.pictures) + timing(d.root, m),
                fun() = screen_as(
                    fill(pictured(d.root, a, m), first, last, m.offsets, m.now),
                    m.theme,
                    own,
                ),
            )
        }
        Stopped(why, can_restart) => stopped(why, can_restart, m.theme),
        Refused(why) => refused(why, m.theme),
        Loading(p) => loading(a.name, if now > p.started { now - p.started } else { 0 }, m.theme),
        // Rapidkoi's own question, not the app's: its buttons are the window's.
        Unapproved(c, kept) => {
            return unapproved(c, kept.len > 0, m.theme);
        }
    };
    sized(shown, m).map(fun(inner: render.Msg) = Msg.Tab(id, inner))
}

/**
 * What an app's screen shows depends on, as one key for kivuli's `lazy`:
 * its tab, its state (its screen is drawn from it), the theme and text
 * size, the person's switches for its looks, the name filled in for them,
 * and each picture's progress (not when it was last on screen). Anything
 * else changing (a popover, a notice, the dock) leaves the key as it was,
 * so the screen is neither rebuilt nor compared.
 *
 * Example:
 *     screen_key(id, state, m.theme, own, first, last, page.pictures)
 */
fun screen_key(
    id: i64,
    state: u8[],
    t: Theme,
    own: Own,
    first: string,
    last: string,
    kept: (string, Kept)[],
): string {
    let shown = kept.map(fun(p: (string, Kept)) = match p.1 {
        Coming => "{p.0}:coming",
        Here(bytes, size, _) => "{p.0}:here:{bytes.len}:{size}",
        Gone => "{p.0}:gone",
    });
    "{id}|{hex(sha256(state))}|{t.name}|{t.scale}|{own.colours}|{own.text_size}|{first}|{last}|{shown.join(",")}"
}

/**
 * The part of a screen's key its times depend on (PRP-053): the minute and
 * each moment's offset, so "5 minutes ago" moves on; "" when it shows none.
 */
fun timing(root: Node, m: Model): string {
    let at = moments(root);
    if at.len == 0 {
        return "";
    }
    let each = at.map(
        fun(ms: i64) = "{ms}:{m.offsets.get(ms).map(fun(o: i64) = "{o}").unwrap_or("-")}",
    );
    "|{m.now / 60_000}|{each.join(",")}"
}

/** The person's switch for an app's looks (PRP-038), from its ⚙ card. */
fun own_of(a: AppPage, m: Model): Own {
    let (colours, text_size) = looks_of(m.people, key_of(a));
    Own { colours: colours, text_size: text_size }
}

/**
 * The page at the person's text size (PRP-038): the body size set on the
 * page, so every size relative to it (`body`, `small`, `rem`) follows.
 */
fun sized<M>(v: View<M>, m: Model): View<M> {
    let base: Styling[] = [Font { size: Size.Scale(m.theme.scale), ..Font.theme() }];
    column([v]).style(base)
}

/**
 * Draws the new-tab app on the empty tab (PRP-027), or nothing: Rapidkoi's
 * own page failing or missing isn't the person's to read.
 *
 * @param m the model: its new-tab app and the theme
 * @returns the page's view
 *
 * Example:
 *     newtab_view(m)
 */
fun newtab_view(m: Model): View<Msg> = match m.newtab {
    Some(p) => match p.screen {
        // Its own messages go to it alone, as a tab's go to its app.
        // Rapidkoi's own app: your name for every app, times in your zone.
        // Its `widgets` slot holds your widgets, drawn by Rapidkoi (PRP-073).
        Running(_, _, d) => sized(
            screen_with(
                fill(pictured(d.root, p, m), m.people.first, m.people.last, m.offsets, m.now),
                m.theme,
                own_of(p, m),
                fun(_: string) = shown_widgets(m, p),
                fun(_: i64, v: View<render.Msg>) = v,
            ),
            m,
        ).map(fun(inner: render.Msg) = Msg.FromNewTab(inner)),
        _ => column([]),
    },
    None => column([]),
};

/**
 * Your widgets for the new tab's slot (PRP-073), unless you blocked its
 * "Showing your widgets" in its ⚙: then the slot stays empty.
 */
fun shown_widgets(m: Model, p: AppPage): View<render.Msg> = match setting_of(
    m.people,
    key_of(p),
    Permission.ShowWidgets,
) {
    Blocked => column([]),
    _ => widgets.row_view(m),
};

/** A page's screen with its pictures as the page has them, and apps' icons as Rapidkoi holds them. */
fun pictured(root: Node, a: AppPage, m: Model): Node = with_shown(
    root,
    a.program.map(fun(g) = g.assets).unwrap_or([]),
    a.pictures,
    fun(place: string): u8[] = icon_for(m, place),
);

/**
 * A screen with each picture as the page has it (PRP-047): a bundle's
 * from its assets, a server's from what's kept, an app's icon from `icon`
 * (PRP-060); one missing from the bundle, or gone, is broken; one not yet
 * here waits.
 *
 * Example:
 *     with_shown(d.root, assets, page.pictures, fun(place: string): u8[] = icon_for(m, place))
 */
fun with_shown(
    n: Node,
    assets: (string, u8[])[],
    kept: (string, Kept)[],
    icon: fun(string): u8[],
): Node = match n {
    Pictured(p, look) => Node.Pictured(
        Picture { shown: shown_of(p.source, assets, kept, icon), ..p },
        look,
    ),
    Boxed(look, facts, press, context, kids) => Node.Boxed(
        look,
        facts,
        press,
        context,
        kids.map(fun(k: Node) = with_shown(k, assets, kept, icon)),
    ),
    _ => n,
};

fun shown_of(
    source: string,
    assets: (string, u8[])[],
    kept: (string, Kept)[],
    icon: fun(string): u8[],
): Shown {
    // Rapidkoi holds it already: shown at once, never fetched (PRP-060).
    if let Some(place) = icon_of(source) {
        return Shown.Ready(icon(place));
    }
    match asset_of(source) {
        Some(name) => {
            for (n, bytes) of assets {
                if n == name {
                    return Shown.Ready(bytes);
                }
            }
            // The download pass stops the app first; drawn broken meanwhile.
            Shown.Broken
        }
        None => {
            for (s, k) of kept {
                if s == source {
                    return match k {
                        Here(bytes, _, _) => Shown.Ready(bytes),
                        Coming => Shown.Waiting,
                        Gone => Shown.Broken,
                    };
                }
            }
            Shown.Waiting
        }
    }
}
