/**
 * Returns the theme the person's choices pick: the colour set, and their
 * text size as `scale`.
 *
 * Example:
 *     theme_for(m.prefs)
 */
public fun theme_for(p: Prefs): Theme {
    let set = match (p.light, p.more_contrast) {
        (false, false) => DARK,
        (true, false) => LIGHT,
        (false, true) => DARK_CONTRAST,
        (true, true) => LIGHT_CONTRAST,
    };
    Theme { scale: p.text_size as f64 / 100.0, ..set }
}

/**
 * Returns WCAG's contrast ratio of a colour on a background: 1 to 21. A
 * translucent colour (`#rrggbbaa`) is laid over the background first.
 *
 * Example:
 *     contrast(t.text, t.page) >= 4.5
 */
public fun contrast(colour: string, background: string): f64 {
    let (f, alpha) = channels(colour);
    let (b, _) = channels(background);
    let laid = [0, 1, 2].map(fun(i: i64) = f[i] * alpha + b[i] * (1.0 - alpha));
    let one = luminance(laid);
    let two = luminance(b);
    let hi = if one > two { one } else { two };
    let lo = if one > two { two } else { one };
    (hi + 0.05) / (lo + 0.05)
}

/** `#rrggbb[aa]` as 0–255 channels and an alpha of 0 to 1. Theme colours only: they're Rapidkoi's own. */
fun channels(hex: string): (f64[], f64) {
    let byte = fun(i: i64): f64 = (digit(hex.to_bytes()[i]) * 16 + digit(
        hex.to_bytes()[i + 1],
    )) as f64;
    let alpha = if hex.len == 9 { byte(7) / 255.0 } else { 1.0 };
    ([byte(1), byte(3), byte(5)], alpha)
}

fun digit(b: u8): i64 {
    let n = b as i64;
    if n >= 97 { n - 87 } else if n >= 65 { n - 55 } else { n - 48 }
}

/** Relative luminance, as WCAG defines it. */
fun luminance(c: f64[]): f64 {
    let lin = fun(x: f64): f64 {
        let v = x / 255.0;
        if v <= 0.04045 { v / 12.92 } else { math.pow((v + 0.055) / 1.055, 2.4) }
    };
    0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2])
}
