/**
 * Several apps at one address (PRP-050, DECISION-064), pure: the chip at
 * the start of the address box (the app's colour and name), its list of
 * every app at the address, and the rows that list and "Which app?" share:
 * each app's colour, name, key fingerprint, Default and, in the chip's
 * list, Rename. Nothing shows at an address with one app.
 *
 * Depends on: kivuli, window.actions, window.window, window.tabs, trust.verify, trust.publishers, trust.keys, guest.nodes, ui.tokens, ui.themes, ui.frame_looks
 * Used by: ui.addressbox, ui.asking
 */
import std.crypto { equal };
import kivuli { View, Align, column, row, text, button };
import kivuli.ui { checkbox, group_button_with, popover as ui_popover };
import window.actions { Msg };
import window.window { Model };
import window.tabs { AppPage };
import trust.verify { Identity, known_for };
import trust.publishers { apps_at };
import trust.keys { fingerprint };
import guest.nodes { ButtonLook };
import ui.tokens { SPACE_SM, gap };
import ui.themes { dim, publisher_colour, button as button_look };
import ui.frame_looks { app_dot };
import ui.schemes { Theme };

/**
 * The chip for the app in front, when its address has several apps: its
 * colour and name, opening the list of them all. `None` otherwise.
 *
 * Example:
 *     several.chip(m, page)
 */
fun chip(m: Model, p: AppPage): Option<View<Msg>> {
    let t = p.trust?;
    let apps = apps_at(known_for(m.ring, t.host), t.host);
    if apps.len < 2 {
        return None;
    }
    let face = group_button_with(
        [row([dot(m.theme, t.origin), text(p.name)]).style([gap(SPACE_SM)]).align(Align.Center)],
        Msg.Chip(true),
    ).align(Align.Center).tooltip(p.name);
    let list = column(rows(m.theme, apps, Some(t.origin), true)).style([gap(SPACE_SM)]);
    Some(ui_popover(face, m.chip, list, Msg.Chip(false)))
}

/**
 * One row per app: its colour, its name (going to it), its key's short
 * fingerprint and Default; Rename too in the chip's list. The current
 * app's name stands out.
 *
 * @param current the app in front's first key, if one is
 * @param renaming whether rows offer Rename (the chip's list)
 *
 * Example:
 *     rows(m.theme, apps, Some(origin), true)
 */
fun rows(
    t: Theme,
    apps: Identity[],
    current: Option<u8[]>,
    renaming: bool,
): View<Msg>[] = apps.map(fun(i: Identity) {
    let here = current.map(fun(o: u8[]) = equal(o, i.origin)).unwrap_or(false);
    let look = if here { ButtonLook.Primary } else { ButtonLook.Normal };
    let mut parts: View<Msg>[] = [
        dot(t, i.origin),
        button(i.name.unwrap_or(i.host), Msg.Choose(i.origin)).style(button_look(t, look)),
        text(fingerprint(i.key)).style(dim(t)).align(Align.Center),
        checkbox("Default", i.default, fun(on: bool) = Msg.SetDefault(i.origin, on)),
    ];
    if renaming {
        parts.push(button("Rename", Msg.Rename(i.origin)).style(button_look(t, ButtonLook.Normal)));
    }
    row(parts).style([gap(SPACE_SM)]).align(Align.Start)
});

/**
 * An app's colour dot, from its first key.
 *
 * Example:
 *     dot(m.theme, origin)
 */
fun dot(t: Theme, origin: u8[]): View<Msg> = column([]).style(
    app_dot(publisher_colour(t, origin)),
).align(Align.Center);
