/**
 * The address box, pure (PRP-015, PRP-019): the framed group in the header
 * bar. Rapidkoi draws it where apps can't: the address and its trust marker
 * are Rapidkoi's word. Its suggestions card is gone until its redesign
 * (session 108; `ui/suggestions.la` keeps what to suggest). Opening and
 * closing happen in `update`.
 *
 * Depends on: kivuli, kivuli.ui, window.actions, window.window, ui.frame, ui.icons, ui.tokens, ui.themes
 * Used by: ui.header
 */
import kivuli { View, Align, Border, Radius, Shadow, State, Styling, Text, When, image, row };
import kivuli.ui {
    input_group,
    group_input,
    group_button_with,
    Button,
    button as ui_button,
    popover as ui_popover,
};
import window.actions { Msg, ShieldPage, PanelPage };
import window.window { Model, page_of, is_pinned };
import ui.frame { marker, marker_note, file_of };
import ui.icons { Icon, icon };
import ui.shield { facts, look_colour, card };
import ui.settings;
import ui.tokens {
    SPACE_XS,
    SPACE_SM,
    ADDRESS_HEIGHT,
    CIRCLE,
    ADDRESS_WIDTH,
    ADDRESS_ICON,
    square,
    padding,
    at_least,
    fixed_height,
    margin_y,
    flush_y,
    EDGE_WIDTH,
};
import ui.themes { address, bare };

/**
 * Builds the address box for the header bar, one framed group: on an app
 * page, the shield at its start in its look, opening its card (PRP-021),
 * then ⚙ opening site settings (PRP-020, PRP-022); in the middle the field
 * ("Enter Address"; Enter goes) on home or while editing, or the app's
 * address, which a click or Ctrl+K turns into the field; and ☆ at its end on
 * an app page.
 *
 * @param m the model
 * @returns the box
 *
 * Example:
 *     addressbox.field(m)
 */
public fun field(m: Model): View<Msg> {
    let t = m.theme;
    let page = page_of(m);
    // kivuli.ui makes fields and buttons at least 36 high; inside the box's
    // edge they take its height instead, so the box can be thinner.
    let inside = at_least(0, ADDRESS_HEIGHT - 2 * EDGE_WIDTH);
    let middle = match page {
        App(p) if !m.editing => {
            let shown = file_of(p.path);
            // The marker's meaning in words, then what clicking it does.
            // Bare: the box's ring is the only outline (session 120).
            ui_button(marker(p, shown), Msg.EditAddress).style([
                Button.ghost(),
                Text.start(),
                inside,
            ]).style(bare(t)).tooltip(
                "{marker_note(p, shown)}. Click to type an address (Ctrl+K)",
            ).shortcut("Ctrl+K")
        }
        // No padding above and below: kivuli.ui's field has 4 px each way, the
        // address button none, so the box (and the bar) was taller on home
        // and while typing than on an app's page (session 122).
        _ => group_input(m.draft, Msg.Draft).placeholder("Enter Address").name("address").on_submit(
            Msg.Go,
        ).autofocus().style([inside, flush_y()]),
    };
    let mut start: View<Msg>[] = [];
    if let App(p) = page {
        // The shield, always, in its look (PRP-021); its card hangs from it
        // while `m.shield` says it's open. A click outside or Escape closes it.
        let f = facts(p);
        let shield_button = group_button_with(
            [
                image(icon(Icon.Shield, look_colour(t, f.look))).style([
                    square(ADDRESS_ICON),
                ]).align(Align.Center),
            ],
            Msg.Shield(Some(ShieldPage.Main)),
        ).style(round()).align(Align.Center).tooltip("Site information");
        start.push(
            ui_popover(
                shield_button,
                m.shield.is_some(),
                card(t, p, m.shield.unwrap_or(ShieldPage.Main)),
                Msg.Shield(None),
            ),
        );
    }
    if let App(p) = page {
        // Site settings, right of the shield (PRP-020): its card hangs from
        // ⚙ while `m.panel` says it's open (PRP-022). A click outside or
        // Escape closes it, as ⚙ does.
        let gear = group_button_with(
            [image(icon(Icon.Settings, t.text)).style([square(ADDRESS_ICON)]).align(Align.Center)],
            Msg.TogglePanel,
        ).style(round()).align(Align.Center).tooltip("Site settings");
        start.push(
            ui_popover(
                gear,
                m.panel.is_some(),
                settings.card(m, p, m.panel.unwrap_or(PanelPage.Main)),
                Msg.TogglePanel,
            ),
        );
    }
    // The shield and ⚙ side by side, their round hovers touching: kivuli.ui
    // puts 8 px between a group's add-ons, too far apart for the owner
    // (session 145).
    if start.len > 1 {
        start = [row(start)];
    }
    let mut end: View<Msg>[] = [];
    if let App(p) = page {
        let tip = if is_pinned(m, p.path) { "Unpin" } else { "Pin" };
        end.push(
            group_button_with(
                [image(icon(Icon.Star, t.text)).style([square(ADDRESS_ICON)]).align(Align.Center)],
                Msg.TogglePin,
            ).style(round()).align(Align.Center).tooltip(tip),
        );
    }
    // A pill, as the owner asked (sessions 75, 121): GTK caps a radius at half
    // the box, so CIRCLE rounds each end fully whatever height kivuli.ui's
    // minimums give it.
    let box = input_group(start, middle, end).style([
        Border { radius: Radius.All(CIRCLE), ..Border.theme() },
        // Exactly this high on every tab: its content differs (the field
        // alone on an empty tab; the shield, ⚙ and ☆ around the address on
        // an app), and each asked for its own height (sessions 122, 152).
        fixed_height(ADDRESS_WIDTH, ADDRESS_HEIGHT),
        // Room above and below inside the header bar (the owner, session 107).
        margin_y(SPACE_SM),
        // No glow while typed in: kivuli.ui's 3 px halo goes, its thin ring
        // edge stays (the owner, session 117).
        When(State.FocusWithin, [Shadow.off()]),
    ]);
    box.align(Align.Center)
}

/**
 * The address box's icon buttons: circles exactly the box's inner height,
 * `SPACE_XS` around the icon, hovering round (session 145). A size alone left
 * them ovals: the group stretched them, so the size is capped too.
 */
fun round(): Styling[] = [
    Border { radius: Radius.All(CIRCLE), ..Border.theme() },
    padding(SPACE_XS),
    square(ADDRESS_HEIGHT - 2 * EDGE_WIDTH),
];
