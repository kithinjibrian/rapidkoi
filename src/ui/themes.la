/**
 * Rapidkoi's themes: every colour it shows, its own parts and apps' content
 * alike, as kivuli style values (DECISION-031). The desktop's GTK theme is
 * never followed. The frame (the header bar and the sidebar) is one flat
 * colour, and the page sits flush inside it, curving only at its top-right
 * corner. Apps name a button's kind; the theme decides its look. Dark is
 * first and the default; others come later, with settings.
 *
 * Depends on: kivuli, guest.nodes, ui.tokens
 * Used by: window.window, ui.layout, ui.addressbox, ui.frame, ui.content, ui.render
 */
import kivuli {
    Sizing,
    Styling,
    Font,
    Text,
    Background,
    Border,
    Side,
    Radius,
    Shadow,
    Effects,
    Paint,
    Size,
    Weight,
    Width,
    When,
    State,
    Palette,
    Token,
    Inside,
    Part,
    hex,
};
import guest.nodes { ButtonLook };
import ui.tokens {
    TEXT_TITLE,
    TEXT_HEADING,
    PAGE_RADIUS,
    EDGE_WIDTH,
    BUTTON_RADIUS,
    CIRCLE,
    HEADER_ICON,
    SPACE_XS,
    SPACE_SM,
    SPACE_MD,
    margin_x,
    padding,
    padding_xy,
};

/** One theme: a name, and a colour per part (`#rrggbb` or `#rrggbbaa`). Hex values live only here. */
public struct Theme {
    /** What settings will call it. */
    public name: string,
    /** The frame: the header bar and the sidebar, one colour. */
    public frame: string,
    /** The page, the address box and the suggestions card. */
    public page: string,
    /** The dim layer over the app while the panel is open: translucent. */
    public scrim: string,
    /** Thin lines: around the suggestions card and text fields. */
    public edge: string,
    /** Text. */
    public text: string,
    /** Secondary text: the text colour, fainter. */
    public dim: string,
    /** A normal button at rest, under the pointer, and pressed. */
    public control: string,
    /** A normal button under the pointer. */
    public control_hover: string,
    /** A normal button being pressed. */
    public control_press: string,
    /** Rapidkoi's brand colour: the main action (primary buttons), focus rings, a focused field's edge. */
    public accent: string,
    /** A primary button under the pointer or pressed. */
    public accent_hover: string,
    /** Text on the accent. */
    public on_accent: string,
    /** The brand gradient's other end: the accent runs into it. Kept for later; nothing wears it now. */
    public accent_end: string,
    /** Icons and text on the frame. */
    public on_frame: string,
    /** A faint icon on the frame: the shield of an unsigned app. */
    public faint: string,
    /** What a control on the gradient turns under the pointer. */
    public frame_hover: string,
    /** Buttons that delete or discard. */
    public danger: string,
    /** A danger button under the pointer or pressed. */
    public danger_hover: string,
    /** Text on the danger colour. */
    public on_danger: string,
    /** A subtle button under the pointer: a faint light wash. */
    public subtle_hover: string,
    /** Behind a tooltip's text. */
    public tooltip: string,
    /** Nothing: fully transparent. */
    public clear: string,
}

/** The dark theme, the default (the frame and page are the owner's colours, 2026-10-17). */
public const DARK: Theme = Theme {
    name: "dark",
    frame: "#242424",
    page: "#161616",
    scrim: "#00000060",
    edge: "#3a3a3a",
    text: "#e8e8e8",
    dim: "#e8e8e88c",
    control: "#2e2e2e",
    control_hover: "#383838",
    control_press: "#424242",
    // Rapidkoi's brand colour (the owner, session 111).
    accent: "#ff7700",
    accent_hover: "#ff8c2e",
    // Dark on the orange: white on it reads at 2.66:1, #161616 at 6.8:1.
    on_accent: "#161616",
    // The brand gradient's other end, a pink-red (the owner, session 112).
    accent_end: "#ff2e63",
    // White on the frame (the owner, session 116).
    on_frame: "#ffffff",
    // Grey, solid: SVG fills don't take #rrggbbaa everywhere, so not `dim`.
    faint: "#8c8c8c",
    // A faint white wash: a window control under the pointer, on the frame.
    frame_hover: "#ffffff26",
    danger: "#c01c28",
    danger_hover: "#d42c38",
    on_danger: "#ffffff",
    subtle_hover: "#ffffff14",
    // Black (the owner, session 146).
    tooltip: "#000000",
    clear: "#00000000",
};

/**
 * Returns a theme as a `kivuli.ui` palette: its colours under shadcn's
 * token names, so `kivuli.ui`'s components draw in them (PRP-019). The same
 * colour for light and dark: Rapidkoi ignores the desktop's scheme
 * (DECISION-031), and the root fixes it to dark besides.
 *
 * @param t the theme
 * @returns the palette for the root's `.palette(…)`
 *
 * Example:
 *     page.palette(palette(m.theme)).scheme(Scheme.Dark)
 */
public fun palette(t: Theme): Palette {
    let pairs = [
        (Token.Background, t.page),
        (Token.Foreground, t.text),
        // Cards and popovers float over the page in the frame's colour.
        (Token.Card, t.frame),
        (Token.CardForeground, t.text),
        (Token.Popover, t.frame),
        (Token.PopoverForeground, t.text),
        (Token.Primary, t.accent),
        (Token.PrimaryForeground, t.on_accent),
        (Token.Secondary, t.control),
        (Token.SecondaryForeground, t.text),
        (Token.Muted, t.control),
        (Token.MutedForeground, t.dim),
        // What a ghost button turns under the pointer.
        (Token.Accent, t.control_hover),
        (Token.AccentForeground, t.text),
        (Token.Destructive, t.danger),
        (Token.DestructiveForeground, t.on_danger),
        (Token.Border, t.edge),
        (Token.Input, t.edge),
        (Token.Ring, t.accent),
    ];
    let mut p = Palette.zinc();
    for (token, colour) of pairs {
        p = p.with(token, hex(colour), hex(colour));
    }
    p
}

/** A button kind's colours: at rest, under the pointer, pressed, and its text. */
public struct ButtonPaint {
    /** At rest. */
    public background: string,
    /** Under the pointer. */
    public hover: string,
    /** Being pressed. */
    public press: string,
    /** Its label and icon. */
    public text: string,
}

/**
 * Returns the colours a kind of button takes in a theme.
 *
 * Example:
 *     button_paint(DARK, ButtonLook.Primary)
 */
public fun button_paint(t: Theme, kind: ButtonLook): ButtonPaint = match kind {
    Normal => ButtonPaint {
        background: t.control,
        hover: t.control_hover,
        press: t.control_press,
        text: t.text,
    },
    Primary => ButtonPaint {
        background: t.accent,
        hover: t.accent_hover,
        press: t.accent_hover,
        text: t.on_accent,
    },
    Danger => ButtonPaint {
        background: t.danger,
        hover: t.danger_hover,
        press: t.danger_hover,
        text: t.on_danger,
    },
    Subtle => ButtonPaint {
        background: t.clear,
        hover: t.subtle_hover,
        press: t.subtle_hover,
        text: t.text,
    },
};

/**
 * Returns the frame's look: the window behind the page, one flat colour
 * with white icons and text (the owner went back to it from the gradient,
 * session 118).
 *
 * Example:
 *     column([body]).style(frame(m.theme))
 */
public fun frame(t: Theme): Styling[] {
    let mut all = flat(t.frame);
    all.push(Text { color: paint(t.on_frame), ..Text.theme() });
    all
}

/**
 * Returns the header bar's look: the frame's.
 *
 * Example:
 *     header_bar(start, title, end).style(header(m.theme))
 */
public fun header(t: Theme): Styling[] = frame(t);

/**
 * Returns the sidebar's look: the frame's, so the header bar and sidebar
 * read as one L.
 *
 * Example:
 *     column([]).style(sidebar(m.theme))
 */
public fun sidebar(t: Theme): Styling[] = frame(t);

/**
 * Returns a look that draws nothing of its own in any state: no background,
 * edge, shadow or focus ring. For a control inside something that frames it
 * already, as the address button inside the address box: one outline, not
 * two (the owner's screenshot, session 120).
 *
 * Example:
 *     ui.button(address, Msg.EditAddress).style(bare(t))
 */
public fun bare(t: Theme): Styling[] {
    let clear = Background { color: paint(t.clear), ..Background.theme() };
    let none = Border { all: Side { width: Width.Px(0), ..Side.theme() }, ..Border.theme() };
    [
        clear,
        none,
        Shadow.off(),
        When(State.Hover, [clear]),
        When(State.Press, [clear]),
        When(State.Focus, [clear, none, Shadow.off()]),
    ]
}

/**
 * Returns a section's group in a card: its rows on the control grey, a
 * little lighter than the card's frame colour, rounded (PRP-022).
 *
 * Example:
 *     column(rows).style(group(t))
 */
public fun group(t: Theme): Styling[] = [
    Background { color: paint(t.control), ..Background.theme() },
    Border { radius: Radius.All(PAGE_RADIUS), ..Border.theme() },
];

/**
 * Returns the window controls' look on the frame, given after
 * `kivuli.ui`'s `WindowControls.look()`: white glyphs, room on each side,
 * and the hover a circle on each control's 24 × 24 icon box, faint white
 * (red for close). The buttons themselves stay clear: GTK stretches them to
 * the bar's height, where rounding makes a tall pill (the owner's
 * screenshot, session 116).
 *
 * Example:
 *     header_bar(start, title, end).style(window_controls(t))
 */
public fun window_controls(t: Theme): Styling[] = [
    Inside(Part.WindowButton, [
        Text { color: paint(t.on_frame), ..Text.theme() },
        Background { color: paint(t.clear), ..Background.theme() },
        margin_x(SPACE_XS),
        When(State.Hover, [Background { color: paint(t.clear), ..Background.theme() }]),
        When(State.Press, [Background { color: paint(t.clear), ..Background.theme() }]),
    ]),
    // kivuli.ui's look paints the close button itself red on hover: clear it
    // too, so close shows the same circle as the rest (session 119).
    Inside(Part.WindowClose, [
        When(State.Hover, [Background { color: paint(t.clear), ..Background.theme() }]),
        When(State.Press, [Background { color: paint(t.clear), ..Background.theme() }]),
    ]),
    // The circle: each control's 24 × 24 icon box, padded so it isn't tight
    // around the glyph (32 across), round.
    Inside(Part.WindowIcon, [
        // The glyph the size of every other icon (the owner, session 126),
        // in place of kivuli.ui's 24.
        Sizing { icon: Width.Px(HEADER_ICON), ..Sizing.theme() },
        padding(SPACE_XS),
        Border { radius: Radius.All(CIRCLE), ..Border.theme() },
        When(State.Hover, [Background { color: paint(t.frame_hover), ..Background.theme() }]),
    ]),
    Inside(Part.WindowCloseIcon, [
        When(State.Hover, [Background { color: paint(t.danger), ..Background.theme() }]),
    ]),
];

/**
 * Returns every tooltip's look: the theme's text on `tooltip`, padded
 * `SPACE_MD` at the sides and `SPACE_SM` above and below, its corners
 * rounded `BUTTON_RADIUS` (session 146). GTK shows a
 * tooltip in its own window beside the root, so only the root's style
 * reaches it (kivuli's `Part.Tooltip`).
 *
 * Example:
 *     root.style(tooltips(t))
 */
public fun tooltips(t: Theme): Styling[] = [
    Inside(Part.Tooltip, [
        Background { color: paint(t.tooltip), ..Background.theme() },
        Text { color: paint(t.text), ..Text.theme() },
        padding_xy(SPACE_MD, SPACE_SM),
        Border { radius: Radius.All(BUTTON_RADIUS), ..Border.theme() },
    ]),
];

/**
 * Returns the page's look: the content area, its top-right corner curved
 * where the frame wraps it.
 *
 * Example:
 *     area.style(page(m.theme))
 */
public fun page(t: Theme): Styling[] = [
    Background { color: paint(t.page), ..Background.theme() },
    Border { radius: Radius.Corners(0, PAGE_RADIUS, 0, 0), ..Border.theme() },
    Text { color: paint(t.text), ..Text.theme() },
];

/**
 * Returns a text field's look: the page's colour, a thin edge that turns the
 * accent while the field has focus.
 *
 * Example:
 *     input(v, f).style(field(t))
 */
public fun field(t: Theme): Styling[] = [
    Background { color: paint(t.page), ..Background.theme() },
    Text { color: paint(t.text), ..Text.theme() },
    Border { all: line(t.edge), radius: Radius.All(BUTTON_RADIUS), ..Border.theme() },
    Shadow.off(),
    When(State.Focus, [Border { all: line(t.accent), ..Border.theme() }]),
];

/**
 * Returns the address box's look: a field whose ends are half circles.
 *
 * Example:
 *     input(m.draft, Msg.Draft).style(address(m.theme))
 */
public fun address(t: Theme): Styling[] {
    let mut all = field(t);
    // Half the height rounds each end into a half circle (the owner,
    // session 75). kivuli radii are pixels, so the box's height is fixed.
    all.push(Border { radius: Radius.All(CIRCLE), ..Border.theme() });
    all
}

/**
 * Returns the suggestions card's look: the page's colour, a thin edge, rounded.
 *
 * Example:
 *     column(rows).style(suggestions(m.theme))
 */
public fun suggestions(t: Theme): Styling[] = [
    Background { color: paint(t.page), ..Background.theme() },
    Text { color: paint(t.text), ..Text.theme() },
    Border { all: line(t.edge), radius: Radius.All(PAGE_RADIUS), ..Border.theme() },
    Shadow.off(),
];

/**
 * Returns an invisible look: a layer that only catches clicks.
 *
 * Example:
 *     button_with(column([]), Msg.Dismiss).style(clear(m.theme))
 */
public fun clear(t: Theme): Styling[] = flat(t.clear);

/**
 * Returns ordinary text's look.
 *
 * Example:
 *     text(s).style(body(t))
 */
public fun body(t: Theme): Styling[] = [Text { color: paint(t.text), ..Text.theme() }];

/**
 * Returns secondary text's look: fainter.
 *
 * Example:
 *     text(reason).style(dim(t))
 */
public fun dim(t: Theme): Styling[] = [Text { color: paint(t.dim), ..Text.theme() }];

/**
 * Returns a view's title's look: `TEXT_TITLE` points, bold.
 *
 * Example:
 *     text("This app stopped working").style(title(t))
 */
public fun title(t: Theme): Styling[] = [
    Font { size: Size.Pt(TEXT_TITLE), weight: Weight.Bold, ..Font.theme() },
    Text { color: paint(t.text), ..Text.theme() },
];

/**
 * Returns a section heading's look: `TEXT_HEADING` points, bold.
 *
 * Example:
 *     text("Pinned").style(heading(t))
 */
public fun heading(t: Theme): Styling[] = [
    Font { size: Size.Pt(TEXT_HEADING), weight: Weight.Bold, ..Font.theme() },
    Text { color: paint(t.text), ..Text.theme() },
];

/**
 * Returns a button's look for its kind: its colours at rest, under the
 * pointer and pressed, rounded, and faded while disabled.
 *
 * Example:
 *     button("Restart", Msg.Restart).style(button(t, ButtonLook.Primary))
 */
public fun button(t: Theme, kind: ButtonLook): Styling[] {
    let p = button_paint(t, kind);
    [
        Background { color: paint(p.background), ..Background.theme() },
        Text { color: paint(p.text), ..Text.theme() },
        Border {
            all: Side { width: Width.Px(0), ..Side.theme() },
            radius: Radius.All(BUTTON_RADIUS),
            ..Border.theme(),
        },
        Shadow.off(),
        When(State.Hover, [Background { color: paint(p.hover), ..Background.theme() }]),
        When(State.Press, [Background { color: paint(p.press), ..Background.theme() }]),
        // Half as strong: still readable, plainly not clickable.
        When(State.Disabled, [Effects { opacity: Some(0.5), ..Effects.theme() }]),
    ]
}

/** A colour of the theme's, as kivuli paint. */
fun paint(colour: string): Paint = Paint.Color(hex(colour));

/** A thin solid line in a colour. */
fun line(colour: string): Side = Side {
    width: Width.Px(EDGE_WIDTH),
    color: paint(colour),
    ..Side.theme(),
};

/** A flat surface: one colour, no border line or theme shadow. */
fun flat(colour: string): Styling[] = [
    Background { color: paint(colour), ..Background.theme() },
    Border { all: Side { width: Width.Px(0), ..Side.theme() }, ..Border.theme() },
    Shadow.off(),
];
