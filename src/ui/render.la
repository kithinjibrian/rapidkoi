/**
 * Rendering, pure: turns a decoded contract tree into kivuli views, and
 * draws the error screen. Every size comes from `theme.la`; every colour
 * from Rapidkoi's theme (`themes.la`), never the desktop's (DECISION-031).
 * Never calls the guest.
 *
 * Depends on: kivuli, cbor, contract, theme, themes
 * Used by: shell
 */
import kivuli { View, Align, button, column, input, row, text };
import cbor { Value };
import contract { Node, TextStyle, ButtonLook };
import theme { SPACE_SM, pixels, gap, margin };
import themes { Theme, body, dim, title, heading, field, button as button_look };

/** What the shell's window sends its `update`. */
public enum Msg {
    /** A node's message, and the event's data (an input's new text). */
    Event(Value, Option<string>),
    /** Start the app again in a fresh store. */
    Restart,
    /** Rapidkoi's answer to an app's effect: its msg, and the bytes or nothing (PRP-011). */
    Answer(Value, Value),
}

/**
 * Builds the kivuli view of a decoded tree.
 *
 * @param n the tree from `contract.read_tree`
 * @param t the theme its words take their looks from
 * @returns the view; a node without a message is a disabled control
 *
 * Example:
 *     screen(tree, m.theme)
 */
public fun screen(n: Node, t: Theme): View<Msg> = match n {
    Text(s, style) => styled_text(s, style, t),
    Button(label, look, msg) => button_of(label, look, msg, t),
    Input(value, hint, Some(msg)) => input(
        value,
        fun(s: string) = Msg.Event(msg, Some(s)),
    ).placeholder(hint).style(field(t)),
    // No message: greyed out and silent (kivuli 0.1.1); `.disabled` drops the handler.
    Input(value, hint, None) => input(
        value,
        fun(s: string) = Msg.Event(Value.Null, Some(s)),
    ).placeholder(hint).disabled(true).style(field(t)),
    // The contract's padding was kivuli 0.10's `.padding`: room outside the node.
    Column(spacing, padding, kids) => column(kids.map(fun(k: Node) = screen(k, t))).style([
        gap(pixels(spacing)),
        margin(pixels(padding)),
    ]),
    Row(spacing, padding, kids) => row(kids.map(fun(k: Node) = screen(k, t))).style([
        gap(pixels(spacing)),
        margin(pixels(padding)),
    ]),
    Unsupported(kind) => text("Unsupported component: {kind}").style(dim(t)).align(Align.Start),
};

/**
 * Builds the screen shown when an app stopped or never started.
 *
 * @param reason why, in plain words
 * @param can_restart whether to offer Restart (not when the module itself didn't load)
 * @param t the theme
 * @returns the error screen
 *
 * Example:
 *     stopped("This app stopped responding", true, m.theme)
 */
public fun stopped(reason: string, can_restart: bool, t: Theme): View<Msg> {
    let mut kids: View<Msg>[] = [
        text("This app stopped working").style(title(t)).align(Align.Start),
        text(reason).style(dim(t)).align(Align.Start),
    ];
    if can_restart {
        kids.push(button("Restart", Msg.Restart).style(button_look(t, ButtonLook.Primary)));
    }
    column(kids).style([gap(SPACE_SM)])
}

/**
 * The page for a signed app that failed a check: why, and no way past it.
 * ⟳ in the bar tries again.
 *
 * Example:
 *     refused("This app couldn't be verified, so Rapidkoi didn't run it: …", m.theme)
 */
public fun refused(reason: string, t: Theme): View<Msg> = column([
    text("Rapidkoi didn't run this app").style(title(t)).align(Align.Start),
    text(reason).style(dim(t)).align(Align.Start),
]).style([gap(SPACE_SM)]);

/**
 * The page while an app loads in the background: its address, a spinner,
 * and from 3 seconds on, the time so far.
 *
 * @param address what's loading, as the bar shows it
 * @param elapsed how long so far, in milliseconds
 * @param t the theme
 *
 * Example:
 *     loading("localhost:8000", 4100, m.theme)
 */
public fun loading(address: string, elapsed: i64, t: Theme): View<Msg> {
    let frame = ["◐", "◓", "◑", "◒"][elapsed / 120 % 4];
    let label = if elapsed >= 3000 { "Loading… {elapsed / 1000} s" } else { "Loading…" };
    column([
        text(address).style(title(t)).align(Align.Start),
        row([text(frame).style(body(t)), text(label).style(dim(t))]).style([gap(SPACE_SM)]),
    ]).style([gap(SPACE_SM)])
}

/** An app's text, at the start of its line: kivuli centers text unless told. */
fun styled_text(s: string, style: TextStyle, t: Theme): View<Msg> {
    let look = match style {
        Body => body(t),
        Title => title(t),
        Heading => heading(t),
        Dim => dim(t),
    };
    text(s).style(look).align(Align.Start)
}

/** An app's button: the app names its kind, Rapidkoi's theme decides its look. */
fun button_of(label: string, look: ButtonLook, msg: Option<Value>, t: Theme): View<Msg> {
    let style = button_look(t, look);
    match msg {
        Some(m) => button(label, Msg.Event(m, None)).style(style),
        // kivuli: a button without a message is disabled; any placeholder
        // message works, since `.disabled(true)` removes it.
        None => button(label, Msg.Restart).disabled(true).style(style),
    }
}
