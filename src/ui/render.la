/**
 * Rendering, pure: turns a decoded contract tree into kivuli views, and
 * draws the error screen. Every size comes from `ui/tokens.la`; every colour
 * from Rapidkoi's theme (`themes.la`), never the desktop's (DECISION-031).
 * Never calls the guest.
 *
 * Depends on: kivuli, cbor, guest.contract, ui.tokens, ui.themes
 * Used by: shell
 */
import kivuli {
    View,
    Align,
    Styling,
    Background,
    Border,
    Outline,
    Shadow,
    Side,
    Radius,
    Width,
    Line,
    When,
    State,
    button,
    button_with,
    column,
    input,
    row,
    text,
    text_area,
    scroll,
    scroll_fit,
};
import cbor { Value };

import guest.nodes { Look, Facts, Typing, Direction, Node, ButtonLook };
import ui.tokens { SPACE_SM, RING_WIDTH, gap, margin, padding_xy };
import ui.themes { body, dim, title, heading, field, paint as theme_paint, button as button_look };
import ui.schemes { Theme };
import ui.paint { Own, AS_STYLED, resolve_for, styles_of, align_of };
import ui.pictured { picture_view };

/** What the shell's window sends its `update`. */
enum Msg {
    /** A node's message, and the event's data (an input's new text). */
    Event(Value, Option<string>),
    /** Start the app again in a fresh store. */
    Restart,
    /** Rapidkoi's answer to an app's effect: its msg, and the bytes or nothing (PRP-011). */
    Answer(Value, Value),
}

/**
 * Builds the kivuli view of a decoded tree.
 *
 * @param n the tree from `contract.read_tree`
 * @param t the theme its words take their looks from
 * @returns the view; a node without a message is a disabled control
 *
 * Example:
 *     screen(tree, m.theme)
 */
fun screen(n: Node, t: Theme): View<Msg> = screen_as(n, t, AS_STYLED);

/**
 * Builds the kivuli view of a decoded tree with the person's switch for
 * its app (PRP-038): their colours, their text size, or both, forced.
 *
 * Example:
 *     screen_as(tree, m.theme, own)
 */
fun screen_as(n: Node, t: Theme, own: Own): View<Msg> = match n {
    Unsupported(kind) => text("Unsupported component: {kind}").style(dim(t)).align(Align.Start),
    Boxed(look, facts, press, kids) => boxed(look, facts, press, kids, t, own),
    Words(s, look, facts) => placed(
        text(s).style(body(t) + drawn(look, facts, t, own, false)),
        look,
        Align.Start,
    ),
    Field(typing, look) => placed(
        typing_box(typing, t).style(field(t) + drawn(look, facts_none(), t, own, false)),
        look,
        Align.Fill,
    ),
    Pictured(p, look) => picture_view(p, look, t, own),
};

/**
 * A box (PRP-037): its children in a row or column, styled as
 * the app said. With `on_press` it's a button around them: focusable, and
 * pressed by click, Enter or Space. Its base look is nothing at all (no
 * GTK button look, DECISION-031) but a focus ring, so the keyboard's place
 * always shows; the app's style goes over it.
 */
fun boxed(
    look: Look,
    facts: Facts,
    press: Option<Value>,
    kids: Node[],
    t: Theme,
    own: Own,
): View<Msg> {
    let inside = kids.map(fun(k: Node) = screen_as(k, t, own));
    let layout = match look.direction {
        Row => row(inside),
        Column => column(inside),
    };
    let resolved = resolve_for(look, t, own, false);
    let mut inner: Styling[] = [];
    if look.gap.is_some() {
        inner.push(gap(resolved.gap.unwrap_or(0)));
    }
    // A scrolling box's padding scrolls with what it holds (PRP-046), as in
    // CSS, so its content is cut at the box's edge, not short of it.
    if look.scroll.is_some() {
        if let Some((v, h)) = resolved.padding {
            inner.push(padding_xy(h, v));
        }
    }
    let spaced = if inner.len > 0 { layout.style(inner) } else { layout };
    let styles = drawn(drawn_on_box(look), facts, t, own, press.is_some());
    // A scrolling box (PRP-046): as tall as its content until its parent runs
    // out of room (`scroll_fit`), or, with `grow`, the room left (`scroll`).
    // The rest of its style goes on the scrolled area, so its sizes bound what scrolls.
    let spaced = match look.scroll {
        Some(_) => if look.grow { scroll(spaced) } else { scroll_fit(spaced) },
        None => spaced,
    };
    match press {
        Some(m) => {
            let pressed = button_with(spaced, Msg.Event(m, None)).style(bare(t) + styles);
            placed(if facts.disabled { pressed.disabled(true) } else { pressed }, look, Align.Fill)
        }
        None => placed(spaced.style(styles), look, Align.Fill),
    }
}

/** What a box draws on itself: its gap is its children's, and a scrolling box's padding scrolls with them. */
fun drawn_on_box(look: Look): Look = match look.scroll {
    Some(_) => Look { gap: None, padding: None, ..look },
    None => Look { gap: None, ..look },
};

/** A pressable box's look before the app's: no fill, edge or shadow; the accent ring on focus. */
fun bare(t: Theme): Styling[] = [
    Background { color: theme_paint(t.clear), ..Background.theme() },
    Border {
        all: Side { width: Width.Px(0), ..Side.theme() },
        radius: Radius.All(0),
        ..Border.theme(),
    },
    Shadow.off(),
    When(State.Focus, [
        Outline {
            width: Width.Px(RING_WIDTH),
            color: theme_paint(t.accent),
            style: Line.Solid,
            ..Outline.theme(),
        },
    ]),
];

/** A look's styles, with the `checked` look laid over when the node is checked. */
fun drawn(look: Look, facts: Facts, t: Theme, own: Own, pressable: bool): Styling[] {
    let base = styles_of(resolve_for(look, t, own, pressable));
    if facts.checked != Some(true) {
        return base;
    }
    let mut out = base;
    for (name, inner) of look.states {
        if name == "checked" {
            for s of styles_of(resolve_for(inner, t, own, pressable)) {
                out.push(s);
            }
        }
    }
    out
}

/** Where a node sits and whether it takes the spare room, as the app said. */
fun placed(v: View<Msg>, look: Look, otherwise: Align): View<Msg> {
    let aligned = v.align(look.align.map(align_of).unwrap_or(otherwise));
    if look.grow { aligned.expand() } else { aligned }
}

/** One line, or a box of several; Enter on one line sends `on_submit` with the text. */
fun typing_box(f: Typing, t: Theme): View<Msg> {
    let change = f.on_change;
    let send = fun(s: string) = Msg.Event(change.unwrap_or(Value.Null), Some(s));
    if f.lines > 1 {
        let area = text_area(f.value, send).placeholder(f.placeholder).name(
            f.label.unwrap_or(f.placeholder),
        );
        return if change.is_none() { area.disabled(true) } else { area };
    }
    // Named by its label when it has one (DECISION-056), so it's found by it.
    let line = input(f.value, send).placeholder(f.placeholder).name(
        f.label.unwrap_or(f.placeholder),
    );
    let submitting = match f.on_submit {
        Some(m) => line.on_submit(Msg.Event(m, Some(f.value))),
        None => line,
    };
    if change.is_none() { submitting.disabled(true) } else { submitting }
}

/** No role, no state: for nodes that can't have them. */
fun facts_none(): Facts = Facts {
    role: None,
    checked: None,
    selected: None,
    disabled: false,
    label: None,
};

/**
 * Builds the screen shown when an app stopped or never started.
 *
 * @param reason why, in plain words
 * @param can_restart whether to offer Restart (not when the module itself didn't load)
 * @param t the theme
 * @returns the error screen
 *
 * Example:
 *     stopped("This app stopped responding", true, m.theme)
 */
fun stopped(reason: string, can_restart: bool, t: Theme): View<Msg> {
    let mut kids: View<Msg>[] = [
        text("This app stopped working").style(title(t)).align(Align.Start),
        text(reason).style(dim(t)).align(Align.Start),
    ];
    if can_restart {
        kids.push(button("Restart", Msg.Restart).style(button_look(t, ButtonLook.Primary)));
    }
    column(kids).style([gap(SPACE_SM)])
}

/**
 * The page for a signed app that failed a check: why, and no way past it.
 * ⟳ in the bar tries again.
 *
 * Example:
 *     refused("This app couldn't be verified, so Rapidkoi didn't run it: …", m.theme)
 */
fun refused(reason: string, t: Theme): View<Msg> = column([
    text("Rapidkoi didn't run this app").style(title(t)).align(Align.Start),
    text(reason).style(dim(t)).align(Align.Start),
]).style([gap(SPACE_SM)]);

/**
 * The page while an app loads in the background: its address, a spinner,
 * and from 3 seconds on, the time so far.
 *
 * @param address what's loading, as the bar shows it
 * @param elapsed how long so far, in milliseconds
 * @param t the theme
 *
 * Example:
 *     loading("localhost:8000", 4100, m.theme)
 */
fun loading(address: string, elapsed: i64, t: Theme): View<Msg> {
    let frame = ["◐", "◓", "◑", "◒"][elapsed / 120 % 4];
    let label = if elapsed >= 3000 { "Loading… {elapsed / 1000} s" } else { "Loading…" };
    column([
        text(address).style(title(t)).align(Align.Start),
        row([text(frame).style(body(t)), text(label).style(dim(t))]).style([gap(SPACE_SM)]),
    ]).style([gap(SPACE_SM)])
}
