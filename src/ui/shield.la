/**
 * The shield, pure (PRP-021): what Rapidkoi can say about an app's trust
 * (how it reached it, who signed it and since when, its version), the
 * shield's look, and its card: the app at the top, a row each for the
 * connection and the signature, each opening a page of its own. It answers
 * "can I trust this?"; what the app may do is ⚙ site settings'. Only
 * Rapidkoi draws it, from its own checks.
 *
 * Depends on: kivuli, kivuli.ui, window.actions, window.tabs, net.address, trust.keys, ui.frame, ui.tokens, ui.themes, ui.cards
 * Used by: ui.addressbox
 */
import kivuli { View, Align, column };
import kivuli.ui { separator, button as ui_button };
import window.actions { Msg, ShieldPage };
import window.tabs { AppPage, Cached };
import net.address { parse, shown };
import trust.keys { fingerprint };
import ui.frame { file_of };
import ui.tokens { SPACE_XS, SPACE_SM, gap, padding_xy };
import ui.schemes { Theme };
import ui.themes { button as button_look };
import guest.nodes { ButtonLook };
import ui.cards { sized, identity, choice, detail, line, sentence };

/** The shield's three looks: everything checks out, something to know, or nothing vouches. */
enum ShieldLook {
    /** Signed, and the signature checks out: a verified site, or a signed file whose key Rapidkoi trusts. */
    Verified,
    /** A development address: you're its publisher, so a tick, but a caution one. */
    Caution,
    /**
     * Nothing trusted vouches for it: unsigned, a key not met yet, a new
     * publisher, or a site that moved on to another key (the owner,
     * 2026-10-30). shield-cross in a pill with the reason, no colour.
     */
    Warned,
    /** Nothing signed it. */
    Unsigned,
}

/** How Rapidkoi reached the app. */
enum Connection {
    /** Over HTTPS from another machine, its certificate checked. */
    Secure,
    /** From this computer, for development. */
    ThisComputer,
    /** From a file on this computer. */
    LocalFile,
}

/** What its signature says. */
enum Signature {
    /** Signed, by a key Rapidkoi verified or trusts. */
    Signed,
    /** Signed, by a key Rapidkoi hasn't met. */
    NotConfirmed,
    /** Signed by a different key than before, opened as a separate app. */
    NewPublisher,
    /** Not signed. */
    NotSigned,
}

/** What the shield says about one app. */
struct ShieldFacts {
    /** The shield's look. */
    look: ShieldLook,
    /** How Rapidkoi reached it. */
    connection: Connection,
    /** What its signature says. */
    signature: Signature,
    /** Where it came from: its host, or its file's name. */
    place: string,
    /** Who signed it: "host · key xxxx-…"; `None` when unsigned. */
    publisher: Option<string>,
    /** Since when Rapidkoi has known that publisher, or that it's new; `None` when unsigned or not confirmed. */
    since: Option<string>,
    /** Its version, "· verified build" when its site's signed index lists the build; `None` without a manifest. */
    version: Option<string>,
    /** Why it's warned, in its pill ("Not signed", "Not verified", "New publisher", "Key changed"); `None` otherwise. */
    warning: Option<string>,
}

/**
 * Works out what the shield says about an app page, from what Rapidkoi
 * already checked when it opened it.
 *
 * @param p the app page
 * @returns its facts
 *
 * Example:
 *     facts(page)
 */
fun facts(p: AppPage): ShieldFacts {
    let (connection, place) = match parse(p.path) {
        Ok(a) => (if a.remote { Connection.Secure } else { Connection.ThisComputer }, shown(a)),
        Err(_) => (Connection.LocalFile, file_of(p.path)),
    };
    let signature = match p.trust {
        None => Signature.NotSigned,
        Some(t) => if t.separate {
            Signature.NewPublisher
        } else {
            match t.standing {
                NotConfirmed => Signature.NotConfirmed,
                _ => Signature.Signed,
            }
        },
    };
    // Its site moved on to another publisher: your version (PRP-049).
    let moved = p.cached.and_then(fun(c: Cached) = c.moved).is_some();
    // Why nothing trusted vouches for it, in the pill (the owner,
    // 2026-10-30). Development (this computer, a local file) says nothing:
    // you're its publisher.
    let development = match connection {
        Secure => false,
        _ => true,
    };
    let warning = match signature {
        _ if moved => Some("Key changed"),
        NewPublisher => Some("New publisher"),
        NotConfirmed => Some("Not verified"),
        NotSigned if !development => Some("Not signed"),
        _ => None,
    };
    let look = match signature {
        _ if warning.is_some() => ShieldLook.Warned,
        NotSigned => ShieldLook.Unsigned,
        NotConfirmed | NewPublisher => ShieldLook.Warned,
        // Signed: a development address is still caution; a file is fine,
        // its signature is what vouches for it.
        Signed => match connection {
            ThisComputer => ShieldLook.Caution,
            _ => ShieldLook.Verified,
        },
    };
    let publisher = p.trust.map(fun(t) = "{t.host} · key {fingerprint(t.key)}");
    let since = match (p.trust, signature) {
        (Some(_), NewPublisher) => Some("New publisher: its key changed"),
        // Not trusted yet, so there's no "since".
        (Some(_), NotConfirmed) => None,
        (Some(t), _) => Some(known_since(t.since)),
        (None, _) => None,
    };
    // Only a site's signed index vouches for the exact build.
    let from_index = match p.trust {
        Some(t) => match t.standing {
            Verified => true,
            _ => false,
        },
        None => false,
    };
    let version = p.manifest.map(
        fun(m) = if from_index { "{m.version} · verified build" } else { m.version },
    );
    ShieldFacts {
        warning: warning,
        look: look,
        connection: connection,
        signature: signature,
        place: place,
        publisher: publisher,
        since: since,
        version: version,
    }
}

/**
 * Returns since when Rapidkoi has known a publisher: "Same publisher since
 * 18 Oct 2026".
 *
 * @param since when its key was first trusted, in milliseconds since 1970; 0 when not recorded
 *
 * Example:
 *     known_since(trust.since)
 */
fun known_since(since: i64): string {
    if since <= 0 {
        return "Same publisher since first use (date not recorded)";
    }
    "Same publisher since {date(since)}"
}

/**
 * Returns when a kept app was last checked against its site (PRP-043):
 * "Checked 5 min ago", or, offline, "Not checked since 18 Oct 2026".
 *
 * @param c its kept copy
 * @param now the time now, in milliseconds since 1970
 *
 * Example:
 *     checked_words(cached, m.now)
 */
fun checked_words(c: Cached, now: i64): string {
    if !c.reached {
        return if c.checked <= 0 {
            "Not checked yet"
        } else {
            "Not checked since {date(c.checked)}"
        };
    }
    let ago = now - c.checked;
    if ago < 60_000 {
        return "Checked just now";
    }
    if ago < 3_600_000 {
        return "Checked {ago / 60_000} min ago";
    }
    if ago < 86_400_000 {
        let hours = ago / 3_600_000;
        return "Checked {hours} {if hours == 1 { "hour" } else { "hours" }} ago";
    }
    "Checked {date(c.checked)}"
}

/** A day as "18 Oct 2026", from milliseconds since 1970. */
fun date(ms: i64): string {
    let (y, m, d) = civil(ms / 86_400_000);
    let months = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec",
    ];
    "{d} {months[m - 1]} {y}"
}

/**
 * Returns the colour the shield is drawn in for a look: the frame's white,
 * the accent's orange, or faint.
 *
 * Example:
 *     icon(Icon.Shield, look_colour(m.theme, f.look))
 */
fun look_colour(t: Theme, look: ShieldLook): string = match look {
    Verified => t.on_frame,
    Caution => t.caution,
    // No colour: the pill's words warn.
    Warned => t.text,
    Unsigned => t.faint,
};

/**
 * Builds the shield's card on a page: the app and its two rows, or one row's
 * page with ‹ back.
 *
 * @param t the theme
 * @param p the app page
 * @param page which page of the card
 * @param now the time now, for when its kept copy was last checked
 * @returns the card's content, for the popover
 *
 * Example:
 *     card(m.theme, page, ShieldPage.Main, m.now)
 */
fun card(t: Theme, p: AppPage, page: ShieldPage, now: i64): View<Msg> {
    let f = facts(p);
    let back = Msg.Shield(Some(ShieldPage.Main));
    let shown = match page {
        Main => {
            let mut parts = [identity(t, p, None), separator()];
            // Its site moved on (PRP-049): said first, then its one action,
            // a row like the others.
            for x of moved_on(t, p) {
                parts.push(x);
            }
            parts.push(
                choice(
                    t,
                    connection_label(f.connection),
                    None,
                    Msg.Shield(Some(ShieldPage.Connection)),
                ),
            );
            parts.push(
                choice(t, signature_label(f.signature), None, Msg.Shield(Some(ShieldPage.Signed))),
            );
            column(parts).style([gap(SPACE_SM)])
        }
        Connection => detail(t, connection_label(f.connection), back, [
            line(t, "Address", f.place),
        ]),
        Signed => {
            let mut lines: View<Msg>[] = [];
            if let Some(who) = f.publisher {
                lines.push(line(t, "Publisher", who));
            }
            if let Some(when) = f.since {
                lines.push(line(t, "Known", when));
            }
            if let Some(v) = f.version {
                lines.push(line(t, "Version", v));
            }
            // Kept apps say when their site was last checked (PRP-043).
            if let Some(c) = p.cached {
                lines.push(line(t, "Updates", checked_words(c, now)));
            }
            detail(t, signature_label(f.signature), back, lines)
        }
    };
    sized(shown)
}

/** A connection row's words. */
fun connection_label(c: Connection): string = match c {
    Secure => "Connection secure",
    ThisComputer => "This computer",
    LocalFile => "Local file",
};

/** A signature row's words. */
fun signature_label(s: Signature): string = match s {
    Signed => "Signed app",
    NotConfirmed => "Not confirmed yet",
    NewPublisher => "New publisher",
    NotSigned => "Not signed",
};

/**
 * Days since 1970-01-01 as (year, month, day) in the proleptic Gregorian
 * calendar: Howard Hinnant's civil_from_days (from the old panel's date
 * words).
 */
fun civil(days: i64): (i64, i64, i64) {
    let z = days + 719_468;
    let era = (if z >= 0 { z } else { z - 146_096 }) / 146_097;
    let doe = z - era * 146_097;
    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };
    (y, m, d)
}

/**
 * When the app's site moved on to another publisher (PRP-049): saying so,
 * at the rows' inset, then a primary button offering the new one as a
 * separate app, and a separator. Nothing otherwise.
 */
fun moved_on(t: Theme, p: AppPage): View<Msg>[] = match (
    p.trust,
    p.cached.and_then(fun(c: Cached) = c.moved),
) {
    (Some(tr), Some(_)) => [
        column([sentence(t, "{tr.host} is now signed by another key")]).style([
            padding_xy(SPACE_SM, SPACE_XS),
        ]),
        // An action, not a page: the brand's primary button, at the rows' inset (the owner).
        column([
            ui_button("Open as a separate app", Msg.SeparateMoved).style(
                button_look(t, ButtonLook.Primary),
            ).align(Align.Start),
        ]).style([padding_xy(SPACE_SM, SPACE_XS)]),
        separator(),
    ],
    _ => [],
};
