/**
 * Permission settings in the card, and the approval dialog (PRP-031),
 * pure: the Permissions row's summary and page (a setting per permission
 * the app declares), which rows and icons a built-in app's `controls`
 * show, and Rapidkoi's own question when an app needs your approval. Only
 * Rapidkoi draws these; an app never sees its settings.
 *
 * Depends on: kivuli, kivuli.ui, window.actions, window.tabs, window.window, bundles.bundle, bundles.permissions, people.people, people.access, ui.themes
 * Used by: ui.settings, ui.addressbox
 */
import kivuli { View, Align, column, row, spacer, text };
import kivuli.ui { button as ui_button, dropdown as ui_dropdown, dialog_header, dialog_footer };
import window.actions { Msg, Answer };
import window.tabs { AppPage };
import window.window { Model };
import bundles.bundle { Manifest, Controls };
import bundles.permissions {
    Permission,
    Setting,
    SETTINGS,
    parse,
    name_of,
    label_of,
    wish_of,
    setting_words,
};
import people.people { setting_of };
import people.access { key_of };
import guest.nodes { ButtonLook };
import ui.themes { body, button as button_look };
import ui.schemes { Theme };

/** The permissions an app declares that this Rapidkoi knows (the loader refused any other). */
fun declared(p: AppPage): Permission[] = parse(
    p.manifest.map(fun(m: Manifest) = m.permissions).unwrap_or([]),
).unwrap_or([]);

/**
 * Returns the Permissions row's summary, or `None` when the app declares
 * none (no row then): "3 allowed", "1 allowed · 1 needs approval · 1 blocked".
 *
 * Example:
 *     summary(m, page)
 */
fun summary(m: Model, p: AppPage): Option<string> {
    let all = declared(p);
    if all.len == 0 {
        return None;
    }
    let count = fun(s: Setting): i64 = all.filter(
        fun(x: Permission) = setting_of(m.people, key_of(p), x) == s,
    ).len;
    let mut parts: string[] = [];
    if count(Setting.Allowed) > 0 {
        parts.push("{count(Setting.Allowed)} allowed");
    }
    if count(Setting.Ask) > 0 {
        parts.push("{count(Setting.Ask)} needs approval");
    }
    if count(Setting.Blocked) > 0 {
        parts.push("{count(Setting.Blocked)} blocked");
    }
    Some(parts.join(" · "))
}

/**
 * Builds the Permissions page's rows: each permission the app declares, in
 * words, with a drop-down of the three settings.
 *
 * Example:
 *     detail(t, "Permissions", Msg.PanelBack, grants.page(m, t, p))
 */
fun page(m: Model, t: Theme, p: AppPage): View<Msg>[] = declared(p).map(fun(
    x: Permission,
): View<Msg> {
    let name = name_of(x);
    let choices = SETTINGS.map(fun(s: Setting) = (setting_words(s), Msg.SetPermission(name, s)));
    row([
        text(label_of(x)).style(body(t)).align(Align.Center),
        spacer(),
        ui_dropdown(choices, setting_words(setting_of(m.people, key_of(p), x)), "").name(name),
    ])
});

/**
 * Says whether the card shows a row (`app_settings.permissions`) or a
 * group (`app_settings`): always for an app without `controls`; for a
 * built-in app with them, a row it names, by itself or by its group, and
 * a group with any row named.
 *
 * Example:
 *     if shows_row(p, "app_data.state") { … }
 */
fun shows_row(p: AppPage, wanted: string): bool = match p.manifest.and_then(
    fun(m: Manifest) = m.controls,
) {
    None => true,
    Some(c) => c.settings.any(
        fun(n: string) = n == wanted || wanted.starts_with("{n}.") || n.starts_with("{wanted}."),
    ),
};

/**
 * Says whether the empty tab's address box shows an icon (`settings`,
 * `share`), as the new tab's `controls` say: share alone without them.
 *
 * Example:
 *     shows_icon(m.newtab, "settings")
 */
fun shows_icon(newtab: Option<AppPage>, icon: string): bool = match newtab.and_then(
    fun(p: AppPage) = p.manifest,
).and_then(fun(m: Manifest) = m.controls) {
    Some(c) => c.address.any(fun(n: string) = n == icon),
    None => icon == "share",
};

/**
 * Builds the approval dialog's content while an app waits for you: what
 * it wants, and Don't allow, Allow once, Always allow. `None` when nothing
 * waits.
 *
 * Example:
 *     grants.question(m)
 */
fun question(m: Model): Option<View<Msg>> = m.approval.map(
    fun(a) = column([
        dialog_header("{a.app} wants to {wish_of(a.permission)}", ""),
        dialog_footer([
            ui_button("Don't allow", Msg.Approve(Answer.Deny)).style(
                button_look(m.theme, ButtonLook.Normal),
            ),
            ui_button("Allow once", Msg.Approve(Answer.Once)).style(
                button_look(m.theme, ButtonLook.Normal),
            ),
            ui_button("Always allow", Msg.Approve(Answer.Always)).style(
                button_look(m.theme, ButtonLook.Primary),
            ),
        ]),
    ]),
);
