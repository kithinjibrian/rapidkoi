/**
 * The frame's looks (split out of `themes.la`, session 150): the window
 * behind the page, the header bar, the sidebar and its app buttons, the
 * window controls and the tooltips. Colours come from the theme
 * (`themes.paint`), never a hex value of their own.
 *
 * Depends on: kivuli, kivuli.ui, ui.tokens, ui.themes
 * Used by: ui.layout, ui.header, ui.sidebar
 */
import kivuli {
    Styling,
    Background,
    Border,
    Side,
    Radius,
    Sizing,
    Text,
    Width,
    When,
    State,
    Inside,
    Part,
    Effects,
    TextAlign,
    Group,
    Spacing,
    Edges,
};
import kivuli.ui { Button };
import ui.tokens {
    SPACE_XS,
    SPACE_SM,
    SPACE_MD,
    BUTTON_RADIUS,
    CIRCLE,
    RING_WIDTH,
    TAB_CLOSE,
    HEADER_ICON,
    margin_x,
    padding,
    padding_xy,
    no_padding,
    square,
    INSTANCE_CHIP,
    APP_DOT,
};
import ui.themes { paint, flat };
import ui.schemes { Theme };

/**
 * Returns the frame's look: the window behind the page, one flat colour
 * with white icons and text (the owner went back to it from the gradient,
 * session 118).
 *
 * Example:
 *     column([body]).style(frame(m.theme))
 */
fun frame(t: Theme): Styling[] {
    let mut all = flat(t.frame);
    all.push(Text { color: paint(t.on_frame), ..Text.theme() });
    all
}

/**
 * Returns the header bar's look: the frame's.
 *
 * Example:
 *     header_bar(start, title, end).style(header(m.theme))
 */
fun header(t: Theme): Styling[] = frame(t);

/**
 * Returns the sidebar's look: the frame's, so the header bar and sidebar
 * read as one L.
 *
 * Example:
 *     column([]).style(sidebar(m.theme))
 */
fun sidebar(t: Theme): Styling[] = frame(t);

/**
 * Returns an app's button in the sidebar: a ghost icon button, round, washed
 * faintly on hover as the window controls are (PRP-023).
 *
 * Example:
 *     ui.button_with([face], Msg.Select(id)).style(app_button(t))
 */
fun app_button(t: Theme): Styling[] = [
    Button.ghost(),
    Button.icon(),
    // A clear ring as wide as the current app's, so ringing one only
    // colours it and its icon doesn't shift (the owner, session 161).
    Border {
        all: Side { width: Width.Px(RING_WIDTH), color: paint(t.clear), ..Side.theme() },
        radius: Radius.All(CIRCLE),
        ..Border.theme()
    },
    When(State.Hover, [Background { color: paint(t.frame_hover), ..Background.theme() }]),
];

/**
 * Returns what the current app's button adds: a round ring in the accent
 * (the owner preferred a ring to a bar, session 145).
 *
 * Example:
 *     look + app_current(t)
 */
fun app_current(t: Theme): Styling[] = [
    Border {
        all: Side { width: Width.Px(RING_WIDTH), color: paint(t.accent), ..Side.theme() },
        ..Border.theme(),
    },
];

/**
 * Returns the sidebar's × look: a small round button on the frame's colour,
 * so it reads over an app's icon.
 *
 * Example:
 *     ui.button_with([x], Msg.CloseTab(id)).style(tab_close(t))
 */
fun tab_close(t: Theme): Styling[] = [
    Button.ghost(),
    Background { color: paint(t.control), ..Background.theme() },
    Text { color: paint(t.on_frame), ..Text.theme() },
    Border { radius: Radius.All(CIRCLE), ..Border.theme() },
    Sizing { min_width: Width.Px(TAB_CLOSE), min_height: Width.Px(TAB_CLOSE), ..Sizing.theme() },
    // The × fills the small circle: kivuli.ui buttons have 16 px at the sides.
    no_padding(),
    When(State.Hover, [Background { color: paint(t.danger), ..Background.theme() }]),
];

/**
 * Returns the look of one instance in the header's strip (PRP-033): a thin
 * pill in the frame's text, washed on hover, the one in front ringed in
 * the accent as the sidebar's current app is. The pill is a group: its ×
 * shows while it's hovered.
 *
 * Example:
 *     row([name, close]).style(instance_chip(t, true))
 */
fun instance_chip(t: Theme, current: bool): Styling[] {
    let mut look: Styling[] = [
        Group.mark(),
        Text { color: paint(t.on_frame), ..Text.theme() },
        Border { radius: Radius.All(CIRCLE), ..Border.theme() },
        // Thinner than a button: exactly this high (the owner, session 177).
        Sizing {
            min_height: Width.Px(INSTANCE_CHIP),
            max_height: Width.Px(INSTANCE_CHIP),
            ..Sizing.theme()
        },
        // The circle sits flush at the start; room only after the ×.
        Spacing {
            padding: Edges { right: Width.Px(SPACE_XS), ..Edges.theme() },
            ..Spacing.theme()
        },
        margin_x(SPACE_XS),
        When(State.Hover, [Background { color: paint(t.frame_hover), ..Background.theme() }]),
    ];
    if current {
        for x of app_current(t) {
            look.push(x);
        }
    }
    look
}

/**
 * Returns the look of an instance's coloured circle (PRP-033): as tall as
 * its pill (the owner, session 177), in `colour`, one of the theme's
 * `instances`.
 *
 * Example:
 *     column(none).style(instance_dot(instance_colour(t, page.instance)))
 */
fun instance_dot(colour: string): Styling[] = [
    Background { color: paint(colour), ..Background.theme() },
    Border { radius: Radius.All(CIRCLE), ..Border.theme() },
    square(INSTANCE_CHIP),
];

/**
 * Returns an app's colour dot at an address with several apps (PRP-050):
 * a small circle in its colour (`themes.publisher_colour`).
 *
 * Example:
 *     app_dot(publisher_colour(t, origin))
 */
fun app_dot(colour: string): Styling[] = [
    Background { color: paint(colour), ..Background.theme() },
    Border { radius: Radius.All(CIRCLE), ..Border.theme() },
    square(APP_DOT),
];

/**
 * Returns the look of the dock's count (PRP-033): a small round badge in
 * the accent, the number dark on it (the brand colour takes dark text).
 *
 * Example:
 *     text("2").style(count_badge(t))
 */
fun count_badge(t: Theme): Styling[] = [
    Background { color: paint(t.accent), ..Background.theme() },
    // kivuli starts a label's text at its left; the badge centres it.
    Text { color: paint(t.on_accent), align: TextAlign.Center, ..Text.theme() },
    Border { radius: Radius.All(CIRCLE), ..Border.theme() },
    Sizing { min_width: Width.Px(TAB_CLOSE), min_height: Width.Px(TAB_CLOSE), ..Sizing.theme() },
    // No padding: the minimum size rounds one digit; more widen it.
    no_padding(),
];

/**
 * Returns the look of a × on a tab that isn't current (PRP-028): the ×'s
 * look, hidden until the pointer is over its tab or the focus is in it.
 *
 * Example:
 *     close.style(tab_close_on_hover(t))
 */
fun tab_close_on_hover(t: Theme): Styling[] {
    let hidden: Styling[] = [
        Effects.opacity(0.0),
        When(State.GroupHover, [Effects.opacity(1.0)]),
        When(State.GroupFocusWithin, [Effects.opacity(1.0)]),
    ];
    tab_close(t) + hidden
}

/**
 * Returns the window controls' look on the frame, given after
 * `kivuli.ui`'s `WindowControls.look()`: white glyphs, room on each side,
 * and the hover a circle on each control's 24 × 24 icon box, faint white
 * (red for close). The buttons themselves stay clear: GTK stretches them to
 * the bar's height, where rounding makes a tall pill (the owner's
 * screenshot, session 116).
 *
 * Example:
 *     header_bar(start, title, end).style(window_controls(t))
 */
fun window_controls(t: Theme): Styling[] = [
    Inside(Part.WindowButton, [
        Text { color: paint(t.on_frame), ..Text.theme() },
        Background { color: paint(t.clear), ..Background.theme() },
        margin_x(SPACE_XS),
        When(State.Hover, [Background { color: paint(t.clear), ..Background.theme() }]),
        When(State.Press, [Background { color: paint(t.clear), ..Background.theme() }]),
    ]),
    // kivuli.ui's look paints the close button itself red on hover: clear it
    // too, so close shows the same circle as the rest (session 119).
    Inside(Part.WindowClose, [
        When(State.Hover, [Background { color: paint(t.clear), ..Background.theme() }]),
        When(State.Press, [Background { color: paint(t.clear), ..Background.theme() }]),
    ]),
    // The circle: each control's 24 × 24 icon box, padded so it isn't tight
    // around the glyph (32 across), round.
    Inside(Part.WindowIcon, [
        // The glyph the size of every other icon (the owner, session 126),
        // in place of kivuli.ui's 24.
        Sizing { icon: Width.Px(HEADER_ICON), ..Sizing.theme() },
        padding(SPACE_XS),
        Border { radius: Radius.All(CIRCLE), ..Border.theme() },
        When(State.Hover, [Background { color: paint(t.frame_hover), ..Background.theme() }]),
    ]),
    Inside(Part.WindowCloseIcon, [
        When(State.Hover, [Background { color: paint(t.danger), ..Background.theme() }]),
    ]),
];

/**
 * Returns every tooltip's look: the theme's text on `tooltip`, padded
 * `SPACE_MD` at the sides and `SPACE_SM` above and below, its corners
 * rounded `BUTTON_RADIUS` (session 146). GTK shows a
 * tooltip in its own window beside the root, so only the root's style
 * reaches it (kivuli's `Part.Tooltip`).
 *
 * Example:
 *     root.style(tooltips(t))
 */
fun tooltips(t: Theme): Styling[] = [
    Inside(Part.Tooltip, [
        Background { color: paint(t.tooltip), ..Background.theme() },
        Text { color: paint(t.text), ..Text.theme() },
        padding_xy(SPACE_MD, SPACE_SM),
        Border { radius: Radius.All(BUTTON_RADIUS), ..Border.theme() },
    ]),
];
